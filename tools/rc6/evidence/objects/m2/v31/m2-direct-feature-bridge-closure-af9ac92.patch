+{
+  "schemaVersion": "BehaviorCandidateFeatureBridgeV1",
+  "contractId": "BehaviorCandidateFeatureBridgeV1",
+  "revision": 1,
+  "status": "FROZEN",
+  "encoding": "UTF-8",
+  "title": "candidate-level facts bridge: transcribes prepareDecisionRequest(CANDIDATES_ONLY) candidate identity and public snapshot, per-candidate DECISION_VISIBLE preview atomic facts, and PrototypeDirectAdapterV1 admit/project output into the BehaviorImmediateFeatureV1 input contract production subset; one pass per candidate and per effect; explicit rejections, pending, deferred and untranscribed accounting; paymentMode derived (never fabricated); ZERO supported projection is a fatal contract violation; BIF caps (CAP_EXCEEDED, MAX_WORK_UNITS_PER_CALL=200000) referenced as whole-compile rejections; no selection, no TopK, no future route, no result world, no hidden facts, no teacher in production closure.",
+  "authority": {
+    "milestone": "M2",
+    "governedBy": [
+      "BehaviorProviderV1",
+      "PrototypeDirectAdapterV1",
+      "PrototypeDirectAdapterV1.schema",
+      "BehaviorImmediateFeatureV1",
+      "BehaviorImmediateFeatureV1.schema",
+      "DirectFactRowV1"
+    ],
+    "claim": "CONTRACT_TARGET_ONLY_NOT_IMPLEMENTED",
+    "claimDetail": "freezes the transcription bridge input/output shape, lifting rules and accounting; the runtime bridge module is not implemented; this contract is not an implementation claim.",
+    "futureRouteDerivation": false,
+    "worldClone": false,
+    "resultWorldEnumeration": false,
+    "hiddenInformationRead": false,
+    "selectionOrTopK": false,
+    "teacherInProductionClosure": false
+  },
+  "inputSurface": {
+    "sources": [
+      "prepareDecisionRequest CANDIDATES_ONLY frozen candidate identity (candidateId, actorId, actorSide, actionKind, targetSet, paymentMode)",
+      "prepareDecisionRequest CANDIDATES_ONLY visibleWorld public snapshot (units, sides, actorStatus)",
+      "per-candidate previewAction basis DECISION_VISIBLE atomic contributions with finite expectedDelta and finite evidence.hitProbability",
+      "PrototypeDirectAdapterV1 admit/project rows: directFacts, legalityModifiers, opportunityModifiers, scheduledFacts, unsupportedOutcomeKinds, deferCode",
+      "candidate declaration public costs (魂力/精神力/体力/生命) and public hit probability evidence",
+      "candidate declaration payment fields: candidate.paymentMode, declaration.paymentMode, candidate.resourcePotentialOnly"
+    ],
+    "forbidden": [
+      "ROUTE",
+      "WORLD_CLONE",
+      "RESULT_WORLD",
+      "HIDDEN",
+      "WALL_CLOCK",
+      "RANDOM_SOURCE",
+      "R8",
+      "TEACHER",
+      "SKILL_ROLE_NAME"
+    ],
+    "timing": "BEFORE_CANDIDATE_FREEZE; one pass per candidate and per effect; no branch combination; no candidate selection or TopK"
+  },
+  "paymentModeDerivationV1": {
+    "rule": "priority chain: 1) candidate.paymentMode when present; 2) else declaration.paymentMode when present; 3) else candidate.resourcePotentialOnly === true => EXTERNAL_TIMELINE; 4) else FORMAL. The emitted BIF candidate.paymentMode is always a non-empty string; the bridge never omits it and never lets the harness fabricate FORMAL.",
+    "priority": [
+      "candidate.paymentMode",
+      "declaration.paymentMode",
+      "candidate.resourcePotentialOnly===true => EXTERNAL_TIMELINE",
+      "FORMAL_DEFAULT"
+    ],
+    "note": "paymentMode is identity only for the feature compiler; EXTERNAL_TIMELINE is an opaque non-empty string, no special-casing downstream."
+  },
+  "perCandidateOutput": {
+    "candidateId": "string, non-empty, at most 512 characters, rejects C0/DEL control characters; equals the prepared candidate identity",
+    "bifInput": {
+      "shape": "production subset of BehaviorImmediateFeatureV1 inputContract revision 4: candidate, publicSnapshot, atomicFacts, directFacts, legalityModifiers, opportunityModifiers, scheduledFacts, mechanicMetadataEntries, projectionFamilies, publicCost, publicProbability, publicDeclarations",
+      "lifting": {
+        "mechanicMetadataEntries": "aggregated from PrototypeDirectAdapterV1 opportunityModifiers.mechanicMetadataEntries across all effects of the candidate into one closed array; values are verbatim normalized deep clones, deep-frozen and never re-interpreted or scored; multi-effect entries are kept per effect instance",
+        "projectionFamilies": "aggregated from PrototypeDirectAdapterV1 opportunityModifiers.projectionFamilies; closed [{sourceEffectId, prototype}] entries; routing identity only, never a weight",
+        "scheduledFacts": "PrototypeDirectAdapterV1 scheduledFacts rows verbatim; no repack; every scheduledFacts row (WINDOW_ADJUST/SETTLEMENT_RATIO_ADJUST/FOLLOW_UP/SUMMON_WINDOW) already carries entryId = sourceEffectId + ':schedule:' + 0-based index inside that effect's own scheduledFacts array",
+        "opportunityModifiers": "transcribed minus the lifted mechanicMetadataEntries and projectionFamilies keys"
+      },
+      "testOnlyKeysNeverEmitted": [
+        "forbiddenFacts",
+        "branchCombination",
+        "preMultiplied"
+      ]
+    },
+    "rejections": {
+      "shape": "array of closed rejection records, one per rejected effect instance",
+      "items": [
+        {
+          "kind": "REJECTED_INPUT_WITH_REASON",
+          "code": [
+            "UNKNOWN_PROTOTYPE_REJECTED",
+            "FORMAL_LIBRARY_OUT_OF_BATTLE_SCOPE",
+            "MISSING_SOURCE_CONTEXT",
+            "MISSING_TARGET_CONTEXT",
+            "INVALID_OPTION_VALUE",
+            "MISSING_REQUIRED_FIELD",
+            "UNKNOWN_RULE",
+            "AMBIGUOUS_TAUNT_TARGET"
+          ],
+          "sourceEffectId": "effect identity"
+        },
+        {
+          "kind": "UNSUPPORTED_CARRIER_REQUIRES_UNPACK",
+          "sourceEffectId": "effect identity"
+        }
+      ],
+      "note": "the REJECTED_INPUT_WITH_REASON code enum covers every PDA mechanical rejection code in PrototypeDirectAdapterV1 (four formal codes plus INVALID_OPTION_VALUE/MISSING_REQUIRED_FIELD/UNKNOWN_RULE/AMBIGUOUS_TAUNT_TARGET); UNSUPPORTED_CARRIER_REQUIRES_UNPACK stays its own kind; rejection records are never remapped into BIF hardExclusions."
+    },
+    "pdaPending": {
+      "shape": "array of closed pending records, one per pending effect instance; mechanically valid input is never disguised as mechanical illegality",
+      "kind": [
+        "PENDING_CONDITIONAL_PROJECTION",
+        "PENDING_TRIGGER_PROJECTION",
+        "PENDING_DURATION_PROJECTION",
+        "PENDING_DIRECTION_PROJECTION",
+        "PENDING_DIRECT_PROJECTION"
+      ]
+    },
+    "pdaDeferred": {
+      "shape": "array of closed deferred records, one per effect instance whose PDA project returned a deferCode; deferred effects stay admitted and are never disguised as pending or rejected",
+      "kinds": [
+        "DEFER_MECHANICS_PROJECTION",
+        "DEFER_LEGALITY_INJECTION",
+        "DEFER_REPORT_PROJECTION"
+      ]
+    },
+    "untranscribedPreviewFacts": {
+      "shape": "explicit count plus reason list for every preview contribution that is not transcribed into atomicFacts; UNKNOWN is never represented as 0",
+      "reasons": [
+        "non-finite expectedDelta",
+        "non-finite hitProbability",
+        "missing outcomeKind",
+        "missing eventId",
+        "unmatched contribution source"
+      ]
+    },
+    "noOfficialEffectMaterialization": {
+      "shape": "array of closed records for candidates whose action kind carries no official effect object in CANDIDATES_ONLY prep",
+      "kinds": [
+        "BASIC_ATTACK",
+        "DEFEND",
+        "EVADE",
+        "PASS"
+      ],
+      "note": "the implicit base-action public mechanics must be materialized upstream from preview public operands; the bridge never invents a skill effect object and never masks the absence with INVALID_OPTION_VALUE"
+    }
+  },
+  "totals": {
+    "shape": "candidateCount, pdaItems, compiledCount, rejectionSum, pendingSum, deferSum, fatalSum, untranscribedSum; all non-negative integers; rejectionSum/pendingSum/deferSum/fatalSum/untranscribedSum equal the sums of the per-candidate records",
