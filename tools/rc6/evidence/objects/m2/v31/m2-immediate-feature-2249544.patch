+      "teacherValueVectorNotFeature": true,
+      "rule": "teacher 输出的 valueVector 永远不是生产特征；生产只消费 BehaviorImmediateFeatureV1 特征向量；raw teacher case 与特征之间无桥时显式 NOT_PAIRED。"
+    },
+    "contractStatus": "FROZEN",
+    "contractStatusNote": "合同文本冻结状态；顶层 status 是 schema 可表达的 artifact 状态（CONTRACT_TARGET_NOT_TRAINED），字段名不冲突。"
+  },
+  "canonicalSerializationV1": {
+    "variant": "RECURSIVE_UTF16_KEY_SORT",
+    "rule": "compact UTF8 JSON (no insignificant whitespace); object keys sorted recursively by UTF-16 code unit ascending; array order preserved; -0 normalized to 0; NaN/Infinity rejected (validator FATAL, never serialized as null)",
+    "appliesTo": [
+      "packageHash",
+      "teacherHash",
