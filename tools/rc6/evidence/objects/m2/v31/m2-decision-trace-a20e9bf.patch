+  "normalized": "(rawValue - mean) / scale for KNOWN unmasked, else omitted",
+  "weight": "artifact coefficient for the featureCode; masked features have no weight applied",
+  "contribution": "weight * normalized for KNOWN unmasked; omitted for UNKNOWN/NOT_APPLICABLE/ALWAYS_UNKNOWN; 0 only when a KNOWN unmasked contribution is exactly 0",
+  "missingMask": "every model feature whose status is not KNOWN (incl SETTLEMENT_DAMAGE/ROLL_REALIZATION which are ALWAYS_UNKNOWN); HARD_EXCLUSION/HARD_EXCLUSION_REASON are NOT part of the model missingMask - they are explained via hardExclusions only; masked features contribute nothing and are never explained as real 0",
+  "score": "intercept + sum over KNOWN unmasked contributions",
+  "summationOrder": "featureOrdering ascending: candidate scope first, then EFFECT_ROW by (sourceEffectId, key, featureCode) UTF-16; fixed order required for reproducibility",
