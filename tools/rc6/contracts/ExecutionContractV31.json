    "random": {
      "required": true,
      "model": "SEEDED_REPLAYABLE_FACT",
      "samplePolicy": "SAMPLE_ONCE_PER_DECLARED_RANDOM_FACT",
      "record": ["seed", "distribution", "actualValue", "outcomeBranch"],
      "replayRule": "Same sourceHash, inputHash, provider state, case and seed reproduce the same random facts.",
      "branchCoverage": "ALL_DECLARED_OUTCOME_PROBABILITIES",
      "rerollAfterSelection": false,
      "reportMayInventRandomValue": false
    },
    "interference": {
      "visibility": "PUBLIC_OR_DECLARED_STATE_ONLY",
      "rateRange": [0, 1],
      "effect": "A target-interference rate changes the legal target opportunity or target distribution and is part of the dependency identity.",
      "cacheRule": "Any affected reuse is invalidated when interference state or rate changes.",
      "hiddenInference": false
    },
    "taunt": {
      "visibility": "PUBLIC_STATE",
      "effect": "An active taunt constrains target legality to the taunter or its declared legal target set.",
      "selectionRule": "Auto selection cannot ignore a legal taunt; PLAYER_LOCKED remains subject to legality.",
      "isGeneralDecisionOverride": false
    }
  },
