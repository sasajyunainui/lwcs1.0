  "interface": {
    "adapterScope": "one adapter per prototype; admit/project dispatched per effect instance and per path; prototype status is a default only; unknown prototype rejected",
    "unknownPrototypePolicy": {
      "action": "REJECTED_INPUT",
      "reasonCode": "UNKNOWN_PROTOTYPE_REJECTED"
    },
    "admit": {
      "input": [
        "effect",
        "legalityContext"
      ],
      "output": {
        "admitted": "boolean",
        "reasons": "string[]"
      },
      "failureAction": "REJECTED_INPUT_WITH_REASON"
    },
    "project": {
      "input": [
        "effect",
        "legalityContext"
      ],
      "output": {
        "factColumns": "direct fact column contributions of MechanicalColumnsV1 (HP_DELTA, RESOURCE_OPTION_CHANGED, SHIELD_DELTA, STATE_DELTA, SCHEDULED_HP_DELTA, SUMMON_WINDOW, RESOURCE_TRANSFER, RULE_DEFENSE_COUNTER, POSITION_DELTA, COPY_EXECUTION, TIME_REWIND)",
        "legalityModifiers": "target-legality modifiers derived from current public state only (taunt source constraint, control cancellation, disarm or silence rules, state migration and erasure of taunt or control)",
        "opportunityModifiers": "opportunity identity and distribution modifiers (judgment rates, interference rates, resource locks) that enter candidate dependency tokens",
        "scheduledFacts": "S5 scheduled and window facts (delayed triggers, duration adjustments, follow-up or summon window grants)",
        "unsupportedOutcomeKinds": "outcome kinds this adapter cannot project; non-empty only together with deferCode or an explicit reason code",
        "deferCode": "per-path defer code; empty string when the path is fully supported"
      },
      "silentZero": false,
      "candidateRetention": "deferred candidates retain vector coverage and candidateAudit reason"
    },
    "allowedDeferCodes": [
      "DEFER_MECHANICS_PROJECTION",
      "DEFER_LEGALITY_INJECTION",
      "DEFER_REPORT_PROJECTION"
    ],
    "legalityContext": {
      "source": "CURRENT_PUBLIC_STATE_ONLY",
      "allowed": [
        "visibleHpRatios",
        "publicStates",
        "observableDeclarations",
        "revealedAbilityIds",
        "observableResults"
      ],
      "forbidden": [
        "hiddenExactHp",
        "hiddenResistance",
        "hiddenInventory",
        "hiddenAbility",
        "unobservedPosterior",
        "worldClone",
        "futureRouteEnumeration",
        "resultEnumeration"
      ],
      "timing": "BEFORE_CANDIDATE_FREEZE",
      "playerLocked": "SAME_GATE"
    },
    "dispatch": "PER_EFFECT_PATH_ADMIT_PROJECT"
  },
