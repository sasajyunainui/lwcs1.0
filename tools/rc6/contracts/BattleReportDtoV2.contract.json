{
  "schemaVersion": "BattleReportDtoV2",
  "visibilityModes": [
    "PLAYER",
    "REVIEW",
    "DEVELOPER"
  ],
  "requiredCommonFields": [
    "schemaVersion",
    "visibilityMode",
    "projectionStatus",
    "draftHash",
    "sourceDraftHash",
    "actualRoundCount",
    "terminalResult",
    "objectiveSummary",
    "roundSummaries",
    "roundOverview",
    "decisionExplanations",
    "realizedOutcomes",
    "resourceTimeline",
    "finalResult",
    "finalSummary",
    "exchanges",
    "narrativeChain",
    "aiStructuredSummary",
    "battleHeadline"
  ],
  "playerProjection": {
    "visibilityMode": "PLAYER",
    "projectionStatus": "PASSED",
    "requiredFields": [
      "battleId",
      "draftHash",
      "objectiveSummary",
      "roundSummaries",
      "decisionExplanations",
      "realizedOutcomes",
      "resourceTimeline",
      "finalResult",
      "aiStructuredSummary"
    ],
    "forbiddenTopLevelFields": [
      "factRegistry",
      "pipelineStats",
      "sourceLedgerCount",
      "sourceDecisionCount",
      "termDictionaryVersion"
    ]
  },
  "playerContract": {
    "visibilityMode": "PLAYER",
    "projectionStatus": "PASSED",
    "allowedSources": [
      "PLAYER"
    ],
    "forbiddenSources": [
      "Ledger",
      "logs",
      "trace",
      "DEVELOPER"
    ],
    "numericTokenRequiredFields": [
      "displayName",
      "value",
      "unit",
      "sourceEventId",
      "sourceFactId",
      "derivationRule",
      "tacticalConsequence",
      "operands"
    ]
  },
  "reviewContract": {
    "visibilityMode": "REVIEW",
    "projectionStatus": "PASSED",
    "mayContain": [
      "anonymousPublicDecisionContext",
      "publicCandidateTradeoffs",
      "numericOperandsAndSources"
    ],
    "mustNotContain": [
      "hiddenResources",
      "hiddenAbilities",
      "hiddenResistances",
      "rawInternalIds",
      "postHocJustification"
    ]
  },
  "developerContract": {
    "visibilityMode": "DEVELOPER",
    "mayContain": [
      "provider",
      "formula",
      "randomSource",
      "causalOwnership",
      "dependencyAndCacheDiagnostics"
    ]
  }
}
