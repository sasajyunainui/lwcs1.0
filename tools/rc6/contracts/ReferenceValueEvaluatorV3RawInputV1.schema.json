{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ReferenceValueEvaluatorV3RawInputV1.schema.json",
  "title": "Reference Value Evaluator V3 Closed Raw Input V1",
  "type": "object",
  "required": ["schemaVersion", "evaluator", "count", "cases"],
  "properties": {
    "schemaVersion": { "const": "ReferenceValueEvaluatorV3RawInputV1" },
    "evaluator": { "const": "tools/rc6/reference/reference-value-evaluator-v3.mjs" },
    "count": { "const": 6 },
    "cases": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/case" } }
  },
  "additionalProperties": false,
  "$defs": {
    "unit": {
      "type": "object",
      "required": ["unitId", "side", "currentHp", "maxHp"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1 },
        "side": { "type": "string", "minLength": 1 },
        "currentHp": { "type": "number" },
        "maxHp": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": ["unitId", "resourceId", "current", "maximum"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1 },
        "resourceId": { "type": "string", "minLength": 1 },
        "current": { "type": "number" },
        "maximum": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": ["unitId", "stateId", "startTick", "expireTick"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1 },
        "stateId": { "enum": ["CONTROLLED", "INSPIRED", "PROTECTED"] },
        "startTick": { "type": "number" },
        "expireTick": { "type": "number" }
      },
      "additionalProperties": false
    },
    "inventory": {
      "type": "object",
      "required": ["unitId", "itemId", "quantity", "startTick", "expireTick"],
      "properties": {
        "unitId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 },
        "quantity": { "type": "number", "minimum": 0 },
        "startTick": { "type": "number" },
        "expireTick": { "type": "number" }
      },
      "additionalProperties": false
    },
    "summon": {
      "type": "object",
      "required": ["summonUnitId", "hostUnitId", "startTick", "expireTick"],
      "properties": {
        "summonUnitId": { "type": "string", "minLength": 1 },
        "hostUnitId": { "type": "string", "minLength": 1 },
        "startTick": { "type": "number" },
        "expireTick": { "type": "number" }
      },
      "additionalProperties": false
    },
    "world": {
      "type": "object",
      "required": ["tick", "horizonTick", "units", "resources", "states", "inventory", "summons"],
      "properties": {
        "tick": { "type": "number" },
        "horizonTick": { "type": "number" },
        "units": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/unit" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "states": { "type": "array", "items": { "$ref": "#/$defs/state" } },
        "inventory": { "type": "array", "items": { "$ref": "#/$defs/inventory" } },
        "summons": { "type": "array", "items": { "$ref": "#/$defs/summon" } }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["kind", "targetUnitId"],
      "properties": {
        "kind": { "enum": ["HEALTH_CHANGE", "RESOURCE_CHANGE", "STATE_CHANGE"] },
        "targetUnitId": { "type": "string", "minLength": 1 },
        "deltaHp": { "type": "number" },
        "resourceId": { "type": "string", "minLength": 1 },
        "delta": { "type": "number" },
        "stateId": { "enum": ["CONTROLLED", "INSPIRED", "PROTECTED"] },
        "operation": { "enum": ["ADD", "REMOVE"] },
        "startTick": { "type": "number" },
        "expireTick": { "type": "number" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "HEALTH_CHANGE" } }, "required": ["kind"] }, "then": { "required": ["deltaHp"] } },
        { "if": { "properties": { "kind": { "const": "RESOURCE_CHANGE" } }, "required": ["kind"] }, "then": { "required": ["resourceId", "delta"] } },
        { "if": { "properties": { "kind": { "const": "STATE_CHANGE" } }, "required": ["kind"] }, "then": { "required": ["stateId", "operation", "startTick", "expireTick"] } }
      ],
      "additionalProperties": false
    },
    "actionFact": {
      "type": "object",
      "required": ["kind", "factId", "eventId", "sequence", "resolveTick", "startTick", "expireTick", "targetUnitId"],
      "properties": {
        "kind": { "enum": ["HEALTH_CHANGE", "RESOURCE_CHANGE", "STATE_CHANGE", "TERMINAL_OUTCOME", "SUMMON", "CREATION"] },
        "factId": { "type": "string", "minLength": 1 },
        "eventId": { "type": "string", "minLength": 1 },
        "sequence": { "type": "number" },
        "resolveTick": { "type": "number" },
        "startTick": { "type": "number" },
        "expireTick": { "type": "number" },
        "targetUnitId": { "type": "string", "minLength": 1 },
        "deltaHp": { "type": "number" },
        "resourceId": { "type": "string", "minLength": 1 },
        "delta": { "type": "number" },
        "stateId": { "enum": ["CONTROLLED", "INSPIRED", "PROTECTED"] },
        "operation": { "enum": ["ADD", "REMOVE"] },
        "winProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "lossProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "drawProbability": { "type": "number", "minimum": 0, "maximum": 1 },
        "hostUnitId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 },
        "quantity": { "type": "number", "exclusiveMinimum": 0 }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "HEALTH_CHANGE" } }, "required": ["kind"] }, "then": { "required": ["deltaHp"] } },
        { "if": { "properties": { "kind": { "const": "RESOURCE_CHANGE" } }, "required": ["kind"] }, "then": { "required": ["resourceId", "delta"] } },
        { "if": { "properties": { "kind": { "const": "STATE_CHANGE" } }, "required": ["kind"] }, "then": { "required": ["stateId", "operation"] } },
        { "if": { "properties": { "kind": { "const": "TERMINAL_OUTCOME" } }, "required": ["kind"] }, "then": { "required": ["winProbability", "lossProbability", "drawProbability"] } },
        { "if": { "properties": { "kind": { "const": "SUMMON" } }, "required": ["kind"] }, "then": { "required": ["hostUnitId"] } },
        { "if": { "properties": { "kind": { "const": "CREATION" } }, "required": ["kind"] }, "then": { "required": ["itemId", "quantity"] } }
      ],
      "additionalProperties": false
    },
    "opportunity": {
      "type": "object",
      "required": ["opportunityId", "actorUnitId", "startTick", "expireTick", "resourceId", "resourceCost", "requiredStateUnitId", "requiredStateId", "requiredItemUnitId", "requiredItemId", "requiredSummonId", "affectedUnitIds", "effects"],
      "properties": {
        "opportunityId": { "type": "string", "minLength": 1 },
        "actorUnitId": { "type": "string", "minLength": 1 },
        "startTick": { "type": "number" },
        "expireTick": { "type": "number" },
        "resourceId": { "type": ["string", "null"], "minLength": 1 },
        "resourceCost": { "type": "number", "minimum": 0 },
        "requiredStateUnitId": { "type": ["string", "null"], "minLength": 1 },
        "requiredStateId": { "enum": ["CONTROLLED", "INSPIRED", "PROTECTED", null] },
        "requiredItemUnitId": { "type": ["string", "null"], "minLength": 1 },
        "requiredItemId": { "type": ["string", "null"], "minLength": 1 },
        "requiredSummonId": { "type": ["string", "null"], "minLength": 1 },
        "affectedUnitIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/effect" } }
      },
      "additionalProperties": false
    },
    "futureAction": {
      "type": "object",
      "required": ["candidateId", "actorUnitId", "startTick", "expireTick", "resourceId", "resourceCost", "requiredStateUnitId", "requiredStateId", "requiredItemUnitId", "requiredItemId", "requiredSummonId", "affectedUnitIds", "effects"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "actorUnitId": { "type": "string", "minLength": 1 },
        "startTick": { "type": "number" },
        "expireTick": { "type": "number" },
        "resourceId": { "type": ["string", "null"], "minLength": 1 },
        "resourceCost": { "type": "number", "minimum": 0 },
        "requiredStateUnitId": { "type": ["string", "null"], "minLength": 1 },
        "requiredStateId": { "enum": ["CONTROLLED", "INSPIRED", "PROTECTED", null] },
        "requiredItemUnitId": { "type": ["string", "null"], "minLength": 1 },
        "requiredItemId": { "type": ["string", "null"], "minLength": 1 },
        "requiredSummonId": { "type": ["string", "null"], "minLength": 1 },
        "affectedUnitIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "effects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/effect" } }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["type", "threshold", "targetIds", "side", "scope"],
      "properties": {
        "type": { "enum": ["HP_RATIO_AT_OR_BELOW", "HP_RATIO_AT_OR_ABOVE"] },
        "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "targetIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "side": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["ANY", "ALL"] }
      },
      "additionalProperties": false
    },
    "objectiveSide": {
      "type": "object",
      "required": ["logic", "conditions"],
      "properties": {
        "logic": { "enum": ["ANY", "ALL"] },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } }
      },
      "additionalProperties": false
    },
    "objectiveContract": {
      "type": ["object", "null"],
      "required": ["victory", "defeat"],
      "properties": {
        "victory": { "$ref": "#/$defs/objectiveSide" },
        "defeat": { "$ref": "#/$defs/objectiveSide" }
      },
      "additionalProperties": false
    },
    "riskInputs": {
      "type": "object",
      "required": ["actorUnitId", "actorOutcomeDeltas", "shieldFacts", "negativeTerminal"],
      "properties": {
        "actorUnitId": { "type": "string", "minLength": 1 },
        "actorOutcomeDeltas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["deltas"],
            "properties": { "deltas": { "type": "array", "items": { "type": "number" } } },
            "additionalProperties": false
          }
        },
        "shieldFacts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["targetUnitId", "deltaHp"],
            "properties": {
              "targetUnitId": { "type": "string", "minLength": 1 },
              "deltaHp": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "negativeTerminal": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["outcomeId", "probability", "observations", "futureActions"],
      "properties": {
        "outcomeId": { "type": "string", "minLength": 1 },
        "probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "observations": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "futureActions": { "type": "array", "items": { "$ref": "#/$defs/futureAction" } }
      },
      "additionalProperties": false
    },
    "informationGroup": {
      "type": "object",
      "required": ["groupId", "outcomes"],
      "properties": {
        "groupId": { "type": "string", "minLength": 1 },
        "outcomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/outcome" } }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": ["candidateId", "actionId", "targetSet", "paymentMode", "legal", "playerLocked", "hardExclusionCodes", "actorSide", "world", "objectiveContract", "actionFacts", "opportunities", "riskInputs", "informationGroups"],
      "properties": {
        "candidateId": { "type": "string", "minLength": 1 },
        "actionId": { "type": "string", "minLength": 1 },
        "targetSet": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "paymentMode": { "type": "string", "minLength": 1 },
        "legal": { "type": "boolean" },
        "playerLocked": { "type": "boolean" },
        "hardExclusionCodes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "actorSide": { "type": "string", "minLength": 1 },
        "world": { "$ref": "#/$defs/world" },
        "objectiveContract": { "$ref": "#/$defs/objectiveContract" },
        "actionFacts": { "type": "array", "items": { "$ref": "#/$defs/actionFact" } },
        "opportunities": { "type": "array", "items": { "$ref": "#/$defs/opportunity" } },
        "riskInputs": { "$ref": "#/$defs/riskInputs" },
        "informationGroups": { "type": "array", "items": { "$ref": "#/$defs/informationGroup" } }
      },
      "additionalProperties": false
    },
    "caseInput": {
      "type": "object",
      "required": ["mode", "playerLockedCandidateId", "candidates"],
      "properties": {
        "mode": { "enum": ["auto", "manual"] },
        "playerLockedCandidateId": { "type": ["string", "null"], "minLength": 1 },
        "candidates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/candidate" } }
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "required": ["selectedCandidateId"],
      "properties": {
        "selectedCandidateId": { "type": "string", "minLength": 1 },
        "objectiveUtilityHEPP": { "type": "number" }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["caseId", "semanticDomain", "input", "expected"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1 },
        "semanticDomain": { "enum": ["S1", "S2", "S3", "S4", "S5", "S6"] },
        "input": { "$ref": "#/$defs/caseInput" },
        "expected": { "$ref": "#/$defs/expected" }
      },
      "additionalProperties": false
    }
  }
}
