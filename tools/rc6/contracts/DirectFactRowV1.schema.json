{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "DirectFactRowV1.schema.json",
 "title": "DirectFactRowV1",
 "description": "Evaluable direct fact row projected by PrototypeDirectAdapterV1 revision 4 (declared magnitudes only; no mitigation or hit final settlement). amount must be finite (JSON schema plus runtime validator); targetIds must be actual candidate target ids, empty or symbolic placeholders rejected; all ids are non-empty, at most 512 characters, allow CJK/hyphen/space and reject C0 control characters and DEL.",
 "type": "object",
 "required": [
  "schemaVersion",
  "factType",
  "key",
  "sourceActionId",
  "sourceActorId",
  "sourceEffectId",
  "targetIds",
  "amount",
  "unit",
  "durationTurns"
 ],
 "properties": {
  "schemaVersion": {
   "const": "DirectFactRowV1"
  },
  "factType": {
   "enum": [
    "HP_DELTA",
    "RESOURCE_OPTION_CHANGED",
    "SHIELD_DELTA",
    "STATE_DELTA",
    "SCHEDULED_HP_DELTA",
    "SUMMON_WINDOW",
    "RESOURCE_TRANSFER",
    "RULE_DEFENSE_COUNTER",
    "POSITION_DELTA",
    "COPY_EXECUTION",
    "TIME_REWIND"
   ]
  },
  "key": {
   "type": "string",
   "minLength": 0
  },
  "sourceActionId": {
   "type": "string",
   "minLength": 1,
   "maxLength": 512,
   "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
  },
  "sourceActorId": {
   "type": "string",
   "minLength": 1,
   "maxLength": 512,
   "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
  },
  "sourceEffectId": {
   "type": "string",
   "minLength": 1,
   "maxLength": 512,
   "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
  },
  "targetIds": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "allOf": [
     {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
     },
     {
      "not": {
       "enum": [
        "自身",
        "单体",
        "群体",
        "全场",
        "召唤物",
        "目标",
        "target",
        "actor",
        "self",
        "all",
        "any"
       ]
      }
     }
    ]
   }
  },
  "amount": {
   "type": "number"
  },
  "unit": {
   "enum": [
    "POWER",
    "ABS",
    "PERCENT",
    "RATIO",
    "COUNT",
    "TURNS",
    "DISTANCE",
    "BOOL"
   ]
  },
  "durationTurns": {
   "type": "integer",
   "minimum": 0
  }
 },
 "additionalProperties": false
}
