{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "BehaviorImmediateFeatureV1.schema.json",
 "title": "BehaviorImmediateFeatureV1",
 "description": "Feature vector document produced by the BehaviorImmediateFeatureV1 feature compiler (revision 4). Closed schema: featureCode/unitFamily/status/reasonCode enums, value present iff KNOWN, EFFECT_ROW features carry at least one sourceFactIds; BOOL feature values are strictly 0 or 1 (STATE_PRESENCE/DAMAGE_TYPE/OVERKILL_AVAILABILITY/HARD_EXCLUSION/ROLL_REALIZATION), additionalProperties false everywhere, no wildcard propertyNames patterns. candidateId admits real ids: nonempty <=512, rejects C0/DEL control chars, any other code points (CJK/hyphen/space) allowed; ordering by UTF-16 code unit. revision 4: featureCode enum 29 codes incl batch-2 raw codes and RESOURCE_DELTA_PERCENT; unitFamily enum adds RATIO.",
 "type": "object",
 "revision": {
  "const": 4
 },
 "required": [
  "schemaVersion",
  "candidateId",
  "features",
  "featureCount"
 ],
 "properties": {
  "schemaVersion": {
   "const": "BehaviorImmediateFeatureV1"
  },
  "candidateId": {
   "type": "string",
   "minLength": 1,
   "maxLength": 512,
   "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
  },
  "features": {
   "type": "array",
   "minItems": 1,
   "maxItems": 256,
   "uniqueItems": true,
   "items": {
    "$ref": "#/$defs/feature"
   }
  },
  "featureCount": {
   "type": "integer",
   "minimum": 0,
   "maximum": 256
  }
 },
 "additionalProperties": false,
 "$defs": {
  "numericCodes": {
   "enum": [
    "RELATION_TARGET_COUNT",
    "SUCCESS_PROBABILITY",
    "PUBLIC_HP_RATIO",
    "PUBLIC_RESOURCE_RATIO",
    "COST_AFFORDABILITY",
    "REVEAL_STRENGTH",
    "OVERKILL_AVAILABILITY",
    "HARD_EXCLUSION",
    "SETTLEMENT_DAMAGE",
    "ROLL_REALIZATION",
    "OUTSIDE_BATCH1_ROW_COUNT",
    "DAMAGE_POWER",
    "DAMAGE_SEGMENTS",
    "DAMAGE_PENETRATION",
    "DAMAGE_TYPE",
    "RESOURCE_DELTA",
    "SHIELD_DELTA",
    "ATTRIBUTE_DELTA",
    "JUDGMENT_DELTA",
    "STATE_PRESENCE",
    "STATE_DURATION",
    "STATE_DELTA_PERCENT",
    "SETTLEMENT_MODIFIER_PERCENT",
    "SUMMON_COUNT",
    "SUMMON_STRENGTH",
    "SUMMON_DURATION",
    "RESOURCE_DELTA_PERCENT"
   ]
  },
  "stringCodes": {
   "enum": [
    "RELATION_TARGET_SIDE",
    "HARD_EXCLUSION_REASON"
   ]
  },
  "rowScopeCodes": {
   "enum": [
    "DAMAGE_POWER",
    "DAMAGE_SEGMENTS",
    "DAMAGE_PENETRATION",
    "DAMAGE_TYPE",
    "RESOURCE_DELTA",
    "SHIELD_DELTA",
    "ATTRIBUTE_DELTA",
    "JUDGMENT_DELTA",
    "STATE_PRESENCE",
    "STATE_DURATION",
    "STATE_DELTA_PERCENT",
    "SETTLEMENT_MODIFIER_PERCENT",
    "SUMMON_COUNT",
    "SUMMON_STRENGTH",
    "SUMMON_DURATION",
    "RESOURCE_DELTA_PERCENT"
   ]
  },
  "unknownReasonCodes": {
   "enum": [
    "NO_PUBLIC_DECLARATION",
    "CONDITIONAL_PROBABILITY_UNRESOLVED",
    "FINAL_SETTLEMENT_UNKNOWN",
    "FUTURE_REALIZATION_UNKNOWN",
    "HIDDEN_AXIS_UNOBSERVED",
    "MISSING_SOURCE_FACT",
    "SIDE_UNOBSERVED",
    "STATE_FORM_UNMAPPED"
   ]
  },
  "notApplicableReasonCodes": {
   "enum": [
    "NO_TARGET_AXIS",
    "NO_HIT_AXIS",
    "NO_PUBLIC_COST",
    "NOT_EXCLUDED",
    "NO_DURATION"
   ]
  },
  "feature": {
   "type": "object",
   "required": [
    "featureCode",
    "unitFamily",
    "status",
    "reasonCode",
    "sourceFactIds",
    "sourceEventIds"
   ],
   "properties": {
    "featureCode": {
     "enum": [
      "RELATION_TARGET_COUNT",
      "RELATION_TARGET_SIDE",
      "SUCCESS_PROBABILITY",
      "PUBLIC_HP_RATIO",
      "PUBLIC_RESOURCE_RATIO",
      "COST_AFFORDABILITY",
      "REVEAL_STRENGTH",
      "OVERKILL_AVAILABILITY",
      "HARD_EXCLUSION",
      "HARD_EXCLUSION_REASON",
      "SETTLEMENT_DAMAGE",
      "ROLL_REALIZATION",
      "OUTSIDE_BATCH1_ROW_COUNT",
      "DAMAGE_POWER",
      "DAMAGE_SEGMENTS",
      "DAMAGE_PENETRATION",
      "DAMAGE_TYPE",
      "RESOURCE_DELTA",
      "SHIELD_DELTA",
      "ATTRIBUTE_DELTA",
      "JUDGMENT_DELTA",
      "STATE_PRESENCE",
      "STATE_DURATION",
      "STATE_DELTA_PERCENT",
      "SETTLEMENT_MODIFIER_PERCENT",
      "SUMMON_COUNT",
      "SUMMON_STRENGTH",
      "SUMMON_DURATION",
      "RESOURCE_DELTA_PERCENT"
     ]
    },
    "unitFamily": {
     "enum": [
      "COUNT",
      "ABS",
      "POWER",
      "PERCENT",
      "RATIO",
      "RATIO_0_1",
      "PROBABILITY_0_1",
      "TURNS",
      "BOOL",
      "ENUM"
     ]
    },
    "status": {
     "enum": [
      "KNOWN",
      "UNKNOWN",
      "NOT_APPLICABLE"
     ]
    },
    "value": {},
    "reasonCode": {
     "type": "string",
     "minLength": 1,
     "maxLength": 64
    },
    "sourceFactIds": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
     }
    },
    "sourceEventIds": {
     "type": "array",
     "uniqueItems": true,
     "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
     }
    }
   },
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "status": {
        "const": "KNOWN"
       }
      },
      "required": [
       "status"
      ]
     },
     "then": {
      "required": [
       "value"
      ],
      "properties": {
       "reasonCode": {
        "const": "OK"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "const": "UNKNOWN"
       }
      },
      "required": [
       "status"
      ]
     },
     "then": {
      "not": {
       "required": [
        "value"
       ]
      },
      "properties": {
       "reasonCode": {
        "$ref": "#/$defs/unknownReasonCodes"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "status": {
        "const": "NOT_APPLICABLE"
       }
      },
      "required": [
       "status"
      ]
     },
     "then": {
      "not": {
       "required": [
        "value"
       ]
      },
      "properties": {
       "reasonCode": {
        "$ref": "#/$defs/notApplicableReasonCodes"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "featureCode": {
        "$ref": "#/$defs/numericCodes"
       }
      },
      "required": [
       "featureCode"
      ]
     },
     "then": {
      "properties": {
       "value": {
        "type": "number"
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "featureCode": {
        "const": "RELATION_TARGET_SIDE"
       }
      },
      "required": [
       "featureCode"
      ]
     },
     "then": {
      "properties": {
       "value": {
        "type": "string",
        "enum": [
         "SELF",
         "ALLY",
         "ENEMY",
         "MIXED"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "featureCode": {
        "const": "HARD_EXCLUSION_REASON"
       }
      },
      "required": [
       "featureCode"
      ]
     },
     "then": {
      "properties": {
       "value": {
        "type": "string",
        "enum": [
         "ACTOR_DISABLED",
         "ACTOR_TERMINAL",
         "TARGET_EMPTY",
         "INVALID_OPTION_VALUE",
         "MISSING_REQUIRED_FIELD",
         "UNKNOWN_STATE",
         "UNKNOWN_RULE",
         "AMBIGUOUS_TAUNT_TARGET",
         "ILLEGAL_TARGET",
         "RESOURCE_INSUFFICIENT"
        ]
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "featureCode": {
        "$ref": "#/$defs/rowScopeCodes"
       }
      },
      "required": [
       "featureCode"
      ]
     },
     "then": {
      "if": {
       "properties": {
        "reasonCode": {
         "not": {
          "const": "MISSING_SOURCE_FACT"
         }
        }
       },
       "required": [
        "reasonCode"
       ]
      },
      "then": {
       "properties": {
        "sourceFactIds": {
         "minItems": 1
        }
       }
      }
     }
    },
    {
     "if": {
      "properties": {
       "featureCode": {
        "enum": [
         "STATE_PRESENCE",
         "DAMAGE_TYPE",
         "OVERKILL_AVAILABILITY",
         "HARD_EXCLUSION",
         "ROLL_REALIZATION"
        ]
       }
      },
      "required": [
       "featureCode"
      ]
     },
     "then": {
      "properties": {
       "value": {
        "enum": [
         0,
         1
        ]
       }
      }
     }
    }
   ]
  },
  "caps": {
   "type": "object",
   "required": [
    "MAX_FEATURES_PER_CANDIDATE",
    "MAX_FACT_ROWS_PER_CANDIDATE",
    "MAX_MODIFIER_ENTRIES_PER_CANDIDATE",
    "MAX_WORK_UNITS_PER_CALL",
    "branchCombination"
   ],
   "additionalProperties": false,
   "properties": {
    "MAX_FEATURES_PER_CANDIDATE": {
     "const": 256
    },
    "MAX_FACT_ROWS_PER_CANDIDATE": {
     "const": 128
    },
    "MAX_MODIFIER_ENTRIES_PER_CANDIDATE": {
     "const": 64
    },
    "MAX_WORK_UNITS_PER_CALL": {
     "const": 200000
    },
    "branchCombination": {
     "const": false
    }
   }
  },
  "rejection": {
   "type": "object",
   "required": [
    "reasonCode"
   ],
   "additionalProperties": false,
   "properties": {
    "schemaVersion": {
     "const": "BehaviorImmediateFeatureV1Rejection"
    },
    "candidateId": {
     "type": "string",
     "minLength": 1,
     "maxLength": 512,
     "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "reasonCode": {
     "enum": [
      "ROUTE_INPUT_REJECTED",
      "WORLD_CLONE_REJECTED",
      "RESULT_WORLD_CARTESIAN_REJECTED",
      "HIDDEN_INPUT_REJECTED",
      "WALL_CLOCK_REJECTED",
      "SKILL_ROLE_NAME_SPECIAL_CASE_REJECTED",
      "TEACHER_INPUT_REJECTED",
      "BRANCH_COMBINATION_FORBIDDEN",
      "NON_FINITE_REJECTED",
      "DUPLICATE_FEATURE",
      "UNIT_FAMILY_MISMATCH",
      "UNKNOWN_ZERO_PLACEHOLDER",
      "DURATION_MULTIPLIES_MAGNITUDE",
      "UNKNOWN_FEATURE_CODE",
      "UNKNOWN_UNIT_FAMILY",
      "INVALID_STATUS_VALUE",
      "MISSING_SOURCE_REFERENCE",
      "INVALID_OPTION_VALUE",
      "PROTOTYPE_NAME_WEIGHTING_REJECTED",
      "CAP_EXCEEDED"
     ]
    },
    "detail": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "features": {
       "type": "integer",
       "minimum": 0
      },
      "rows": {
       "type": "integer",
       "minimum": 0
      },
      "modifiers": {
       "type": "integer",
       "minimum": 0
      },
      "work": {
       "type": "integer",
       "minimum": 0
      }
     }
    }
   }
  }
 }
}
