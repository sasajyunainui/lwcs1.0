{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BehaviorImmediateFeatureV1.schema.json",
  "title": "BehaviorImmediateFeatureV1",
  "description": "Feature vector document produced by the BehaviorImmediateFeatureV1 feature compiler (revision 2). Closed schema: featureCode/unitFamily/status/reasonCode enums, value present iff KNOWN, EFFECT_ROW features carry at least one sourceFactIds; BOOL feature values are strictly 0 or 1 (STATE_PRESENCE/DAMAGE_TYPE/OVERKILL_AVAILABILITY/HARD_EXCLUSION/ROLL_REALIZATION), additionalProperties false everywhere, no wildcard propertyNames patterns. candidateId admits real ids: nonempty <=512, rejects C0/DEL control chars, any other code points (CJK/hyphen/space) allowed; ordering by UTF-16 code unit.",
  "type": "object",
  "required": [
    "schemaVersion",
    "candidateId",
    "features",
    "featureCount"
  ],
  "properties": {
    "schemaVersion": {
      "const": "BehaviorImmediateFeatureV1"
    },
    "candidateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/feature"
      }
    },
    "featureCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    }
  },
  "additionalProperties": false,
  "$defs": {
    "numericCodes": {
      "enum": [
        "RELATION_TARGET_COUNT",
        "SUCCESS_PROBABILITY",
        "PUBLIC_HP_RATIO",
        "PUBLIC_RESOURCE_RATIO",
        "COST_AFFORDABILITY",
        "REVEAL_STRENGTH",
        "OVERKILL_AVAILABILITY",
        "HARD_EXCLUSION",
        "SETTLEMENT_DAMAGE",
        "ROLL_REALIZATION",
        "OUTSIDE_BATCH1_ROW_COUNT",
        "DAMAGE_POWER",
        "DAMAGE_SEGMENTS",
        "DAMAGE_PENETRATION",
        "DAMAGE_TYPE",
        "RESOURCE_DELTA",
        "SHIELD_DELTA",
        "ATTRIBUTE_DELTA",
        "JUDGMENT_DELTA",
        "STATE_PRESENCE",
        "STATE_DURATION"
      ]
    },
    "stringCodes": {
      "enum": [
        "RELATION_TARGET_SIDE",
        "HARD_EXCLUSION_REASON"
      ]
    },
    "rowScopeCodes": {
      "enum": [
        "DAMAGE_POWER",
        "DAMAGE_SEGMENTS",
        "DAMAGE_PENETRATION",
        "DAMAGE_TYPE",
        "RESOURCE_DELTA",
        "SHIELD_DELTA",
        "ATTRIBUTE_DELTA",
        "JUDGMENT_DELTA",
        "STATE_PRESENCE",
        "STATE_DURATION"
      ]
    },
    "unknownReasonCodes": {
      "enum": [
        "NO_PUBLIC_DECLARATION",
        "CONDITIONAL_PROBABILITY_UNRESOLVED",
        "FINAL_SETTLEMENT_UNKNOWN",
        "FUTURE_REALIZATION_UNKNOWN",
        "HIDDEN_AXIS_UNOBSERVED",
        "MISSING_SOURCE_FACT",
        "SIDE_UNOBSERVED",
        "STATE_FORM_UNMAPPED"
      ]
    },
    "notApplicableReasonCodes": {
      "enum": [
        "NO_TARGET_AXIS",
        "NO_HIT_AXIS",
        "NO_PUBLIC_COST",
        "NOT_EXCLUDED",
        "NO_DURATION"
      ]
    },
    "feature": {
      "type": "object",
      "required": [
        "featureCode",
        "unitFamily",
        "status",
        "reasonCode",
        "sourceFactIds",
        "sourceEventIds"
      ],
      "properties": {
        "featureCode": {
          "enum": [
            "RELATION_TARGET_COUNT",
            "RELATION_TARGET_SIDE",
            "SUCCESS_PROBABILITY",
            "PUBLIC_HP_RATIO",
            "PUBLIC_RESOURCE_RATIO",
            "COST_AFFORDABILITY",
            "REVEAL_STRENGTH",
            "OVERKILL_AVAILABILITY",
            "HARD_EXCLUSION",
            "HARD_EXCLUSION_REASON",
            "SETTLEMENT_DAMAGE",
            "ROLL_REALIZATION",
            "OUTSIDE_BATCH1_ROW_COUNT",
            "DAMAGE_POWER",
            "DAMAGE_SEGMENTS",
            "DAMAGE_PENETRATION",
            "DAMAGE_TYPE",
            "RESOURCE_DELTA",
            "SHIELD_DELTA",
            "ATTRIBUTE_DELTA",
            "JUDGMENT_DELTA",
            "STATE_PRESENCE",
            "STATE_DURATION"
          ]
        },
        "unitFamily": {
          "enum": [
            "COUNT",
            "ABS",
            "POWER",
            "PERCENT",
            "RATIO_0_1",
            "PROBABILITY_0_1",
            "TURNS",
            "BOOL",
            "ENUM"
          ]
        },
        "status": {
          "enum": [
            "KNOWN",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "value": {},
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "sourceFactIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "sourceEventIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "KNOWN"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "reasonCode": {
                "const": "OK"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            },
            "properties": {
              "reasonCode": {
                "$ref": "#/$defs/unknownReasonCodes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "NOT_APPLICABLE"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            },
            "properties": {
              "reasonCode": {
                "$ref": "#/$defs/notApplicableReasonCodes"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "featureCode": {
                "$ref": "#/$defs/numericCodes"
              }
            },
            "required": [
              "featureCode"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "featureCode": {
                "const": "RELATION_TARGET_SIDE"
              }
            },
            "required": [
              "featureCode"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "SELF",
                  "ALLY",
                  "ENEMY",
                  "MIXED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "featureCode": {
                "const": "HARD_EXCLUSION_REASON"
              }
            },
            "required": [
              "featureCode"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "ACTOR_DISABLED",
                  "ACTOR_TERMINAL",
                  "TARGET_EMPTY",
                  "INVALID_OPTION_VALUE",
                  "MISSING_REQUIRED_FIELD",
                  "UNKNOWN_STATE",
                  "UNKNOWN_RULE",
                  "AMBIGUOUS_TAUNT_TARGET",
                  "ILLEGAL_TARGET",
                  "RESOURCE_INSUFFICIENT"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "featureCode": {
                "$ref": "#/$defs/rowScopeCodes"
              }
            },
            "required": [
              "featureCode"
            ]
          },
          "then": {
            "properties": {
              "sourceFactIds": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "featureCode": {
                "enum": [
                  "STATE_PRESENCE",
                  "DAMAGE_TYPE",
                  "OVERKILL_AVAILABILITY",
                  "HARD_EXCLUSION",
                  "ROLL_REALIZATION"
                ]
              }
            },
            "required": [
              "featureCode"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  0,
                  1
                ]
              }
            }
          }
        }
      ]
    }
  }
}
