{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SemanticAssertionV1.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "assertionId",
    "domain",
    "statement",
    "executableCheck",
    "resolutionStatus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "SemanticAssertionV1"
    },
    "assertionId": {
      "type": "string"
    },
    "domain": {
      "enum": [
        "S1",
        "S2",
        "S3",
        "S4",
        "S5",
        "S6"
      ]
    },
    "statement": {
      "type": "string"
    },
    "executableCheck": {
      "type": "string"
    },
    "resolutionStatus": {
      "const": "FROZEN"
    }
  },
  "additionalProperties": true
}
