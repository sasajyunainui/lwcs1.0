{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PrototypeDirectAdapterV1.schema.json",
  "title": "PrototypeDirectAdapterV1",
  "type": "object",
  "oneOf": [
    {
      "title": "contract",
      "type": "object",
      "required": ["schemaVersion", "contractId", "status", "encoding", "authority", "interface", "registry", "counts", "deferredPaths", "constraints", "validation"],
      "properties": {
        "schemaVersion": { "const": "PrototypeDirectAdapterV1" },
        "contractId": { "type": "string", "minLength": 1, "pattern": "^RC6-M2-" },
        "status": { "enum": ["FROZEN"] },
        "encoding": { "const": "UTF-8" },
        "authority": {
          "type": "object",
          "required": ["adjudication", "supersedes", "previewAdmissionDecoupled", "futureRouteDerivation", "worldClone", "silentZero", "wholePrototypeExclusion"],
          "properties": {
            "adjudication": { "const": "M2-CONTRACT-ADJUDICATION-C" },
            "supersedes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
            "previewAdmissionDecoupled": { "const": true },
            "futureRouteDerivation": { "const": false },
            "worldClone": { "const": false },
            "silentZero": { "const": false },
            "wholePrototypeExclusion": { "const": false }
          },
          "additionalProperties": false
        },
        "interface": {
          "type": "object",
          "required": ["adapterScope", "dispatch", "unknownPrototypePolicy", "admit", "project", "allowedDeferCodes", "legalityContext"],
          "properties": {
            "adapterScope": { "const": "one adapter per prototype; admit/project dispatched per effect instance and per path; prototype status is a default only; unknown prototype rejected" },
            "dispatch": { "const": "PER_EFFECT_PATH_ADMIT_PROJECT" },
            "unknownPrototypePolicy": {
              "type": "object",
              "required": ["action", "reasonCode"],
              "properties": {
                "action": { "const": "REJECTED_INPUT" },
                "reasonCode": { "const": "UNKNOWN_PROTOTYPE_REJECTED" }
              },
              "additionalProperties": false
            },
            "admit": {
              "type": "object",
              "required": ["input", "output", "failureAction"],
              "properties": {
                "input": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["effect", "legalityContext"] } },
                "output": {
                  "type": "object",
                  "required": ["admitted", "reasons"],
                  "properties": {
                    "admitted": { "const": "boolean" },
                    "reasons": { "const": "string[]" }
                  },
                  "additionalProperties": false
                },
                "failureAction": { "const": "REJECTED_INPUT_WITH_REASON" }
              },
              "additionalProperties": false
            },
            "project": {
              "type": "object",
              "required": ["input", "output", "silentZero", "candidateRetention"],
              "properties": {
                "input": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["effect", "legalityContext"] } },
                "output": {
                  "type": "object",
                  "required": ["factColumns", "legalityModifiers", "opportunityModifiers", "scheduledFacts", "unsupportedOutcomeKinds", "deferCode"],
                  "properties": {
                    "factColumns": { "const": "direct fact column contributions of MechanicalColumnsV1 (HP_DELTA, RESOURCE_OPTION_CHANGED, SHIELD_DELTA, STATE_DELTA, SCHEDULED_HP_DELTA, SUMMON_WINDOW, RESOURCE_TRANSFER, RULE_DEFENSE_COUNTER, POSITION_DELTA, COPY_EXECUTION, TIME_REWIND)" },
                    "legalityModifiers": { "const": "target-legality modifiers derived from current public state only (taunt source constraint, control cancellation, disarm or silence rules, state migration and erasure of taunt or control)" },
                    "opportunityModifiers": { "const": "opportunity identity and distribution modifiers (judgment rates, interference rates, resource locks) that enter candidate dependency tokens" },
                    "scheduledFacts": { "const": "S5 scheduled and window facts (delayed triggers, duration adjustments, follow-up or summon window grants)" },
                    "unsupportedOutcomeKinds": { "const": "outcome kinds this adapter cannot project; non-empty only together with deferCode or an explicit reason code" },
                    "deferCode": { "const": "per-path defer code; empty string when the path is fully supported" }
                  },
                  "additionalProperties": false
                },
                "silentZero": { "const": false },
                "candidateRetention": { "const": "deferred candidates retain vector coverage and candidateAudit reason" }
              },
              "additionalProperties": false
            },
            "allowedDeferCodes": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": { "enum": ["DEFER_MECHANICS_PROJECTION", "DEFER_LEGALITY_INJECTION", "DEFER_REPORT_PROJECTION"] }
            },
            "legalityContext": {
              "type": "object",
              "required": ["source", "allowed", "forbidden", "timing", "playerLocked"],
              "properties": {
                "source": { "const": "CURRENT_PUBLIC_STATE_ONLY" },
                "allowed": {
                  "type": "array",
                  "minItems": 5,
                  "maxItems": 5,
                  "uniqueItems": true,
                  "items": { "enum": ["visibleHpRatios", "publicStates", "observableDeclarations", "revealedAbilityIds", "observableResults"] }
                },
                "forbidden": {
                  "type": "array",
                  "minItems": 8,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": { "enum": ["hiddenExactHp", "hiddenResistance", "hiddenInventory", "hiddenAbility", "unobservedPosterior", "worldClone", "futureRouteEnumeration", "resultEnumeration"] }
                },
                "timing": { "const": "BEFORE_CANDIDATE_FREEZE" },
                "playerLocked": { "const": "SAME_GATE" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "registry": {
          "type": "object",
          "required": ["伤害结算","资源变化","资源转移","护盾变化","属性修正","判定修正","结算修正","炸环","状态施加","时窗修正","状态移除","规则防御","状态转移","状态交换","资源锁定","规则改写","机制抹消","机制授予","复制执行","时光回溯","位移执行","决策干扰","召唤生成","修炼增益","天赋提升","永久属性提升","战斗外复活"],
          "properties": {
            "伤害结算": { "$ref": "#/$defs/registryEntry" },
            "资源变化": { "$ref": "#/$defs/registryEntry" },
            "资源转移": { "$ref": "#/$defs/registryEntry" },
            "护盾变化": { "$ref": "#/$defs/registryEntry" },
            "属性修正": { "$ref": "#/$defs/registryEntry" },
            "判定修正": { "$ref": "#/$defs/registryEntry" },
            "结算修正": { "$ref": "#/$defs/registryEntry" },
            "炸环": { "$ref": "#/$defs/registryEntry" },
            "状态施加": { "$ref": "#/$defs/registryEntry" },
            "时窗修正": { "$ref": "#/$defs/registryEntry" },
            "状态移除": { "$ref": "#/$defs/registryEntry" },
            "规则防御": { "$ref": "#/$defs/registryEntry" },
            "状态转移": { "$ref": "#/$defs/registryEntry" },
            "状态交换": { "$ref": "#/$defs/registryEntry" },
            "资源锁定": { "$ref": "#/$defs/registryEntry" },
            "规则改写": { "$ref": "#/$defs/registryEntry" },
            "机制抹消": { "$ref": "#/$defs/registryEntry" },
            "机制授予": { "$ref": "#/$defs/registryEntry" },
            "复制执行": { "$ref": "#/$defs/registryEntry" },
            "时光回溯": { "$ref": "#/$defs/registryEntry" },
            "位移执行": { "$ref": "#/$defs/registryEntry" },
            "决策干扰": { "$ref": "#/$defs/registryEntry" },
            "召唤生成": { "$ref": "#/$defs/registryEntry" },
            "修炼增益": { "$ref": "#/$defs/registryEntry" },
            "天赋提升": { "$ref": "#/$defs/registryEntry" },
            "永久属性提升": { "$ref": "#/$defs/registryEntry" },
            "战斗外复活": { "$ref": "#/$defs/registryEntry" }
          },
          "additionalProperties": false
        },
        "counts": { "$ref": "#/$defs/counts" },
        "deferredPaths": {
          "type": "array",
          "minItems": 40,
          "maxItems": 40,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/deferredPath" }
        },
        "constraints": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "validation": {
          "type": "object",
          "required": ["schema", "utf8", "mojibakeScan", "casesContract", "selfChecks"],
          "properties": {
            "schema": { "const": "PrototypeDirectAdapterV1.schema.json" },
            "utf8": { "const": "REQUIRED" },
            "mojibakeScan": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "enum": ["U+FFFD", "CJK_MOJIBAKE_PREFIX", "LATIN1_UTF8_SEQUENCE", "UTF8_DECODE_REPLACEMENT"] }
            },
            "casesContract": { "const": "PrototypeDirectAdapterCasesV1" },
            "selfChecks": {
              "type": "object",
              "required": ["deferredPathIdsMatchUniverse", "perPathDispatchRequired"],
              "properties": {
                "deferredPathIdsMatchUniverse": { "const": true },
                "perPathDispatchRequired": { "const": true }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "title": "cases",
      "type": "object",
      "required": ["schemaVersion", "contractId", "counts", "deferredPathIds", "cases"],
      "properties": {
        "schemaVersion": { "const": "PrototypeDirectAdapterCasesV1" },
        "contractId": { "type": "string", "minLength": 1, "pattern": "^RC6-M2-" },
        "counts": {
          "type": "object",
          "required": ["inBattlePathCount", "supportedPathCount", "deferredPathCount", "deferredPathIdsCount", "rejectedInputPathCount", "silentOmissionCount", "outOfBattlePrototypeCount", "outOfBattlePathCount", "byPrototype"],
          "properties": {
            "inBattlePathCount": { "const": 621 },
            "supportedPathCount": { "const": 581 },
            "deferredPathCount": { "const": 40 },
            "deferredPathIdsCount": { "const": 40 },
            "rejectedInputPathCount": { "const": 0 },
            "silentOmissionCount": { "const": 0 },
            "outOfBattlePrototypeCount": { "const": 4 },
            "outOfBattlePathCount": { "const": 91 },
            "byPrototype": { "$ref": "#/$defs/pathCountsByPrototype" }
          },
          "additionalProperties": false
        },
        "deferredPathIds": {
          "type": "array",
          "minItems": 40,
          "maxItems": 40,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^PPU1:IN_BATTLE:(复制执行|时光回溯):[^:]+:[0-9]+$" }
        },
        "cases": {
          "type": "array",
          "minItems": 32,
          "items": { "$ref": "#/$defs/case" }
        }
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "supportedEntry": {
      "type": "object",
      "required": ["category", "status", "tier", "pathCount", "supportKind", "reason"],
      "properties": {
        "category": { "enum": ["战斗结算", "行为推导"] },
        "status": { "const": "SUPPORTED" },
        "tier": { "enum": ["T0", "T1", "EXISTING_ADMITTED"] },
        "pathCount": { "type": "integer", "minimum": 1 },
        "supportKind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "deferredEntry": {
      "type": "object",
      "required": ["category", "status", "tier", "pathCount", "defaultDeferCode", "deferredPathCount", "supportKind", "reason"],
      "properties": {
        "category": { "enum": ["战斗结算", "行为推导"] },
        "status": { "const": "DEFERRED_EXPLICIT" },
        "tier": { "const": "T2" },
        "pathCount": { "type": "integer", "minimum": 1 },
        "defaultDeferCode": { "enum": ["DEFER_MECHANICS_PROJECTION", "DEFER_LEGALITY_INJECTION", "DEFER_REPORT_PROJECTION"] },
        "deferredPathCount": { "type": "integer", "minimum": 1 },
        "supportKind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "outOfBattleEntry": {
      "type": "object",
      "required": ["category", "status", "tier", "supportKind", "reason"],
      "properties": {
        "category": { "const": "战斗外" },
        "status": { "const": "OUT_OF_BATTLE_SCOPE" },
        "tier": { "const": "NONE" },
        "supportKind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "rejectedEntry": {
      "type": "object",
      "required": ["category", "status", "tier", "supportKind", "reason"],
      "properties": {
        "category": { "enum": ["战斗结算", "行为推导", "战斗外"] },
        "status": { "const": "REJECTED_INPUT" },
        "tier": { "const": "NONE" },
        "supportKind": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "registryEntry": {
      "oneOf": [
        { "$ref": "#/$defs/supportedEntry" },
        { "$ref": "#/$defs/deferredEntry" },
        { "$ref": "#/$defs/outOfBattleEntry" },
        { "$ref": "#/$defs/rejectedEntry" }
      ]
    },
    "deferredPath": {
      "type": "object",
      "required": ["pathId", "prototype", "field", "option", "deferCode"],
      "properties": {
        "pathId": { "type": "string", "pattern": "^PPU1:IN_BATTLE:(复制执行|时光回溯):[^:]+:[0-9]+$" },
        "prototype": { "enum": ["复制执行", "时光回溯"] },
        "field": { "type": "string", "minLength": 1 },
        "option": {},
        "deferCode": { "enum": ["DEFER_MECHANICS_PROJECTION", "DEFER_LEGALITY_INJECTION", "DEFER_REPORT_PROJECTION"] }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "required": ["totalInBattlePathCount", "supportedPathCount", "deferredPathCount", "deferredPathIdsCount", "rejectedInputPathCount", "outOfBattleScopePathCount", "silentOmissionCount", "supportedByTier", "deferredByPrototype"],
      "properties": {
        "totalInBattlePathCount": { "const": 621 },
        "supportedPathCount": { "const": 581 },
        "deferredPathCount": { "const": 40 },
        "deferredPathIdsCount": { "const": 40 },
        "rejectedInputPathCount": { "const": 0 },
        "outOfBattleScopePathCount": { "const": 91 },
        "silentOmissionCount": { "const": 0 },
        "supportedByTier": {
          "type": "object",
          "required": ["existingAdmitted", "t0", "t1"],
          "properties": {
            "existingAdmitted": { "const": 374 },
            "t0": { "const": 166 },
            "t1": { "const": 41 }
          },
          "additionalProperties": false
        },
        "deferredByPrototype": {
          "type": "object",
          "required": ["复制执行", "时光回溯"],
          "properties": {
            "复制执行": { "const": 22 },
            "时光回溯": { "const": 18 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pathCountsByPrototype": {
      "type": "object",
      "required": ["伤害结算","资源变化","资源转移","护盾变化","属性修正","判定修正","结算修正","炸环","状态施加","时窗修正","状态移除","规则防御","状态转移","状态交换","资源锁定","规则改写","机制抹消","机制授予","复制执行","时光回溯","位移执行","决策干扰","召唤生成"],
      "properties": {
        "伤害结算": { "$ref": "#/$defs/prototypePathCount" },
        "资源变化": { "$ref": "#/$defs/prototypePathCount" },
        "资源转移": { "$ref": "#/$defs/prototypePathCount" },
        "护盾变化": { "$ref": "#/$defs/prototypePathCount" },
        "属性修正": { "$ref": "#/$defs/prototypePathCount" },
        "判定修正": { "$ref": "#/$defs/prototypePathCount" },
        "结算修正": { "$ref": "#/$defs/prototypePathCount" },
        "炸环": { "$ref": "#/$defs/prototypePathCount" },
        "状态施加": { "$ref": "#/$defs/prototypePathCount" },
        "时窗修正": { "$ref": "#/$defs/prototypePathCount" },
        "状态移除": { "$ref": "#/$defs/prototypePathCount" },
        "规则防御": { "$ref": "#/$defs/prototypePathCount" },
        "状态转移": { "$ref": "#/$defs/prototypePathCount" },
        "状态交换": { "$ref": "#/$defs/prototypePathCount" },
        "资源锁定": { "$ref": "#/$defs/prototypePathCount" },
        "规则改写": { "$ref": "#/$defs/prototypePathCount" },
        "机制抹消": { "$ref": "#/$defs/prototypePathCount" },
        "机制授予": { "$ref": "#/$defs/prototypePathCount" },
        "复制执行": { "$ref": "#/$defs/prototypePathCount" },
        "时光回溯": { "$ref": "#/$defs/prototypePathCount" },
        "位移执行": { "$ref": "#/$defs/prototypePathCount" },
        "决策干扰": { "$ref": "#/$defs/prototypePathCount" },
        "召唤生成": { "$ref": "#/$defs/prototypePathCount" }
      },
      "additionalProperties": false
    },
    "prototypePathCount": {
      "type": "object",
      "required": ["status", "pathCount"],
      "properties": {
        "status": { "enum": ["SUPPORTED", "DEFERRED_EXPLICIT"] },
        "pathCount": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["caseId", "kind", "prototype", "effect", "expect"],
      "properties": {
        "caseId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9-]+$" },
        "kind": { "enum": ["POSITIVE", "LEGALITY", "DEFER", "NEGATIVE", "ANTI_PATTERN"] },
        "probe": { "enum": ["CONTRACT_POLICY"] },
        "pathId": { "type": "string", "pattern": "^PPU1:IN_BATTLE:" },
        "prototype": { "type": "string", "minLength": 1 },
        "effect": { "type": "object" },
        "legalityContext": { "type": "object" },
        "expect": {
          "type": "object",
          "required": ["admitted"],
          "properties": {
            "admitted": { "type": "boolean" },
            "deferCode": { "enum": ["", "DEFER_MECHANICS_PROJECTION", "DEFER_LEGALITY_INJECTION", "DEFER_REPORT_PROJECTION"] },
            "unsupportedOutcomeKinds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "factColumns": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "legalityModifiers": { "type": "object" },
            "opportunityModifiers": { "type": "object" },
            "scheduledFacts": { "type": "array", "items": { "type": "object" } },
            "retainedInCandidateAudit": { "type": "boolean" },
            "reasonCode": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}