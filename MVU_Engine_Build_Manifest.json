{
  "manifestVersion": "1.1.0",
  "product": {
    "bundle": "MVU_Engine_Bundle.js",
    "engineRuntime": "MVU_Engine_Runtime.js",
    "projectRuntimeBundle": "LWCS_MVU_Project_Runtime_Bundle.js",
    "sourcePatch": "MVU_Engine_Source.patch",
    "bundleBytes": 1245412,
    "bundleSha256": "32a91ca7cf75c8e058a8ae2abbcbc52907f9a850a0df974a89cc5d371553bd2b",
    "engineRuntimeBytes": 1172740,
    "engineRuntimeSha256": "57c8cf6cf0a112ba047c145b9903c08b09b53ae0f27827d4c8311ca6da634c6c",
    "projectRuntimeBundleBytes": 2465429,
    "projectRuntimeBundleSha256": "b4e9e8bfb9c7b42677742c63ead6b2ae9b092fc683e3716a056f3e7858554b29",
    "sourcePatchBytes": 75755,
    "sourcePatchSha256": "de42b83fd992b58fba0aad04c7656fa5e2707498b6f5ac0f4952a7d8526e321e"
  },
  "upstream": {
    "repository": "https://github.com/MagicalAstrogy/MagVarUpdate.git",
    "commit": "0a730cd4a9b99689d1135a49b542c780b977c24c",
    "artifact": "artifact/bundle.js"
  },
  "build": {
    "packageManager": "yarn@3.4.1",
    "applyPatch": "git apply --unidiff-zero --whitespace=error MVU_Engine_Source.patch",
    "install": "corepack yarn install --immutable",
    "command": "powershell -NoProfile -Command \"$env:LWCS_MVU_BUILD_DATE='2026-08-29 00:00'; corepack yarn build\"",
    "buildDate": "2026-08-29 00:00",
    "output": "artifact/bundle.js -> MVU_Engine_Runtime.js; node Build_Runtime_Bundles.cjs MVU_Engine_Bundle.js -> MVU_Engine_Bundle.js",
    "environmentComposition": [
      "LWCS_Persistence_Adapter.js",
      "LWCS_MVU_Persistence_Provider.js",
      "MVU_Engine_Runtime.js"
    ],
    "dependencyPolicy": "bundle npm dependencies; retain only documented SillyTavern/TavernHelper host globals"
  },
  "loading": {
    "entry": "MVU_ZOD_Entry.js",
    "bundleMode": "dynamic-import",
    "ownerMarker": "__LWCS_MVU_ENGINE_OWNER_V1__",
    "duplicatePolicy": "reuse-current-ready-commit-generation; wait-for-stale-owned-release-and-unique-unregister; fail-unowned",
    "formalDependencyInFlight": "__LWCS_MVU_FORMAL_RESOURCE_LOADS_V1__"
  },
  "runtimeContract": {
    "generationBoundary": "TauriTavern: tavern_events.MESSAGE_RECEIVED(message_id, type); other hosts: tavern_events.MESSAGE_RECEIVED",
    "chatHooksReady": "__LWCS_MVU_CHAT_HOOKS_READY_V1__",
    "syncHotRead": "Mvu.getMvuData",
    "asyncRead": "Mvu.getMvuDataAsync",
    "persistenceAwait": "Mvu.persistence.awaitIdle",
    "persistenceStatus": "Mvu.persistence.getStatus",
    "providerHandleAwait": "handle.awaitIdle",
    "providerHandleStatus": "handle.getStatus",
    "providerHandleFloorRead": "handle.readState",
    "events": {
      "taskStarted": "lwcs_mvu_task_started",
      "taskFinished": "lwcs_mvu_task_finished",
      "commitStarted": "lwcs_mvu_commit_started",
      "commitFinished": "lwcs_mvu_commit_finished"
    },
    "staleKey": ["chat_id", "absolute_index", "swipe_id", "text_fingerprint"],
    "ttHostMarkers": ["__TAURITAVERN_MAIN_READY__", "__TAURITAVERN__.ready"],
    "ttCanonicalCommit": "provider_single_commit",
    "persistentDataChanges": false
  }
}
