  },
  "runtimeContract": {
    "generationBoundary": "TauriTavern: tavern_events.MESSAGE_RECEIVED(message_id, type); other hosts: tavern_events.MESSAGE_RECEIVED",
    "chatHooksReady": "__LWCS_MVU_CHAT_HOOKS_READY_V1__",
