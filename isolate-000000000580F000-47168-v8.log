ervations || [])])\x2C\n    });\n    return Object.freeze({\n      version: VERSION\x2C\n      actorId: preview.unitId(actor)\x2C\n      candidateCount: normalized.length\x2C\n      paretoCount: normalized.filter(candidate => !candidate.rejectionCode).length\x2C\n      candidateAudit: Object.freeze(normalized.map(candidateAuditRecord))\x2C\n      selected: selectedRecord\x2C\n      beliefState: Object.freeze(beliefState)\x2C\n      teamIntent: Object.freeze(teamIntent)\x2C\n      problems: Object.freeze(problems)\x2C\n      strategicSignature: signature\x2C\n      stalemate\x2C\n      stateCapacityTotal: beforeUtility.total\x2C\n      beliefRevision\x2C\n      pendingStrategicEffect\x2C\n      strategyMemory: Object.freeze({\n        problemId: problems[0]?.problemId || 'NEUTRAL_PROGRESS'\x2C\n        targetIds: Object.freeze([...(selected.declaration.targetIds || [])])\x2C\n        expectedOutcomeKinds: Object.freeze((selected.preview?.contributions || []).map(entry => entry.outcomeKind))\x2C\n        expectedWindowIds: Object.freeze((selected.preview?.contributions || []).map(entry => entry.windowId).filter(Boolean))\x2C\n        expiresAtOpportunity: Math.max(1\x2C Number(input.actionOpportunity?.sequence || 0) + 1)\x2C\n      })\x2C\n      scoreAudit: Object.freeze([selected\x2C ...alternatives].map(candidate => Object.freeze({\n        candidateId: candidate.candidateId\x2C\n        actionName: candidateActionName(candidate)\x2C\n        actionKind: candidate.declaration.actionKind\x2C\n        actionRole: String(input.actionOpportunity?.role || 'ACTIVE').trim().toUpperCase() || 'ACTIVE'\x2C\n        actorId: preview.unitId(actor)\x2C\n        targetIds: Object.freeze([...(candidate.declaration.targetIds || [])])\x2C\n        utilityBefore: candidate.utilityBefore\x2C\n        utilityAfter: candidate.utilityAfter\x2C\n        objectiveUtility: candidate.objectiveUtility\x2C\n        normalizedUtility: candidate.normalizedUtility\x2C\n        vector: Object.free