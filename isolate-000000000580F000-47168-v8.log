        return record(\n          `schedule:${descriptorId}`\x2C\n          scheduledEvents.find(entry =>\n            String(entry?.descriptorId || entry?.scheduleId || '').trim() === String(descriptorId || '').trim()\n          ) || null\x2C\n        );\n      }\x2C\n      readObjective(conditionId) {\n        const conditions = [\n          ...(objectiveContract?.victory?.conditions || [])\x2C\n          ...(objectiveContract?.defeat?.conditions || [])\x2C\n        ];\n        return record(\n          `objective:${conditionId}`\x2C\n          conditions.find((entry\x2C index) =>\n            String(entry?.conditionId || entry?.id || index).trim() === String(conditionId || '').trim()\n          ) || null\x2C\n        );\n      }\x2C\n      readRule(ruleKey) {\n        return record(`rule:${ruleKey}`\x2C worldSnapshot?.\u89c4\u5219?.[ruleKey] ?? worldSnapshot?.battleRules?.[ruleKey] ?? null);\n      }\x2C\n      readBelief(mechanicKey) {\n        return record(\n          `belief:${mechanicKey}`\x2C\n          beliefState?.mechanics?.[mechanicKey] ??\n            beliefState?.mechanicPosteriors?.[mechanicKey] ??\n            beliefState?.[mechanicKey] ??\n            null\x2C\n        );\n      }\x2C\n      dependencyKeys() {\n        return Object.freeze([...values.keys()].sort());\n      }\x2C\n      dependencyValueHash(keys = [...values.keys()]) {\n        return `dependency:${preview.stableHash(\n          [...keys].sort().map(key => [key\x2C values.has(key) ? values.get(key) : null])\x2C\n        )}`;\n      }\x2C\n    });\n  }\n\n  function r8PreviewCacheKey(context = {}\x2C candidate = {}\x2C dependencyValueHash = '') {\n    return [\n      context.worldRevision\x2C\n      context.visibleWorldRevision\x2C\n      context.beliefRevision\x2C\n      context.objectiveHash\x2C\n      context.opportunityRevision\x2C\n      context.resourceTimelineRevision\x2C\n      context.scheduleRevision\x2C\n      candidate.declarationFingerprint || declarationFingerprint(candidate.declaration)\x2C\n      preview.stableHash(candidate.declaration?.targetIds || [])\x2C\n      preview.stableHash(context.horizon || {})\x2C\n      dependencyValueHash\x2C\n    ].join('|');\n  }\n\n  function actionRouteFromPreview(input = {}) {\n    const candidate = input.candidate || {};\n    const previewResult = input.previewResult || {};\n    const worldSnapshot = input.worldSnapshot || {};\n    const actorSide = String(input.actorSide || '').trim();\n    const targetIds = Object.freeze([...(candidate?.declaration?.targetIds || [])]);\n    const dependencyUnitIds = Object.freeze([...new Set([\n      String(candidate?.declaration?.actorId || '').trim()\x2C\n      ...targetIds.map(value => String(value || '').trim())\x2C\n    ].filter(Boolean))].sort());\n    const trajectories = [];\n    const outcomeKinds = new Set();\n    const realizationWindows = new Set();\n    const paymentDependencies = [];\n    const opportunityDependencies = [];\n    const actionPoolEffects = [];\n    for (const entry of previewResult?.contributions || []) {\n      const outcomeKind = String(entry?.outcomeKind || '').trim();\n      if (outcomeKind) outcomeKinds.add(outcomeKind);\n      if (entry?.windowId) realizationWindows.add(String(entry.windowId));\n      if (entry?.outcomeKind === 'RESOURCE_OPTION_CHANGED' && entry?.windowId === 'ACTION_COST') {\n        paymentDependencies.push({\n          unitId: entry.targetId\x2C\n          resource: entry?.evidence?.resource || ''\x2C\n          amount: Math.abs(Number(entry?.evidence?.delta || 0))\x2C\n        });\n      }\n      if (['ACTION_CANCELLED'\x2C 'ACTION_GRANTED'\x2C 'SUMMON_WINDOW'].includes(outcomeKind)) {\n        opportunityDependencies.push({\n          targetId: entry.targetId\x2C\n          outcomeKind\x2C\n          windowId: entry.windowId || ''\x2C\n        });\n      }\n      if (!['HP_DELTA'\x2C 'SCHEDULED_HP_DELTA'].includes(outcomeKind)) {\n        actionPoolEffects.push({\n          rootActionId: String(entry?.rootCauseId || entry?.sourceActionId || candidate?.candidateId || '').trim()\x2C\n          effectInstanceId: String(entry?.effectInstanceId || '').trim()\x2C\n          targetId: String(entry?.targetId || '').trim()\x2C\n          outcomeKind\x2C\n          windowId: String(entry?.windowId || '')\x2C\n          expectedDelta: Number(entry?.expectedDelta || 0)\x2C\n          threatValue: Number(entry?.threatValue || 0)\x2C\n          evidence: cloneValue(entry?.evidence || {})\x2C\n        });\n        continue;\n      }\n      const target = findUnitInWorld(worldSnapshot\x2C entry.targetId);\n      if (!target) continue;\n      const baseMaxHp = Math.max(1\x2C preview.readHpMax(target));\n      const rawDelta = Number(entry?.evidence?.delta ?? entry?.expectedDelta ?? 0);\n      const targetSide = sideOf(worldSnapshot\x2C target);\n      const beneficialDelta = targetSide === actorSide ? rawDelta : -rawDelta;\n      trajectories.push({\n        targetId: entry.targetId\x2C\n        outcomeKind\x2C\n        windowId: String(entry?.windowId || '')\x2C\n        healthDeltaPP: 100 * rawDelta / baseMaxHp\x2C\n        actorBenefitPP: 100 * beneficialDelta / baseMaxHp\x2C\n        rootActionId: String(entry?.rootCauseId || entry?.sourceActionId || candidate?.candidateId || '').trim()\x2C\n        sourceEffectInstanceId: String(entry?.effectInstanceId || '')\x2C\n      });\n    }\n    const routeShape = {\n      targetIds\x2C\n      outcomeKinds: [...outcomeKinds].sort()\x2C\n      healthPath: trajectories.map(entry => [\n        entry.targetId\x2C\n        entry.outcomeKind\x2C\n        Number(entry.healthDeltaPP.toFixed(8))\x2C\n        entry.windowId\x2C\n      ])\x2C\n      paymentDependencies\x2C\n      opportunityDependencies\x2C\n      realizationWindows: [...realizationWindows].sort()\x2C\n      actionPoolEffects: actionPoolEffects.map(entry => [\n        entry.targetId\x2C\n        entry.outcomeKind\x2C\n        entry.windowId\x2C\n        entry.effectInstanceId\x2C\n      ])\x2C\n    };\n    return Object.freeze({\n      routeKey: `route:${preview.stableHash(routeShape)}`\x2C\n      candidateId: String(candidate?.candidateId || '').trim()\x2C\n      declarationFingerprint: candidate.declarationFingerprint || declarationFingerprint(candidate.declaration)\x2C\n      targetIds\x2C\n      outcomeKinds: Object.freeze([...outcomeKinds].sort())\x2C\n      paymentDependencies: deepFreeze(paymentDependencies)\x2C\n      opportunityDependencies: deepFreeze(opportunityDependencies)\x2C\n      realizationWindows: Object.freeze([...realizationWindows].sort())\x2C\n      healthTrajectoryByTarget: deepFreeze(trajectories)\x2C\n      actionPoolEffects: deepFreeze(actionPoolEffects)\x2C\n      terminalPathId: ''\x2C\n      probabilityBounds: Object.freeze({ lower: 0\x2C upper: 1 })\x2C\n      dependencyKeys: Object.freeze([...(input.dependencyKeys || [])].sort())\x2C\n      dependencyUnitIds\x2C\n      routeBenefitPP: trajectories.reduce((sum\x2C entry) => sum + Number(entry.actorBenefitPP || 0)\x2C 0)\x2C\n    });\n  }\n\n  function routeDominates(left = {}\x2C right = {}) {\n    const leftBenefit = Number(left.routeBenefitPP || 0);\n    const rightBenefit = Number(right.routeBenefitPP || 0);\n    const leftCost = (left.paymentDependencies || []).reduce((sum\x2C entry) => sum + Number(entry.amount || 0)\x2C 0);\n    const rightCost = (right.paymentDependencies || []).reduce((sum\x2C entry) => sum + Number(entry.amount || 0)\x2C 0);\n    return leftBenefit >= rightBenefit - 1e-9 &&\n      leftCost <= rightCost + 1e-9 &&\n      (leftBenefit > rightBenefit + 1e-9 || leftCost < rightCost - 1e-9);\n  }\n\n  function selectPrimaryBackupRoutes(routes = []) {\n    const nonDominated = routes.filter(route =>\n      !routes.some(other => other !== route && routeDominates(other\x2C route))\n    ).sort((left\x2C right) =>\n      Number(right.routeBenefitPP || 0) - Number(left.routeBenefitPP || 0) ||\n      String(left.routeKey || '').localeCompare(String(right.routeKey || ''))\n    );\n    const primaryRoute = nonDominated[0] || routes[0] || null;\n    const backupRoute = nonDominated.find(route => route.routeKey !== primaryRoute?.routeKey) ||\n      routes.find(route => route.routeKey !== primaryRoute?.routeKey) ||\n      null;\n    return Object.freeze({\n      searchedRouteCount: routes.length\x2C\n      nonDominatedRouteCount: nonDominated.length\x2C\n      primaryRoute\x2C\n      backupRoute\x2C\n    });\n  }\n\n  function buildR8RouteCatalog(input = {}) {\n    const worldSnapshot = input.worldSnapshot || {};\n    const dependencyView = input.dependencyView;\n    const evaluationContext = input.evaluationContext || {};\n    const actorId = String(input.actorId || '').trim();\n    const actorCandidates = Array.isArray(input.actorCandidates) ? input.actorCandidates : [];\n    const cache = new Map();\n    const catalog = {};\n    const actorCandidateRoutes = {};\n    const actorProjectedWorlds = {};\n    const fullRoutesByUnit = {};\n    const previousCatalog = input.previousCatalog && typeof input.previousCatalog === 'object'\n      ? input.previousCatalog\n      : null;\n    const affectedUnitIds = new Set((input.affectedUnitIds || []).map(value => String(value || '').trim()).filter(Boolean));\n    const affectedTargetUnitIds = new Set(\n      (Array.isArray(input.affectedTargetUnitIds) ? input.affectedTargetUnitIds : [...affectedUnitIds])\n        .map(value => String(value || '').trim())\n        .filter(Boolean)\x2C\n    );\n    affectedTargetUnitIds.forEach(unitId => affectedUnitIds.add(unitId));\n    if (previousCatalog && affectedTargetUnitIds.size) {\n      Object.entries(previousCatalog).forEach(([unitId\x2C envelope]) => {\n        const routes = [envelope?.primaryRoute\x2C envelope?.backupRoute].filter(Boolean);\n        if (routes.some(route =>\n          (route.targetIds || []).some(targetId => affectedTargetUnitIds.has(String(targetId || '').trim()))\n        )) {\n          affectedUnitIds.add(unitId);\n        }\n      });\n    }\n    const entries = worldEntries(worldSnapshot)\n      .filter(entry => preview.isAlive(entry.unit) && preview.isBattleCapable(entry.unit))\n      .sort((left\x2C right) => String(preview.unitId(left.unit)).localeCompare(String(preview.unitId(right.unit))));\n    for (const entry of entries) {\n      const currentUnitId = preview.unitId(entry.unit);\n      if (previousCatalog && affectedUnitIds.size && !affectedUnitIds.has(currentUnitId)) {\n        catalog[currentUnitId] = previousCatalog[currentUnitId];\n        continue;\n      }\n      const candidates = currentUnitId === actorId\n        ? actorCandidates\n        : enumerateCandidates({\n            worldSnapshot\x2C\n            actorId: currentUnitId\x2C\n            actorSide: entry.side\x2C\n            beliefState: input.beliefState\x2C\n            battleIntent: input.battleIntent\x2C\n            actionOpportunity: {\n              role: 'ACTIVE'\x2C\n              grantType: 'NATURAL_ACTION'\x2C\n              sequence: Number(input.actionOpportunity?.sequence || 0) + 1\x2C\n            }\x2C\n          }).map(candidate => ({\n            ...candidate\x2C\n            declarationFingerprint: declarationFingerprint(candidate.declaration)\x2C\n          }));\n      const routes = candidates.map(candidate => {\n        dependencyView.readUnitHp(currentUnitId);\n        dependencyView.readUnitBaseMaxHp(currentUnitId);\n        for (const targetId of candidate?.declaration?.targetIds || []) {\n          if (!findUnitInWorld(worldSnapshot\x2C targetId)) continue;\n          dependencyView.readUnitHp(targetId);\n          dependencyView.readUnitBaseMaxHp(targetId);\n          dependencyView.readDefenseProfile(targetId);\n        }\n        const dependencyKeys = dependencyView.dependencyKeys();\n        const dependencyValueHash = dependencyView.dependencyValueHash(dependencyKeys);\n        const cacheKey = r8PreviewCacheKey(evaluationContext\x2C candidate\x2C dependen