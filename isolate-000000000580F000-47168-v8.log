script-source,29,node:internal/webidl,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayBufferIsView\x2C\x0d\n  ArrayBufferPrototypeGetResizable\x2C\x0d\n  ArrayIsArray\x2C\x0d\n  ArrayPrototypePush\x2C\x0d\n  ArrayPrototypeToSorted\x2C\x0d\n  BigInt\x2C\x0d\n  DataViewPrototypeGetBuffer\x2C\x0d\n  FunctionPrototypeCall\x2C\x0d\n  MathAbs\x2C\x0d\n  MathMax\x2C\x0d\n  MathMin\x2C\x0d\n  MathPow\x2C\x0d\n  MathSign\x2C\x0d\n  MathTrunc\x2C\x0d\n  Number\x2C\x0d\n  NumberIsFinite\x2C\x0d\n  NumberIsNaN\x2C\x0d\n  NumberMAX_SAFE_INTEGER\x2C\x0d\n  NumberMIN_SAFE_INTEGER\x2C\x0d\n  ObjectPrototypeIsPrototypeOf\x2C\x0d\n  SafeArrayIterator\x2C\x0d\n  SafeSet\x2C\x0d\n  String\x2C\x0d\n  SymbolIterator\x2C\x0d\n  TypeError\x2C\x0d\n  TypedArrayPrototypeGetBuffer\x2C\x0d\n  TypedArrayPrototypeGetSymbolToStringTag\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst { kEmptyObject\x2C setOwnProperty } = require('internal/util');\x0d\nconst {\x0d\n  isSharedArrayBuffer\x2C\x0d\n  isTypedArray\x2C\x0d\n} = require('internal/util/types');\x0d\n\x0d\nconst BIGINT_2_63 = 1n << 63n;\x0d\nconst BIGINT_2_64 = 1n << 64n;\x0d\n\x0d\nconst converters = { __proto__: null };\x0d\n\x0d\n/**\x0d\n * @typedef {object} ConversionOptions\x0d\n * @property {string} [prefix] Message prefix for operation failures.\x0d\n * @property {string} [context] Message context for the converted value.\x0d\n * @property {string} [code] Node.js error code to assign to TypeError.\x0d\n * @property {boolean} [enforceRange] Web IDL [EnforceRange] attribute.\x0d\n * @property {boolean} [clamp] Web IDL [Clamp] attribute.\x0d\n * @property {boolean} [allowShared] Web IDL [AllowShared] attribute for\x0d\n *   buffer view types.\x0d\n * @property {boolean} [allowResizable] Web IDL [AllowResizable] attribute.\x0d\n */\x0d\n\x0d\n/**\x0d\n * @callback Converter\x0d\n * @param {any} V JavaScript value to convert to an IDL value.\x0d\n * @param {ConversionOptions} [options] Conversion options.\x0d\n * @returns {any}\x0d\n */\x0d\n\x0d\n/**\x0d\n * @callback DictionaryMemberValidator\x0d\n * @param {any} idlMemberValue Converted IDL member value.\x0d\n * @param {object} jsDict Original JavaScript dictionary object.\x0d\n * @returns {void}\x0d\n */\x0d\n\x0d\n/**\x0d\n * @typedef {object} DictionaryMember\x0d\n * @property {string} key Dictionary member identifier.\x0d\n * @property {Converter} converter Converter for the member type.\x0d\n * @property {boolean} [required] Whether the member is required.\x0d\n * @property {() => any} [defaultValue] Function returning the default value.\x0d\n * @property {DictionaryMemberValidator} [validator] Optional Node.js\x0d\n *   extension point invoked after conversion and before storing the member.\x0d\n *   This is for early semantic validation of known unsupported IDL values\x2C\x0d\n *   especially in Web Crypto\x2C where SubtleCrypto.supports() needs to answer\x0d\n *   from normalized dictionaries without running the requested operation.\x0d\n */\x0d\n\x0d\n/**\x0d\n * Creates a TypeError with a Node.js error code.\x0d\n * @param {string} message Error message.\x0d\n * @param {string} code Node.js error code to assign.\x0d\n * @returns {TypeError}\x0d\n */\x0d\nfunction codedTypeError(message\x2C code) {\x0d\n  // eslint-disable-next-line no-restricted-syntax\x0d\n  const err = new TypeError(message);\x0d\n  setOwnProperty(err\x2C 'code'\x2C code);\x0d\n  return err;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Creates the exception thrown by Web IDL converters.\x0d\n * @param {string} message Unprefixed conversion failure message.\x0d\n * @param {ConversionOptions} [options] Conversion options.\x0d\n * @returns {TypeError}\x0d\n */\x0d\nfunction makeException(message\x2C options = kEmptyObject) {\x0d\n  const prefix = options.prefix ? options.prefix + ': ' : '';\x0d\n  const context = options.context?.length === 0 ?\x0d\n    '' : (options.context ?? 'Value') + ' ';\x0d\n  return codedTypeError(\x0d\n    `${prefix}${context}${message}`\x2C\x0d\n    options.code || 'ERR_INVALID_ARG_TYPE'\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the ECMAScript specification type of a JavaScript value.\x0d\n * @see https://tc39.es/ecma262/#sec-ecmascript-data-types-and-values\x0d\n * @param {any} V JavaScript value.\x0d\n * @returns {'Undefined'|'Null'|'Boolean'|'String'|'Symbol'|'Number'|'BigInt'|'Object'}\x0d\n */\x0d\nfunction type(V) {\x0d\n  // ECMA-262 6.1: map JavaScript values to language type names.\x0d\n  switch (typeof V) {\x0d\n    case 'undefined':\x0d\n      return 'Undefined';\x0d\n    case 'boolean':\x0d\n      return 'Boolean';\x0d\n    case 'string':\x0d\n      return 'String';\x0d\n    case 'symbol':\x0d\n      return 'Symbol';\x0d\n    case 'number':\x0d\n      return 'Number';\x0d\n    case 'bigint':\x0d\n      return 'BigInt';\x0d\n    case 'object':\x0d\n    case 'function':\x0d\n    default:\x0d\n      // ECMA-262 6.1.2: null is its own language type.\x0d\n      // ECMA-262 6.1.7: functions are Object values.\x0d\n      if (V === null) {\x0d\n        return 'Null';\x0d\n      }\x0d\n      return 'Object';\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns IntegerPart(n).\x0d\n * @see https://webidl.spec.whatwg.org/#abstract-opdef-integerpart\x0d\n * @param {number} n Numeric value.\x0d\n * @returns {number}\x0d\n */\x0d\nfunction integerPart(n) {\x0d\n  // Web IDL IntegerPart steps 1-3: floor(abs(n))\x2C restore the sign\x2C\x0d\n  // and choose +0 rather than -0.\x0d\n  const integer = MathTrunc(n);\x0d\n  return integer === 0 ? 0 : integer;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Rounds to the nearest integer\x2C choosing the even integer on ties.\x0d\n * @param {number} x Numeric value.\x0d\n * @returns {number}\x0d\n */\x0d\nfunction evenRound(x) {\x0d\n  // Web IDL ConvertToInt step 7.2: round to the nearest integer\x2C\x0d\n  // choosing the even integer on ties and +0 rather than -0.\x0d\n  const i = integerPart(x);\x0d\n  const remainder = MathAbs(x % 1);\x0d\n  const sign = MathSign(x);\x0d\n  if (remainder === 0.5)