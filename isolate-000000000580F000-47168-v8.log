8\u679c\u6a21\u5f0f: '\u53ec\u5524'\x2C\n        \u53ec\u5524\u7269\u540d\u79f0: '\u5149\u5f71\u53cc\u9f99\u5206\u8eab'\x2C\n        \u6570\u91cf: 6\x2C\n        \u72b6\u6001: '\u771f\u5047\u6270\u4e71'\x2C\n        \u524d\u6447: 18\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u53cc\u9f99\u5206\u8eab']\x2C\n        \u753b\u9762\u63cf\u8ff0: '\u5149\u9f99\u5206\u8eab\u4e0e\u5f71\u9f99\u5206\u8eab\u4f1a\u5728\u540c\u4e00\u77ac\u540c\u65f6\u5c55\u5f00\uff0c\u516d\u9053\u8eab\u5f71\u4ece\u4e0d\u540c\u89d2\u5ea6\u4e00\u8d77\u6251\u51fa\uff0c\u771f\u5047\u96be\u8fa8\u4e4b\u95f4\u5b8c\u6210\u56f4\u6740\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u8c22\u9082\u660e\u786e\u70b9\u540d\u7684\u7ec4\u5408\u7b2c\u4e09\u9b42\u6280\uff0c\u4ee5\u53cc\u6b66\u9b42\u5206\u8eab\u53e0\u52a0\u5f62\u6210\u591a\u89d2\u5ea6\u5e72\u6270\u3001\u5305\u5939\u548c\u7a81\u88ad\uff0c\u662f\u4ed6\u4e2d\u671f\u6781\u91cd\u8981\u7684\u7206\u53d1\u94fa\u57ab\u3002\u5b9e\u9645\u6548\u679c\uff1a\u53ec\u55246\u4e2a\u5149\u5f71\u53cc\u9f99\u5206\u8eab\u6301\u7eed2\u56de\u5408\uff0c\u5355\u4f53[\u771f\u5047\u6270\u4e71]\u6301\u7eed2\u56de\u5408(\u5f3a\u5ea6-12%)\u3002\u6d88\u8017\uff1a\u9b42\u529b1700\u3002'\x2C\n      })\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u5149\u5e7b\u9f99 / \u5f71\u5e7b\u9f99'\x2C\n        '\u81ea\u521b\u9b42\u6280'\x2C\n        '\u81ea\u521b\u9b42\u6280.\u5149\u5e7b\u9f99 / \u5f71\u5e7b\u9f99'\x2C\n        'ch0669_01'\x2C\n        453025\x2C\n        ['\u5149\u5e7b\u9f99'\x2C '\u5f71\u5e7b\u9f99']\x2C\n        4\x2C\n        '\u91d1\u8272\u5149\u5e7b\u9f99\u4e0e\u865a\u65e0\u5f71\u5e7b\u9f99\u4f1a\u5728\u4ed6\u8eab\u5468\u5148\u540e\u6210\u5f62\uff0c\u4e00\u660e\u4e00\u6697\u4e24\u6761\u5e7b\u9f99\u524d\u540e\u5939\u51fb\u65f6\uff0c\u6574\u7247\u7a7a\u57df\u90fd\u50cf\u88ab\u9f99\u5f71\u6495\u88c2\u3002'\x2C\n        '\u4ee5\u53cc\u5e7b\u9f99\u5f62\u6210\u9ad8\u9636\u538b\u5236\u548c\u5408\u51fb\uff0c\u662f\u4ed6\u5728\u56db\u4e94\u73af\u9636\u6bb5\u6