e0d\u662f\u5175\u5668\u81ea\u5e26\u80fd\u529b\uff0c\u800c\u662f\u4ee5\u81ea\u8eab\u4fe1\u5ff5\u3001\u67aa\u610f\u548c\u4f4d\u9762\u52a9\u529b\u5f62\u6210\u52bf\u4e0d\u53ef\u6321\u7684\u6b63\u9762\u7a81\u7834\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u7a81\u8fdb40\u8ddd\u79bb\uff0c\u5355\u4f53210%\u8fd1\u8eab\u653b\u51fb\uff0c\u9632\u7a7f25\uff0c\u81ea\u8eab\u610f\u5fd7+16%\u6301\u7eed1\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b18000\uff0c\u4f53\u529b22000\uff0c\u7cbe\u795e\u529b6000\u3002'\x2C\n      )\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u5b64\u6ce8\u4e00\u63b7'\x2C\n        '\u81ea\u521b\u9b42\u6280'\x2C\n        '\u81ea\u521b\u9b42\u6280.\u5b64\u6ce8\u4e00\u63b7'\x2C\n        'ch1111_01'\x2C\n        746940\x2C\n        ['\u5b64\u6ce8\u4e00\u63b7'\x2C '\u91d1\u9f99\u4e5d\u5f0f\u7b2c\u516b\u5f0f']\x2C\n        6\x2C\n        '\u6240\u6709\u529b\u91cf\u5728\u4e00\u77ac\u538b\u5165\u67aa\u950b\u6216\u9f99\u722a\uff0c\u820d\u5f03\u9000\u8def\u6362\u53d6\u4e00\u6b21\u6781\u9650\u7a81\u6740\uff0c\u50cf\u628a\u6574\u6761\u91d1\u9f99\u8840\u8109\u90fd\u62bc\u5728\u8fd9\u4e00\u51fb\u4e0a\u3002'\x2C\n        '\u91d1\u9f99\u4e5d\u5f0f\u7b2c\u516b\u5f0f\uff0c\u662f\u5510\u821e\u9e9f\u81ea\u609f\u7684\u51b3\u6b7b\u578b\u7a81\u6740\u6218\u6280\uff0c\u4e0d\u5c5e\u4e8e\u88c5\u5907\u81ea\u5e26\u80fd\u529b\u3002\u5b9e\u9645\u6548\u679c\uff1a\u5355\u4f53260%\u8fd1\u8eab\u653b\u51fb\uff0c\u9632\u7a7f30\uff0c\u81ea\u8eab\u53d7\u5230\u4f24\u5bb3+12%\u6301\u7eed1\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b26000\uff0c\u4f53\u529b30000\uff0c\u7cbe\u795e\u529b9000\u3002'\x2C\n      )\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u767d\u4e91\u5343\u8f7d'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u767d\u4e91\u5343\u8f7d'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u767d\u4