tener('end'\x2C onlegacyfinish);\x0d\n    stream.removeListener('close'\x2C onlegacyfinish);\x0d\n    stream.removeListener('finish'\x2C onfinish);\x0d\n    stream.removeListener('end'\x2C onend);\x0d\n    stream.removeListener('error'\x2C onerror);\x0d\n    stream.removeListener('close'\x2C onclose);\x0d\n  };\x0d\n\x0d\n  if (options.signal && !closed) {\x0d\n    const abort = () => {\x0d\n      // Keep it because cleanup removes it.\x0d\n      const endCallback = callback;\x0d\n      cleanup();\x0d\n      endCallback.call(\x0d\n        stream\x2C\x0d\n        new AbortError(undefined\x2C { cause: options.signal.reason }));\x0d\n    };\x0d\n    if (options.signal.aborted) {\x0d\n      process.nextTick(abort);\x0d\n    } else {\x0d\n      addAbortListener ??= require('internal/events/abort_listener').addAbortListener;\x0d\n      const disposable = addAbortListener(options.signal\x2C abort);\x0d\n      const originalCallback = callback;\x0d\n      callback = once((...args) => {\x0d\n        disposable[SymbolDispose]();\x0d\n        originalCallback.apply(stream\x2C args);\x0d\n      });\x0d\n    }\x0d\n  }\x0d\n\x0d\n  return cleanup;\x0d\n}\x0d\n\x0d\nfunction eosWeb(stream\x2C options\x2C callback) {\x0d\n  let isAborted = false;\x0d\n  let abort = nop;\x0d\n  if (options.signal) {\x0d\n    abort = () => {\x0d\n      isAborted = true;\x0d\n      callback.call(stream\x2C new AbortError(undefined\x2C { cause: options.signal.reason }));\x0d\n    };\x0d\n    if (options.signal.aborted) {\x0d\n      process.nextTick(abort);\x0d\n    } else {\x0d\n      addAbortListener ??= require('internal/events/abort_listener').addAbortListener;\x0d\n      const disposable = addAbortListener(options.signal\x2C abort);\x0d\n      const originalCallback = callback;\x0d\n      callback = once((...args) => {\x0d\n        disposable[SymbolDispose]();\x0d\n        originalCallback.apply(stream\x2C args);\x0d\n      });\x0d\n    }\x0d\n  }\x0d\n  const resolverFn = (...args) => {\x0d\n    