6301\u7eed\u6062\u590d')\n    ? '\u8d44\u6e90\u53d8\u5316'\n    : \u673a\u5236 === '\u638c\u63a7\u4fee\u6b63' || \u5c5e\u6027 === '\u638c\u63a7'\n      ? '\u5224\u5b9a\u4fee\u6b63'\n      : ['\u6d88\u8017'\x2C '\u524d\u6447'].includes(\u5c5e\u6027)\n        ? '\u7ed3\u7b97\u4fee\u6b63'\n        : '\u5c5e\u6027\u4fee\u6b63';\n  const effect = {\n    \u539f\u578b\x2C\n    \u76ee\u6807: \u5f52\u4e00\u5316\u6267\u884c\u6548\u679c\u4f5c\u7528\u76ee\u6807_V1(target || '\u81ea\u8eab'\x2C '\u81ea\u8eab')\x2C\n    \u6570\u503c: \u89c4\u8303\u5316\u6267\u884c\u6548\u679c\u6570\u503c_V1(num\x2C \u52a8\u4f5c)\x2C\n  };\n  if (\u539f\u578b === '\u8d44\u6e90\u53d8\u5316') effect.\u8d44\u6e90 = \u8d44\u6e90;\n  else if (\u539f\u578b === '\u5224\u5b9a\u4fee\u6b63') effect.\u5224\u5b9a = \u52a8\u4f5c === '\u500d\u7387\u538b\u5236' ? '\u53cd\u5e94' : '\u547d\u4e2d';\n  else if (\u539f\u578b === '\u7ed3\u7b97\u4fee\u6b63') {\n    if (\u5c5e\u6027 === '\u6d88\u8017') effect.\u7ed3\u7b97 = '\u6d88\u8017';\n    else if (\u5c5e\u6027 === '\u524d\u6447') effect.\u7ed3\u7b97 = '\u524d\u6447';\n    else effect.\u7ed3\u7b97 = \u5c5e\u6027;\n    if (['\u6d88\u8017'\x2C '\u524d\u6447'].includes(effect.\u7ed3\u7b97) && ['\u500d\u7387\u63d0\u5347'\x2C '\u500d\u7387\u538b\u5236'\x2C ''].includes(\u52a8\u4f5c)) {\n      effect.\u6570\u503c = formatSkillSignedChangeValue(num\x2C true);\n    }\n  }\n  else effect.\u5c5e\u6027 = \u5c5e\u6027;\n  const \u6301\u7eed\u56de\u5408 = Math.max(0\x2C Number(duration || 0));\n  if (\u6301\u7eed\u56de\u5408 > 0) effect.\u6301\u7eed\u56de\u5408 = \u6301\u7eed\u56de\u5408;\n  return effect;\n}\n\nfunction buildPackedAttributeEffectsFromRatios(target\x2C statMods = {}\x2C duration = 0) {\n  const effects = [];\n  Object.entries(statMods || {}).forEach(([property\x2C ratio]) => {\n    const num = Number(ratio || 0);\n    if (!Number.isFinite(num) || Math.abs(num - 1) <= 0.001) return;\n    effects.push(\n      buildPackedAttributeEffect(\n        '\u5c5e\u6027\u53d8\u5316'\x2C\n        target\x2C\n        property\x2C\n        num >= 1 ? '\u500d\u7387\u63d0\u5347' : '\u500d\u7387\u538b\u5236'\x2C\n        num\x2C\n        duration\x2C\n      )\x2C\n    );\n  });\n  return effects.filter(Boolean);\n}\n\nfunction buildPackedRecoverAttributeEffect(target\x2C property\x2C ratio\x2C duration = 0\x2C overtime = false) {\n  const num = Number(ratio || 0);\n  if (!Number.isFinite(num) || num <= 0) return null;\n  if (!overtime) {\n    return buildPackedAttributeEffect('\u5c5e\u6027\u53d8\u5316'\x2C target\x2C property\x2C '\u52a0\u503c'\x2C num\x2C 0);\n  }\n  return {\n    \u539f\u578b: '\u72b6\u6001\u65bd\u52a0'\x2C\n    \u76ee\u6807: \u5f52\u4e00\u5316\u6267\u884c\u6548\u679c\u4f5c\u7528\u76ee\u6807_V1(target || '\u81ea\u8eab'\x2C '\u81ea\u8eab')\x2C\n    \u72b6\u6001: '\u6301\u7eed\u6062\u590d'\x2C\n    \u6570\u503c: formatSkillSignedChangeValue(Math.abs(num)\x2C true)\x2C\n    \u6301\u7eed\u56de\u5408: Math.max(1\x2C Math.round(Number(duration || 1)))\x2C\n    \u751f\u6548\u65b9\u5f0f: '\u72ec\u7acb\u751f\u6548'\x2C\n  };\n}\n\nfunction \u683c\u5f0f\u5316\u6280\u80fd\u7ed3\u6784\u8f6c\u8bd1\u5b57\u6bb5_V1(\u503c\x2C \u515c\u5e95 = '') {\n  if (\u503c === undefined || \u503c === null) return \u515c\u5e95;\n  if (Array.isArray(\u503c)) return \u503c.map(\u6761\u76ee => \u683c\u5f0f\u5316\u6280\u80fd\u7ed3\u6784\u8f6c\u8bd1\u5b57\u6bb5_V1(\u6761\u76ee\x2C \u515c\u5e95)).filter(Boolean).join('/');\n  if (typeof \u503c === 'object') return Object.entries(\u503c)\n    .map(([\u952e\x2C \u539f\u59cb\u503c]) => `${\u952e}:${\u683c\u5f0f\u5316\u6280\u80fd\u7ed3\u6784\u8f6c\u8bd1\u5b57\u6bb5_V1(\u539f\u59cb\u503c\x2C '')}`)\n    .filter(Boolean)\n    .join('\uff0c') || \u515c\u5e95;\n  const \u6587\u672c = String(\u503c).trim();\n  return \u6587\u672c || \u515c\u5e95;\n}\n\nfunction \u683c\u5f0f\u5316\u6280\u80fd\u7ed3\u6784\u6570\u503c_V1(\u503c\x2C \u515c\u5e95 = '') {\n  const \u6587\u672c = String(\u503c ?? '').trim();\n  if (!\u6587\