d056ce87f51c5b48b2fb987ace2b30c'\x2C\n  \u767d\u5bd2\u6a31: '2f14c772c2e48c40c4656236e278f7f5cc677aa05bf58094999c10dfddaaa406'\x2C\n});\n\nconst manualBattleCaseDefinitions = [\n  { caseId: 'duel_overmatch_lethal'\x2C group: 'duel'\x2C rounds: 20\x2C focus: ['level_gap'\x2C 'lethal_intent'] }\x2C\n  { caseId: 'duel_overmatch_nonlethal'\x2C group: 'duel'\x2C rounds: 20\x2C focus: ['level_gap'\x2C 'nonlethal_intent'] }\x2C\n  { caseId: 'duel_underdog_survival'\x2C group: 'duel'\x2C rounds: 20\x2C focus: ['underdog'\x2C 'survival'] }\x2C\n  { caseId: 'duel_peer_unknown_probe'\x2C group: 'duel'\x2C rounds: 20\x2C focus: ['peer'\x2C 'limited_information'] }\x2C\n  { caseId: 'duel_agile_single_target_failure'\x2C group: 'duel'\x2C rounds: 20\x2C focus: ['agile'\x2C 'adaptation'] }\x2C\n  { caseId: 'duel_agile_counter_options'\x2C group: 'duel'\x2C rounds: 20\x2C focus: ['agile'\x2C 'counterplay'] }\x2C\n  { caseId: 'duel_charge_interrupt_safer'\x2C group: 'duel'\x2C rounds: 20\x2C focus: ['charging'\x2C 'interrupt'] }\x2C\n  { caseId: 'duel_charge_defense_safer'\x2C group: 'duel'\x2C rounds: 20\x2C focus: ['charging'\x2C 'defense'] }\x2C\n  { caseId: 'team_focus_without_overkill'\x2C group: 'team'\x2C rounds: 10\x2C focus: ['focus'\x2C 'overkill'] }\x2C\n  { caseId: 'team_protect_critical_ally'\x2C group: 'team'\x2C rounds: 10\x2C focus: ['protect'\x2C 'ally_crisis'\x2C 'resource_threat'] }\x2C\n  { caseId: 'team_heal_crisis'\x2C group: 'team'\x2C rounds: 10\x2C focus: ['healing'\x2C 'ally_crisis'] }\x2C\n  { caseId: 'team_control_overlap'\x2C group: 'team'\x2C rounds: 10\x2C focus: ['control'\x2C 'marginal_value'] }\x2C\n  { caseId: 'team_resource_support'\x2C group: 'team'\x2C rounds: 10\x2C focus: ['resource'\x2C 'consumer'] }\x2C\n  { caseId: 'team_multi_target_response'\x2C group: 'team'\x2C rounds: 10\x2C focus: ['aoe'\x2C 'targeting'] }\x2C\n  { caseId: 'team_counter_coordination'\x2C group: 'team'\x2C rounds: 10\x2C focus: ['counter'\x2C 'coordination'] }\x2C\n  { caseId: 'team_unknown_enemy_adaptation'\x2C group: 'team'\x2C rounds: 10\x2C focus: ['limited_information'\x2C 'adaptation'] }\x2C\n  { caseId: 'raid_balanced'\x2C group: 'raid'\x2C rounds: 5\x2C focus: ['balanced'\x2C 'seven_vs_seven'] }\x2C\n  { caseId: 'raid_level_gap'\x2C group: 'raid'\x2C rounds: 5\x2C focus: ['level_gap'\x2C 'seven_vs_seven'] }\x2C\n  { caseId: 'raid_control_heavy'\x2C group: 'raid'\x2C rounds: 5\x2C focus: ['control'\x2C 'seven_vs_seven'] }\x2C\n  { caseId: 'raid_summon_heavy'\x2C group: 'raid'\x2C rounds: 5\x2C focus: ['summon'\x2C 'seven_vs_seven'] }\x2C\n  { caseId: 'summon_one_window'\x2C group: 'special'\x2C rounds: 6\x2C focus: ['summon'\x2C 'lifecycle'] }\x2C\n  { caseId: 'item_creation_consumption'\x2C group: 'special'\x2C rounds: 8\x2C focus: ['creation'\x2C 'inventory'\x2C 'consumer'] }\x2C\n  { caseId: 'equipment_switch_no_loop'\x2C group: 'special'\x2C rounds: 8\x2C focus: ['equipment'\x2C 'loop_prevention'] }\x2C\n  { caseId: 'intent_capture_vs_kill'\x2C group: 'special'\x2C rounds: 8\x2C focus: ['battle_intent'\x2C 'terminal'] }\x2C\n];\n\nconst requiredEventKinds = Object.freeze({\n  team_control_overlap: ['state_apply']\x2C\n  team_counter_coordination: ['counter_window']\x2C\n  raid_control_heavy: ['state_apply']\x2C\n  raid_summon_heavy: ['summon_create']\x2C\n  summon_one_window: ['summon_create']\x2C\n  item_creation_consumption: ['create'\x2C 'item_consume'\x2C 'resource_change']\x2C\n  equipment_switch_no_loop: ['complete']\x2C\n});\nconst strategyRelationsByCase = Object.freeze({\n  duel_peer_unknown_probe: ['BELIEF_FAILURE_ADAPTATION']\x2C\n  duel_charge_interrupt_safer: ['FAILURE_ADAPTATION_CHANGES_ACTION']\x2C\n  team_protect_critical_ally: ['ALLY_CRISIS_RESPONSE']\x2C\n  team_resource_support: ['RESOURCE_SUPPORT_CONTINUITY']\x2C\n  team_counter_coordination: ['COUNTER_TEAM_CHAIN']\x2C\n  team_unknown_enemy_adaptation: ['VISIBLE_THREAT_RESPONSE']\x2C\n  raid_balanced: ['REPORT_TARGET_GROUPS'\x2C 'REPORT_REASON_TACTICAL']\x2C\n  raid_control_heavy: ['REPORT_TARGET_GROUPS'\x2C 'REPORT_REASON_TACTICAL']\x2C\n  raid_summon_heavy: ['SUMMON_REAL_ACTION'\x2C 'REPORT_TARGET_GROUPS'\x2C 'REPORT_REASON_TACTICAL']\x2C\n  team_multi_target_response: ['REPORT_TARGET_GROUPS'\x2C 'REPORT_REASON_TACTICAL']\x2C\n});\nconst candidateRelations = Object.freeze(['SELECTED_IS_LEGAL'\x2C 'SCORE_AUDIT_SELECTED_AND_TWO_ALTERNATIVES']);\nconst forbiddenSelections = Object.freeze(['HARD_INVALID'\x2C 'DOMINATED'\x2C 'ZERO_EFFECT_COSTLY'\x2C 'SELF_DEFEATING'\x2C 'SUMMON_NO_ACTION_WINDOW'\x2C 'ZERO_PROGRESS'\x2C 'OBJECTIVE_STALL'\x2C 'CRISIS_RESPONSE_NOT_REALIZED'\x2C 'UNCOMPENSATED_RISK']);\nconst mutationRelations = Object.freeze(['INPUT_IMMUTABLE']);\n\nexport const manualBattleCases = Object.freeze(manualBattleCaseDefinitions.map(item => Object.freeze({\n  ...item\x2C\n  candidateRelations\x2C\n  forbiddenSelections\x2C\n  requiredFacts: Object.freeze([\n    Object.freeze({ kind: 'event'\x2C eventKind: 'action_start' })\x2C\n    Object.freeze({ kind: 'block'\x2C blockType: 'ROUND_SUMMARY' })\x2C\n    ...(requiredEventKinds[item.caseId] || []).map(eventKind => Object.freeze({ kind: 'event'\x2C eventKind }))\x2C\n  ])\x2C\n  mutationRelations\x2C\n  strategyRelations: Object.freeze(strategyRelationsByCase[item.caseId] || [])\x2C\n})));\n\nexport const determinismCaseIds = Object.freeze([\n  'duel_overmatch_lethal'\x2C\n  'team_control_overlap'\x2C\n  'raid_balanced'\x2C\n  'summon_one_window'\x2C\n  'item_creation_consumption'\x2C\n]);\n
