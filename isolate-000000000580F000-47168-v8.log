(max - min));\n  const grade = { F\u7ea7_\u6b8b\u7f3a: 'F'\x2C D\u7ea7_\u7c97\u7cd9: 'D'\x2C C\u7ea7_\u52a3\u8d28: 'C'\x2C B\u7ea7_\u666e\u901a: 'B'\x2C A\u7ea7_\u4f18\u79c0: 'A'\x2C S\u7ea7_\u6781\u54c1: 'S'\x2C 'S+\u7ea7_\u795e\u54c1': 'S+' }[quality] || 'B';\n  const gradeFactor = { F: 0.6\x2C D: 0.8\x2C C: 1\x2C B: 2\x2C A: 3\x2C S: 4\x2C 'S+': 5 }[grade] || 2;\n  const secondaryEffectScale = getSecondaryRingScale(ringIndex);\n  const secondaryDurationScale = Math.max(0.7\x2C secondaryEffectScale);\n  const randomInRange = table => {\n    const [min\x2C max] = pickSkillGradeTableRangeV1(table\x2C grade);\n    if (min === max) return min;\n    return Number((min + Math.random() * (max - min)).toFixed(2));\n  };\n  const pickStatKey = (directions = []) => {\n    const ordered = Array.isArray(directions) ? directions : [];\n    if (ordered.includes('\u529b\u91cf')) return 'str';\n    if (ordered.includes('\u9632\u5fa1')) return 'def';\n    if (ordered.includes('\u654f\u6377')) return 'agi';\n    if (ordered.includes('\u7cbe\u795e\u529b')) return 'men_max';\n    if (ordered.includes('\u9b42\u529b')) return 'sp_max';\n    return 'str';\n  };\n  const pickStatKeys = (directions = []\x2C count = 2) => {\n    const map = { \u529b\u91cf: 'str'\x2C \u9632\u5fa1: 'def'\x2C \u654f\u6377: 'agi'\x2C \u7cbe\u795e\u529b: 'men_max'\x2C \u9b42\u529b: 'sp_max' };\n    const keys = directions.map(d => map[d]).filter(Boolean);\n    return Array.from(new Set(keys)).slice(0\x2C count);\n  };\n\n  const \u4f24\u5bb3\u610f\u56fe = { \u5a01\u529b\u500d\u7387: 0\x2C \u4f24\u5bb3\u7c7b\u578b: '\u65e0'\x2C \u9632\u5fa1\u7a7f\u900f: 0\x2C \u62a4\u76fe\u6570\u503c: 0\x2C \u6062\u590d\u6bd4\u4f8b: 0 };\n  const \u6548\u679c\u610f\u56fe = {\n    \u72b6\u6001: '\u65e0'\x2C\n    \u6301\u7eed\u56de\u5408: 0\x2C\n    \u5c5e\u6027\u500d\u7387: { str: 1.0\x2C def: 1.0\x2C agi: 1.0\x2C men_max: 1.0\x2C sp_max: 1.0 }\x2C\n    \u6301\u7eed\u4f24\u5bb3\u6570\u503c: 0\x2C\n    \u7ed3\u7b97\u53c2\u6570: {\