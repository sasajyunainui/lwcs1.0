script-source,155,BattleRuntime_Module.js,/* BattleRuntime_Module.js - Battle runtime boundary and shared contracts. */\n\n(() => {\n  'use strict';\n\n  const root = typeof globalThis !== 'undefined' ? globalThis : window;\n  const previewRuntime = root.__LWCS_BATTLE_PREVIEW__;\n  const decisionRuntime = root.__LWCS_BATTLE_DECISION__;\n  if (!previewRuntime || previewRuntime.version !== '7.3-R6.3-preview-2') {\n    throw new Error(`battle_runtime_preview_version_mismatch:${previewRuntime?.version || 'missing'}`);\n  }\n  if (!decisionRuntime || decisionRuntime.version !== '7.3-R6.3-decision-2') {\n    throw new Error(`battle_runtime_decision_version_mismatch:${decisionRuntime?.version || 'missing'}`);\n  }\n  const sharedRegistry = root.__LWCS_SKILL_MECHANISM_REGISTRY__;\n  const prototypeRegistry = sharedRegistry?.\u539f\u578b\u5b9a\u4e49;\n  if (!prototypeRegistry || typeof prototypeRegistry !== 'object') {\n    throw new Error('battle_runtime_shared_prototype_registry_missing');\n  }\n  const SOUL_TOWER_MAX_AGE = 30;\n  const SOUL_TOWER_TEAM_LIMIT = 7;\n  const SOUL_TOWER_MAX_AGE_GAP = 3;\n\n  const actionKinds = Object.freeze([\n    'BASIC_ATTACK'\x2C 'DEFEND'\x2C 'EVADE'\x2C 'COUNTER'\x2C 'OBSERVE'\x2C\n    'GUARD'\x2C 'WITHDRAW'\x2C 'RELEASE_SKILL'\x2C 'USE_ITEM'\x2C 'EQUIP'\x2C\n  ]);\n  const actionRoles = Object.freeze(['ACTIVE'\x2C 'REACTION'\x2C 'COUNTER'\x2C 'ASSIST'\x2C 'STATE_TICK']);\n  const opportunityGrantTypes = Object.freeze([\n    'NATURAL_ACTION'\x2C 'COUNTER_WINDOW'\x2C 'DODGE_WINDOW'\x2C 'DEFEND_WINDOW'\x2C\n    'GUARD_INTERCEPT'\x2C 'FOLLOW_UP'\x2C 'EXTRA_ACTION'\x2C 'ASSIST_WINDOW'\x2C 'SELF_TRIGGER'\x2C\n  ]);\n  const resourceTimelineOperations = Object.freeze([\n    'PAY'\x2C 'RESTORE'\x2C 'REDUCE'\x2C 'LOCK'\x2C 'UNLOCK'\x2C 'REFUND'\x2C\n    'NATURAL_RECOVERY'\x2C 'SUSTAIN_COST'\x2C 'ITEM_CONSUME'\x2C\n  ]);\n  const resourcePhasePriority = Object.freeze({\n    RESTORE: 10\x2C\n    NATURAL_RECOVERY: 10\x2C\n    REFUND: 15\x2C\n    UNLOCK: 20\x2C\n    REDUCE: 30\x2C\n    LOCK: 35\x2C\n    PAY: 40\x2C\n    SUSTAIN_COST: 45\x2C\n    ITEM_CONSUME: 50\x2C\n  });\n  const sideEffectTriggerSet = new Set(['\u6548\u679c\u751f\u6548\u540e'\x2C '\u547d\u4e2d\u540e'\x2C '\u56de\u5408\u7ed3\u675f\u65f6'\x2C '\u6548\u679c\u7ed3\u675f\u540e']);\n  const sideEffectTargetSet = new Set(['\u6280\u80fd\u91ca\u653e\u8005'\x2C '\u6548\u679c\u627f\u53d7\u8005'\x2C '\u53cc\u65b9']);\n  const sideEffectStatusMap = Object.freeze({\n    \u5168\u5c5e\u6027\u964d\u4f4e: '\u865a\u5f31'\x2C \u81ea\u635f\u53cd\u566c: '\u53cd\u566c'\x2C \u7cbe\u795e\u7d0a\u4e71: '\u7cbe\u795e\u7d0a\u4e71'\x2C \u9b42\u529b\u53cd\u566c: '\u9b42\u529b\u67af\u7aed'\x2C\n    \u547d\u4e2d\u4e0b\u964d: '\u7cbe\u795e\u7d0a\u4e71'\x2C \u52a8\u4f5c\u8fdf\u7f13: '\u8fdf\u7f13'\x2C \u76ee\u6807\u9519\u4e71: '\u6df7\u4e71'\x2C \u65bd\u6cd5\u50f5\u76f4: '\u50f5\u76f4'\x2C\n  });\n  const sideEffectTypeSet = new Set([\n    '\u5168\u5c5e\u6027\u964d\u4f4e'\x2C '\u81ea\u635f\u53cd\u566c'\x2C '\u81f4\u6b7b\u732e\u796d'\x2C '\u7cbe\u795e\u7d0a\u4e71'\x2C '\u9b42\u529b\u53cd\u566c'\x2C\n    '\u547d\u4e2d\u4e0b\u964d'\x2C '\u52a8\u4f5c\u8fdf\u7f13'\x2C '\u76ee\u6807\u9519\u4e71'\x2C '\u65bd\u6cd5\u50f5\u76f4'\x2C\n  ]);\n  const reportBlockTypes = Object.freeze([\n    'ACTION_DECLARED'\x2C 'ACTION_RESOLVED'\x2C 'REACTION_RESOLVED'\x2C 'STATE_TICK'\x2C\n    'SUMMON_ACTION'\x2C 'RESOURCE_CHANGE'\x2C 'ROUND_SUMMARY'\x2C 'FINAL_SUMMARY'\x2C\n  ]);\n  const prototypeRuntimeContract = Object.freeze({\n    \u4f24\u5bb3\u7ed3\u7b97: Object.freeze({ component: 'effectiveDeltaEV'\x2C settlementConsumers: Object.freeze(['direct_damage'\x2C 'multi_damage'\x2C 'delay_burst'])\x2C factTypes: Object.freeze(['DAMAGE'])\x2C reportBlockTypes: Object.freeze(['ACTION_RESOLVED']) })\x2C\n    \u8d44\u6e90\u53d8\u5316: Object.freeze({ component: 'sustainEV'\x2C settlementConsumers: Object.freeze(['recover_sp'\x2C 'recover_men'\x2C 'recover_vit'\x2C 'delay_burst'])\x2C factTypes: Object.f