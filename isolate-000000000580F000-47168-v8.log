script-source,148,file:///D:/silltyavern/tavern_helper_template-main/tavern_helper_template-main/lwcs/tools/battle_r63_manual_cases.mjs,import crypto from 'node:crypto';\nimport { manualBattleCases\x2C manualSourceDataHashes } from './battle_r63_manual_manifest.mjs';\n\nconst clone = value => structuredClone(value);\nconst hash = value => crypto.createHash('sha256').update(JSON.stringify(value)).digest('hex');\n\nfunction sourceSnapshot(library\x2C name) {\n  const snapshots = library?.\u89d2\u8272?.[name]?.\u5feb\u7167;\n  const snapshot = Array.isArray(snapshots) ? snapshots.at(-1)?.\u89d2\u8272 : null;\n  if (!snapshot) throw new Error(`r63_manual_character_missing:${name}`);\n  return clone(snapshot);\n}\n\nfunction readSystem(snapshot = {}) {\n  return String(snapshot?.\u7b2c1\u6b66\u9b42?.\u7cfb\u522b || snapshot?.\u7b2c1\u6b66\u9b42?.\u7c7b\u578b || snapshot?.\u5c5e\u6027?.\u7cfb\u522b || '\u5f3a\u653b\u7cfb').trim() || '\u5f3a\u653b\u7cfb';\n}\n\nfunction removeLockedSoulRings(value\x2C maximumRingCount) {\n  if (!value || typeof value !== 'object') return;\n  Object.keys(value).forEach(key => {\n    const match = /^\u7b2c(\\d+)\u9b42\u73af$/.exec(String(key));\n    if (match && Number(match[1]) > maximumRingCount) {\n      delete value[key];\n      return;\n    }\n    removeLockedSoulRings(value[key]\x2C maximumRingCount);\n  });\n}\n\nfunction participant(library\x2C getBaseStats\x2C name\x2C options = {}) {\n  const snapshot = sourceSnapshot(library\x2C name);\n  const sourceHash = hash(snapshot);\n  const expectedSourceHash = manualSourceDataHashes[name];\n  if (!expectedSourceHash || sourceHash !== expectedSourceHash) {\n    throw new Error(`r63_manual_character_hash_changed:${name}:expected=${expectedSourceHash || 'missing'}:actual=${sourceHash}`);\n  }\n  const level = Math.max(1\x2C Number(options.level || snapshot?.\u5c5e\u6027?.\u7b49\u7ea7 || 1));\n  removeLockedSoulRings(snapshot\x2C Math.min(9\x2C Math.floor(level / 10)));\n  const system = readSystem(snapshot);\n  if (typeof getBaseStats !== 'function') throw new Error('r63_manual_base_stats_missing');\n  const stats = getBaseStats(level);\n  const hpMax = Math.max(1\x2C Math.floor(Number(stats?.vit_max || 1)));\n  const soulMax = Math.max(1\x2C Math.floor(Number(stats?.sp_max || 1)));\n  const spiritMax = Math.max(1\x2C Math.floor(Number(stats?.men_max || 1)));\n  const staminaMax = hpMax;\n  const strength = Math.max(1\x2C Math.floor(Number(stats?.str || 1) * Number(options.strengthRatio ?? 1)));\n  const defense = Math.max(1\x2C Math.floor(Number(stats?.def || 1) * Number(options.defenseRatio ?? 1)));\n  const agility = Math.max(1\x2C Math.floor(Number(stats?.agi || 1) * Number(options.agilityRatio ?? 1)));\n  const hp = Math.max(1\x2C Math.round(hpMax * Number(options.hpRatio ?? 1)));\n  const stamina = Math.max(1\x2C Math.round(staminaMax * Number(options.staminaRatio ?? 1)));\n  const soul = Math.max(0\x2C Math.round(soulMax * Number(options.soulRatio ?? 1)));\n  const spirit = Math.max(0\x2C Math.round(spiritMax * Number(options.spiritRatio ?? 1)));\n  snapshot.id = name;\n  snapshot.name = name;\n  snapshot.\u540d\u79f0 = name;\n  snapshot.type = system;\n  snapshot.\u7cfb\u522b = system;\n  delete snapshot.final;\n  Object.assign(snapshot\x2C {\n    hp\x2C\n    HP: hp\x2C\n    hp_max: hpMax\x2C\n    sp: soul\x2C\n    men: spirit\x2C\n    vit: stamina\x2C\n    sta: stamina\x2C\n    sp_max: soulMax\x2C\n    men_max: spiritMax\x2C\n    vit_max: hpMax\x2C\n    str: strength\x2C\n    def: defense\x2C\n    agi: agility\x2C\n  });\n  snapshot.\u5c5e\u6027 = {\n    ...(snapshot.\u5c5e\u6027 || {})\x2C\n    \u7b49\u7ea7: level\x2C\n    \u7cfb\u522b: system\x2C\n    HP: hp\x2C\n    HP\u4e0a\u9650: hpMax\x2C\n    \u4f53\u529b: stamina\x2C\n    \u4f53\u529b\u4e0a\u9650: staminaMax\x2C\n    \u9b42\u529b: soul\x2C\n    \u9b42\u529b\u4e0a\u9650: soulMax\x2C\n    \u7cbe\u795e\u529b: spirit\x2C\n    \u7cbe\u795e\u529b\u4e0a\u9650: spiritMax\x2C\n    \u529b\u91cf: strength\x2C\n    \u9632\u5fa1: defense\x2C\n    \u654f\u6377: agility\x2C\n    \u72b6\u6001\u6548\u679c: {}\x2C\n  };\n  snapshot.\u72b6\u6001 = { ...(snapshot.\u72b6\u6001 || {})\x2C \u5b58\u6d3b: true\x2C \u4f4d\u7f6e: 'R6.3\u672c\u5730\u5ba1\u9605\u573a'\x2C \u884c\u52a8: '\u6218\u6597' };\n  snapshot.\u72b6\u6001\u6548\u679c = {};\n  snapshot.\u6301\u7eed\u6548\u679c = {};\n  snapshot.\u80cc\u5305 = snapshot.\u80cc\u5305 && typeof snapshot.\u80cc\u5305 === 'object' ? snapshot.\u80cc\u5305 : {};\n  if (options.charging) snapshot.\u84c4\u529b\u6280\u80fd = clone(options.charging);\n  return { unit: snapshot\x2C sourceHash };\n}\n\nfunction battle(caseId\x2C rounds\x2C intent\x2C players\x2C enemies\x2C initialBelief = {}) {\n  const contract = manualBattleCases.find(item => item.caseId === caseId);\n  if (!contract) throw new Error(`r63_manual_case_contract_missing:${caseId}`);\n  return {\n    caseId\x2C\n    seed: 630000 + [...caseId].reduce((sum\x2C char) => sum + char.charCodeAt(0)\x2C 0)\x2C\n    rounds\x2C\n    intent\x2C\n    initialBelief\x2C\n    sourceCharacterIds: [...players\x2C ...enemies].map(entry => entry.unit.name)\x2C\n    sourceDataHashes: Object.fromEntries([...players\x2C ...enemies].map(entry => [entry.unit.name\x2C entry.sourceHash]))\x2C\n    focus: [...contract.focus]\x2C\n    candidateRelations: [...contract.candidateRelations]\x2C\n    forbiddenSelections: [...contract.forbiddenSelections]\x2C\n    requiredFacts: contract.requiredFacts.map(item => ({ ...item }))\x2C\n    mutationRelations: [...contract.mutationRelations]\x2C\n    combatData: {\n      \u56de\u5408: 0\x2C\n      \u6218\u6597\u7c7b\u578b: '\u666e\u901a\u6218\u6597'\x2C\n      \u6218\u6597\u610f\u56fe: intent\x2C\n      \u65f6\u95f4\u6bb5: '\u767d\u5929'\x2C\n      \u8fdb\u884c\u4e2d: true\x2C\n      \u53c2\u6218\u8005: { team_player: players.map(entry => entry.unit)\x2C team_enemy: enemies.map(entry => entry.unit) }\x2C\n    }\x2C\n  };\n}\n\nfunction objectiveContract(maxRounds\x2C victoryConditions\x2C defeatConditions = [{ type: 'TEAM_INCAPACITATED'\x2C side: 'PLAYER'\x2C scope: 'ALL' }]) {\n  return {\n    version: 1\x2C\n    explicit: true\x2C\n    startRound: 0\x2C\n    maxRounds\x2C\n    resolutionPriority: 'DEFEAT_FIRST'\x2C\n    victory: { logic: 'ANY'\x2C conditions: victoryConditions }\x2C\n    defeat: { logic: 'ANY'\x2C conditions: defeatConditions }\x2C\n  };\n}\n\nexport function buildManualCases(library\x2C getBaseStats) {\n  const make = (name\x2C options) => participant(library\x2C getBaseStats\x2C name\x2C options);\n  const charge = {\n    id: 'visible-charge'\x2C type: 'skill'\x2C action_type: '\u91ca\u653e\u9b42\u6280'\x2C cast_time: 30\x2C\n    skill: {\n      id: 'visible-charge-skill'\x2C name: '\u5df2\u663e\u9732\u84c4\u529b\u91cd\u51fb'\x2C \u9b42\u6280\u540d: '\u5df2\u663e\u9732\u84c4\u529b\u91cd\u51fb'\x2C \u524d\u6447: 30\x2C \u6d88\u8017: { \u9b42\u529b: 100 }\x2C\n      _\u6548\u679c\u6570\u7ec4: [{ \u539f\u578b: '\u4f24\u5bb3\u7ed3\u7b97'\x2C \u76ee\u6807: '\u5355\u4f53'\x2C \u5a01\u529b\u500d\u7387: 500\x2C \u4f24\u5bb3\u7c7b\u578b: '\u8fd1\u8eab\u653b\u51fb'\x2C \u751f\u6548\u65b9\u5f0f: '\u72ec\u7acb\u751f\u6548' }]\x2C\n    }\x2C\n  };\n  const longCharge = {\n    ...clone(charge)\x2C\n    cast_time: 80\x2C\n    skill: { ...clone(charge.skill)\x2C \u524d\u6447: 80 }\x2C\n  };\n  const equipmentTester = make('\u8c22\u9082'\x2C { level: 50 });\n  equipmentTester.unit.\u80cc\u5305.\u75be\u98ce\u8bd5\u4f5c\u5315\u9996 = {\n    id: 'r63-review-agility-dagger'\x2C\n    name: '\u75be\u98ce\u8bd5\u4f5c\u5315\u9996'\x2C\n    \u540d\u79f0: '\u75be\u98ce\u8bd5\u4f5c\u5315\u9996'\x2C\n    \u7c7b\u578b: '\u88c5\u5907'\x2C\n    \u6570\u91cf: 1\x2C\n    \u88c5\u5907\u5c5e\u6027: { \u654f\u6377: '+20%' }\x2C\n  };\n  const cases = [\n    battle('duel_overmatch_lethal'\x2C 4\x2C '\u6b7b\u6597'\x2C [make('\u4e91\u51a5')]\x2C [make('\u97e6\u5c0f\u67ab')])\x2C\n    battle('duel_overmatch_nonlethal'\x2C 4\x2C '\u70b9\u5230\u4e3a\u6b62'\x2C [make('\u821e\u957f\u7a7a')]\x2C [make('\u97e6\u5c0f\u67ab')])\x2C\n    battle('duel_underdog_survival'\x2C 5\x2C '\u6c42\u751f'\x2C [make('\u97e6\u5c0f\u67ab')]\x2C [make('\u821e\u957f\u7a7a'\x2C { charging: longCharge })])\x2C\n    battle('duel_peer_unknown_probe'\x2C 5\x2C '\u70b9\u5230\u4e3a\u6b62'\x2C [make('\u8c22\u9082'\x2C { level: 50 })]\x2C [make('\u97e6\u5c0f\u67ab'\x2C { level: 50 })]\x2C { confidence: 0.2 })\x2C\n    battle('duel_agile_single_target_failure'\x2C 5\x2C '\u6c42\u751f'\x2C [make('\u8c22\u9082'\x2C { level: 45\x2C hpRatio: 0.05 })]\x2C [make('\u738b\u91d1\u73ba'\x2C { level: 50 })])\x2C\n    battle('duel_agile_counter_options'\x2C 5\x2C '\u5207\u78cb'\x2C [make('\u8c22\u9082'\x2C { level: 50 })]\x2C [make('\u738b\u91d1\u73ba'\x2C { level: 50 })])\x2C\n    battle('duel_charge_interrupt_safer'\x2C 6\x2C '\u5207\u78cb'\x2C [make('\u821e\u957f\u7a7a'\x2C { level: 60 })]\x2C [make('\u53e4\u6708'\x2C { level: 60\x2C charging: charge })])\x2C\n    battle('duel_charge_defense_safer'\x2C 4\x2C '\u5207\u78cb'\x2C [make('\u97e6\u5c0f\u67ab'\x2C { hpRatio: 0.25\x2C soulRatio: 0 })]\x2C [make('\u821e\u957f\u7a7a'\x2C { charging: longCharge })])\x2C\n    battle('team_focus_without_overkill'\x2C 4\x2C '\u51fb\u8d25'\x2C [make('\u5510\u821e\u9e9f')\x2C make('\u53e4\u6708')\x2C make('\u8c22\u9082')]\x2C [make('\u5f20\u626c\u5b50'\x2C { hpRatio: 0.25 })\x2C make('\u738b\u91d1\u73ba')\x2C make('\u97e6\u5c0f\u67ab')])\x2C\n    battle('team_protect_critical_ally'\x2C 4\x2C '\u5b88\u62a4'\x2C [make('\u821e\u957f\u7a7a'\x2C { level: 70\x2C hpRatio: 0.15 })\x2C make('\u96c5\u8389'\x2C { level: 98 })\x2C make('\u5510\u821e\u9e9f'\x2C { level: 70 })]\x2C [make('\u9f99\u8dc3'\x2C { level: 70\x2C strengthRatio: 0.2 })\x2C make('\u6234\u6708\u708e'\x2C { level: 70\x2C strengthRatio: 0.2 })\x2C make('\u82cf\u6c90'\x2C { level: 70\x2C strengthRatio: 0.2 })])\x2C\n    battle('team_heal_crisis'\x2C 4\x2C '\u5b88\u62a4'\x2C [make('\u96c5\u8389'\x2C { level: 98\x2C hpRatio: 0.8 })\x2C make('\u821e\u957f\u7a7a'\x2C { level: 90\x2C hpRatio: 0.25 })\x2C make('\u53e4\u6708'\x2C { level: 90\x2C hpRatio: 0.3 })]\x2C [make('\u9f99\u8dc3'\x2C { level: 90 })\x2C make('\u6234\u6708\u708e'\x2C { level: 90 })\x2C make('\u82cf\u6c90'\x2C { level: 90 })])\x2C\n    battle('team_control_overlap'\x2C 4\x2C '\u51fb\u8d25'\x2C [make('\u53e4\u6708'\x2C { level: 60 })\x2C make('\u8bb8\u5c0f\u8a00'\x2C { level: 60 })\x2C make('\u821e\u957f\u7a7a'\x2C { level: 60 })]\x2C [make('\u9f99\u8dc3'\x2C { level: 55\x2C charging: charge })\x2C make('\u6234\u6708\u708e'\x2C { level: 55 })\x2C make('\u82cf\u6c90'\x2C { level: 55 })])\x2C\n    battle('team_resource_support'\x2C 6\x2C '\u51fb\u8d25'\x2C [make('\u767d\u5bd2\u6a31'\x2C { level: 50 })\x2C make('\u5510\u821e\u9e9f'\x2C { level: 50\x2C soulRatio: 0.08 })\x2C make('\u53e4\u6708'\x2C { level: 50\x2C soulRatio: 0.12 })]\x2C [make('\u9f99\u8dc3'\x2C { level: 50 })\x2C make('\u6234\u6708\u708e'\x2C { level: 50 })\x2C make('\u82cf\u6c90'\x2C { level: 50 })])\x2C\n    battle('team_multi_target_response'\x2C 6\x2C '\u51fb\u8d25'\x2C [make('\u5510\u821e\u9e9f'\x2C { level: 60 })\x2C make('\u8c22\u9082'\x2C { level: 60 })\x2C make('\u53e4\u6708'\x2C { level: 60 })]\x2C [make('\u5f20\u626c\u5b50'\x2C { level: 52\x2C hpRatio: 0.55 })\x2C make('\u738b\u91d1\u73ba'\x2C { level: 52\x2C hpRatio: 0.55 })\x2C make('\u97e6\u5c0f\u67ab'\x2C { level: 52\x2C hpRatio: 0.55 })])\x2C\n    battle('team_counter_coordination'\x2C 6\x2C '\u5207\u78cb'\x2C [make('\u8c22\u9082'\x2C { level: 55 })\x2C make('\u5510\u821e\u9e9f'\x2C { level: 55 })\x2C make('\u53e4\u6708'\x2C { level: 55 })]\x2C [make('\u738b\u91d1\u73ba'\x2C { level: 55 })\x2C make('\u5f20\u626c\u5b50'\x2C { level: 55 })\x2C make('\u8bb8\u5c0f\u8a00'\x2C { level: 55 })])\x2C\n    battle('team_unknown_enemy_adaptation'\x2C 6\x2C '\u5207\u78cb'\x2C [make('\u5510\u821e\u9e9f'\x2C { level: 55 })\x2C make('\u53e4\u6708'\x2C { level: 55 })\x2C make('\u8bb8\u5c0f\u8a00'\x2C { level: 55 })]\x2C [make('\u9f99\u8dc3'\x2C { level: 58\x2C charging: longCharge })\x2C make('\u6234\u6708\u708e'\x2C { level: 55 })\x2C make('\u82cf\u6c90'\x2C { level: 55 })]\x2C { confidence: 0.12 })\x2C\n    battle('raid_balanced'\x2C 5\x2C '\u51fb\u8d25'\x2C [make('\u5510\u821e\u9e9f'\x2C { level: 55 })\x2C make('\u53e4\u6708'\x2C { level: 55 })\x2C make('\u8c22\u9082'\x2C { level: 55 })\x2C make('\u8bb8\u5c0f\u8a00'\x2C { level: 55 })\x2C make('\u53f6\u661f\u6f9c'\x2C { level: 55 })\x2C make('\u5f90\u7b20\u667a'\x2C { level: 55 })\x2C make('\u539f\u6069\u591c\u8f89'\x2C { level: 55 })]\x2C [make('\u9f99\u8dc3'\x2C { level: 50 })\x2C make('\u6234\u6708\u708e'\x2C { level: 50 })\x2C make('\u82cf\u6c90'\x2C { level: 50 })\x2C make('\u738b\u91d1\u73ba'\x2C { level: 50 })\x2C make('\u5f20\u626c\u5b50'\x2C { level: 50 })\x2C make('\u97e6\u5c0f\u67ab'\x2C { level: 50 })\x2C make('\u4e50\u6b63\u5b87'\x2C { level: 50 })])\x2C\n    battle('raid_level_gap'\x2C 5\x2C '\u51fb\u8d25'\x2C [make('\u5510\u821e\u9e9f'\x2C { level: 90 })\x2C make('\u53e4\u6708'\x2C { level: 90 })\x2C make('\u8c22\u9082'\x2C { level: 90 })\x2C make('\u8bb8\u5c0f\u8a00'\x2C { level: 90 })\x2C make('\u53f6\u661f\u6f9c'\x2C { level: 90 })\x2C make('\u5f90\u7b20\u667a'\x2C { level: 90 })\x2C make('\u539f\u6069\u591c\u8f89'\x2C { level: 90 })]\x2C [make('\u9f99\u8dc3'\x2C { level: 50 })\x2C make('\u6234\u6708\u708e'\x2C { level: 50 })\x2C make('\u82cf\u6c90'\x2C { level: 50 })\x2C make('\u738b\u91d1\u73ba'\x2C { level: 50 })\x2C make('\u5f20\u626c\u5b50'\x2C { level: 50 })\x2C make('\u97e6\u5c0f\u67ab'\x2C { level: 50 })\x2C make('\u4e50\u6b63\u5b87'\x2C { level: 50 })])\x2C\n    battle('raid_control_heavy'\x2C 5\x2C '\u51fb\u8d25'\x2C [make('\u8bb8\u5c0f\u8a00'\x2C { level: 75 })\x2C make('\u821e\u957f\u7a7a'\x2C { level: 75 })\x2C make('\u53e4\u6708'\x2C { level: 75 })\x2C make('\u5510\u821e\u9e9f'\x2C { level: 75 })\x2C make('\u8c22\u9082'\x2C { level: 75 })\x2C make('\u53f6\u661f\u