* @property {object} [fs] - custom fs implementation\x2C must provide write\x2C writeSync\x2C fsync\x2C\x0d\n   *   fsyncSync\x2C close\x2C open\x2C mkdir\x2C mkdirSync methods. Mostly useful for testing.\x0d\n   * @param {Utf8StreamOptions} [options]\x0d\n   */\x0d\n  constructor(options = kNullPrototype) {\x0d\n    validateObject(options\x2C 'options');\x0d\n    let {\x0d\n      fd\x2C\x0d\n    } = options;\x0d\n    const {\x0d\n      dest\x2C\x0d\n      minLength\x2C\x0d\n      maxLength\x2C\x0d\n      maxWrite\x2C\x0d\n      periodicFlush\x2C\x0d\n      sync\x2C\x0d\n      append = true\x2C\x0d\n      mkdir\x2C\x0d\n      retryEAGAIN\x2C\x0d\n      fsync\x2C\x0d\n      contentMode = kContentModeUtf8\x2C\x0d\n      mode\x2C\x0d\n      // Provides for a custom fs implementation. Mostly useful for testing.\x0d\n      fs: overrideFs = {}\x2C\x0d\n    } = options;\x0d\n\x0d\n    super();\x0d\n\x0d\n    fd ??= dest;\x0d\n\x0d\n    validateObject(overrideFs\x2C 'options.fs');\x0d\n    this.#fs = { ...fs\x2C ...overrideFs };\x0d\n    validateFunction(this.#fs.write\x2C 'options.fs.write');\x0d\n    validateFunction(this.#fs.writeSync\x2C 'options.fs.writeSync');\x0d\n    validateFunction(this.#fs.fsync\x2C 'options.fs.fsync');\x0d\n    validateFunction(this.#fs.fsyncSync\x2C 'options.fs.fsyncSync');\x0d\n    validateFunction(this.#fs.close\x2C 'options.fs.close');\x0d\n    validateFunction(this.#fs.open\x2C 'options.fs.open');\x0d\n    validateFunction(this.#fs.mkdir\x2C 'options.fs.mkdir');\x0d\n    validateFunction(this.#fs.mkdirSync\x2C 'options.fs.mkdirSync');\x0d\n\x0d\n    this.#hwm = MathMax(minLength || 0\x2C this.#hwm);\x0d\n    this.#minLength = minLength || 0;\x0d\n    this.#maxLength = maxLength || 0;\x0d\n    this.#maxWrite = maxWrite || kMaxWrite;\x0d\n    this.#periodicFlush = periodicFlush || 0;\x0d\n    this.#sync = sync || false;\x0d\n    this.#fsync = fsync || false;\x0d\n    this.#append = append || false;\x0d\n    this.#mode = mode;\x0d\n    this.#r