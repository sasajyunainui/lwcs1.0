let n = 0; n < input.length; ++n) {\x0d\n    const n_reversed = input.length - n - 1;\x0d\n    result |= BigInt(input[n]) << 8n * BigInt(n_reversed);\x0d\n  }\x0d\n\x0d\n  return result;\x0d\n}\x0d\n\x0d\nfunction getStringOption(options\x2C key) {\x0d\n  let value;\x0d\n  if (options && (value = options[key]) != null)\x0d\n    validateString(value\x2C `options.${key}`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the requested usages that are present in `usageSet`.\x0d\n * @param {SafeSet<string>} usageSet\x0d\n * @param {...string} usages\x0d\n * @returns {SafeSet<string>}\x0d\n */\x0d\nfunction getUsagesUnion(usageSet\x2C ...usages) {\x0d\n  const newset = new SafeSet();\x0d\n  for (let n = 0; n < usages.length; n++) {\x0d\n    if (usageSet.has(usages[n]))\x0d\n      newset.add(usages[n]);\x0d\n  }\x0d\n  return newset;\x0d\n}\x0d\n\x0d\n// Must be at most 31 entries.\x0d\nconst kCanonicalUsageOrder = [\x0d\n  'encrypt'\x2C 'decrypt'\x2C\x0d\n  'sign'\x2C 'verify'\x2C\x0d\n  'deriveKey'\x2C 'deriveBits'\x2C\x0d\n  'wrapKey'\x2C 'unwrapKey'\x2C\x0d\n  'encapsulateKey'\x2C 'encapsulateBits'\x2C\x0d\n  'decapsulateKey'\x2C 'decapsulateBits'\x2C\x0d\n];\x0d\n\x0d\nconst kUsageMasks = {\x0d\n  __proto__: null\x2C\x0d\n};\x0d\nconst kUsageByMask = {\x0d\n  __proto__: null\x2C\x0d\n};\x0d\n// Derive both lookup tables from kCanonicalUsageOrder so adding a new\x0d\n// usage only requires updating the canonical list above. The numeric\x0d\n// mask uses the usage's canonical index as its bit position.\x0d\nfor (let n = 0; n < kCanonicalUsageOrder.length; n++) {\x0d\n  const usage = kCanonicalUsageOrder[n];\x0d\n  const mask = 1 << n;\x0d\n  kUsageMasks[usage] = mask;\x0d\n  kUsageByMask[mask] = usage;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns a bit mask representing the usages from `usageSet`.\x0d\n * @param {SafeSet<string>} usageSet\x0d\n * @returns {number}\x0d\n */\x0d\nfunction getUsagesMask(usageSet) {\x0d\n  // No usages is a valid state for some public keys\x2C represented by a\x0d\n  // zero mask.\x0d\n  if (usageSet.size === 0) return 0;\x0d\n  let mask = 0;\x0d\n  for (const usage of usageSet) {\x0d\n    mask |= kUsageMasks[usage];\x0d\n  }\x0d\n  return mask;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns whether `mask` contains `usage`.\x0d\n * @param {number} mask\x0d\n * @param {string} usage\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction hasUsage(mask\x2C usage) {\x0d\n  return (mask & kUsageMasks[usage]) !== 0;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the usages represented by `mask` in canonical order.\x0d\n * @param {number} mask\x0d\n * @returns {string[]}\x0d\n */\x0d\nfunction getUsagesFromMask(mask) {\x0d\n  // Short circuit most common cases\x2C empty and single usage\x0d\n  // No usages is a valid state for some public keys\x0d\n  if (mask === 0) return [];\x0d\n  // A mask with exactly one bit set maps directly to one usage\x0d\n  if ((mask & (mask - 1)) === 0) {\x0d\n    return [kUsageByMask[mask]];\x0d\n  }\x0d\n  // Multiple usages need to be expanded in canonical order.\x0d\n  const result = [];\x0d\n  for (let n = 0; n < kCanonicalUsageOrder.length; n++) {\x0d\n    if (mask & (1 << n))\x0d\n      ArrayPrototypePush(result\x2C kCanonicalUsageOrder[n]);\x0d\n  }\x0d\n  return result;\x0d\n}\x0d\n\x0d\nfunction getBlockSize(name) {\x0d\n  switch (name) {\x0d\n    case 'SHA-1':\x0d\n      // Fall through\x0d\n    case 'SHA-256':\x0d\n      return 512;\x0d\n    case 'SHA-384':\x0d\n      // Fall through\x0d\n    case 'SHA-512':\x0d\n      return 1024;\x0d\n    case 'SHA3-256':\x0d\n      // Fall through\x0d\n    case 'SHA3-384':\x0d\n      // Fall through\x0d\n    case 'SHA3-512':\x0d\n      // This interaction is not defined for now.\x0d\n      // https://github.com/WICG/webcrypto-modern-algos/issues/23\x0d\n      throw lazyDOMException('Explicit algorithm length member is required'\x2C 'NotSupportedError');\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction getDigestSizeInBytes(name) {\x0d\n  switch (name) {\x0d\n    case 'SHA-1':\x0d\n      return 20;\x0d\n    case 'SHA-256': // Fall through\x0d\n    case 'SHA3-256':\x0d\n      return 32;\x0d\n    case 'SHA-384': // Fall through\x0d\n    case 'SHA3-384':\x0d\n      return 48;\x0d\n    case 'SHA-512': // Fall through\x0d\n    case 'SHA3-512':\x0d\n      return 64;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction validateKeyOps(keyOps\x2C usagesSet) {\x0d\n  if (keyOps === undefined) return;\x0d\n  validateArray(keyOps\x2C 'keyData.key_ops');\x0d\n  let keyOpsMask = 0;\x0d\n  for (let n = 0; n < keyOps.length; n++) {\x0d\n    const op = keyOps[n];\x0d\n    const opMask = kUsageMasks[op];\x0d\n    // Skipping unknown key ops\x0d\n    if (opMask === undefined)\x0d\n      continue;\x0d\n    // Have we seen it already? if so\x2C error\x0d\n    if (keyOpsMask & opMask)\x0d\n      throw lazyDOMException('Duplicate key operation'\x2C 'DataError');\x0d\n    keyOpsMask |= opMask;\x0d\n\x0d\n    // TODO(@jasnell): RFC7517 section 4.3 strong recommends validating\x0d\n    // key usage combinations. Specifically\x2C it says that unrelated key\x0d\n    // ops SHOULD NOT be used together. We're not yet validating that here.\x0d\n  }\x0d\n\x0d\n  if (usagesSet !== undefined) {\x0d\n    const usagesMask = getUsagesMask(usagesSet);\x0d\n    if ((keyOpsMask & usagesMask) !== usagesMask) {\x0d\n      throw lazyDOMException(\x0d\n        'Key operations and usage mismatch'\x2C\x0d\n        'DataError');\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction secureHeapUsed() {\x0d\n  const val = _secureHeapUsed();\x0d\n  if (val === undefined)\x0d\n    return { total: 0\x2C used: 0\x2C utilization: 0\x2C min: 0 };\x0d\n  const used = Number(_secureHeapUsed());\x0d\n  const total = Number(getOptionValue('--secure-heap'));\x0d\n  const min = Number(getOptionValue('--secure-heap-min'));\x0d\n  const utilization = used / total;\x0d\n  return { total\x2C used\x2C utilization\x2C min };\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  getArrayBufferOrView\x2C\x0d\n  getCiphers\x2C\x0d\n  getCurves\x2C\x0d\n  getDataViewOrTypedArrayBuffer\x2C\x0d\n  getHashes\x2C\x0d\n  kHandle\x2C\x0d\n  setEngine\x2C\x0d\n  toBuf\x2C\x0d\n\x0d\n  kNamedCurveAliases\x2C\x0d\n  normalizeAlgorithm\x2C\x0d\n  normalizeHashName\x2C\x0d\n  hasAnyNotIn\x2C\x0d\n  validateByteSource\x2C\x0d\n  validateKeyOps\x2C\x0d\n  jobPromise\x2C\x0d\n  jobPromiseThen\x2C\x0d\n  cleanupWebCryptoResult\x2C\x0d\n  prepareWebCryptoResult\x2C\x0d\n  validateMaxBufferLength\x2C\x0d\n  bigIntArrayToUnsignedBigInt\x2C\x0d\n  bigIntArrayToUnsignedInt\x2C\x0d\n  getBlockSize\x2C\x0d\n  getDigestSizeInBytes\x2C\x0d\n  getStringOption\x2C\x0d\n  getUsagesUnion\x2C\x0d\n  getUsagesMask\x2C\x0d\n  getUsagesFromMask\x2C\x0d\n  hasUsage\x2C\x0d\n  secureHeapUsed\x2C\x0d\n  getCachedHashId\x2C\x0d\n  getHashCache\x2C\x0d\n  getOpenSSLSecLevel\x2C\x0d\n};\x0d\n
