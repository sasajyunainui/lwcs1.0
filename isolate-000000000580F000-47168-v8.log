script-source,127,node:internal/crypto/webcrypto,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayIsArray\x2C\x0d\n  ArrayPrototypeSlice\x2C\x0d\n  FunctionPrototypeCall\x2C\x0d\n  JSONParse\x2C\x0d\n  JSONStringify\x2C\x0d\n  ObjectDefineProperties\x2C\x0d\n  ObjectKeys\x2C\x0d\n  ObjectPrototypeHasOwnProperty\x2C\x0d\n  ObjectSetPrototypeOf\x2C\x0d\n  PromiseReject\x2C\x0d\n  PromiseResolve\x2C\x0d\n  ReflectApply\x2C\x0d\n  ReflectConstruct\x2C\x0d\n  SafeArrayIterator\x2C\x0d\n  StringPrototypeRepeat\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n  StringPrototypeStartsWith\x2C\x0d\n  SymbolIterator\x2C\x0d\n  SymbolToStringTag\x2C\x0d\n  TypedArrayPrototypeGetBuffer\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  kWebCryptoKeyFormatRaw\x2C\x0d\n  kWebCryptoKeyFormatPKCS8\x2C\x0d\n  kWebCryptoKeyFormatSPKI\x2C\x0d\n  kWebCryptoCipherEncrypt\x2C\x0d\n  kWebCryptoCipherDecrypt\x2C\x0d\n} = internalBinding('crypto');\x0d\n\x0d\nconst {\x0d\n  decodeUTF8\x2C\x0d\n  encodeUtf8String\x2C\x0d\n} = internalBinding('encoding_binding');\x0d\n\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_ILLEGAL_CONSTRUCTOR\x2C\x0d\n    ERR_INVALID_THIS\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\nconst {\x0d\n  createPublicKey\x2C\x0d\n  CryptoKey\x2C\x0d\n  getCryptoKeyAlgorithm\x2C\x0d\n  getCryptoKeyExtractable\x2C\x0d\n  getCryptoKeyHandle\x2C\x0d\n  getCryptoKeyType\x2C\x0d\n  getCryptoKeyUsages\x2C\x0d\n  getCryptoKeyUsagesMask\x2C\x0d\n  hasCryptoKeyUsage\x2C\x0d\n  importGenericSecretKey\x2C\x0d\n  PrivateKeyObject\x2C\x0d\n} = require('internal/crypto/keys');\x0d\n\x0d\nconst {\x0d\n  asyncDigest\x2C\x0d\n} = require('internal/crypto/hash');\x0d\n\x0d\nconst {\x0d\n  cleanupWebCryptoResult\x2C\x0d\n  getBlockSize\x2C\x0d\n  jobPromiseThen\x2C\x0d\n  normalizeAlgorithm\x2C\x0d\n  normalizeHashName\x2C\x0d\n  prepareWebCryptoResult\x2C\x0d\n  validateMaxBufferLength\x2C\x0d\n} = require('internal/crypto/util');\x0d\n\x0d\nconst {\x0d\n  emitExperimentalWarning\x2C\x0d\n  kEnumerableProperty\x2C\x0d\n  lazyDOMException\x2C\x0d\n  setOwnProperty\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nconst {\x0d\n  getRandomValues: _getRandomValues\x2C\x0d\n  randomUUID: _randomUUID\x2C\x0d\n} = require('internal/crypto/random');\x0d\n\x0d\nconst {\x0d\n  isPromise\x2C\x0d\n} = require('internal/util/types');\x0d\n\x0d\nlet webidl;\x0d\n\x0d\n// WebCrypto methods return promises\x2C including for synchronous validation\x0d\n// failures. Keep that conversion in one place so method bodies stay readable.\x0d\nfunction callSubtleCryptoMethod(fn\x2C receiver\x2C args) {\x0d\n  try {\x0d\n    const result = ReflectApply(fn\x2C receiver\x2C args);\x0d\n    if (isPromise(result))\x0d\n      return result;\x0d\n    // PromiseResolve() performs thenable assimilation for object results.\x0d\n    // Shadow inherited then accessors while it resolves synchronous results.\x0d\n    const shouldCleanupResult = prepareWebCryptoResult(result);\x0d\n    try {\x0d\n      return PromiseResolve(result);\x0d\n    } finally {\x0d\n      if (shouldCleanupResult)\x0d\n        cleanupWebCryptoResult(result);\x0d\n    }\x0d\n  } catch (err) {\x0d\n    return PromiseReject(err);\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction digest(algorithm\x2C data) {\x0d\n  return callSubtleCryptoMethod(digestImpl\x2C this\x2C arguments);\x0d\n}\x0d\n\x0d\nfunction digestImpl(algorithm\x2C data) {\x0d\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\x0d\n\x0d\n  webidl ??= require('internal/crypto/webidl');\x0d\n  const prefix = "Failed to execute 'digest' on 'SubtleCrypto'";\x0d\n  webidl.requiredArguments(arguments.length\x2C 2\x2C { prefix });\x0d\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\x0d\n    prefix\x2C\x0d\n    context: '1st argument'\x2C\x0d\n  });\x0d\n  data = webidl.converters.BufferSource(data\x2C {\x0d\n    prefix\x2C\x0d\n    context: '2nd argument'\x2C\x0d\n  });\x0d\n\x0d\n  algorithm = normalizeAlgorithm(algorithm\x2C 'digest');\x0d\n\x0d\n  return FunctionPrototypeCall(asyncDigest\x2C this\x2C algorithm\x2C data);\x0d\n}\x0d\n\x0d\nfunction randomUUID() {\x0d\n  if (this !== crypto) throw new ERR_INVALID_THIS('Crypto');\x0d\n  return _randomUUID();\x0d\n}\x0d\n\x0d\nfunction generateKey(\x0d\n  algorithm\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages) {\x0d\n  return callSubtleCryptoMethod(generateKeyImpl\x2C this\x2C arguments);\x0d\n}\x0d\n\x0d\nfunction generateKeyImpl(\x0d\n  algorithm\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages) {\x0d\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\x0d\n\x0d\n  webidl ??= require('internal/crypto/webidl');\x0d\n  const prefix = "Failed to execute 'generateKey' on 'SubtleCrypto'";\x0d\n  webidl.requiredArguments(arguments.length\x2C 3\x2C { prefix });\x0d\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\x0d\n    prefix\x2C\x0d\n    context: '1st argument'\x2C\x0d\n  });\x0d\n  extractable = webidl.converters.boolean(extractable\x2C {\x0d\n    prefix\x2C\x0d\n    context: '2nd argument'\x2C\x0d\n  });\x0d\n  keyUsages = webidl.converters['sequence<KeyUsage>'](keyUsages\x2C {\x0d\n    prefix\x2C\x0d\n    context: '3rd argument'\x2C\x0d\n  });\x0d\n\x0d\n  algorithm = normalizeAlgorithm(algorithm\x2C 'generateKey');\x0d\n  switch (algorithm.name) {\x0d\n    case 'RSASSA-PKCS1-v1_5':\x0d\n      // Fall through\x0d\n    case 'RSA-PSS':\x0d\n      // Fall through\x0d\n    case 'RSA-OAEP':\x0d\n      return require('internal/crypto/rsa')\x0d\n        .rsaKeyGenerate(algorithm\x2C extractable\x2C keyUsages);\x0d\n    case 'Ed25519':\x0d\n      // Fall through\x0d\n    case 'Ed448':\x0d\n      // Fall through\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      return require('internal/crypto/cfrg')\x0d\n        .cfrgGenerateKey(algorithm\x2C extractable\x2C keyUsages);\x0d\n    case 'ECDSA':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      return require('internal/crypto/ec')\x0d\n        .ecGenerateKey(algorithm\x2C extractable\x2C keyUsages);\x0d\n    case 'HMAC':\x0d\n      return require('internal/crypto/mac')\x0d\n        .hmacGenerateKey(algorithm\x2C extractable\x2C keyUsages);\x0d\n    case 'AES-CTR':\x0d\n      // Fall through\x0d\n    case 'AES-CBC':\x0d\n      // Fall through\x0d\n    case 'AES-GCM':\x0d\n      // Fall through\x0d\n    case 'AES-OCB':\x0d\n      // Fall through\x0d\n    case 'AES-KW':\x0d\n      return require('internal/crypto/aes')\x0d\n        .aesGenerateKey(algorithm\x2C extractable\x2C keyUsages);\x0d\n    case 'ChaCha20-Poly1305':\x0d\n      return require('internal/crypto/chacha20_poly1305')\x0d\n        .c20pGenerateKey(algorithm\x2C extractable\x2C keyUsages);\x0d\n    case 'ML-DSA-44':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-65':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-87':\x0d\n      return require('internal/crypto/ml_dsa')\x0d\n        .mlDsaGenerateKey(algorithm\x2C extractable\x2C keyUsages);\x0d\n    case 'ML-KEM-512':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-768':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-1024':\x0d\n      return require('internal/crypto/ml_kem')\x0d\n        .mlKemGenerateKey(algorithm\x2C extractable\x2C keyUsages);\x0d\n    case 'KMAC128':\x0d\n      // Fall through\x0d\n    case 'KMAC256':\x0d\n      return require('internal/crypto/mac')\x0d\n        .kmacGenerateKey(algorithm\x2C extractable\x2C keyUsages);\x0d\n    default:\x0d\n      throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction deriveBits(algorithm\x2C baseKey\x2C length = null) {\x0d\n  return callSubtleCryptoMethod(deriveBitsImpl\x2C this\x2C arguments);\x0d\n}\x0d\n\x0d\nfunction deriveBitsImpl(algorithm\x2C baseKey\x2C length = null) {\x0d\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\x0d\n\x0d\n  webidl ??= require('internal/crypto/webidl');\x0d\n  const prefix = "Failed to execute 'deriveBits' on 'SubtleCrypto'";\x0d\n  webidl.requiredArguments(arguments.length\x2C 2\x2C { prefix });\x0d\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\x0d\n    prefix\x2C\x0d\n    context: '1st argument'\x2C\x0d\n  });\x0d\n  baseKey = webidl.converters.CryptoKey(baseKey\x2C {\x0d\n    prefix\x2C\x0d\n    context: '2nd argument'\x2C\x0d\n  });\x0d\n  if (length !== null) {\x0d\n    length = webidl.converters['unsigned long'](length\x2C {\x0d\n      prefix\x2C\x0d\n      context: '3rd argument'\x2C\x0d\n    });\x0d\n  }\x0d\n\x0d\n  algorithm = normalizeAlgorithm(algorithm\x2C 'deriveBits');\x0d\n  if (!hasCryptoKeyUsage(baseKey\x2C 'deriveBits')) {\x0d\n    throw lazyDOMException(\x0d\n      'baseKey does not have deriveBits usage'\x2C\x0d\n      'InvalidAccessError');\x0d\n  }\x0d\n  if (getCryptoKeyAlgorithm(baseKey).name !== algorithm.name)\x0d\n    throw lazyDOMException('Key algorithm mismatch'\x2C 'InvalidAccessError');\x0d\n  switch (algorithm.name) {\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      return require('internal/crypto/diffiehellman')\x0d\n        .ecdhDeriveBits(algorithm\x2C baseKey\x2C length);\x0d\n    case 'HKDF':\x0d\n      return require('internal/crypto/hkdf')\x0d\n        .hkdfDeriveBits(algorithm\x2C baseKey\x2C length);\x0d\n    case 'PBKDF2':\x0d\n      return require('internal/crypto/pbkdf2')\x0d\n        .pbkdf2DeriveBits(algorithm\x2C baseKey\x2C length);\x0d\n    case 'Argon2d':\x0d\n      // Fall through\x0d\n    case 'Argon2i':\x0d\n      // Fall through\x0d\n    case 'Argon2id':\x0d\n      return require('internal/crypto/argon2')\x0d\n        .argon2DeriveBits(algorithm\x2C baseKey\x2C length);\x0d\n  }\x0d\n  throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\x0d\n}\x0d\n\x0d\nfunction getKeyLength({ name\x2C length\x2C hash }) {\x0d\n  switch (name) {\x0d\n    case 'AES-CTR':\x0d\n    case 'AES-CBC':\x0d\n    case 'AES-GCM':\x0d\n    case 'AES-OCB':\x0d\n    case 'AES-KW':\x0d\n      if (length !== 128 && length !== 192 && length !== 256)\x0d\n        throw lazyDOMException('Invalid key length'\x2C 'OperationError');\x0d\n\x0d\n      return length;\x0d\n    case 'HMAC':\x0d\n      if (length === undefined) {\x0d\n        return getBlockSize(hash?.name);\x0d\n      }\x0d\n\x0d\n      if (typeof length === 'number' && length !== 0) {\x0d\n        return length;\x0d\n      }\x0d\n\x0d\n      throw lazyDOMException('Invalid key length'\x2C 'OperationError');\x0d\n    case 'KMAC128':\x0d\n    case 'KMAC256':\x0d\n      if (typeof length === 'number') {\x0d\n        return length;\x0d\n      }\x0d\n\x0d\n      return name === 'KMAC128' ? 128 : 256;\x0d\n    case 'HKDF':\x0d\n    case 'PBKDF2':\x0d\n    case 'Argon2d':\x0d\n    case 'Argon2i':\x0d\n    case 'Argon2id':\x0d\n      return null;\x0d\n    case 'ChaCha20-Poly1305':\x0d\n      return 256;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction deriveKey(\x0d\n  algorithm\x2C\x0d\n  baseKey\x2C\x0d\n  derivedKeyAlgorithm\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages) {\x0d\n  return callSubtleCryptoMethod(deriveKeyImpl\x2C this\x2C arguments);\x0d\n}\x0d\n\x0d\nfunction deriveKeyImpl(\x0d\n  algorithm\x2C\x0d\n  baseKey\x2C\x0d\n  derivedKeyAlgorithm\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages) {\x0d\n  if (this !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\x0d\n\x0d\n  webidl ??= require('internal/crypto/webidl');\x0d\n  const prefix = "Failed to execute 'deriveKey' on 'SubtleCrypto'";\x0d\n  webidl.requiredArguments(arguments.length\x2C 5\x2C { prefix });\x0d\n  algorithm = webidl.converters.AlgorithmIdentifier(algorithm\x2C {\x0d\n    prefix\x2C\x0d\n    context: '1st argument'\x2C\x0d\n  });\x0d\n  baseKey = webidl.converters.CryptoKey(baseKey\x2C {\x0d\n    prefix\x2C\x0d\n    context: '2nd argument'\x2C\x0d\n  });\x0d\n  derivedKeyAlgorithm = webidl.converters.AlgorithmIdentifier(derivedKeyAlgorithm\x2C {\x0d\n    prefix\x2C\x0d\n    context: '3rd argument'\x2C\x0d\n  });\x0d\n  extractable = webidl.converters.boolean(extractable\x2C {\x0d\n    prefix\x2C\x0d\n    context: '4th argument'\x2C\x0d\n  });\x0d\n  keyUsages = webidl.converters['sequence<KeyUsage>'](keyUsages\x2C {\x0d\n    prefix\x2C\x0d\n    context: '5th argument'\x2C\x0d\n  });\x0d\n\x0d\n  algorithm = normalizeAlgorithm(algorithm\x2C 'deriveBits');\x0d\n  derivedKeyAlgorithm = normalizeAlgorithm(derivedKeyAlgorithm\x2C 'importKey');\x0d\n  if (!hasCryptoKeyUsage(baseKey\x2C 'deriveKey')) {\x0d\n    throw lazyDOMException(\x0d\n      'baseKey does not have deriveKey usage'\x2C\x0d\n      'InvalidAccessError');\x0d\n  }\x0d\n  if (getCryptoKeyAlgorithm(baseKey).name !== algorithm.name)\x0d\n    throw lazyDOMException('Key algorithm mismatch'\x2C 'InvalidAccessError');\x0d\n\x0d\n  const length = getKeyLength(normalizeAlgorithm(arguments[2]\x2C 'get key length'));\x0d\n  let bits;\x0d\n  switch (algorithm.name) {\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      bits = require('internal/crypto/diffiehellman')\x0d\n        .ecdhDeriveBits(algorithm\x2C baseKey\x2C length);\x0d\n      break;\x0d\n    case 'HKDF':\x0d\n      bits = require('internal/crypto/hkdf')\x0d\n        .hkdfDeriveBits(algorithm\x2C baseKey\x2C length);\x0d\n      break;\x0d\n    case 'PBKDF2':\x0d\n      bits = require('internal/crypto/pbkdf2')\x0d\n        .pbkdf2DeriveBits(algorithm\x2C baseKey\x2C length);\x0d\n      break;\x0d\n    case 'Argon2d':\x0d\n      // Fall through\x0d\n    case 'Argon2i':\x0d\n      // Fall through\x0d\n    case 'Argon2id':\x0d\n      bits = require('internal/crypto/argon2')\x0d\n        .argon2DeriveBits(algorithm\x2C baseKey\x2C length);\x0d\n      break;\x0d\n    default:\x0d\n      throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\x0d\n  }\x0d\n\x0d\n  return jobPromiseThen(bits\x2C (bits) => FunctionPrototypeCall(\x0d\n    importKeySync\x2C\x0d\n    this\x2C\x0d\n    'raw-secret'\x2C bits\x2C derivedKeyAlgorithm\x2C extractable\x2C keyUsages\x2C\x0d\n  ));\x0d\n}\x0d\n\x0d\nfunction exportKeySpki(key) {\x0d\n  switch (getCryptoKeyAlgorithm(key).name) {\x0d\n    case 'RSASSA-PKCS1-v1_5':\x0d\n      // Fall through\x0d\n    case 'RSA-PSS':\x0d\n      // Fall through\x0d\n    case 'RSA-OAEP':\x0d\n      return require('internal/crypto/rsa')\x0d\n        .rsaExportKey(key\x2C kWebCryptoKeyFormatSPKI);\x0d\n    case 'ECDSA':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      return require('internal/crypto/ec')\x0d\n        .ecExportKey(key\x2C kWebCryptoKeyFormatSPKI);\x0d\n    case 'Ed25519':\x0d\n      // Fall through\x0d\n    case 'Ed448':\x0d\n      // Fall through\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      return require('internal/crypto/cfrg')\x0d\n        .cfrgExportKey(key\x2C kWebCryptoKeyFormatSPKI);\x0d\n    case 'ML-DSA-44':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-65':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-87':\x0d\n      return require('internal/crypto/ml_dsa')\x0d\n        .mlDsaExportKey(key\x2C kWebCryptoKeyFormatSPKI);\x0d\n    case 'ML-KEM-512':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-768':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-1024':\x0d\n      return require('internal/crypto/ml_kem')\x0d\n        .mlKemExportKey(key\x2C kWebCryptoKeyFormatSPKI);\x0d\n    default:\x0d\n      return undefined;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction exportKeyPkcs8(key) {\x0d\n  switch (getCryptoKeyAlgorithm(key).name) {\x0d\n    case 'RSASSA-PKCS1-v1_5':\x0d\n      // Fall through\x0d\n    case 'RSA-PSS':\x0d\n      // Fall through\x0d\n    case 'RSA-OAEP':\x0d\n      return require('internal/crypto/rsa')\x0d\n        .rsaExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\x0d\n    case 'ECDSA':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      return require('internal/crypto/ec')\x0d\n        .ecExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\x0d\n    case 'Ed25519':\x0d\n      // Fall through\x0d\n    case 'Ed448':\x0d\n      // Fall through\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      return require('internal/crypto/cfrg')\x0d\n        .cfrgExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\x0d\n    case 'ML-DSA-44':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-65':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-87':\x0d\n      return require('internal/crypto/ml_dsa')\x0d\n        .mlDsaExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\x0d\n    case 'ML-KEM-512':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-768':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-1024':\x0d\n      return require('internal/crypto/ml_kem')\x0d\n        .mlKemExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\x0d\n    default:\x0d\n      return undefined;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction exportKeyRawPublic(key\x2C format) {\x0d\n  switch (getCryptoKeyAlgorithm(key).name) {\x0d\n    case 'ECDSA':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      return require('internal/crypto/ec')\x0d\n        .ecExportKey(key\x2C kWebCryptoKeyFormatRaw);\x0d\n    case 'Ed25519':\x0d\n      // Fall through\x0d\n    case 'Ed448':\x0d\n      // Fall through\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      return require('internal/crypto/cfrg')\x0d\n        .cfrgExportKey(key\x2C kWebCryptoKeyFormatRaw);\x0d\n    case 'ML-DSA-44':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-65':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-87': {\x0d\n      // ML-DSA keys don't recognize "raw"\x0d\n      if (format !== 'raw-public') {\x0d\n        return undefined;\x0d\n      }\x0d\n      return require('internal/crypto/ml_dsa')\x0d\n        .mlDsaExportKey(key\x2C kWebCryptoKeyFormatRaw);\x0d\n    }\x0d\n    case 'ML-KEM-512':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-768':\x0d\n      // Fall through\x0