script-source,138,node:internal/streams/fast-utf8-stream,'use strict';\x0d\n\x0d\n// This file is derived from the original SonicBoom module\x0d\n// MIT License\x0d\n// Copyright (c) 2017 Matteo Collina\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypePush\x2C\x0d\n  MathMax\x2C\x0d\n  SymbolDispose\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  sleep\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nconst {\x0d\n  Buffer\x2C\x0d\n} = require('buffer');\x0d\n\x0d\nconst fs = require('fs');\x0d\nconst EventEmitter = require('events');\x0d\nconst path = require('path');\x0d\nconst {\x0d\n  clearInterval\x2C\x0d\n  setInterval\x2C\x0d\n  setTimeout\x2C\x0d\n} = require('timers');\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_INVALID_STATE\x2C\x0d\n    ERR_OPERATION_FAILED\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\nconst {\x0d\n  validateBoolean\x2C\x0d\n  validateFunction\x2C\x0d\n  validateObject\x2C\x0d\n  validateOneOf\x2C\x0d\n  validateString\x2C\x0d\n  validateUint32\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst BUSY_WRITE_TIMEOUT = 100;\x0d\nconst kEmptyBuffer = Buffer.allocUnsafe(0);\x0d\n\x0d\n// 16 KB. Don't write more than docker buffer size.\x0d\n// https://github.com/moby/moby/blob/513ec73831269947d38a644c278ce3cac36783b2/daemon/logger/copier.go#L13\x0d\nconst kMaxWrite = 16 * 1024;\x0d\nconst kContentModeBuffer = 'buffer';\x0d\nconst kContentModeUtf8 = 'utf8';\x0d\nconst kNullPrototype = { __proto__: null };\x0d\n\x0d\n// Utf8Stream is a port of the original SonicBoom module\x0d\n// (https://github.com/pinojs/sonic-boom) that provides a fast and efficient\x0d\n// way to write UTF-8 encoded data to a file or stream.\x0d\nclass Utf8Stream extends EventEmitter {\x0d\n  #len = 0;\x0d\n  #fd = -1;\x0d\n  #bufs = [];\x0d\n  #lens = [];\x0d\n  #writing = false;\x0d\n  #ending = false;\x0d\n  #reopening = false;\x0d\n  #asyncDrainScheduled = false;\x0d\n  #flushPend