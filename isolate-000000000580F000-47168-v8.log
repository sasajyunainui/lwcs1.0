\u6301\u7eed2\u56de\u5408(\u5f3a\u5ea6-18%)\uff0c\u7fa4\u4f53\u9020\u6210\u4f24\u5bb3-16%(\u9650\u5b9a\u5143\u7d20\u7c7b)\u6301\u7eed2\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b1500\uff0c\u7cbe\u795e\u529b420\u3002'\x2C\n      )\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u84dd\u94f6\u9738\u738b\u53d8'\x2C\n        '\u9b42\u73af\u9b42\u6280'\x2C\n        '\u7b2c1\u6b66\u9b42.\u7b2c4\u9b42\u73af.\u7b2c4\u9b42\u6280'\x2C\n        'ch0584_02'\x2C\n        443425\x2C\n        ['\u84dd\u94f6\u9738\u738b\u53d8'\x2C '\u7b2c\u56db\u9b42\u6280'\x2C '\u7b2c4\u9b42\u6280'\x2C '\u9738\u738b\u9f99']\x2C\n        4\x2C\n        '\u7b2c\u56db\u9b42\u73af\u4eae\u8d77\u540e\uff0c\u5927\u7247\u84dd\u94f6\u7687\u4f1a\u5728\u6697\u91d1\u9f99\u9cde\u7eb9\u8def\u4e2d\u75af\u72c2\u66b4\u957f\uff0c\u7c97\u58ee\u5f97\u5982\u540c\u4e00\u6761\u6761\u86df\u9f99\uff0c\u62bd\u51fb\u3001\u7f20\u7ed5\u548c\u627f\u538b\u80fd\u529b\u90fd\u4f1a\u66b4\u6da8\u3002'\x2C\n        '\u4e07\u5e74\u5c42\u6b21\u7684\u5168\u9762\u589e\u5e45\u9b42\u6280\uff0c\u53ef\u540c\u65f6\u5f3a\u5316\u524d\u9762\u4e09\u5927\u84dd\u94f6\u7687\u9b42\u6280\uff0c\u8ba9\u63a7\u5236\u3001\u7a7f\u523a\u3001\u9632\u5fa1\u4e0e\u6301\u7eed\u4f5c\u6218\u80fd\u529b\u6574\u4f53\u8dc3\u5347\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u9632\u5fa1+14%\u6301\u7eed3\u56de\u5408\uff0c\u81ea\u8eab\u9020\u6210\u4f24\u5bb3+22%(\u9650\u5b9a\u6728)\u6301\u7eed3\u56de\u5408\uff0c\u81ea\u8eab\u53d7\u5230\u4f24\u5bb3-28%(\u9650\u5b9a\u6728)\u6301\u7eed3\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b2800\uff0c\u4f53\u529b900\u3002'\x2C\n      )\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u81ea\u7136\u4e4b\u5b50'\x2C\n        '\u9b42\u73af\u9b42\u6280'\x2C\n        '\u7b2c1\u6b66\u9b42.\u7b2c5\u9b42\u73af.\u7b2c5\u9b42\u6280'\x2C\n        'ch0845_01'\x2C\n        599962\x2C\n        ['\u81ea\u7136\u4e4b\u5b50'\x2C '\u7b2c\u4e94\u9b42\u73af'\x2C '\u7b2c5\u9b42\u73af']\x2C\n        5\x2C\n        '\u7eff\u91d1\u8272\u7b2c\u4e94\u9b42\u73af\u4eae\u8d77\u65f6\uff0c\u5468\u56f4\u751f\u547d\u80fd\u91cf\u4f1a\u4e3b\u52a8\u5411\u4ed6\u6c47\u805a\uff0c\u690d\u7269\u4e0e\u81ea\u7136\u6c14\u606f\u4eff\u4f5b\u628a\u4ed6\u5f53\u4f5c\u6838\u5fc3\u56de\u5e94\u3002'\x2C\n        '\u88ab\u5927\u81ea\u7136\u627f\u8ba4\u540e\u7684\u751f\u547d\u7cfb\u9b42\u6280\uff0c\u53ef\u4eb2\u548c\u3001\u8c03\u52a8\u5e76\u53cd\u9988\u5468\u56f4\u751f\u547d\u80fd\u91cf\uff0c\u662f\u5510\u821e\u9e9f\u81ea\u7136\u4e4b\u79cd\u8def\u7ebf\u7684\u6838\u5fc3\u80fd\u529b\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u751f\u547d+12%\uff0c\u81ea\u8eab\u6cbb\u7597+18%\u6301\u7eed3\u56de\u5408\uff0c\u7fa4\u4f53[\u81ea\u7136\u4eb2\u548c]\u6301\u7eed3\u56de\u5408(\u5f3a\u5ea6+12%)\u3002\u6d88\u8017\uff1a\u9b42\u529b7200\uff0c\u7cbe\u795e\u529b1800\u3002'\x2C\n      )\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u541e\u98df\u5929\u5730'\x2C\n        '\u9b42\u73af\u9b42\u6280'\x2C\n        '\u7b2c1\u6b66\u9b42.\u7b2c6\u9b42\u73af.\u7b2c6\u9b42\u6280'\x2C\n        'ch1054_01'\x2C\n        745840\x2C\n        ['\u541e\u98df\u5929\u5730'\x2C '\u7b2c\u516d\u9b42\u6280'\x2C '\u7b2c6\u9b42\u6280'\x2C '\u7eee\u7f57\u90c1\u91d1\u9999']\x2C\n        6\x2C\n        '\u7b2c\u516d\u9b42\u73af\u53d1\u52a8\u65f6\uff0c\u7eee\u7f57\u90c1\u91d1\u9999\u822c\u7684\u5927\u82b1\u5728\u80cc\u540e\u76db\u653e\uff0c\u5468\u56f4\u5929\u5730\u5143\u529b\u4e0e\u5404\u79cd\u5143\u7d20\u80fd\u91cf\u4f1a\u50cf\u957f\u9cb8\u5438\u6c34\u822c\u5411\u4ed6\u6c47\u805a\u3002'\x2C\n        '\u7b2c\u516d\u9b42\u6280\uff0c\u80fd\u591f\u541e\u566c\u5e76\u8f6c\u5316\u5916\u754c\u80fd\u91cf\u4e3a\u81ea\u8eab\u6240\u7528\uff0c\u4e34\u65f6\u5927\u5e45\u63d0\u5347\u4fee\u4e3a\u4e0e\u7eed\u822a\uff0c\u4e5f\u53ef\u4e3a\u8840\u9b42\u878d\u5408\u6280\u84dd\u7687\u541e\u5929\u5730\u63d0\u4f9b\u57fa\u7840\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u9b42\u529b+18%\uff0c\u81ea\u8eab\u9b42\u529b+28%\u6301\u7eed3\u56de\u5408\uff0c\u81ea\u8eab\u6d88\u8017-12%\u6301\u7eed3\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b7600\uff0c\u7cbe\u795e\u529b1800\u3002'\x2C\n      )\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u84dd\u7687\u68ee\u7f57\u96f7\u72f1'\x2C\n        '\u9b42\u73af\u9b42\u6280'\x2C\n        '\u7b2c1\u6b66\u9b42.\u7b2c9\u9b42\u73af.\u7b2c9\u9b42\u6280'\x2C\n        'ch1417_02'\x2C\n        806847\x2C\n        ['\u84dd\u7687\u68ee\u7f57\u96f7\u72f1'\x2C '\u96f7\u72f1']\x2C\n        9\x2C\n        '\u65e0\u6570\u84dd\u94f6\u7687\u5316\u4e3a\u96f7\u9706\u68ee\u6797\uff0c\u96f7\u5149\u5728\u6bcf\u4e00\u6839\u85e4\u8513\u95f4\u75af\u72c2\u70b8\u88c2\uff0c\u6574\u7247\u533a\u57df\u90fd\u50cf\u88ab\u62d6\u5165\u4e86\u4e00\u5ea7\u96f7\u9706\u56da\u7b3c\u3002'\x2C\n        '\u5927\u8303\u56f4\u9ad8\u538b\u5236\u96f7\u7cfb\u9b42\u6280\uff0c\u517c\u5177\u6301\u7eed\u96f7\u51fb\u3001\u7a7a\u95f4\u5e72\u6270\u4e0e\u533a\u57df\u5c01\u9501\uff0c\u662f\u4ed6\u540e\u671f\u6700\u5f3a\u7684\u7fa4\u4f53\u96f7\u63a7\u4e4b\u4e00\u3002\u5b9e\u9645\u6548\u679c\uff1a\u7fa4\u4f53105%\u8fdc\u7a0b\u653b\u51fb\uff0c\u7fa4\u4f53[\u533a\u57df\u5c01\u9501]\u6301\u7eed3\u56de\u5408(\u5f3a\u5ea6-20%)\u3002\u6d88\u8017\uff1a\u9b42\u529b42000\uff0c\u7cbe\u795e\u529b8500\u3002'\x2C\n      )\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u84dd\u7687\u96f7\u795e\u4e4b\u97ad'\x2C\n        '\u81ea\u521b\u9b42\u6280'\x2C\n        '\u81ea\u521b\u9b42\u6280.\u84dd\u7687\u96f7\u795e\u4e4b\u97ad'\x2C\n        'ch1417_03'\x2C\n        806848\x2C\n        ['\u84dd\u7687\u96f7\u795e\u4e4b\u97ad'\x2C '\u96f7\u795e\u4e4b\u97ad']\x2C\n        9\x2C\n        '\u6240\u6709\u96f7\u9706\u5e76\u4e0d\u76f4\u63a5\u5916\u653e\uff0c\u800c\u662f\u6cbf\u624b\u81c2\u4e0e\u84dd\u94f6\u7687\u9ad8\u5ea6\u538b\u7f29\uff0c\u6700\u7ec8\u5316\u4f5c\u4e00\u8bb0\u517c\u5177\u96f7\u9706\u4e0e\u6cd5\u5219\u538b\u8feb\u7684\u97ad\u51fb\u91cd\u62bd\u76ee\u6807\u3002'\x2C\n        '\u504f\u5355\u4f53\u7684\u9ad8\u7834\u574f\u96f7\u7cfb\u6740\u62db\uff0c\u4e0e\u84dd\u7687\u68ee\u7f57\u96f7\u72f1\u4e92\u8865\uff0c\u91cd\u70b9\u7528\u4e8e\u7cbe\u51c6\u70b9\u6740\u4e0e\u6253\u65ad\u9ad8\u9636\u76ee\u6807\u3002\u5b9e\u9645\u6548\u679c\uff1a\u5355\u4f53185%\u8fdc\u7a0b\u653b\u51fb\uff0c\u9632\u7a7f20\uff0c\u5355\u4f53[\u9ebb\u75f9]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-16%)\u3002\u6d88\u8017\uff1a\u9b42\u529b36000\uff0c\u4f53\u529b12000\u3002'\x2C\n      )\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u91d1\u9f99\u5347\u5929'\x2C\n        '\u81ea\u521b\u9b42\u6280'\x2C\n        '\u81ea\u521b\u9b42\u6280.\u91d1\u9f99\u5347\u5929'\x2C\n        'ch0703_01'\x2C\n        455215\x2C\n        ['\u91d1\u9f99\u5347\u5929']\x2C\n        4\x2C\n        '\u91d1\u8272\u5de8\u9f99\u4ece\u5730\u9762\u6216\u67aa\u52bf\u4e2d\u9aa4\u7136\u51b2\u5929\u800c\u8d77\uff0c\u5e26\u7740\u7b14\u76f4\u4e0a\u64a9\u7684\u9f99\u5f62\u51b2\u51fb\u786c\u751f\u751f\u628a\u76ee\u6807\u9876\u98de\u3002'\x2C\n        '\u517c\u5177\u5347\u7a7a\u6253\u65ad\u3001\u6b63\u9762\u8d2f\u7a7f\u4e0e\u8ffd\u51fb\u8d77\u624b\u529f\u80fd\uff0c\u662f\u4ed6\u4e2d\u540e\u671f\u975e\u5e38\u5e38\u7528\u7684\u5f3a\u51b2\u5f0f\u653b\u51fb\u3002\u5b9e\u9645\u6548\u679c\uff1a\u5355\u4f53\u51fb\u98de8\u8ddd\u79bb\uff0c\u5355\u4f53120%\u8fd1\u8eab\u653b\u51fb\u3002\u6d88\u8017\uff1a\u4f53\u529b3200\u3002'\x2C\n      )\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u91d1\u9f99\u5bc2\u706d\u722a'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u8840\u8109\u6280\u80fd'\x2C\n        \u5199\u5165\u8def\u5f84: '\u8840\u8109\u4e4b\u529b.\u6280\u80fd.\u91d1\u9f99\u5bc2\u706d\u722a'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u91d1\u9f99\u5bc2\u706d\u722a'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 3\x2C\n        \u9644\u5e26\u5c5e\u6027: ['\u6bc1\u706d']\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u653b\u6740'\x2C\n        \u4f24\u5bb3\u7c7b\u578b: '\u771f\u5b9e\u653b\u51fb'\x2C\n        \u76ee\u6807: '\u7fa4\u4f53'\x2C\n        \u5a01\u529b\u500d\u7387: 165\x2C\n        \u9632\u5fa1\u7a7f\u900f: 28\x2C\n        \u72b6\u6001: '\u5bc2\u706d\u6495\u88c2'\x2C\n        \u524d\u6447: 22\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u91d1\u9f99\u5bc2\u706d\u722a']\x2C\n        \u753b\u9762\u63cf\u8ff0: '\u91d1\u8272\u5de8\u722a\u6a2a\u7a7a\u63a2\u51fa\uff0c\u722a\u950b\u5e26\u7740\u5bc2\u706d\u6c14\u606f\u6495\u5f00\u6b63\u9762\u7a7a\u95f4\uff0c\u547d\u4e2d\u65f6\u4f1a\u5f62\u6210\u8986\u76d6\u5927\u7247\u533a\u57df\u7684\u6bc1\u706d\u6495\u88c2\u9762\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u91d1\u9f99\u738b\u8840\u8109\u9b42\u73af\u6280\uff0c\u517c\u5177\u950b\u9510\u3001\u7c89\u788e\u548c\u5bc2\u706d\u538b\u5236\uff0c\u9002\u5408\u7834\u5f00\u9ad8\u9632\u5fa1\u76ee\u6807\u6216\u5728\u8fd1\u4e2d\u8ddd\u5b8c\u6210\u7206\u53d1\u65a9\u6740\u3002\u5b9e\u9645\u6548\u679c\uff1a\u7fa4\u4f53165%\u771f\u5b9e\u653b\u51fb\uff0c\u9632\u7a7f28\uff0c\u7fa4\u4f53[\u5bc2\u706d\u6495\u88c2]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-10%)\u3002\u6d88\u8017\uff1a\u4f53\u529b1700\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u9f99\u96f7\u66b4'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u9f99\u96f7\u66b4'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u9f99\u96f7\u66b4'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 6\x2C\n        \u9644\u5e26\u5c5e\u6027: ['\u96f7'\x2C '\u7cbe\u795e']\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u653b\u6740'\x2C\n        \u4f24\u5bb3\u7c7b\u578b: '\u8fd1\u8eab\u653b\u51fb'\x2C\n        \u76ee\u6807: '\u5355\u4f53'\x2C\n        \u5a01\u529b\u500d\u7387: 178\x2C\n        \u9632\u5fa1\u7a7f\u900f: 22\x2C\n        \u72b6\u6001: '\u96f7\u66b4\u9707\u8361'\x2C\n        \u524d\u6447: 20\x2C\n        \u6d88\u8017\u500d\u7387: 1.1\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u9f99\u96f7\u66b4']\x2C\n        \u753b\u9762\u63cf\u8ff0:\n          '\u91d1\u84dd\u8272\u5149\u8292\u9aa4\u7136\u4ece\u4f53\u5185\u55b7\u8584\u65f6\uff0c\u9f99\u7f61\u3001\u96f7\u9e23\u960e\u72f1\u85e4\u96f7\u9706\u4e0e\u7cbe\u795e\u51b2\u51fb\u4f1a\u5728\u8d34\u8eab\u63a5\u89e6\u5904\u540c\u65f6\u70b8\u5f00\uff0c\u50cf\u628a\u6574\u9053\u96f7\u66b4\u76f4\u63a5\u704c\u8fdb\u5bf9\u624b\u4f53\u5185\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0:\n          '\u4ed6\u4e3a\u6a21\u4eff\u84dd\u7535\u9738\u738b\u9f99\u5bb6\u65cf\u6218\u6597\u65b9\u5f0f\u800c\u521b\u51fa\u7684\u5f3a\u653b\u6280\uff0c\u4f9d\u9760\u8fd1\u8eab\u63a5\u89e6\u628a\u96f7\u9706\u3001\u9f99\u7f61\u4e0e\u7cbe\u795e\u9707\u8361\u4e09\u91cd\u7206\u53d1\u53e0\u6210\u4e00\u51fb\uff0c\u5a01\u529b\u6781\u9ad8\u3002\u5b9e\u9645\u6548\u679c\uff1a\u5355\u4f53178%\u8fd1\u8eab\u653b\u51fb\uff0c\u9632\u7a7f22\uff0c\u5355\u4f53[\u96f7\u66b4\u9707\u8361]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-10%)\u3002\u6d88\u8017\uff1a\u9b42\u529b11220\uff0c\u7cbe\u795e\u529b2693\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u84dd\u7687\u91d1\u9f99\u543c'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u84dd\u7687\u91d1\u9f99\u543c'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u84dd\u7687\u91d1\u9f99\u543c'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 6\x2C\n        \u9644\u5e26\u5c5e\u6027: []\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u63a7\u5236'\x2C\n        \u72b6\u6001: '\u9f99\u5a01\u9707\u6151'\x2C\n        \u76ee\u6807: '\u7fa4\u4f53'\x2C\n        \u524d\u6447: 22\x2C\n        \u6d88\u8017\u500d\u7387: 1.05\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u84dd\u7687\u91d1\u9f99\u543c'\x2C '\u84dd\u7687\u9ec4\u91d1\u9f99\u543c']\x2C\n        \u753b\u9762\u63cf\u8ff0:\n          '\u84dd\u94f6\u7687\u6c14\u606f\u4e0e\u91d1\u9f99\u8840\u8109\u5728\u540c\u4e00\u77ac\u4ea4\u7f20\u7206\u53d1\uff0c\u5de8\u5927\u7684\u91d1\u9f99\u5934\u5e26\u7740\u84dd\u7687\u7eb9\u7406\u6012\u543c\u800c\u51fa\uff0c\u6574\u7247\u7a7a\u95f4\u90fd\u4f1a\u88ab\u8fd9\u9053\u9f99\u541f\u9707\u5f97\u5267\u70c8\u98a4\u6296\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u5c06\u751f\u547d\u6c14\u606f\u3001\u9f99\u5a01\u548c\u9707\u6151\u51b2\u51fb\u53e0\u5728\u4e00\u8d77\u7684\u8840\u9b42\u878d\u5408\u6280\uff0c\u65e2\u80fd\u6b63\u9762\u9707\u788e\u80fd\u91cf\u5f62\u6001\u653b\u52bf\uff0c\u4e5f\u80fd\u5f3a\u884c\u9707\u6151\u9ad8\u9636\u654c\u4eba\u3002\u5b9e\u9645\u6548\u679c\uff1a\u7fa4\u4f53[\u9f99\u5a01\u9707\u6151]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-18%)\uff0c\u7fa4\u4f53\u53cd\u5e94-16%\u6301\u7eed1\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b10710\uff0c\u4f53\u529b4927\uff0c\u7cbe\u795e\u529b2570\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u84dd\u7687\u91d1\u9f99\u98de\u7fd4'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u84dd\u7687\u91d1\u9f99\u98de\u7fd4'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u84dd\u7687\u91d1\u9f99\u98de\u7fd4'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 6\x2C\n        \u9644\u5e26\u5c5e\u6027: []\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u4f4d\u79fb\u7a81\u88ad'\x2C\n        \u4f24\u5bb3\u7c7b\u578b: '\u8fd1\u8eab\u653b\u51fb'\x2C\n        \u76ee\u6807: '\u5355\u4f53'\x2C\n        \u5a01\u529b\u500d\u7387: 162\x2C\n        \u9632\u5fa1\u7a7f\u900f: 18\x2C\n        \u4f4d\u79fb\u7c7b\u578b: '\u7a81\u8fdb'\x2C\n        \u8ddd\u79bb: 38\x2C\n        \u524d\u6447: 16\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u84dd\u7687\u91d1\u9f99\u98de\u7fd4'\x2C '\u84dd\u7687\u9f99\u98de\u7fd4']\x2C\n        \u753b\u9762\u63cf\u8ff0: '\u84dd\u94f6\u7687\u4e0e\u91d1\u9f99\u8840\u8109\u4e00\u5e76\u538b\u5165\u524d\u51b2\u8f68\u8ff9\u540e\uff0c\u6574\u4e2a\u4eba\u50cf\u5316\u6210\u4e00\u6761\u84dd\u91d1\u4ea4\u7ec7\u7684\u5de8\u9f99\u9ad8\u901f\u6251\u6740\uff0c\u9f99\u9996\u5728\u51b2\u523a\u4e2d\u6108\u53d1\u51dd\u5b9e\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u4ee5\u98de\u7fd4\u7c7b\u9f99\u52bf\u4e3a\u9aa8\u67b6\u7684\u8840\u9b42\u878d\u5408\u6280\uff0c\u517c\u5177\u8d85\u9ad8\u901f\u7a81\u8fdb\u4e0e\u6b63\u9762\u8d2f\u7a7f\uff0c\u662f\u8fde\u9501\u7206\u53d1\u4e2d\u7684\u8d77\u624b\u7a81\u523a\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u7a81\u8fdb38\u8ddd\u79bb\uff0c\u5355\u4f53162%\u8fd1\u8eab\u653b\u51fb\uff0c\u9632\u7a7f18\u3002\u6d88\u8017\uff1a\u9b42\u529b10200\uff0c\u4f53\u529b4692\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u84dd\u7687\u91d1\u9f99\u5bc2\u706d\u722a'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u84dd\u7687\u91d1\u9f99\u5bc2\u706d\u722a'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u84dd\u7687\u91d1\u9f99\u5bc2\u706d\u722a'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 6\x2C\n        \u9644\u5e26\u5c5e\u6027: ['\u6bc1\u706d']\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u653b\u6740'\x2C\n        \u4f24\u5bb3\u7c7b\u578b: '\u771f\u5b9e\u653b\u51fb'\x2C\n        \u76ee\u6807: '\u7fa4\u4f53'\x2C\n        \u5a01\u529b\u500d\u7387: 190\x2C\n        \u9632\u5fa1\u7a7f\u900f: 30\x2C\n        \u72b6\u6001: '\u5bc2\u706d\u521b\u4f24'\x2C\n        \u524d\u6447: 24\x2C\n        \u6d88\u8017\u500d\u7387: 1.15\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u84dd\u7687\u91d1\u9f99\u5bc2\u706d\u722a']\x2C\n        \u753b\u9762\u63cf\u8ff0:\n          '\u5de8\u5927\u7684\u91d1\u8272\u9f99\u722a\u6a2a\u7a7a\u63a2\u51fa\u65f6\uff0c\u540e\u65b9\u65e0\u6570\u84dd\u94f6\u7687\u4f1a\u865a\u5316\u7740\u878d\u5165\u722a\u950b\u4e4b\u4e2d\uff0c\u6574\u53ea\u5de8\u722a\u77ac\u95f4\u6269\u5c55\u6210\u8986\u76d6\u5927\u7247\u533a\u57df\u7684\u6bc1\u706d\u6495\u88c2\u9762\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u628a\u84dd\u94f6\u7687\u3001\u91d1\u9f99\u738b\u8840\u8109\u3001\u91d1\u9f99\u5bc2\u706d\u722a\u4e0e\u9b42\u9aa8\u950b\u8292\u538b\u6210\u540c\u4e00\u51fb\u7684\u8840\u9b42\u878d\u5408\u6280\uff0c\u662f\u4ed6\u6700\u5371\u9669\u7684\u8fd1\u4e2d\u8ddd\u7206\u53d1\u6740\u62db\u4e4b\u4e00\u3002\u5b9e\u9645\u6548\u679c\uff1a\u7fa4\u4f53190%\u771f\u5b9e\u653b\u51fb\uff0c\u9632\u7a7f30\uff0c\u7fa4\u4f53[\u5bc2\u706d\u521b\u4f24]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-10%)\u3002\u6d88\u8017\uff1a\u9b42\u529b11730\uff0c\u4f53\u529b5396\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u84dd\u7687\u9f99\u5347\u5929'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u84dd\u7687\u9f99\u5347\u5929'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u84dd\u7687\u9f99\u5347\u5929'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 6\x2C\n        \u9644\u5e26\u5c5e\u6027: []\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u4f4d\u79fb\u7a81\u88ad'\x2C\n        \u4f24\u5bb3\u7c7b\u578b: '\u8fd1\u8eab\u653b\u51fb'\x2C\n        \u76ee\u6807: '\u5355\u4f53'\x2C\n        \u5a01\u529b\u500d\u7387: 170\x2C\n        \u9632\u5fa1\u7a7f\u900f: 18\x2C\n        \u4f4d\u79fb\u7c7b\u578b: '\u51fb\u98de'\x2C\n        \u8ddd\u79bb: 10\x2C\n        \u524d\u6447: 20\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u84dd\u7687\u9f99\u5347\u5929'\x2C '\u84dd\u7687\u91d1\u9f99\u5347\u5929']\x2C\n        \u753b\u9762\u63cf\u8ff0:\n          '\u84dd\u94f6\u7687\u4e0e\u91d1\u9f99\u738b\u8840\u8109\u5728\u67aa\u52bf\u4e2d\u5f7b\u5e95\u4ea4\u878d\u540e\uff0c\u4e00\u6761\u84dd\u91d1\u5de8\u9f99\u4f1a\u81ea\u524d\u65b9\u6216\u5730\u9762\u608d\u7136\u5347\u8d77\uff0c\u628a\u76ee\u6807\u8fde\u540c\u9632\u7ebf\u4e00\u8d77\u9876\u5411\u9ad8\u7a7a\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u4ee3\u8868\u6027\u7684\u8840\u9b42\u878d\u5408\u6280\uff0c\u517c\u5177\u751f\u547d\u529b\u3001\u8d2f\u7a7f\u529b\u4e0e\u4e0a\u64a9\u7206\u53d1\uff0c\u65e2\u80fd\u6b63\u9762\u7834\u9635\uff0c\u4e5f\u80fd\u5728\u8fde\u62db\u4e2d\u5f62\u6210\u7ec8\u6bb5\u91cd\u51fb\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u51fb\u98de10\u8ddd\u79bb\uff0c\u5355\u4f53170%\u8fd1\u8eab\u653b\u51fb\uff0c\u9632\u7a7f18\u3002\u6d88\u8017\uff1a\u9b42\u529b10200\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u84dd\u7687\u5343\u592b\u6240\u6307'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u84dd\u7687\u5343\u592b\u6240\u6307'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u84dd\u7687\u5343\u592b\u6240\u6307'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 6\x2C\n        \u9644\u5e26\u5c5e\u6027: []\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u653b\u6740'\x2C\n        \u4f24\u5bb3\u7c7b\u578b: '\u8fd1\u8eab\u653b\u51fb'\x2C\n        \u76ee\u6807: '\u5355\u4f53'\x2C\n        \u5a01\u529b\u500d\u7387: 185\x2C\n        \u9632\u5fa1\u7a7f\u900f: 28\x2C\n        \u524d\u6447: 28\x2C\n        \u6d88\u8017\u500d\u7387: 1.15\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u84dd\u7687\u5343\u592b\u6240\u6307']\x2C\n        \u753b\u9762\u63cf\u8ff0:\n          '\u9ec4\u91d1\u9f99\u67aa\u523a\u51fa\u65f6\uff0c\u4e07\u5343\u91d1\u8272\u67aa\u8292\u4e4b\u5916\u8fd8\u4f1a\u540c\u65f6\u4f34\u751f\u4e00\u9053\u9053\u84dd\u91d1\u8272\u950b\u8292\uff0c\u6700\u7ec8\u5168\u90e8\u91cd\u5f52\u4e00\u70b9\uff0c\u5316\u4e3a\u66f4\u9738\u9053\u7684\u8d2f\u7a7f\u8f68\u8ff9\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u5c06\u8840\u8109\u4e4b\u529b\u3001\u9b42\u529b\u4e0e\u5343\u592b\u6240\u6307\u67aa\u610f\u7194\u4e3a\u4e00\u4f53\u7684\u8840\u9b42\u878d\u5408\u6280\uff0c\u662f\u4ed6\u9ec4\u91d1\u9f99\u67aa\u8def\u7ebf\u6700\u5f3a\u7684\u6b63\u9762\u7a81\u6740\u4e4b\u4e00\u3002\u5b9e\u9645\u6548\u679c\uff1a\u5355\u4f53185%\u8fd1\u8eab\u653b\u51fb\uff0c\u9632\u7a7f28\uff0c\u5355\u4f53[\u538b\u5236]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-10%)\u3002\u6d88\u8017\uff1a\u9b42\u529b11730\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u84dd\u7687\u541e\u5929\u5730'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u84dd\u7687\u541e\u5929\u5730'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u84dd\u7687\u541e\u5929\u5730'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 6\x2C\n        \u9644\u5e26\u5c5e\u6027: []\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u9886\u57df\u589e\u5e45'\x2C\n        \u76ee\u6807: '\u81ea\u8eab'\x2C\n        \u5c5e\u6027: ['\u9b42\u529b\u4e0a\u9650'\x2C '\u4f53\u529b\u4e0a\u9650']\x2C\n        \u7ed3\u7b97: '\u5916\u754c\u80fd\u91cf\u5438\u6536'\x2C\n        \u7ed3\u7b97\u6570\u503c: '+32%'\x2C\n        \u524d\u6447: 30\x2C\n        \u6d88\u8017\u500d\u7387: 1.05\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u84dd\u7687\u541e\u5929\u5730']\x2C\n        \u753b\u9762\u63cf\u8ff0: '\u7eee\u7f57\u90c1\u91d1\u9999\u822c\u7684\u5927\u82b1\u5728\u80cc\u540e\u76db\u653e\u65f6\uff0c\u5de8\u5927\u7684\u91d1\u8272\u5fc3\u810f\u5149\u5f71\u4f1a\u968f\u4e4b\u663e\u73b0\uff0c\u5468\u56f4\u80fd\u91cf\u50cf\u88ab\u6574\u7247\u6218\u573a\u5f3a\u884c\u62bd\u5411\u4ed6\u4f53\u5185\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u4ee5\u541e\u98df\u5929\u5730\u4e3a\u6838\u5fc3\u5347\u534e\u51fa\u7684\u8840\u9b42\u878d\u5408\u6280\uff0c\u80fd\u591f\u75af\u72c2\u5438\u6444\u5916\u754c\u80fd\u91cf\u5e76\u5168\u9762\u62d4\u5347\u81ea\u8eab\uff0c\u4e3a\u540e\u7eed\u5f3a\u653b\u63d0\u4f9b\u7206\u53d1\u589e\u5e45\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u9b42\u529b\u4e0a\u9650\u3001\u4f53\u529b\u4e0a\u9650+18%\u6301\u7eed4\u56de\u5408\uff0c\u81ea\u8eab\u9b42\u529b+32%\u6301\u7eed3\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b10710\uff0c\u7cbe\u795e\u529b2570\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u84dd\u7687\u771f\u8eab'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u9b42\u73af\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u7b2c1\u6b66\u9b42.\u7b2c7\u9b42\u73af.\u7b2c7\u9b42\u6280'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u84dd\u7687\u771f\u8eab'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 7\x2C\n        \u9644\u5e26\u5c5e\u6027: []\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u6b66\u9b42\u771f\u8eab'\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u84dd\u7687'\x2C '\u84dd\u7687\u771f\u8eab'\x2C '\u84dd\u94f6\u771f\u8eab'\x2C '\u7b2c\u4e03\u9b42\u6280'\x2C '\u7b2c7\u9b42\u6280']\x2C\n        \u753b\u9762\u63cf\u8ff0: '\u7b2c\u4e03\u9b42\u73af\u95ea\u8000\u540e\uff0c\u65e0\u6570\u84dd\u94f6\u7687\u4f1a\u50cf\u5de8\u9f99\u822c\u4ece\u8eab\u4e0a\u6cc9\u6d8c\u66b4\u5c04\uff0c\u6574\u4e2a\u4eba\u8fdb\u5165\u4e0e\u84dd\u7687\u6b66\u9b42\u5f7b\u5e95\u76f8\u878d\u7684\u771f\u8eab\u5f62\u6001\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u84dd\u94f6\u7687\u6b66\u9b42\u771f\u8eab\uff0c\u80fd\u591f\u5168\u9762\u653e\u5927\u81ea\u8eab\u84dd\u94f6\u7687\u7cfb\u6280\u80fd\u4e0e\u8840\u8109\u878d\u5408\u5f3a\u5ea6\uff0c\u662f\u540e\u671f\u6301\u7eed\u538b\u5236\u548c\u9ad8\u9636\u8fde\u62db\u7684\u6838\u5fc3\u57fa\u5e95\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u529b\u91cf\u3001\u654f\u6377\u3001\u9632\u5fa1+32%\u6301\u7eed4\u56de\u5408\uff0c\u81ea\u8eab\u9020\u6210\u4f24\u5bb3+24%\u6301\u7eed3\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b:25% \u7ef4\u6301:\u9b42\u529b:8%\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u9c9c\u8840\u91d1\u9f99\u9886\u57df'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u9c9c\u8840\u91d1\u9f99\u9886\u57df'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u9c9c\u8840\u91d1\u9f99\u9886\u57df'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 7\x2C\n        \u9644\u5e26\u5c5e\u6027: []\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u9886\u57df\u589e\u5e45'\x2C\n        \u76ee\u6807: '\u81ea\u8eab'\x2C\n        \u5c5e\u6027: ['\u529b\u91cf'\x2C '\u9632\u5fa1'\x2C '\u4f53\u529b\u4e0a\u9650']\x2C\n        \u7ed3\u7b97: '\u9f99\u5a01\u538b\u5236'\x2C\n        \u7ed3\u7b97\u6570\u503c: '+24%'\x2C\n        \u524d\u6447: 24\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u9c9c\u8840\u91d1\u9f99\u9886\u57df']\x2C\n        \u753b\u9762\u63cf\u8ff0:\n          '\u91d1\u8272\u6597\u94e0\u9886\u57df\u9aa4\u7136\u5316\u4e3a\u91d1\u7ea2\u8840\u7130\uff0c\u4e00\u6761\u6761\u91d1\u7ea2\u5de8\u9f99\u81ea\u811a\u4e0b\u4e0e\u5468\u56f4\u5347\u817e\u800c\u8d77\uff0c\u75af\u72c2\u800c\u4e0d\u5c48\u7684\u9f99\u738b\u610f\u5ff5\u4f1a\u77ac\u95f4\u7b3c\u7f69\u6574\u7247\u6218\u573a\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0:\n          '\u4e09\u5b57\u6597\u94e0\u9886\u57df\uff0c\u80fd\u663e\u8457\u62d4\u5347\u81ea\u8eab\u6c14\u8840\u3001\u9f99\u5a01\u4e0e\u6b63\u9762\u653b\u6740\u5f3a\u5ea6\uff0c\u5e76\u5bf9\u9f99\u7c7b\u6b66\u9b42\u3001\u6597\u94e0\u4e0e\u76f8\u5173\u9886\u57df\u5f62\u6210\u6781\u5f3a\u538b\u5236\uff0c\u751a\u81f3\u5177\u5907\u541e\u566c\u548c\u5c01\u6740\u6548\u679c\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u529b\u91cf\u3001\u9632\u5fa1\u3001\u4f53\u529b\u4e0a\u9650+18%\u6301\u7eed4\u56de\u5408\uff0c\u7fa4\u4f53[\u9f99\u5a01\u538b\u5236]\u6301\u7eed3\u56de\u5408(\u5f3a\u5ea6-24%)\u3002\u6d88\u8017\uff1a\u9b42\u529b15000\uff0c\u4f53\u529b6900\uff0c\u7cbe\u795e\u529b3600\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u65f6\u5149\u56de\u6eaf\u9886\u57df'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u65f6\u5149\u56de\u6eaf\u9886\u57df'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u65f6\u5149\u56de\u6eaf\u9886\u57df'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 8\x2C\n        \u9644\u5e26\u5c5e\u6027: ['\u7cbe\u795e'\x2C '\u65f6\u95f4']\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u9886\u57df\u63a7\u5236'\x2C\n        \u72b6\u6001: '\u65f6\u5149\u56de\u6eaf'\x2C\n        \u7ed3\u7b97: '\u884c\u52a8\u65f6\u5e8f'\x2C\n        \u524d\u6447: 26\x2C\n        \u6d88\u8017\u500d\u7387: 1.15\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u65f6\u5149\u56de\u6eaf\u9886\u57df'\x2C '\u65f6\u5149\u56de\u6eaf']\x2C\n        \u753b\u9762\u63cf\u8ff0: '\u9886\u57df\u53d1\u52a8\u65f6\uff0c\u76ee\u6807\u5468\u56f4\u7684\u65f6\u95f4\u6d41\u901f\u4f1a\u50cf\u88ab\u5f3a\u884c\u62fd\u56de\u4e0a\u4e00\u77ac\uff0c\u660e\u660e\u5df2\u7ecf\u5b8c\u6210\u7684\u7a81\u8fdb\u3001\u51fa\u624b\u6216\u7206\u53d1\u4f1a\u7a81\u7136\u5012\u9000\u91cd\u7f6e\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0:\n          '\u5510\u821e\u9e9f\u72ec\u6709\u7684\u7cbe\u795e\u9886\u57df\uff0c\u53ef\u628a\u7279\u5b9a\u76ee\u6807\u6216\u653b\u51fb\u9001\u56de\u4e0a\u4e00\u79d2\u5e76\u6270\u4e71\u65f6\u95f4\u8282\u594f\uff0c\u4e5f\u80fd\u901a\u8fc7\u65f6\u95f4\u8fdf\u7f13\u6216\u52a0\u901f\u6253\u4e71\u654c\u65b9\u8fde\u62db\uff0c\u662f\u4ed6\u540e\u671f\u6700\u6838\u5fc3\u7684\u63a7\u573a\u5e95\u724c\u4e4b\u4e00\u3002\u5b9e\u9645\u6548\u679c\uff1a\u7fa4\u4f53[\u65f6\u5149\u56de\u6eaf]\u6301\u7eed3\u56de\u5408(\u5f3a\u5ea6-18%)\uff0c\u7fa4\u4f53\u53cd\u5e94-20%\u6301\u7eed3\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b26450\uff0c\u7cbe\u795e\u529b6348\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u5343\u9f99\u590d\u82cf'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u5343\u9f99\u590d\u82cf'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u5343\u9f99\u590d\u82cf'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 9\x2C\n        \u9644\u5e26\u5c5e\u6027: []\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u53ec\u5524'\x2C\n        \u53ec\u5524\u7269\u540d\u79f0: '\u5343\u9f99\u9f99\u9b42'\x2C\n        \u6570\u91cf: 12\x2C\n        \u72b6\u6001: '\u9f99\u9b42\u538b\u5236'\x2C\n        \u524d\u6447: 34\x2C\n        \u6d88\u8017\u500d\u7387: 1.2\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u5343\u9f99\u590d\u82cf']\x2C\n        \u753b\u9762\u63cf\u8ff0:\n          '\u56db\u5b57\u6597\u94e0\u628a\u9c9c\u8840\u91d1\u9f99\u9886\u57df\u518d\u6b21\u5347\u534e\u540e\uff0c\u6f2b\u5929\u9f99\u9b42\u4f1a\u5728\u91d1\u7ea2\u8272\u9886\u57df\u4e2d\u540c\u65f6\u590d\u82cf\uff0c\u4eff\u4f5b\u4e0a\u5343\u5934\u771f\u9f99\u4e00\u9f50\u88ab\u4ed6\u5524\u9192\u5e76\u542c\u547d\u800c\u52a8\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0:\n          '\u9c9c\u8840\u91d1\u9f99\u9886\u57df\u8fdb\u5316\u540e\u7684\u56db\u5b57\u6597\u94e0\u5f62\u6001\uff0c\u53ef\u4e34\u65f6\u8c03\u52a8\u9f99\u9b42\u5316\u4e3a\u771f\u9f99\u519b\u52bf\uff0c\u5927\u5e45\u63d0\u5347\u9886\u57df\u538b\u5236\u3001\u7fa4\u4f53\u653b\u4f10\u4e0e\u7edf\u5fa1\u611f\uff0c\u662f\u4ed6\u538b\u7bb1\u5e95\u7684\u9876\u7ea7\u9886\u57df\u80fd\u529b\u3002\u5b9e\u9645\u6548\u679c\uff1a\u53ec\u552412\u4e2a\u5343\u9f99\u9f99\u9b42\u6301\u7eed2\u56de\u5408\uff0c\u5355\u4f53[\u9f99\u9b42\u538b\u5236]\u6301\u7eed2\u56de\u5408(\u5f3a\u5ea6-12%)\u3002\u6d88\u8017\uff1a\u9b42\u529b45600\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u84dd\u7687\u5bc2\u706d\u795e\u722a'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u84dd\u7687\u5bc2\u706d\u795e\u722a'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u84dd\u7687\u5bc2\u706d\u795e\u722a'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 9\x2C\n        \u9644\u5e26\u5c5e\u6027: ['\u6bc1\u706d']\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u653b\u6740'\x2C\n        \u4f24\u5bb3\u7c7b\u578b: '\u771f\u5b9e\u653b\u51fb'\x2C\n        \u76ee\u6807: '\u5355\u4f53'\x2C\n        \u5a01\u529b\u500d\u7387: 225\x2C\n        \u9632\u5fa1\u7a7f\u900f: 34\x2C\n        \u72b6\u6001: '\u5bc2\u706d\u521b\u4f24'\x2C\n        \u524d\u6447: 22\x2C\n        \u6d88\u8017\u500d\u7387: 1.15\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u84dd\u7687\u5bc2\u706d\u795e\u722a']\x2C\n        \u753b\u9762\u63cf\u8ff0: '\u5de8\u5927\u7684\u84dd\u7687\u5bc2\u706d\u795e\u722a\u608d\u7136\u62cd\u51fa\u65f6\uff0c\u84dd\u94f6\u7687\u3001\u91d1\u9f99\u6050\u722a\u4e0e\u91d1\u9f99\u5bc2\u706d\u795e\u6293\u7684\u950b\u8292\u4f1a\u5728\u534a\u7a7a\u53e0\u6210\u540c\u4e00\u53ea\u6bc1\u706d\u5de8\u722a\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u5728\u84dd\u7687\u8def\u7ebf\u4e0b\u8fdb\u4e00\u6b65\u53e0\u52a0\u591a\u91cd\u6495\u88c2\u4e0e\u538b\u5236\u7684\u9ad8\u9636\u722a\u51fb\uff0c\u5c24\u5176\u64c5\u957f\u6b63\u9762\u786c\u6495\u5f3a\u654c\u9632\u5fa1\u3002\u5b9e\u9645\u6548\u679c\uff1a\u5355\u4f53225%\u771f\u5b9e\u653b\u51fb\uff0c\u9632\u7a7f34\uff0c\u5355\u4f53[\u5bc2\u706d\u521b\u4f24]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-10%)\u3002\u6d88\u8017\uff1a\u9b42\u529b43700\uff0c\u4f53\u529b20102\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u84dd\u7687\u9f99\u6446\u5c3e'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u84dd\u7687\u9f99\u6446\u5c3e'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u84dd\u7687\u9f99\u6446\u5c3e'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 9\x2C\n        \u9644\u5e26\u5c5e\u6027: []\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u653b\u6740'\x2C\n        \u4f24\u5bb3\u7c7b\u578b: '\u8fd1\u8eab\u653b\u51fb'\x2C\n        \u76ee\u6807: '\u7fa4\u4f53'\x2C\n        \u5a01\u529b\u500d\u7387: 148\x2C\n        \u9632\u5fa1\u7a7f\u900f: 16\x2C\n        \u72b6\u6001: '\u51fb\u9000\u538b\u5236'\x2C\n        \u524d\u6447: 18\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u84dd\u7687\u9f99\u6446\u5c3e']\x2C\n        \u753b\u9762\u63cf\u8ff0: '\u4e00\u811a\u7529\u51fa\u65f6\uff0c\u9f99\u541f\u4f1a\u88f9\u7740\u84dd\u7687\u9f99\u5c3e\u822c\u7684\u6a2a\u626b\u52b2\u9053\u540c\u65f6\u8f70\u51fa\uff0c\u50cf\u771f\u6b63\u7684\u9f99\u5c3e\u9aa4\u7136\u62bd\u8fc7\u6218\u573a\u4fa7\u9762\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u84dd\u7687\u4f53\u7cfb\u4e0b\u7684\u6a2a\u626b\u91cd\u51fb\u6280\uff0c\u5f3a\u8c03\u7206\u53d1\u5f0f\u626b\u8361\u3001\u7834\u4f4d\u4e0e\u8fd1\u8ddd\u79bb\u5f3a\u884c\u62bd\u98de\u5bf9\u624b\u3002\u5b9e\u9645\u6548\u679c\uff1a\u7fa4\u4f53148%\u8fd1\u8eab\u653b\u51fb\uff0c\u9632\u7a7f16\uff0c\u7fa4\u4f53[\u51fb\u9000\u538b\u5236]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-10%)\u3002\u6d88\u8017\uff1a\u9b42\u529b38000\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u5343\u592b\u6240\u6307'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u5343\u592b\u6240\u6307'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u5510\u821e\u9e9f_\u5343\u592b\u6240\u6307'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 7\x2C\n        \u9644\u5e26\u5c5e\u6027: []\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u653b\u6740'\x2C\n        \u4f24\u5bb3\u7c7b\u578b: '\u8fd1\u8eab\u653b\u51fb'\x2C\n        \u76ee\u6807: '\u5355\u4f53'\x2C\n        \u5a01\u529b\u500d