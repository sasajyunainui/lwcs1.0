y.unit))\n        .map((entry\x2C index) => {\n          const actorId = preview.unitId(entry.unit);\n          const actionOpportunity = input.actionOpportunity || {};\n          const request = decision.prepareDecisionRequest({\n            worldSnapshot\x2C\n            actorId\x2C\n            objectiveContract: input.objectiveContract || worldSnapshot?.\u80dc\u8d1f\u6761\u4ef6 || {}\x2C\n            battleIntent: input.battleIntent || {\n              mode: String(worldSnapshot?.\u6218\u6597\u610f\u56fe || '').trim()\x2C\n              objectives: worldSnapshot?.\u80dc\u8d1f\u6761\u4ef6 || {}\x2C\n            }\x2C\n            beliefState: input.initialBelief?.[actorId] || input.initialBelief || {}\x2C\n            actionOpportunity\x2C\n            strategyMemory: input.strategyMemory || {}\x2C\n            seed: `${seed}:${Number(worldSnapshot?.\u56de\u5408 || 0)}:${index}`\x2C\n            runtimeSnapshot: input.runtimeSnapshot && typeof input.runtimeSnapshot === 'object'\n              ? input.runtimeSnapshot\n              : buildDecisionRuntimeSnapshot(worldSnapshot\x2C actorId\x2C actionOpportunity)\x2C\n          });\n          return decision.runProvider({ providerId\x2C request });\n        });\n      if (JSON.stringify(sourceCombatData) !== sourceSnapshot) throw new Error('PROVIDER_MUTATED_STATE');\n      const decisionAudits = providerResults.map(result =>\n        buildDecisionAuditRecord(result.decisionAudit)\x2C\n      );\n      return {\n        caseId\x2C\n        seed\x2C\n        mode\x2C\n        providerId\x2C\n        ledger: []\x2C\n        trace: []\x2C\n        scoreAudit: decisionAudits.flatMap(item => item.scoreAudit)\x2C\n        actionChains: []\x2C\n        reportBlocks: []\x2C\n        roundOverview: []\x2C\n        finalBattleReport: null\x2C\n        aiSummaryInput: null\x2C\n        initialSnapshot: cloneValue(worldSnapshot)\x2C\n        finalSnapshot: worldSnapshot\x2C\n        decisions: decisionAudits\x2C\n        providerResults\x2C\n      };\n    }\n    const decisionEngine = String(input?.settings?.decisionEngine || 'legacy').trim().toLowerCase();\n    const decideOnceImpl = decisionEngine === 'next-shadow' ? decision.decideNext : decision.decide;\n    if (typeof decideOnceImpl !== 'function') throw new Error(`battle_decision_engine_missing:${decisionEngine}`);\n    const decideOnce = (payload\x2C index = 0) => decideOnceImpl({\n      ...payload\x2C\n      battleIntent: input.battleIntent || payload?.battleIntent || {\n        mode: String(payload?.worldSnapshot?.\u6218\u6597\u610f\u56fe || worldSnapshot?.\u6218\u6597\u610f\u56fe || '').trim()\x2C\n        objectives: payload?.worldSnapshot?.\u80dc\u8d1f\u6761\u4ef6 || worldSnapshot?.\u80dc\u8d1f\u6761\u4ef6 || {}\x2C\n      }\x2C\n      beliefState: payload?.beliefState && Object.keys(payload.beliefState).length\n        ? payload.beliefState\n        : input.initialBelief?.[payload?.actorId] || input.initialBelief || {}\x2C\n      seed: `${seed}:${Number(payload?.worldSnapshot?.\u56de\u5408 || 0)}:${index}:${payload?.seedOffset || 0}`\x2C\n    });\n    if (input.settings?.decisionOnly === true) {\n      const decisions = preview.listUnits(worldSnapshot)\n        .filter(entry => preview.isAlive(entry.unit))\n        .map((entry\x2C index) => decideOnce({\n          worldSnapshot\x2C\n          actorId: preview.unitId(entry.unit)\x2C\n          actionOpportunity: input.actionOpportunity || {}\x2C\n          strategyMemory: input.strategyMemory || {}\x2C\n        }\x2C index));\n      if (JSON.stringify(sourceCombatData) !== sourceSnapshot) throw new Error('PREVIEW_MUTATED_STATE');\n      const decisionAudits = decisions.map(buildDecisionAuditRecord);\n      return {\n        caseId\x2C\n        seed\x2C\n        mode\x2C\n        ledger: []\x2C\n        trace: []\x2C\n        scoreAudit: decisionAudits.flatMap(item => item.scoreAudit)\x2C\n        actionChains: []\x2C\n        reportBlocks: []\x2C\n        roundOverview: []\x2C\n        finalBattleReport: null\x2C\n        aiSummaryInput: null\x2C\n        finalSnapshot: worldSnapshot\x2C\n        decisions: decisionAudits\x2C\n      };\n    }\n  }\n\n  function runBattleCase(options = {}) {\n    return runDecisionCase(options && typeof options === 'object' ? options : {});\n  }\n\n  function executeBattleDraft(input = {}) {\n    const source = input && typeof input === 'object' ? input : {};\n    const result = runDecisionCase(cloneValue(source));\n    if (Number(result?.audit?.fatalCount || 0) > 0) {\n      const codes = (Array.isArray(result?.audit?.fatals) ? result.audit.fatals : [])\n        .map(item => String(item?.code || '').trim())\n        .filter(Boolean);\n      throw new Error(`battle_draft_runtime_audit_failed:${codes.join('\x2C') || 'unknown'}`);\n    }\n    const draft = {\n      schemaVersion: '7.3-R7.4-draft-1'\x2C\n      status: 'DRAFT'\x2C\n      caseId: String(result?.caseId || source?.caseId || '').trim()\x2C\n      seed: result?.seed ?? source?.seed ?? 1\x2C\n      mode: String(result?.mode || source?.mode || '').trim()\x2C\n      roundsRequested: Math.max(0\x2C Number(result?.roundsRequested || source?.rounds || 0))\x2C\n      actualRoundCount: Math.max(0\x2C Number(result?.roundsExecuted || 0))\x2C\n      ledger: cloneValue(result?.ledger || result?.eventLedger || [])\x2C\n      trace: cloneValue(result?.trace || result?.resolutionTrace || [])\x2C\n      decisionAudit: cloneValue(result?.decisions || result?.decisionTrace || [])\x2C\n      actionQueueTrace: cloneValue(result?.actionQueueTrace || [])\x2C\n      terminalResult: cloneValue(result?.terminal || result?.objectiveResolution || {\n        terminal: result?.winner && result.winner !== 'unfinished'\x2C\n        winner: result?.winner || 'unfinished'\x2C\n      })\x2C\n      initialSnapshot: cloneValue(result?.initialSnapshot || null)\x2C\n      finalSnapshot: cloneValue(result?.finalSnapshot || result?.snapshot || null)\x2C\n    };\n    return Object.freeze({ ...draft\x2C draftHash: hashBattleValue(draft) });\n  }\n\n  function executeBattleDraftR8(input = {}) {\n    const source = input && typeof input === 'object' ? cloneValue(input) : {};\n    const providerId = String(source?.settings?.providerId || '').trim();\n    if (!['legacy-baseline'\x2C 'r74-next-baseline'\x2C 'r8-shadow'\x2C 'r8'].includes(providerId)) {\n      throw new Error(`battle_runtime_r8_provider_invalid:${providerId || 'missing'}`);\n    }\n    const inputHash = hashBattleValue(source);\n    const result = runDecisionCase(source);\n    const objectiveContract = source.objectiveContract ||\n      source.battleIntent?.objectives ||\n      source.combatData?.\u80dc\u8d1f\u6761\u4ef6 ||\n      {};\n    const draft = {\n      schemaVersion: '8.3-draft-1'\x2C\n      status: 'DRAFT'\x2C\n      providerId\x2C\n      inputHash\x2C\n      objectiveHash: hashBattleValue(objectiveContract)\x2C\n      ledger: cloneValue(result?.ledger || [])\x2C\n      trace: cloneValue(result?.trace || [])\x2C\n      actionQueueTrace: cloneValue(result?.actionQueueTrace || [])\x2C\n      decisionAudit: cloneValue(result?.providerResults || result?.decisions || [])\x2C\n      terminalResult: cloneValue(result?.terminal || {\n        terminal: false\x2C\n        winner: 'unfinished'\x2C\n        reason: 'DECISION_ONLY'\x2C\n      })\x2C\n      initialSnapshot: cloneValue(result?.initialSnapshot || source.combatData || null)\x2C\n      finalSnapshot: cloneValue(result?.finalSnapshot || source.combatData || null)\x2C\n    };\n    return Object.freeze({ ...draft\x2C draftHash: hashBattleValue(draft) });\n  }\n\n  function sealBattleResult(input = {}) {\n    const draft = input?.draft && typeof input.draft === 'object' ? cloneValue(input.draft) : null;\n    const reportAudit = input?.reportAudit && typeof input.reportAudit === 'object' ? input.reportAudit : null;\n    if (!draft || String(draft?.status || '').trim() !== 'DRAFT') throw new Error('battle_result_draft_invalid');\n    const draftHash = String(draft?.draftHash || '').trim();\n    delete draft.draftHash;\n    if (!draftHash || hashBattleValue(draft) !== draftHash) throw new Error('BATTLE_COMMIT_HASH_MISMATCH:draft');\n    if (reportAudit?.passed !== true || Number(reportAudit?.fatalCount || 0) > 0) {\n      throw new Error('battle_result_report_audit_failed');\n    }\n    const reportDto = reportAudit?.reportDto && typeof reportAudit.reportDto === 'object'\n      ? cloneValue(reportAudit.reportDto)\n      : null;\n    const reportHash = String(reportAudit?.reportHash || '').trim();\n    if (!reportDto || !reportHash || hashBattleValue(reportDto) !== reportHash) {\n      throw new Error('BATTLE_COMMIT_HASH_MISMATCH:report');\n    }\n    return Object.freeze({\n      schemaVersion: '7.3-R7.4-sealed-1'\x2C\n      sealStatus: 'SEALED'\x2C\n      draftHash\x2C\n      reportHash\x2C\n      terminalResult: cloneValue(draft.terminalResult)\x2C\n      finalSnapshot: cloneValue(draft.finalSnapshot)\x2C\n      reportDto\x2C\n      aiSummaryInput: cloneValue(reportDto.aiSummaryInput || null)\x2C\n    });\n  }\n\n  function verifySealedBattlePackage(input = {}) {\n    const sealedPackage = input && typeof input === 'object' ? cloneValue(input) : null;\n    if (!sealedPackage || String(sealedPackage?.sealStatus || '').trim() !== 'SEALED') {\n      throw new Error('BATTLE_COMMIT_BEFORE_REPORT_SEAL');\n    }\n    if (!['7.3-R7.4-sealed-1'\x2C '8.3-sealed-1'].includes(String(sealedPackage?.schemaVersion || '').trim())) {\n      throw new Error('BATTLE_COMMIT_HASH_MISMATCH:schema');\n    }\n    const draftHash = String(sealedPackage?.draftHash || '').trim();\n    const reportHash = String(sealedPackage?.reportHash || '').trim();\n    const reportDto = sealedPackage?.reportDto;\n    if (\n      !draftHash ||\n      !reportHash ||\n      !reportDto ||\n      typeof reportDto !== 'object' ||\n      String(reportDto?.sourceDraftHash || '').trim() !== draftHash ||\n      hashBattleValue(reportDto) !== reportHash\n    ) {\n      throw new Error('BATTLE_COMMIT_HASH_MISMATCH:package');\n    }\n    if (!sealedPackage?.finalSnapshot || typeof sealedPackage.finalSnapshot !== 'object') {\n      throw new Error('BATTLE_COMMIT_HASH_MISMATCH:final_snapshot');\n    }\n    return Object.freeze(sealedPackage);\n  }\n\n  function auditPrototypeCoverage() {\n    const rows = prototypeManifest.map(entry => {\n      const contract = prototypeRuntimeContract[entry.name];\n      return {\n        prototype: entry.name\x2C\n        component: String(contract?.component || '').trim()\x2C\n        settlementConsumers: [...(contract?.settlementConsumers || [])]\x2C\n        factTypes: [...(contract?.factTypes || [])]\x2C\n        reportBlockTypes: [...(contract?.reportBlockTypes || [])]\x2C\n        stages: {\n          legality: typeof assertEffectList === 'function'\x2C\n          preview: !!contract?.component\x2C\n          scoring: !!contract?.component\x2C\n          settlement: (contract?.settlementConsumers || []).length > 0\x2C\n          ledger: (contract?.factTypes || []).length > 0\x2C\n          report: (contract?.reportBlockTypes || []).length > 0\x2C\n        }\x2C\n      };\n    });\n    const expected = new Set(prototypeManifest.map(entry => entry.name));\n    const actual = new Set(rows.map(row => String(row?.prototype || '').trim()).filter(Boolean));\n    const missing = [...expected].filter(name => !actual.has(name));\n    const unknown = [...actual].filter(name => !expected.has(name));\n    if (missing.length || unknown.length) {\n      throw new Error(`battle_prototype_coverage_mismatch:missing=${missing.join('\x2C')}:unknown=${unknown.join('\x2C')}`);\n    }\n    const requiredStages = ['legality'\x2C 'preview'\x2C 'scoring'\x2C 'settlement'\x2C 'ledger'\x2C 'report'];\n    rows.forEach(row => {\n      const incomplete = requiredStages.filter(stage => row?.stages?.[stage] !== true);\n      if (incomplete.length) throw new Error(`battle_prototype_stage_missing:${row.prototype}:${incomplete.join('\x2C')}`);\n    });\n    const coveredPrototypes = new Set(rows.filter(row => Object.values(row.stages).every(Boolean)).map(row => row.prototype));\n    const coveredOptionKeys = new Set(prototypeOptionMatrix\n      .filter(entry => coveredPrototypes.has(entry.prototype))\n      .map(entry => entry.optionKey));\n    const missingOptionKeys = prototypeOptionMatrix\n      .map(entry => entry.optionKey)\n      .filter(optionKey => !coveredOptionKeys.has(optionKey));\n    if (missingOptionKeys.length) throw new Error(`battle_prototype_option_coverage_missing:${missingOptionKeys.join('\x2C')}`);\n    return cloneValue({ prototypes: rows\x2C coveredOptionKeys: [...coveredOptionKeys]\x2C prototypeCount: rows.length\x2C optionCount: coveredOptionKeys.size });\n  }\n\n  const api = Object.freeze({\n    version: '7.3-R6.3'\x2C\n    actionKinds\x2C\n    actionRoles\x2C\n    opportunityGrantTypes\x2C\n    resourceTimelineOperations\x2C\n    sideEffectStatusMap\x2C\n    reportBlockTypes\x2C\n    prototypeRegistry\x2C\n    prototypeRuntimeContract\x2C\n    prototypeManifest\x2C\n    prototypeOptionMatrix\x2C\n    cloneValue\x2C\n    stableSerialize\x2C\n    hashBattleValue\x2C\n    normalizeSideEffectList\x2C\n    settleConditionSideEffects\x2C\n    settleDelayedEffect\x2C\n    settlePersistentPrototype\x2C\n    settleConditionsAtRoundEnd\x2C\n    nextRuntimeId\x2C\n    ensureCombatRuntime\x2C\n    normalizeOpportunityRecord\x2C\n    opportunitySnapshotFromRuntime\x2C\n    resourceTimelineFromRuntime\x2C\n    scheduledEventsFromRuntime\x2C\n    buildRuntimeDecisionSnapshot\x2C\n    buildDecisionRuntimeSnapshot\x2C\n    buildNoOpRuntimeSnapshot\x2C\n    getBattleSnapshot\x2C\n    ensureLedger\x2C\n    attachLedger\x2C\n    ensureTrace\x2C\n    probabilitySucceeds\x2C\n    createActionQueue\x2C\n    buildActionQueue\x2C\n    createEmptyCombatEffectMap\x2C\n    buildCombatFinalStats\x2C\n    prepareCombatData\x2C\n    evaluateBattleTerminal\x2C\n    syncSummonUnitMirror: syncSummonMirror\x2C\n    writeCombatResource\x2C\n    readCombatResource: persistentResourceValue\x2C\n    ensureActionDiagnostic\x2C\n    registerStateSource\x2C\n    findStateSource\x2C\n    decideDuelContinuation\x2C\n    executeActionNodes\x2C\n    executeDeclaration\x2C\n    beginStructuredDeclaration\x2C\n    executeStructuredDeclaration\x2C\n    settleStructuredReaction\x2C\n    openStructuredCounterWindow\x2C\n    auditStructuredCommitCoverage\x2C\n    runStructuredBattle\x2C\n    calculateBaseDamage\x2C\n    assertEffectList\x2C\n    assertSkillEffects\x2C\n    runDecisionCase\x2C\n    runBattleCase\x2C\n    executeBattleDraft\x2C\n    executeBattleDraftR8\x2C\n    sealBattleResult\x2C\n    verifySealedBattlePackage\x2C\n    auditFacts\x2C\n    normalizeActionDisplayName\x2C\n    normalizeActionRole\x2C\n    normalizeBattleSide\x2C\n    inferUnitSide\x2C\n    inferEventSides\x2C\n    inferActionRole\x2C\n    inferFactType\x2C\n    inferEffectPrototype\x2C\n    inferActionTargetScope\x2C\n    normalizeTargetIds\x2C\n    normalizeActorControl\x2C\n    findRecentLedgerAction\x2C\n    findInitialIntentNode\x2C\n    normalizeCausalNode\x2C\n    writeLedgerEvent\x2C\n    writeRoundEndResourceEvent\x2C\n    settleNaturalRecoveryAtRoundEnd\x2C\n    settleRingRecoveryAtRoundEnd\x2C\n    settleConditionResourceTick\x2C\n    triggerStateRevive\x2C\n    triggerRevive\x2C\n    refreshSustainRuntimeLoad\x2C\n    settleExpiredConditionBase\x2C\n    buildMinimalSettlementTrace: \u6784\u5efa\u4e8b\u4ef6\u6700\u5c0f\u7ed3\u7b97\u8f68\u8ff9\x2C\n    inferStateTickAggregateKind: \u8bfb\u53d6\u72b6\u6001Tick\u805a\u5408\u79cd\u7c7b\x2C\n    cloneAuditSnapshot\x2C\n    collectDecisionTrace\x2C\n    collectResolutionTrace\x2C\n    buildActionChains\x2C\n    buildReportBlocks\x2C\n    buildRoundOverview\x2C\n    buildFinalSummary\x2C\n    buildAiNarrativeSummary\x2C\n    auditPrototypeCoverage\x2C\n    evaluateBattleTerminal\x2C\n    readTeamAlive\x2C\n    validateSoulTowerRoster\x2C\n    ensureSummonWindowRuntime\x2C\n    removeSummonUnit\x2C\n    removeHostStateSummon\x2C\n    consumeSummonWindow\x2C\n    refreshSummonMentalLoad\x2C\n    beginBattleRound\x2C\n    settleGuardSummonWindows\x2C\n  });\n\n  root.__LWCS_BATTLE_RUNTIME__ = api;\n  root.__LWCS_BATTLE_RUNTIME_REGISTRY_SOURCE__ = 'shared';\n  root.__LWCS_BATTLE_RUNTIME_REGISTRY_SIZE__ = prototypeManifest.length;\n})();\n
