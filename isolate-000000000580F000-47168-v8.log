    []\x2C\n    );\n    const dependencyView = createDependencyView({\n      worldSnapshot: visibleWorld\x2C\n      objectiveContract\x2C\n      opportunitySnapshot\x2C\n      scheduledEvents\x2C\n      beliefState\x2C\n    });\n    const evaluationContext = {\n      schemaVersion: '8.3-evaluation-context-1'\x2C\n      worldRevision: String(input?.worldRevision || worldRevisionFor(worldSnapshot))\x2C\n      visibleWorldRevision: `visible:${preview.stableHash(visibleWorld)}`\x2C\n      beliefRevision: beliefRevisionFor(beliefState)\x2C\n      objectiveHash: `objective:${preview.stableHash(objectiveContract)}`\x2C\n      opportunityRevision: `opportunity:${preview.stableHash(opportunitySnapshot)}`\x2C\n      resourceTimelineRevision: `resource:${preview.stableHash(resourceTimeline)}`\x2C\n      scheduleRevision: `schedule:${preview.stableHash(scheduledEvents)}`\x2C\n      opportunitySnapshot\x2C\n      resourceTimeline\x2C\n      scheduledEvents\x2C\n      horizon: cloneValue(input?.horizon || battleHorizonProfile(input\x2C visibleWorld))\x2C\n      dependencyView\x2C\n    };\n    const candidatesOnly = String(input?.analysisDepth || '').trim().toUpperCase() === 'CANDIDATES_ONLY';\n    const candidateEnvelopeMetrics = {\n      rebuildCount: 0\x2C\n      previewCalls: 0\x2C\n      searchedRouteCount: 0\x2C\n      reusedRouteCount: 0\x2C\n    };\n    const baselineCreationFutureUseAudits =\n      candidatesOnly && String(input?.providerId || '').trim() === 'r74-next-baseline'\n        ? buildBaselineCreationFutureUseAudits({\n            ...input\x2C\n            worldSnapshot: visibleWorld\x2C\n            actorId\x2C\n            actorSide\x2C\n            battleIntent\x2C\n            beliefState\x2C\n            actionOpportunity\x2C\n            __preparedDecisionWorld: true\x2C\n            __preparedBeliefState: beliefState\x2C\n            __frozenCandidates: frozenCandidates\x2C\n          })\n        : {};\n    const routeAnalysis = candidatesOnly\n      ? {\n          routeCatalog: {}\x2C\n          actorCandidateRoutes: {}\x2C\n          actorProjectedWorlds: {}\x2C\n          cacheMetrics: {\n            cacheSize: 0\x2C\n            previewCalls: 0\x2C\n            searchedUnitCount: 0\x2C\n            recomputedUnitCount: 0\x2C\n            searchedRouteCount: 0\x2C\n          }\x2C\n        }\n      : buildR8RouteCatalog({\n          worldSnapshot: visibleWorld\x2C\n          actorId\x2C\n          actorCandidates: frozenCandidates\x2C\n          beliefState\x2C\n          battleIntent\x2C\n          actionOpportunity\x2C\n          dependencyView\x2C\n          evaluationContext\x2C\n          previousCatalog: input?.previousRouteCatalog\x2C\n          affectedUnitIds: input?.affectedRouteUnitIds\x2C\n          affectedTargetUnitIds: input?.affectedRouteTargetUnitIds\x2C\n        });\n    const teamMarginalPlan = candidatesOnly\n      ? []\n      : buildTeamMarginalPlan(routeAnalysis.routeCatalog\x2C visibleWorld\x2C actorId);\n    const candidateEnvelopeDeltas = candidatesOnly\n      ? {}\n      : buildR8CandidateEnvelopeDeltas({\n          worldSnapshot: visibleWorld\x2C\n          actorSide\x2C\n          routeCatalog: routeAnalysis.routeCatalog\x2C\n          projectedWorlds: routeAnalysis.actorProjectedWorlds\x2C\n          candidateRoutes: routeAnalysis.actorCandidateRoutes\x2C\n          fullRoutesByUnit: routeAnalysis.fullRoutesByUnit\x2C\n          beliefState\x2C\n          battleIntent\x2C\n          actionOpportunity\x2C\n          opportunitySnapshot: runtimeSnapshot.opportunitySnapshot || []\x2C\n          scheduledEvents: runtimeSnapshot.scheduledEvents || []\x2C\n          objectiveContract\x2C\n          metrics: candidateEnvelopeMetrics\x2C\n        });\n    const requestPayload = {\n      schemaVersion: R8_REQUEST_SCHEMA\x2C\n      actorId\x2C\n      actorSide\x2C\n      actionOpportunity\x2C\n      objectiveContract\x2C\n      visibleWorld\x2C\n      beliefState\x2C\n      teamPublicFacts: worldEntries(visibleWorld).map(entry => ({\n        unitId: preview.unitId(entry.unit)\x2C\n        side: entry.side\x2C\n        alive: preview.isAlive(entry.unit)\x2C\n        hpRatio: preview.readHp(entry.unit) / Math.max(1\x2C preview.readHpMax(entry.unit))\x2C\n        visibleStates: visibleStates(entry.unit)\x2C\n      }))\x2C\n      frozenCandidates\x2C\n      candidateFingerprintMap\x2C\n      evaluationContext\x2C\n      actionRouteCatalog: routeAnalysis.routeCatalog\x2C\n      actorCandidateRoutes: routeAnalysis.actorCandidateRoutes\x2C\n      candidateEnvelopeDeltas\x2C\n      teamMarginalPlan\x2C\n      routeCacheMetrics: routeAnalysis.cacheMetrics\x2C\n      candidateEnvelopeMetrics: Object.freeze({ ...candidateEnvelopeMetrics })\x2C\n      battleIntent: cloneValue(battleIntent)\x2C\n      strategyMemory: cloneValue(input?.strategyMemory || {})\x2C\n      analysisDepth: candidatesOnly ? 'CANDIDATES_ONLY' : 'FULL'\x2C\n      baselineCreationFutureUseAudits\x2C\n      seed: input?.seed ?? 1\x2C\n    };\n    requestPayload.responseModelByCandidate = candidatesOnly\n      ? {}\n      : Object.fromEntries(\n          frozenCandidates.map(candidate => [\n            candidate.candidateId\x2C\n            buildR8ResponseModel(requestPayload\x2C candidate.candidateId)\x2C\n          ])\x2C\n        );\n    requestPayload.informationValueByCandidate = candidatesOnly\n      ? {}\n      : Object.fromEntries(\n          frozenCandidates.map(candidate => [\n            candidate.candidateId\x2C\n            r8InformationValue(requestPayload\x2C candidate.candidateId)\x2C\n          ])\x2C\n        );\n    if (preview.stableHash(worldSnapshot) !== sourceWorldHash) {\n      throw new Error('PROVIDER_MUTATED_STATE:prepare');\n    }\n    const request = {\n      ...requestPayload\x2C\n      requestHash: decisionRequestHash(requestPayload)\x2C\n    };\n    return deepFreeze(request);\n  }\n\n  function providerInput(request = {}) {\n    return {\n      worldSnapshot: request.visibleWorld\x2C\n      visibleWorldSnapshot: request.visibleWorld\x2C\n      actorId: request.actorId\x2C\n      battleIntent: request.battleIntent\x2C\n      beliefState: request.beliefState\x2C\n      actionOpportunity: request.actionOpportunity\x2C\n      strategyMemory: request.strategyMemory\x2C\n      seed: request.seed\x2C\n      __preparedDecisionWorld: true\x2C\n      __preparedBeliefState: request.beliefState\x2C\n      __frozenCandidates: request.frozenCandidates\x2C\n      __creationFutureUseAuditByCandidate: request.baselineCreationFutureUseAudits\x2C\n    };\n  }\n\n  const providerRegistry = Object.freeze({\n    'legacy-baseline': request => decide(providerInput(request))\x2C\n    'r74-next-baseline': request => decideNext(providerInput(request))\x2C\n    'r8-shadow': request => runR8Provider(request)\x2C\n    r8: request => runR8Provider(request)\x2C\n  });\n\n  function runProvider(input = {}) {\n    const providerId = String(input?.providerId || '').trim();\n    const request = input?.request;\n    if (!Object.hasOwn(providerRegistry\x2C providerId)) {\n      throw new Error(`battle_decision_provider_unknown:${providerId || 'missing'}`);\n    }\n    if (!request || request.schemaVersion !== R8_REQUEST_SCHEMA) {\n      throw new Error('DECISION_SCHEMA_MISMATCH:request');\n    }\n    const beforeHash = decisionRequestHash(request);\n    if (beforeHash !== request.requestHash) throw new Error('PROVIDER_MUTATED_STATE:request_hash');\n    let decision;\n    providerExecutionDepth += 1;\n    try {\n      decision = providerRegistry[providerId](request);\n    } finally {\n      providerExecutionDepth -= 1;\n    }\n    if (decisionRequestHash(request) !== beforeHash) throw new Error('PROVIDER_MUTATED_STATE:provider');\n    const selectedCandidateId = String(decision?.selected?.candidateId || '').trim();\n    const lostOpportunity = decision?.lostOpportunity && typeof decision.lostOpportunity === 'object'\n      ? cloneValue(decision.lostOpportunity)\n      : null;\n    if (!selectedCandidateId && lostOpportunity) {\n      return deepFreeze({\n        schemaVersion: R8_RESULT_SCHEMA\x2C\n        providerId\x2C\n        requestHash: request.requestHash\x2C\n        selectedCandidateId: ''\x2C\n        selectedDeclaration: null\x2C\n        decisionAudit: cloneValue(decision)\x2C\n        beliefState: cloneValue(decision?.beliefState || request.beliefState)\x2C\n        teamIntent: cloneValue(decision?.teamIntent || {})\x2C\n        strategyMemory: cloneValue(decision?.strategyMemory || request.strategyMemory)\x2C\n        strategicSignature: String(decision?.strategicSignature || '').trim()\x2C\n        stateCapacityTotal: Math.max(0\x2C Number(decision?.stateCapacityTotal || 0))\x2C\n        beliefRevision: String(decision?.beliefRevision || beliefRevisionFor(request.beliefState))\x2C\n        pendingStrategicEffect: decision?.pendingStrategicEffect === true\x2C\n        decisionProfile: cloneValue(decision?.decisionProfile || {})\x2C\n      });\n    }\n    const selectedCandidate = request.frozenCandidates.find(\n      candidate => candidate.candidateId === selectedCandidateId\x2C\n    );\n    if (!selectedCandidate) throw new Error('PROVIDER_UNKNOWN_CANDIDATE');\n    const selectedDeclaration = cloneValue(decision?.selected?.declaration || {});\n    const expectedFingerprint = request.candidateFingerprintMap[selectedCandidateId];\n    if (declarationFingerprint(selectedDeclaration) !== expectedFingerprint) {\n      throw new Error('DECLARATION_FINGERPRINT_MISMATCH');\n    }\n    return deepFreeze({\n      schemaVersion: R8_RESULT_SCHEMA\x2C\n      providerId\x2C\n      requestHash: request.requestHash\x2C\n      selectedCandidateId\x2C\n      selectedDeclaration\x2C\n      decisionAudit: cloneValue(decision)\x2C\n      beliefState: cloneValue(decision?.beliefState || request.beliefState)\x2C\n      teamIntent: cloneValue(decision?.teamIntent || {})\x2C\n      strategyMemory: cloneValue(decision?.strategyMemory || request.strategyMemory)\x2C\n      strategicSignature: String(decision?.strategicSignature || '').trim()\x2C\n      stateCapacityTotal: Math.max(0\x2C Number(decision?.stateCapacityTotal || 0))\x2C\n      beliefRevision: String(decision?.beliefRevision || beliefRevisionFor(request.beliefState))\x2C\n      pendingStrategicEffect: decision?.pendingStrategicEffect === true\x2C\n      decisionProfile: cloneValue(decision?.decisionProfile || {})\x2C\n    });\n  }\n\n  root.__LWCS_BATTLE_DECISION__ = Object.freeze({\n    version: VERSION\x2C\n    actionKinds\x2C\n    collectSkills\x2C\n    collectAvailableRings\x2C\n    parseSkillCosts\x2C\n    costAffordable\x2C\n    enumerateCandidates\x2C\n    buildInitialBelief\x2C\n    buildDecisionWorld\x2C\n    mechanicKey\x2C\n    relevantStateFingerprint\x2C\n    betaPrior\x2C\n    mechanicPosterior\x2C\n    updateMechanicBelief\x2C\n    hitMechanicKey\x2C\n    hitMechanicFactor\x2C\n    updatePublicObservation\x2C\n    updateTargetRealizationBelief\x2C\n    unknownResponseMass\x2C\n    mechanicAdaptationKey\x2C\n    mechanicPosteriorWithAdaptation\x2C\n    buildTeamIntent\x2C\n    identifyProblems\x2C\n    activeStrategyMemory\x2C\n    collectInventory\x2C\n    creationProfile\x2C\n    strategicSignature\x2C\n    detectStalemate\x2C\n    actionFamilyOf\x2C\n    detectStrategyDegeneration\x2C\n    stateUtility\x2C\n    buildNextValueContext\x2C\n    stateUtilityNext\x2C\n    scoreCandidatesNext\x2C\n    compareDecisionKernels\x2C\n    decideNext\x2C\n    readMetrics: () => Object.freeze({ ...decisionMetrics })\x2C\n    resetMetrics: resetDecisionMetrics\x2C\n    dominates\x2C\n    paretoFilter\x2C\n    normalizeUtilities\x2C\n    classifyCandidateEvidence\x2C\n    decide\x2C\n    declarationFingerprint\x2C\n    createDependencyView\x2C\n    r8PreviewCacheKey\x2C\n    actionRouteFromPreview\x2C\n    selectPrimaryBackupRoutes\x2C\n    buildR8RouteCatalog\x2C\n    buildTeamMarginalPlan\x2C\n    buildR8CandidateEnvelopeDeltas\x2C\n    buildR8ResponseModel\x2C\n    r8InformationValue\x2C\n    r8ObjectiveGroups\x2C\n    r8ThresholdOverkill\x2C\n    r8TerminalUtility\x2C\n    r8UnitHasFutureOpportunity\x2C\n    r8ActionPoolDeltas\x2C\n    projectR8GoalUtility\x2C\n    buildR8CausalValueFacts\x2C\n    validateR8CausalOwnership\x2C\n    r8HasDefenseWindow\x2C\n    r8CandidateExclusion\x2C\n    r8Dominates\x2C\n    r8ParetoFilter\x2C\n    r8NormalizeUtilities\x2C\n    selectR8Candidate\x2C\n    runR8Provider\x2C\n    prepareDecisionRequest\x2C\n    runProvider\x2C\n    providerIds: Object.freeze(Object.keys(providerRegistry))\x2C\n  });\n})();\n
