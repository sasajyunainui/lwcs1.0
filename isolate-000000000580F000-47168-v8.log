\u771f\u8eab\u9b42\u6280\u4f4d_V1(\u9b42\u6280\u4f4d) && \u6280\u80fd\u6d88\u8017\u5305\u542b\u767e\u5206\u6bd4_V1(skill?.\u6d88\u8017);\n  const \u6807\u51c6 = \u6b66\u9b42\u771f\u8eab\u767e\u5206\u6bd4\u6d88\u8017 ? null : \u83b7\u53d6\u6807\u51c6\u6d88\u8017_V1(\u9b42\u6280\u4f4d);\n  if (\u6b66\u9b42\u771f\u8eab\u767e\u5206\u6bd4\u6d88\u8017) {\n    const \u5b9e\u9645\u6bd4\u4f8b = \u8bfb\u53d6\u6280\u80fd\u627f\u8f7d\u6d88\u8017\u6bd4\u4f8b_V1(skill\x2C \u4e0a\u4e0b\u6587);\n    return Math.max(0.05\x2C Math.min(4\x2C \u5b9e\u9645\u6bd4\u4f8b / \u83b7\u53d6\u6b66\u9b42\u771f\u8eab\u8fd0\u8f6c\u6807\u51c6\u6d88\u8017\u6bd4\u4f8b_V1()));\n  }\n  if (!Number.isFinite(\u6807\u51c6) || \u6807\u51c6 <= 0) return 1;\n  const \u5b9e\u9645 = \u8bfb\u53d6\u6280\u80fd\u5b9e\u9645\u6d88\u8017_V1(skill\x2C \u4e0a\u4e0b\u6587\x2C \u6807\u51c6);\n  return Math.max(0.05\x2C Math.min(4\x2C \u5b9e\u9645 / \u6807\u51c6));\n}\n\nfunction \u8ba1\u7b97\u524d\u6447\u500d\u6570_V1(skill = {}\x2C \u4e0a\u4e0b\u6587 = {}) {\n  const \u5b9e\u9645 = \u8bfb\u53d6\u6280\u80fd\u5b9e\u9645\u524d\u6447_V1(skill\x2C \u4e0a\u4e0b\u6587);\n  return Math.max(0.05\x2C Math.min(4\x2C \u5b9e\u9645 / SKILL_STANDARD_CAST_TIME_V1));\n}\n\n// \u500d\u6570 \u2192 \u6bd4\u4f8b\uff1a1.0\xd7 \u5bf9\u5e94 0\uff1b\u500d\u6570>1 \u65f6\u4e0a\u626c\u5230 \u4e0a\u9650\u6bd4\u4f8b\uff08\u6309 4\xd7 \u5c01\u9876\uff09\uff1b\u500d\u6570<1 \u65f6\u4e0b\u964d\u5230 \u4e0b\u9650\u6bd4\u4f8b\uff08\u6309 0.25\xd7 \u5c01\u9876\uff09\nfunction \u500d\u6570\u5230\u6bd4\u4f8b_V1(\u500d\u6570 = 1\x2C \u4e0a\u9650\u6bd4\u4f8b = 0.6\x2C \u4e0b\u9650\u6bd4\u4f8b = -0.45) {\n  const \u503c = Number(\u500d\u6570);\n  if (!Number.isFinite(\u503c)) return 0;\n  if (\u503c >= 1) return Math.min(\u4e0a\u9650\u6bd4\u4f8b\x2C (\u503c - 1) * (\u4e0a\u9650\u6bd4\u4f8b / 3));\n  return Math.max(\u4e0b\u9650\u6bd4\u4f8b\x2C (\u503c - 1) * Math.abs(\u4e0b\u9650\u6bd4\u4f8b) / 0.75);\n}\n\nfunction \u8bfb\u53d6\u6280\u80fd\u5206\u9636\u6bb5\u