    \u5a01\u529b\u500d\u7387: 130\x2C\n        \u9632\u5fa1\u7a7f\u900f: 16\x2C\n        \u524d\u6447: 32\x2C\n        \u6d88\u8017\u500d\u7387: 1.15\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u795e\u5723\u5ba1\u5224']\x2C\n        \u753b\u9762\u63cf\u8ff0: '\u4e09\u5927\u9b42\u6280\u4e0e\u5723\u5251\u5a01\u80fd\u5728\u77ac\u95f4\u88ab\u4ed6\u5f3a\u884c\u538b\u6210\u540c\u4e00\u9053\u6062\u5b8f\u91d1\u8272\u5ba1\u5224\u4e4b\u5149\uff0c\u843d\u4e0b\u65f6\u65e2\u50cf\u51c0\u5316\uff0c\u4e5f\u50cf\u5f7b\u5e95\u5ba1\u5224\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u628a\u795e\u5723\u4e4b\u5149\u3001\u5723\u5251\u4e0e\u5ba1\u5224\u4e4b\u5149\u5f3a\u884c\u53e0\u6210\u4e00\u6b21\u77ac\u95f4\u7206\u53d1\u7684\u7ec4\u5408\u6280\uff0c\u517c\u5177\u5927\u8303\u56f4\u538b\u5236\u3001\u9b42\u529b\u6d88\u878d\u4e0e\u5f3a\u70c8\u795e\u5723\u51b2\u51fb\u3002\u5b9e\u9645\u6548\u679c\uff1a\u7fa4\u4f53130%\u771f\u5b9e\u653b\u51fb\uff0c\u9632\u7a7f16\uff0c\u7fa4\u4f53[\u538b\u5236]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-10%)\u3002\u6d88\u8017\uff1a\u9b42\u529b8280\u3002'\x2C\n      })\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u5723\u878d\u672f'\x2C\n        '\u81ea\u521b\u9b42\u6280'\x2C\n        '\u81ea\u521b\u9b42\u6280.\u5723\u878d\u672f'\x2C\n        'ch1189_01'\x2C\n        776645\x2C\n        ['\u5723\u878d\u672f']\x2C\n        7\x2C\n        '\u795e\u5723\u4e4b\u5149\u3001\u5723\u5251\u4e0e\u5ba1\u5224\u4e4b\u5149\u88ab\u5f3a\u884c\u7194\u4e3a\u4e00\u4f53\uff0c\u4e00\u8f6e\u8f6e\u66f4\u9ad8\u5c42\u7ea7\u7684\u795e\u5723\u51b2\u51fb\u968f\u4e4b\u8fde\u7eed\u7206\u53d1\u3002'\x2C\n        '\u628a\u591a\u4e2a\u795e\u5723\u7cfb\u6280\u80fd\u4e34\u65f6\u7194\u63a5\u6210\u4e00\u6761\u7206\u53d1\u94fe\uff0c\u8ba9\u5ba1\u5224\u3001\u65a9\u51fb\u4e0e\u707c\u70e7\u6548\u679c\u5728\u77ed\u65f6\u95f4\u5185\u6210\u500d\u63d0\u5347\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u9020\u6210\u4f24\u5bb3+26%(\u9650\u5b9a\u5149)\u6301\u7eed2\u56de\u5408\uff0c\u81ea\u8eab\u547d\u4e2d+12%\u6301\u7eed2\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b10500\uff0c\u7cbe\u795e\u529b4200\u3002'\x2C\n      )\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u795e\u5723\u727a\u7272'\x2C\n        '\u8840\u8109\u6280\u80fd'\x2C\n        '\u8840\u8109\u4e4b\u529b.\u6280\u80fd.\u795e\u5723\u727a\u7272'\x2C\n        'ch1042_02'\x2C\n        745567\x2C\n        ['\u795e\u5723\u727a\u7272'\x2C '\u727a\u7272']\x2C\n        6\x2C\n        '\u751f\u547d\u706b\u7130\u88ab\u70b9\u71c3\u540e\uff0c\u91d1\u8272\u5723\u7130\u4f1a\u5728\u4ed6\u4f53\u8868\u4e0e\u53cc\u7ffc\u95f4\u71c3\u70e7\uff0c\u8fde\u91cd\u521b\u548c\u8d1f\u9762\u72b6\u6001\u90fd\u50cf\u88ab\u8fd9\u80a1\u706b\u7130\u5f3a\u884c\u9a71\u6563\u3002'\x2C\n        '\u4ee5\u751f\u547d\u529b\u4e3a\u4ee3\u4ef7\u5927\u5e45\u589e\u5e45\u795e\u5723\u4e4b\u529b\u5e76\u62b5\u6297\u8d1f\u9762\u6548\u679c\uff0c\u662f\u795e\u5723\u5929\u4f7f\u4e00\u8109\u6700\u6838\u5fc3\u7684\u5b88\u62a4\u578b\u8840\u8109\u80fd\u529b\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u751f\u547d-12%\uff0c\u81ea\u8eab\u529b\u91cf+24%\u6301\u7eed3\u56de\u5408\uff0c\u81ea\u8eab[\u8d1f\u9762\u6297\u6027\u63d0\u5347]\u6301\u7eed3\u56de\u5408(\u5f3a\u5ea6+18%)\u3002\u6d88\u8017\uff1a\u751f\u547d12000\uff0c\u7cbe\u795e\u529b2400\u3002'\x2C\n      )\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u795e\u5723\u5929\u4f7f'\x2C\n        '\u9b42\u73af\u9b42\u6280'\x2C\n        '\u7b2c1\u6b66\u9b42.\u7b2c7\u9b42\u73af.\u7b2c7\u9b42\u6280'\x2C\n        'ch1189_01'\x2C\n        776645\x2C\n        ['\u795e\u5723\u5929\u4f7f'\x2C '\u795e\u5723\u5929\u4f7f\u771f\u8eab']\x2C\n        7\x2C\n        '\u7b2c\u4e03\u9b42\u73af\u70b9\u71c3\u540e\uff0c\u4ed6\u6574\u4e2a\u4eba\u5316\u4e3a\u900f\u660e\u800c\u70bd\u4eae\u7684\u795e\u5723\u5929\u4f7f\uff0c\u7fbd\u7ffc\u4e0e\u8eab\u4f53\u50cf\u548c\u5149\u672c\u8eab\u878d\u4e3a\u4e86\u4e00\u4f53\u3002'\x2C\n        '\u6b66\u9b42\u771f\u8eab\u5f62\u6001\uff0c\u5168\u9762\u63d0\u5347\u98de\u884c\u3001\u901f\u5ea6\u3001\u795e\u5723\u5a01\u80fd\u4e0e\u751f\u5b58\u80fd\u529b\uff0c\u662f\u4ed6\u540e\u671f\u6240\u6709\u9ad8\u9636\u8fdb\u653b\u7684\u57fa\u7840\u5f62\u6001\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u654f\u6377+24%\u6301\u7eed4\u56de\u5408\uff0c\u81ea\u8eab\u9020\u6210\u4f24\u5bb3+28%(\u9650\u5b9a\u5149)\u6301\u7eed4\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b:25% \u7ef4\u6301:\u9b42\u529b:8%\u3002'\x2C\n      )\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u5723\u5149\u65a9'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u5723\u5149\u65a9'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u4e50\u6b63\u5b87_\u5723\u5149\u65a9'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 7\x2C\n        \u9644\u5e26\u5c5e\u6027: ['\u5149']\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u653b\u6740'\x2C\n        \u4f24\u5bb3\u7c7b\u578b: '\u771f\u5b9e\u653b\u51fb'\x2C\n        \u76ee\u6807: '\u5355\u4f53'\x2C\n        \u5a01\u529b\u500d\u7387: 145\x2C\n        \u9632\u5fa1\u7a7f\u900f: 14\x2C\n        \u524d\u6447: 20\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u5723\u5149\u65a9']\x2C\n        \u753b\u9762\u63cf\u8ff0: '\u795e\u5723\u5149\u660e\u4e4b\u529b\u4f1a\u5728\u51fa\u624b\u77ac\u95f4\u538b\u6210\u4e00\u9053\u950b\u9510\u65a9\u7ebf\uff0c\u5e26\u7740\u91d1\u8272\u7206\u9e23\u6b63\u9762\u5207\u5411\u76ee\u6807\u6240\u5728\u4e00\u4fa7\u7a7a\u95f4\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u4ee5\u9ad8\u6d53\u5ea6\u5723\u5149\u51dd\u6210\u7684\u76f4\u63a5\u65a9\u51fb\u6280\uff0c\u91cd\u5728\u5feb\u901f\u7834\u9632\u548c\u914d\u5408\u5176\u4ed6\u795e\u5723\u7cfb\u5f3a\u653b\u8fde\u7eed\u538b\u5236\u3002\u5b9e\u9645\u6548\u679c\uff1a\u5355\u4f53145%\u771f\u5b9e\u653b\u51fb\uff0c\u9632\u7a7f14\uff0c\u5355\u4f53[\u538b\u5236]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-10%)\u3002\u6d88