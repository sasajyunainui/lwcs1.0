u679c\uff1a\u81ea\u8eab\u529b\u91cf\u3001\u654f\u6377+28%\u6301\u7eed4\u56de\u5408\uff0c\u81ea\u8eab\u9020\u6210\u4f24\u5bb3+28%(\u9650\u5b9a\u6697)\u6301\u7eed3\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b3680\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u5730\u72f1\u4e4b\u95e8'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u9b42\u73af\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u7b2c2\u6b66\u9b42.\u7b2c4\u9b42\u73af.\u7b2c4\u9b42\u6280'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u539f\u6069\u591c\u8f89_\u5730\u72f1\u4e4b\u95e8'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 4\x2C\n        \u9644\u5e26\u5c5e\u6027: ['\u6697']\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u53ec\u5524'\x2C\n        \u53ec\u5524\u7269\u540d\u79f0: '\u9b54\u5316\u5206\u8eab'\x2C\n        \u72b6\u6001: '\u6076\u9b54\u7275\u5236'\x2C\n        \u524d\u6447: 34\x2C\n        \u6d88\u8017\u500d\u7387: 1.2\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u7b2c4\u9b42\u6280 \u5730\u72f1\u4e4b\u95e8'\x2C '\u5730\u72f1\u4e4b\u95e8']\x2C\n        \u753b\u9762\u63cf\u8ff0: '\u4e00\u6247\u901a\u4f53\u6697\u7d2b\u3001\u4eff\u4f5b\u6076\u9b54\u5f20\u53e3\u822c\u7684\u5927\u95e8\u4f1a\u5728\u5979\u8eab\u524d\u9aa4\u7136\u5c55\u5f00\uff0c\u9b54\u5316\u540e\u7684\u53e6\u4e00\u4e2a\u5979\u53ef\u81ea\u95e8\u4e2d\u8d70\u51fa\u5e76\u52a0\u5165\u6218\u6597\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0:\n          '\u6d89\u53ca\u6076\u9b54\u4f4d\u9762\u529b\u91cf\u7684\u9ad8\u5371\u9b42\u6280\uff0c\u80fd\u591f\u53ec\u51fa\u9b54\u5316\u5206\u8eab\u534f\u540c\u4f5c\u6218\uff0c\u5e76\u8ba9\u6cf0\u5766\u5de8\u733f\u4e0e\u5815\u843d\u5929\u4f7f\u4e24\u6761\u6218\u6597\u7ebf\u5728\u77ed\u65f6\u95f4\u5185\u540c\u65f6\u5b58\u5728\u3002\u5b9e\u9645\u6548\u679c\uff1a\u53ec\u55241\u4e2a\u9b54\u5316\u5206\u8eab\u6301\u7eed2\u56de\u5408\uff0c\u5355\u4f53[\u6076\u9b54\u7275\u5236]\u6301\u7eed2\u56de\u5408(\u5f3a\u5ea6-12%)\u3002\u6d8