Passing in an encoding option does not help since our Buffer encoding only\x0d\n  // knows about certain specific text encodings and a single file path might\x0d\n  // actually contain segments that use multiple encodings. It's tricky! So\x2C\x0d\n  // for this variation where we are producing a buffer\x2C we won't scan for the\x0d\n  // slashes at all\x2C and instead will decode the bytes literally into the\x0d\n  // returned Buffer. That said\x2C that can also be tricky because\x2C on windows\x2C\x0d\n  // the file path separator *is* the ASCII backslash. This is a known issue\x0d\n  // on windows specific to the Shift-JIS encoding that we're not really going\x0d\n  // to solve here. Instead\x2C we're going to do the best we can and just\x0d\n  // interpret the input url as a sequence of bytes.\x0d\n\x0d\n  // Because we are converting to a Windows file path here\x2C we need to replace\x0d\n  // the explicit forward slash separators with backslashes. Note that this\x0d\n  // intentionally disregards any percent-encoded forward slashes in the path.\x0d\n  pathname = SideEffectFreeRegExpPrototypeSymbolReplace(FORWARD_SLASH\x2C pathname\x2C '\\\\');\x0d\n\x0d\n  // Now\x2C let's start to build our Buffer. We will initially start with a\x0d\n  // Buffer allocated to fit in the entire string. Worst case there are no\x0d\n  // percent encoded characters and we take the string as is. Any invalid\x0d\n  // percent encodings\x2C e.g. `%ZZ` are ignored and are passed through\x0d\n  // literally.\x0d\n  const decodedu8 = percentDecode(Buffer.from(pathname\x2C 'utf8'));\x0d\n  const decodedPathname = Buffer.from(TypedArrayPrototypeGetBuffer(decodedu8)\x2C\x0d\n                                      TypedArrayPrototypeGetByteOffset(decodedu8)\x2C\x0d\n                                      TypedArrayPrototypeGetByteLength(decodedu8));\x0d\n  if (hostname !== '') {\x0d\n    // If hostname is set\x2C then we have a UNC path\x0d\n    // Pass the hostname through domainToUnicode just in case\x0d\n    // it is an IDN using punycode encoding. We do not need to worry\x0d\n    // about percent encoding because the URL parser will have\x0d\n    // already taken care of that for us. Note that this only\x0d\n    // causes IDNs with an appropriate `xn--` prefix to be decoded.\x0d\n\x0d\n    // This is a bit tricky because of the need to convert to a Buffer\x0d\n    // followed by concatenation of the results.\x0d\n    const prefix = Buffer.from('\\\\\\\\'\x2C 'ascii');\x0d\n    const domain = Buffer.from(domainToUnicode(hostname)\x2C 'utf8');\x0d\n\x0d\n    return Buffer.concat([prefix\x2C domain\x2C decodedPathname]);\x0d\n  }\x0d\n  // Otherwise\x2C it's a local path that requires a drive letter\x0d\n  // In this case we're only going to pay attention to the second and\x0d\n  // third bytes in the decodedPathname. If first byte is either an ASCII\x0d\n  // uppercase letter between 'A' and 'Z' or lowercase letter between\x0d\n  // 'a' and 'z'\x2C and the second byte must be an ASCII `:` or the\x0d\n  // operation will fail.\x0d\n\x0d\n  const letter = decodedPathname[1] | 0x20;\x0d\n  const sep = decodedPathname[2];\x0d\n\x0d\n  if (letter < CHAR_LOWERCASE_A || letter > CHAR_LOWERCASE_Z ||   // a..z A..Z\x0d\n      (sep !== CHAR_COLON)) {\x0d\n    throw new ERR_INVALID_FILE_URL_PATH('must be absolute'\x2C url);\x0d\n  }\x0d\n\x0d\n  // Now\x2C we'll just return everything except the first byte of\x0d\n  // decodedPathname\x0d\n  return decodedPathname.subarray(1);\x0d\n}\x0d\n\x0d\nfunction getPathFromURLPosix(url) {\x0d\n  if (url.hostname !== '') {\x0d\n    throw new ERR_INVALID_FILE_URL_HOST(platform);\x0d\n  }\x0d\n  const pathname = url.pathname;\x0d\n  for (let n = 0; n < pathname.length; n++) {\x0d\n    if (pathname[n] === '%') {\x0d\n      const third = StringPrototypeCodePointAt(pathname\x2C n + 2) | 0x20;\x0d\n      if (pathname[n + 1] === '2' && third === 102) {\x0d\n        throw new ERR_INVALID_FILE_URL_PATH(\x0d\n          'must not include encoded / characters'\x2C\x0d\n          url\x2C\x0d\n        );\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n  // Fast-path: if there is no percent-encoding\x2C avoid decodeURIComponent.\x0d\n  return StringPrototypeIncludes(pathname\x2C '%') ? decodeURIComponent(pathname) : pathname;\x0d\n}\x0d\n\x0d\nfunction getPathBufferFromURLPosix(url) {\x0d\n  if (url.hostname !== '') {\x0d\n    throw new ERR_INVALID_FILE_URL_HOST(platform);\x0d\n  }\x0d\n  const pathname = url.pathname;\x0d\n\x0d\n  // In the getPathFromURLPosix variant\x2C we scan the input for forward slash\x0d\n  // (/) characters\x2C specifically looking for the ASCII/UTF8 and forbidding\x0d\n  // its use. This is a bit tricky because these may conflict with non-UTF8\x0d\n  // encodings. Passing in an encoding option does not help since our Buffer\x0d\n  // encoding only knows about certain specific text encodings and a single\x0d\n  // file path might actually contain segments that use multiple encodings.\x0d\n  // It's tricky! So\x2C for this variation where we are producing a buffer\x2C we\x0d\n  // won't scan for the slashes at all\x2C and instead will decode the bytes\x0d\n  // literally into the returned Buffer. We're going to do the best we can and\x0d\n  // just interpret the input url as a sequence of bytes.\x0d\n  const u8 = percentDecode(Buffer.from(pathname\x2C 'utf8'));\x0d\n  return Buffer.from(TypedArrayPrototypeGetBuffer(u8)\x2C\x0d\n                     TypedArrayPrototypeGetByteOffset(u8)\x2C\x0d\n                     TypedArrayPrototypeGetByteLength(u8));\x0d\n}\x0d\n\x0d\nfunction fileURLToPath(path\x2C options = kEmptyObject) {\x0d\n  const windows = options?.windows;\x0d\n  if (typeof path === 'string')\x0d\n    path = new URL(path);\x0d\n  else if (!isURL(path))\x0d\n    throw new ERR_INVALID_ARG_TYPE('path'\x2C ['string'\x2C 'URL']\x2C path);\x0d\n  if (path.protocol !== 'file:')\x0d\n    throw new ERR_INVALID_URL_SCHEME('file');\x0d\n  return (windows ?? isWindows) ? getPathFromURLWin32(path) : getPathFromURLPosix(path);\x0d\n}\x0d\n\x0d\n// An alternative to fileURLToPath that outputs a Buffer\x0d\n// instead of a string. The other fileURLToPath does not\x0d\n// handle non-UTF8 encoded percent encodings at all\x2C so\x0d\n// converting to a Buffer is necessary in cases where the\x0d\n// to string conversion would fail.\x0d\nfunction fileURLToPathBuffer(path\x2C options = kEmptyObject) {\x0d\n  const windows = options?.windows;\x0d\n  if (typeof path === 'string') {\x0d\n    path = new URL(path);\x0d\n  } else if (!isURL(path)) {\x0d\n    throw new ERR_INVALID_ARG_TYPE('path'\x2C ['string'\x2C 'URL']\x2C path);\x0d\n  }\x0d\n  if (path.protocol !== 'file:') {\x0d\n    throw new ERR_INVALID_URL_SCHEME('file');\x0d\n  }\x0d\n  return (windows ?? isWindows) ? getPathBufferFromURLWin32(path) : getPathBufferFromURLPosix(path);\x0d\n}\x0d\n\x0d\nfunction pathToFileURL(filepath\x2C options = kEmptyObject) {\x0d\n  const windows = options?.windows ?? isWindows;\x0d\n  const isUNC = windows && StringPrototypeStartsWith(filepath\x2C '\\\\\\\\');\x0d\n  let resolved = isUNC ?\x0d\n    filepath :\x0d\n    (windows ? path.win32.resolve(filepath) : path.posix.resolve(filepath));\x0d\n  if (isUNC || (windows && StringPrototypeStartsWith(resolved\x2C '\\\\\\\\'))) {\x0d\n    // UNC path format: \\\\server\\share\\resource\x0d\n    // Handle extended UNC path and standard UNC path\x0d\n    // "\\\\?\\UNC\\" path prefix should be ignored.\x0d\n    // Ref: https://learn.microsoft.com/en-us/windows/win32/fileio/maximum-file-path-limitation\x0d\n    const isExtendedUNC = StringPrototypeStartsWith(resolved\x2C '\\\\\\\\?\\\\UNC\\\\');\x0d\n    const prefixLength = isExtendedUNC ? 8 : 2;\x0d\n    const hostnameEndIndex = StringPrototypeIndexOf(resolved\x2C '\\\\'\x2C prefixLength);\x0d\n    if (hostnameEndIndex === -1) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(\x0d\n        'path'\x2C\x0d\n        resolved\x2C\x0d\n        'Missing UNC resource path'\x2C\x0d\n      );\x0d\n    }\x0d\n    if (hostnameEndIndex === 2) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(\x0d\n        'path'\x2C\x0d\n        resolved\x2C\x0d\n        'Empty UNC servername'\x2C\x0d\n      );\x0d\n    }\x0d\n    const hostname = StringPrototypeSlice(resolved\x2C prefixLength\x2C hostnameEndIndex);\x0d\n    return new URL(StringPrototypeSlice(resolved\x2C hostnameEndIndex)\x2C hostname\x2C kCreateURLFromWindowsPathSymbol);\x0d\n  }\x0d\n  // path.resolve strips trailing slashes so we must add them back\x0d\n  const filePathLast = StringPrototypeCharCodeAt(filepath\x2C\x0d\n                                                 filepath.length - 1);\x0d\n  if ((filePathLast === CHAR_FORWARD_SLASH ||\x0d\n       ((windows ?? isWindows) && filePathLast === CHAR_BACKWARD_SLASH)) &&\x0d\n      resolved[resolved.length - 1] !== path.sep)\x0d\n    resolved += '/';\x0d\n\x0d\n  return new URL(resolved\x2C undefined\x2C windows ? kCreateURLFromWindowsPathSymbol : kCreateURLFromPosixPathSymbol);\x0d\n}\x0d\n\x0d\nfunction toPathIfFileURL(fileURLOrPath) {\x0d\n  if (!isURL(fileURLOrPath))\x0d\n    return fileURLOrPath;\x0d\n  return fileURLToPath(fileURLOrPath);\x0d\n}\x0d\n\x0d\n/**\x0d\n * This util takes a string containing a URL and return the URL origin\x2C\x0d\n * its meant to avoid calls to `new URL` constructor.\x0d\n * @param {string} url\x0d\n * @returns {URL['origin']}\x0d\n */\x0d\nfunction getURLOrigin(url) {\x0d\n  return bindingUrl.getOrigin(url);\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  fileURLToPath\x2C\x0d\n  fileURLToPathBuffer\x2C\x0d\n  pathToFileURL\x2C\x0d\n  toPathIfFileURL\x2C\x0d\n  installObjectURLMethods\x2C\x0d\n  URL\x2C\x0d\n  URLPattern\x2C\x0d\n  URLSearchParams\x2C\x0d\n  URLParse: URL.parse\x2C\x0d\n  domainToASCII\x2C\x0d\n  domainToUnicode\x2C\x0d\n  urlToHttpOptions\x2C\x0d\n  encodeStr\x2C\x0d\n  isURL\x2C\x0d\n\x0d\n  urlUpdateActions: updateActions\x2C\x0d\n  getURLOrigin\x2C\x0d\n  unsafeProtocol\x2C\x0d\n  hostlessProtocol\x2C\x0d\n  slashedProtocol\x2C\x0d\n};\x0d\n
