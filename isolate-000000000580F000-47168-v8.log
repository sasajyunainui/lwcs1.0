uleSource\x2C\x0d\n   *   responseURL?: string\x2C\x0d\n   *   isSourceLoadedSynchronously: boolean\x2C\x0d\n   * }} LoadResult\x0d\n   * @param {string} url The URL of the module to be loaded.\x0d\n   * @param {object} context Metadata about the module\x0d\n   * @returns {Promise<LoadResult> | LoadResult}}\x0d\n   */\x0d\n  load(url\x2C context) {\x0d\n    if (this.isForAsyncLoaderHookWorker) {\x0d\n      // TODO(joyeecheung): invoke the synchronous hooks in the default step on loader thread.\x0d\n      return this.#asyncLoaderHooks.load(url\x2C context);\x0d\n    }\x0d\n    return this.#loadSync(url\x2C context);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * This is the default load step for module.registerHooks()\x2C which incorporates asynchronous hooks\x0d\n   * from module.register() which are run in a blocking fashion for it to be synchronous.\x0d\n   * @param {{isSourceLoadedSynchronously: boolean}} out\x0d\n   *   Output object to track whether the source was loaded synchronously without polluting\x0d\n   *   the user-visible load result.\x0d\n   * @param {string} url See {@link load}\x0d\n   * @param {object} context See {@link load}\x0d\n   * @returns {{ format: ModuleFormat\x2C source: ModuleSource }}\x0d\n   */\x0d\n  #loadAndMaybeBlockOnLoaderThread(out\x2C url\x2C context) {\x0d\n    if (this.#asyncLoaderHooks?.loadSync) {\x0d\n      out.isSourceLoadedSynchronously = false;\x0d\n      return this.#asyncLoaderHooks.loadSync(url\x2C context);\x0d\n    }\x0d\n    out.isSourceLoadedSynchronously = true;\x0d\n    return defaultLoadSync(url\x2C context);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Similar to {@link load} but this is always run synchronously. If there are asynchronous hooks\x0d\n   * from module.register()\x2C this blocks on the loader thread for it to return synchronously.\x0d\n   *\x0d\n   * This is here to support `require()` in imported CJS and `module.registerHooks()` hooks.\x0d\n   * @param {string} url See {@link load}\x0d\n   * @param {object} [context] See {@link load}\x0d\n   * @returns {LoadResult}\x0d\n   */\x0d\n  #loadSync(url\x2C context) {\x0d\n    // Use an output parameter to track the state and avoid polluting the user-visible resolve results.\x0d\n    const out = {\x0d\n      isSourceLoadedSynchronously: true\x2C\x0d\n      __proto__: null\x2C\x0d\n    };\x0d\n    let result;\x0d\n    if (syncLoadHooks.length) {\x0d\n      // Has module.registerHooks() hooks\x2C chain the asynchronous hooks in the default step.\x0d\n      // TODO(joyeecheung): construct the ModuleLoadContext in the loaders directly instead\x0d\n      // of converting them from plain objects in the hooks.\x0d\n      result = loadWithSyncHooks(\x0d\n        url\x2C\x0d\n        context.format\x2C\x0d\n        context.importAttributes\x2C\x0d\n        this.#defaultConditions\x2C\x0d\n        this.#loadAndMaybeBlockOnLoaderThread.bind(this\x2C out)\x2C\x0d\n        validateLoadSloppy\x2C\x0d\n      );\x0d\n    } else {\x0d\n      result = this.#loadAndMaybeBlockOnLoaderThread(out\x2C url\x2C context);\x0d\n    }\x0d\n    result.isSourceLoadedSynchronously = out.isSourceLoadedSynchronously;\x0d\n    return result;\x0d\n  }\x0d\n\x0d\n  validateLoadResult(url\x2C format) {\x0d\n    if (format == null) {\x0d\n      throwUnknownModuleFormat(url\x2C format);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  importMetaInitialize(meta\x2C context) {\x0d\n    if (this.#asyncLoaderHooks) {\x0d\n      return this.#asyncLoaderHooks.importMetaInitialize(meta\x2C context\x2C this);\x0d\n    }\x0d\n    importMetaInitializer ??= require('internal/modules/esm/initialize_import_meta').initializeImportMeta;\x0d\n    meta = importMetaInitializer(meta\x2C context\x2C this);\x0d\n    return meta;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Block until the async loader hooks have been initialized.\x0d\n   *\x0d\n   * No-op when no hooks have been supplied.\x0d\n   */\x0d\n  waitForAsyncLoaderHookInitialization() {\x0d\n    this.#asyncLoaderHooks?.waitForLoaderHookInitialization();\x0d\n  }\x0d\n}\x0d\nObjectSetPrototypeOf(ModuleLoader.prototype\x2C null);\x0d\n\x0d\nlet emittedLoaderFlagWarning = false;\x0d\n/**\x0d\n * A loader instance is used as the main entry point for loading ES modules. Currently\x2C this is a singleton; there is\x0d\n * only one used for loading the main module and everything in its dependency graph\x2C though separate instances of this\x0d\n * class might be instantiated as part of bootstrap for other purposes.\x0d\n * @param {AsyncLoaderHooksOnLoaderHookWorker|undefined} [asyncLoaderHooks]\x0d\n *   Only provided when run on the loader hook thread.\x0d\n * @returns {ModuleLoader}\x0d\n */\x0d\nfunction createModuleLoader(asyncLoaderHooks) {\x0d\n  // Don't spawn a new loader hook worker if we are already in a loader hook worker to avoid infinite recursion.\x0d\n  if (shouldSpawnLoaderHookWorker()) {\x0d\n    assert(asyncLoaderHooks === undefined\x2C 'asyncLoaderHooks should only be provided on the loader hook thread itself');\x0d\n    const userLoaderPaths = getOptionValue('--experimental-loader');\x0d\n    if (userLoaderPaths.length > 0) {\x0d\n      if (!emittedLoaderFlagWarning) {\x0d\n        const readableURIEncode = (string) => ArrayPrototypeReduce(\x0d\n          [\x0d\n            [/'/g\x2C '%27']\x2C // We need to URL-encode the single quote as it's the delimiter for the --import flag.\x0d\n            [/%22/g\x2C '"']\x2C // We can decode the double quotes to improve readability.\x0d\n            [/%2F/ig\x2C '/']\x2C // We can decode the slashes to improve readability.\x0d\n          ]\x2C\x0d\n          (str\x2C { 0: regex\x2C 1: replacement }) => RegExpPrototypeSymbolReplace(hardenRegExp(regex)\x2C str\x2C replacement)\x2C\x0d\n          encodeURIComponent(string));\x0d\n        process.emitWarning(\x0d\n          '`--experimental-loader` may be removed in the future; instead use `register()`:\\n' +\x0d\n          `--import 'data:text/javascript\x2Cimport { register } from "node:module"; import { pathToFileURL } from "node:url"; ${ArrayPrototypeJoin(\x0d\n            ArrayPrototypeMap(userLoaderPaths\x2C (loader) => `register(${readableURIEncode(JSONStringify(loader))}\x2C pathToFileURL("./"))`)\x2C\x0d\n            '; '\x2C\x0d\n          )};'`\x2C\x0d\n          'ExperimentalWarning'\x2C\x0d\n        );\x0d\n        emittedLoaderFlagWarning = true;\x0d\n      }\x0d\n      const { AsyncLoaderHooksProxiedToLoaderHookWorker } = require('internal/modules/esm/hooks');\x0d\n      asyncLoaderHooks = new AsyncLoaderHooksProxiedToLoaderHookWorker();\x0d\n    }\x0d\n  }\x0d\n\x0d\n  return new ModuleLoader(asyncLoaderHooks);\x0d\n}\x0d\n\x0d\nlet cascadedLoader;\x0d\n\x0d\n/**\x0d\n * This is a singleton ESM loader that integrates the loader hooks\x2C if any.\x0d\n * It it used by other internal built-ins when they need to load user-land ESM code\x0d\n * while also respecting hooks.\x0d\n * When built-ins need access to this loader\x2C they should do\x0d\n * require('internal/module/esm/loader').getOrInitializeCascadedLoader()\x0d\n * lazily only right before the loader is actually needed\x2C and don't do it\x0d\n * in the top-level\x2C to avoid circular dependencies.\x0d\n * @param {AsyncLoaderHooksOnLoaderHookWorker|undefined} [asyncLoaderHooks]\x0d\n *   Only provided when run on the loader hook thread.\x0d\n * @returns {ModuleLoader}\x0d\n */\x0d\nfunction getOrInitializeCascadedLoader(asyncLoaderHooks) {\x0d\n  cascadedLoader ??= createModuleLoader(asyncLoaderHooks);\x0d\n  return cascadedLoader;\x0d\n}\x0d\n\x0d\nfunction isCascadedLoaderInitialized() {\x0d\n  return cascadedLoader !== undefined;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Register a single loader programmatically.\x0d\n * @param {string|URL} specifier\x0d\n * @param {string|URL} [parentURL] Base to use when resolving `specifier`; optional if\x0d\n *   `specifier` is absolute. Same as `options.parentUrl`\x2C just inline\x0d\n * @param {object} [options] Additional options to apply\x2C described below.\x0d\n * @param {string|URL} [options.parentURL] Base to use when resolving `specifier`\x0d\n * @param {any} [options.data] Arbitrary data passed to the loader's `initialize` hook\x0d\n * @param {any[]} [options.transferList] Objects in `data` that are changing ownership\x0d\n * @returns {void} We want to reserve the return value for potential future extension of the API.\x0d\n * @example\x0d\n * ```js\x0d\n * register('./myLoader.js');\x0d\n * register('ts-node/esm'\x2C { parentURL: import.meta.url });\x0d\n * register('./myLoader.js'\x2C { parentURL: import.meta.url });\x0d\n * register('ts-node/esm'\x2C import.meta.url);\x0d\n * register('./myLoader.js'\x2C import.meta.url);\x0d\n * register(new URL('./myLoader.js'\x2C import.meta.url));\x0d\n * register('./myLoader.js'\x2C {\x0d\n *   parentURL: import.meta.url\x2C\x0d\n *   data: { banana: 'tasty' }\x2C\x0d\n * });\x0d\n * register('./myLoader.js'\x2C {\x0d\n *   parentURL: import.meta.url\x2C\x0d\n *   data: someArrayBuffer\x2C\x0d\n *   transferList: [someArrayBuffer]\x2C\x0d\n * });\x0d\n * ```\x0d\n */\x0d\nfunction register(specifier\x2C parentURL = undefined\x2C options) {\x0d\n  if (parentURL != null && typeof parentURL === 'object' && !isURL(parentURL)) {\x0d\n    options = parentURL;\x0d\n    parentURL = options.parentURL;\x0d\n  }\x0d\n  getOrInitializeCascadedLoader().register(\x0d\n    specifier\x2C\x0d\n    parentURL ?? 'data:'\x2C\x0d\n    options?.data\x2C\x0d\n    options?.transferList\x2C\x0d\n  );\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  createModuleLoader\x2C\x0d\n  getOrInitializeCascadedLoader\x2C\x0d\n  isCascadedLoaderInitialized\x2C\x0d\n  register\x2C\x0d\n};\x0d\n
