   '\u89d2\u8272.\u83ab\u6893\u9e3f.\u5feb\u7167.0.\u89d2\u8272.\u6b66\u9b42\u878d\u5408\u6280.\u660a\u65e5\u5929\u7434.\u6280\u80fd\u6570\u636e': {\n      \u9b42\u6280\u540d: '\u660a\u65e5\u5929\u7434'\x2C\n      \u753b\u9762\u63cf\u8ff0: '\u9b54\u7434\u5316\u4f5c\u4e03\u9053\u5149\u4e1d\u6258\u8d77\u660a\u65e5\uff0c\u91d1\u7ea2\u5149\u7130\u6cbf\u7434\u5f26\u7206\u5f00\uff0c\u5f62\u6210\u8986\u76d6\u6218\u573a\u7684\u97f3\u5149\u51b2\u51fb\u3002'\x2C\n      \u6548\u679c\u63cf\u8ff0: '\u83ab\u6893\u9e3f\u4e0e\u6556\u9510\u7684\u6b66\u9b42\u878d\u5408\u6280\uff0c\u4ee5\u9b54\u7434\u7275\u5f15\u660a\u65e5\u8fdc\u7a0b\u7206\u53d1\uff0c\u9020\u6210\u8303\u56f4\u4f24\u5bb3\u5e76\u524a\u5f31\u76ee\u6807\u884c\u52a8\u8282\u594f\u3002\u5b9e\u9645\u6548\u679c\uff1a\u7fa4\u4f535000%\u8fdc\u7a0b\u653b\u51fb\uff0c\u9632\u7a7f28\uff0c\u7fa4\u4f53[\u6807\u8bb0]\u6301\u7eed2\u56de\u5408(\u5f3a\u5ea6-100%)\u3002\u6d88\u8017\uff1a\u9b42\u529b:80% | \u7cbe\u795e\u529b:50%\u3002'\x2C\n      \u6d88\u8017: '\u9b42\u529b:80% | \u7cbe\u795e\u529b:50%'\x2C\n      \u524d\u6447: 25\x2C\n      _\u6548\u679c\u6570\u7ec4: [\n        {\n          \u539f\u578b: '\u4f24\u5bb3\u7ed3\u7b97'\x2C\n          \u76ee\u6807: '\u7fa4\u4f53'\x2C\n          \u751f\u6548\u65b9\u5f0f: '\u72ec\u7acb\u751f\u6548'\x2C\n          \u5a01\u529b\u500d\u7387: 5000\x2C\n          \u4f24\u5bb3\u7c7b\u578b: '\u8fdc\u7a0b\u653b\u51fb'\x2C\n          \u9632\u5fa1\u7a7f\u900f: 28\x2C\n          \u653b\u51fb\u6bb5\u6570: 1\x2C\n          \u7ed3\u7b97\u6807\u7b7e: '\u6807\u51c6\u4f24\u5bb3'\x2C\n          \u6297\u6027\u7c7b\u578b: '\u5143\u7d20\u6297\u6027'\x2C\n        }\x2C\n        {\n          \u539f\u578b: '\u72b6\u6001\u65bd\u52a0'\x2C\n          \u76ee\u6807: '\u7fa4\u4f53'\x2C\n          \u6301\u7eed\u56de\u5408: 2\x2C\n          \u751f\u6548\u65b9\u5f0f: '\u8ddf\u968f\u4e3b\u539f\u578b'\x2C\n          \u72b6\u6001: '\u6807\u8bb0'\x2C\n          \u89e6\u53d1\u65b9\u5f0f: '\u7acb\u5373\u89e6\u53d1'\x2C\n          \u65