  let main = '\u7279\u6b8a\u89c4\u5219\u7c7b';\n  let subModel = '\u53ec\u5524';\n  if (roll > 60) {\n    main = '\u589e\u76ca\u7c7b';\n    const \u5019\u9009 = \u9009\u62e9\u5408\u6cd5\u53ec\u5524\u539f\u578b(['\u6280\u80fd\u6548\u679c\u589e\u5e45'\x2C '\u6d88\u8017'\x2C '\u524d\u6447']);\n    subModel = pickRandom(\u5019\u9009) || \u5019\u9009[0] || '\u6280\u80fd\u6548\u679c\u589e\u5e45';\n  } else if (\u6392\u9664\u539f\u578b.has('\u53ec\u5524') || !\u81ea\u52a8\u751f\u6210\u673a\u5236\u6ee1\u8db3\u9884\u7b97\u8303\u56f4_V1('\u53ec\u5524'\x2C \u53ec\u5524\u4e0a\u4e0b\u6587)) {\n    const \u5019\u9009 = \u9009\u62e9\u5408\u6cd5\u53ec\u5524\u539f\u578b(['\u6280\u80fd\u6548\u679c\u589e\u5e45'\x2C '\u6d88\u8017'\x2C '\u524d\u6447']);\n    main = '\u589e\u76ca\u7c7b';\n    subModel = pickRandom(\u5019\u9009) || \u5019\u9009[0] || '\u6280\u80fd\u6548\u679c\u589e\u5e45';\n  }\n  const \u9884\u7b97\u95e8\u7981 = \u8bfb\u53d6\u81ea\u52a8\u751f\u6210\u5f53\u524d\u6700\u9ad8\u627f\u8f7dCOST_V1(\u53ec\u5524\u4e0a\u4e0b\u6587);\n  const \u4e3b\u673a\u5236\u76ee\u6807 = \u751f\u6210\u6280\u80fd\u673a\u5236\u6b63\u5f0f\u76ee\u6807_V1(subModel\x2C {\n    ...\u53ec\u5524\u4e0a\u4e0b\u6587\x2C\n    \u4e3b\u673a\u5236\u5927\u7c7b: main\x2C\n    \u91ca\u653e\u5f62\u6001: '\u76f4\u63a5\u751f\u6548'\x2C\n  });\n  const \u4e3b\u673a\u5236\u6700\u4f4eCOST = Number(\u4f30\u7b97\u53ec\u5524\u673a\u5236\u8303\u56f4(subModel\x2C main\x2C \u9884\u7b97\u95e8\u7981)?.\u6700\u4f4e\u53ef\u8fbeCOST ?? Infinity);\n  let \u5269\u4f59\u9884\u7b97 = \u9884\u7b97\u95e8\u7981 > 0 && Number.isFinite(\u4e3b\u673a\u5236\u6700\u4f4eCOST)\n    ? Math.max(0\x2C \u9884\u7b97\u95e8\u7981 - \u4e3b\u673a\u5236\u6700\u4f4eCOST)\n    : Infinity;\n  const secondary = [];\n  \u89c4\u8303\u5316\u673a\u5236\u679a\u4e3e\u6570\u7ec4_V1([\n    ...preferredSecondary\x2C\n    ...(subModel === '\u53ec\u5524' ? ['\u5171\u4eab\u89c6\u91ce'] : ['\u62a4\u536b'])\x2C\n  ]).filter(\u673a\u5236 =>\n    !\u6392\u9664\u539f\u578b.has(String(\u673a\u5236 || '').trim()) &&\n    \u6280\u80fd\u673a\u5236\u6ee1\u8db3\u54c1\u8d28\u95e8\u69db_V1(\u673a\u5236\x2C { ...options\x2C type: '\u53ec\u5524\u7cfb'\x2C grade: safeGrade }) &&\n    SKILL_MECHANISM_META_V1[\u673a\u5236]?.\u53ef\u526f\u673a\u5236 === true &&\n    \u673a\u5236\u5177\u5907\u5171\u4eab\u539f\u578b\u7f16\u8bd1_V1(\u673a\u5236)\x2C\n  ).forEach(\u673a\u5236 => {\n    if (secondary.includes(\u673a\u5236)) return;\n    const \u526f\u673a\u5236\u76ee\u6807 = \u751f\u6210\u6280\u80fd\u673a\u5236\u6b63\u5f0f\u76ee\u6807_V1(\u673a\u5236\x2C {\n      ...\u53ec\u5524\u4e0a\u4e0b\u6587\x2C\n      \u4e3b\u673a\u5236\u5927\u7c7b: findMainMechanicGroupByArchetype(\u673a\u5236)\x2C\n      \u91ca\u653e\u5f62\u6001: '\u76f4\u63a5\u751f\u6548'\x2C\n    });\n    const \u526f\u673a\u5236\u6700\u4f4eCOST = Number(\u4f30\u7b97\u53ec\u5524\u673a\u5236\u8303\u56f4(\u673a\u5236\x2C findMainMechanicGroupByArchetype(\u673a\u5236)\x2C Number.isFinite(\u5269\u4f59\u9884\u7b97) ? \u5269\u4f59\u9884\u7b97 : \u9884\u7b97\u95e8\u7981)?.\u6700\u4f4e\u53ef\u8fbeCOST ?? Infinity);\n    if (Number.isFinite(\u5269\u4f59\u9884\u7b97) && (!Number.isFinite(\u526f\u673a\u5236\u6700\u4f4eCOST) || \u526f\u673a\u5236\u6700\u4f4eCOST > \u5269\u4f59\u9884\u7b97 + \u6280\u80fd\u9884\u7b97COST\u5bb9\u5dee_V1)) return;\n    secondary.push(\u673a\u5236);\n    if (Number.isFinite(\u5269\u4f59\u9884\u7b97)) \u5269\u4f59\u9884\u7b97 = Math.max(0\x2C \u5269\u4f59\u9884\u7b97 - Math.max(0\x2C \u526f\u673a\u5236\u6700\u4f4eCOST));\n  });\n  return {\n    \u7cfb\u522b\u6765\u6e90: '\u53ec\u5524\u7cfb'\x2C\n    \u4e3b\u673a\u5236\u5927\u7c7b: main\x2C\n    \u4e3b\u673a\u5236\u539f\u578b: subModel\x2C\n    \u526f\u673a\u5236: secondary.slice(0\x2C 2)\x2C\n    \u91ca\u653e\u5f62\u6001: '\u76f4\u63a5\u751f\u6548'\x2C\n    \u76ee\u6807: \u4e3b\u673a\u5236\u76ee\u6807\x2C\n    \u52a0\u6210\u5c5e\u6027\u5019\u9009: ['\u7cbe\u795e\u529b'\x2C '\u9b42\u529b']\x2C\n    \u71c3\u6599\u6a21\u578b: buildF