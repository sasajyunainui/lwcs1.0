0d\n\x0d\n// CryptoJob constructors can synchronously throw while running their native\x0d\n// AdditionalConfig hook. WebCrypto needs those operation-specific setup\x0d\n// failures to reject with an OperationError.\x0d\nfunction jobPromise(getJob) {\x0d\n  try {\x0d\n    return getJob().run();\x0d\n  } catch (err) {\x0d\n    return PromiseReject(lazyDOMException(\x0d\n      'The operation failed for an operation-specific reason'\x2C\x0d\n      { name: 'OperationError'\x2C cause: err }));\x0d\n  }\x0d\n}\x0d\n\x0d\n// Temporarily shadow inherited then accessors on WebCrypto result objects.\x0d\n// Promise resolution reads "then" synchronously for thenable assimilation.\x0d\n// Returning an own undefined data property keeps that lookup from reaching\x0d\n// user-mutated prototypes.\x0d\nfunction prepareWebCryptoResult(value) {\x0d\n  if ((value === null || typeof value !== 'object') &&\x0d\n      typeof value !== 'function') {\x0d\n    return false;\x0d\n  }\x0d\n  if (isPromise(value) || ObjectPrototypeHasOwnProperty(value\x2C 'then'))\x0d\n    return false;\x0d\n  setOwnProperty(value\x2C 'then'\x2C undefined);\x0d\n  return true;\x0d\n}\x0d\n\x0d\n// Remove the temporary then property installed by prepareWebCryptoResult().\x0d\nfunction cleanupWebCryptoResult(value) {\x0d\n  delete value.then;\x0d\n}\x0d\n\x0d\n// Resolve a WebCrypto promise while inherited then accessors are shadowed.\x0d\nfunction resolveWebCryptoResult(resolve\x2C value) {\x0d\n  const shouldCleanupResult = prepareWebCryptoResult(value);\x0d\n  try {\x0d\n    resolve(value);\x0d\n  } finally {\x0d\n    if (shouldCleanupResult)\x0d\n      cleanupWebCryptoResult(value);\x0d\n  }\x0d\n}\x0d\n\x0d\n// Run a WebCrypto promise reaction and settle the outer promise.\x0d\nfunction settleJobPromise(handler\x2C resolve\x2C reject\x2C value\x2C isRejected) {\x0d\n  try {\x0d\n    if (typeof handler === 'function') {\x0d\n      resolveWebCryptoResult(resolve\x2C handler(value));\x0d\n    } else if (isRejec