\u7a7a\u88ab\u5979\u5316\u4f5c\u591c\u5e55\uff0c\u4e00\u767e\u96f6\u516b\u9897\u661f\u8fb0\u5728\u9886\u57df\u4e2d\u4eae\u8d77\uff0c\u6240\u6709\u661f\u76f8\u529b\u91cf\u90fd\u968f\u5979\u610f\u5fd7\u5782\u843d\u6218\u573a\u3002'\x2C\n        '\u9886\u57df\u6210\u578b\u540e\u6301\u7eed\u653e\u5927\u5979\u5168\u90e8\u661f\u76f8\u7c7b\u6280\u80fd\u7684\u8986\u76d6\u3001\u9891\u7387\u4e0e\u7a33\u5b9a\u6027\uff0c\u4e5f\u662f\u661f\u706d\u795e\u5149\u8fde\u7eed\u53d1\u52a8\u7684\u6839\u57fa\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u7cbe\u795e\u529b\u4e0a\u9650+28%\u6301\u7eed4\u56de\u5408\uff0c\u7fa4\u4f53\u53cd\u5e94-12%\u6301\u7eed4\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b:25% \u7ef4\u6301:\u9b42\u529b:8%\u3002'\x2C\n      )\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u6597\u8f6c\u661f\u79fb'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u6597\u8f6c\u661f\u79fb'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u8bb8\u5c0f\u8a00_\u6597\u8f6c\u661f\u79fb'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 8\x2C\n        \u9644\u5e26\u5c5e\u6027: ['\u5149'\x2C '\u7a7a\u95f4']\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u9886\u57df\u63a7\u5236'\x2C\n        \u72b6\u6001: '\u8f68\u8ff9\u9519\u4f4d'\x2C\n        \u7ed3\u7b97: '\u7a7a\u95f4\u4f4d\u79fb'\x2C\n        \u524d\u6447: 24\x2C\n        \u6d88\u8017\u500d\u7387: 1.1\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u6597\u8f6c\u661f\u79fb']\x2C\n        \u753b\u9762\u63cf\u8ff0: '\u661f\u5149\u9886\u57df\u626d\u8f6c\u94fa\u5f00\u540e\uff0c\u6765\u88ad\u8fdc\u7a0b\u653b\u52bf\u3001\u98de\u5c04\u7269\u4f53\u4e43\u81f3\u540c\u4f34\u4e0e\u654c\u4eba\u7684\u4f4d\u7f6e\u90fd\u80fd\u5728\u5979\u6307\u5f15\u4e0b\u77ac\u95f4\u9519\u4f4d\u6539\u9053\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u4e09\u5b57\u6597\u94e0\u9886\u57df\uff0c\u53ef\u8f6c\u79fb\u80fd\u91cf\u3001\u7269\u4f53\u4e0e\u4eba\u7269\u4f4d\u7f6e\uff0c\u5e76\u4e0e\u661f\u5149\u7480\u74a8\u8054\u52a8\uff0c\u628a\u63a7\u573a\u4e0e\u6218\u573a\u8c03\u5ea6\u80fd\u529b\u63d0\u5347\u5230\u6781\u5f3a\u5c42\u7ea7\u3002\u5b9e\u9645\u6548\u679c\uff1a\u7fa4\u4f53[\u8f68\u8ff9\u9519\u4f4d]\u6301\u7eed3\u56de\u5408(\u5f3a\u5ea6-18%)\uff0c\u7fa4\u4f53\u53cd\u5e94-20%\u6301\u7eed3\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b25300\uff0c\u7cbe\u795e\u529b6072\u3002'\x2C\n      })\x2C\n    ])\x2C\n    \u4e50\u6b63\u5b87: \u89d2\u8272\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879('\u4e50\u6b63\u5b87'\x2C [\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u5929\u4f7f\u964d\u4e34'\x2C\n        '\u9b42\u73af\u9b42\u6280'\x2C\n        '\u7b2c1\u6b66\u9b42.\u7b2c4\u9b42\u73af.\u7b2c4\u9b42\u6280'\x2C\n        'ch0517_01'\x2C\n        390329\x2C\n        ['\u5929\u4f7f\u964d\u4e34'\x2C '\u5149\u6697\u5723\u5251'\x2C '\u7b2c\u56db\u9b42\u6280'\x2C '\u7b2c4\u9b42\u6280']\x2C\n        4\x2C\n        '\u7b2c\u56db\u9b42\u73af\u4eae\u8d77\u65f6\uff0c\u80cc\u540e\u5de8\u5927\u5929\u4f7f\u5149\u5f71\u663e\u73b0\uff0c\u795e\u5723\u5149\u660e\u4e4b\u529b\u9ad8\u901f\u5411\u5168\u8eab\u4e0e\u5723\u5251\u6c47\u805a\u3002'\x2C\n        '\u4ee5\u5929\u4f7f\u964d\u4e34\u5f62\u6001\u5927\u5e45\u5f3a\u5316\u81ea\u8eab\u795e\u5723\u6c14\u606f\u3001\u7206\u53d1\u4e0e\u5723\u5251\u5a01\u80fd\uff0c\u662f\u540e\u7eed\u9ad8\u5f3a\u5ea6\u5ba1\u5224\u8fde\u62db\u7684\u6838\u5fc3\u589e\u5e45\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u529b\u91cf+18%\u6301\u7eed3\u56de\u5408\uff0c\u81ea\u8eab\u9020\u6210\u4f24\u5bb3+16%(\u9650\u5b9a\u5149)\u6301\u7eed3\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b2000\u3002'\x2C\n      )\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u5ba1\u5224\u4e4b\u5149'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u9b42\u73af\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u7b2c1\u6b66\u9b42.\u7b2c3\u9b42\u73af.\u7b2c3\u9b42\u6280'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u4e50\u6b63\u5b87_\u5ba1\u5224\u4e4b\u5149'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 3\x2C\n        \u9644\u5e26\u5c5e\u6027: ['\u5149']\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u653b\u6740'\x2C\n        \u4f24\u5bb3\u7c7b\u578b: '\u771f\u5b9e\u653b\u51fb'\x2C\n        \u76ee\u6807: '\u5355\u4f53'\x2C\n        \u5a01\u529b\u500d\u7387: 118\x2C\n        \u9632\u5fa1\u7a7f\u900f: 12\x2C\n        \u524d\u6447: 26\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u5ba1\u5224\u4e4b\u5149']\x2C\n        \u753b\u9762\u63cf\u8ff0:\n          '\u4e00\u9053\u5a01\u4e25\u795e\u5723\u7684\u5de8\u5927\u5149\u67f1\u4f1a\u5728\u9501\u5b9a\u76ee\u6807\u540e\u81ea\u5929\u800c\u964d\uff0c\u5728\u795e\u5723\u5929\u4f7f\u771f\u8eab\u589e\u5e45\u4e0b\u751a\u81f3\u80fd\u628a\u76ee\u6807\u8fde\u540c\u5468\u56f4\u7a7a\u95f4\u4e00\u8d77\u538b\u6210\u7eaf\u91d1\u8272\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0: '\u795e\u5723\u5929\u4f7f\u4e00\u8109\u6700\u6838\u5fc3\u7684\u7b2c\u4e09\u9b42\u6280\uff0c\u4ee5\u9ad8\u6d53\u5ea6\u795e\u5723\u6253\u51fb\u5b8c\u6210\u9547\u538b\u3001\u51c0\u5316\u4e0e\u91cd\u521b\uff0c\u5bf9\u90aa\u6076\u5c5e\u6027\u76ee\u6807\u5c24\u4e3a\u81f4\u547d\u3002\u5b9e\u9645\u6548\u679c\uff1a\u5355\u4f53118%\u771f\u5b9e\u653b\u51fb\uff0c\u9632\u7a7f12\uff0c\u5355\u4f53[\u538b\u5236]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-10%)\u3002\u6d88\u8017\uff1a\u9b42\u529b1700\u3002'\x2C\n      })\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u5149\u6697\u5723\u5251'\x2C\n        '\u81ea\u521b\u9b42\u6280'\x2C\n        '\u81ea\u521b\u9b42\u6280.\u5149\u6697\u5723\u5251'\x2C\n        'ch0520_02'\x2C\n        390324\x2C\n        ['\u5149\u6697\u5723\u5251']\x2C\n        4\x2C\n        '\u795e\u5723\u5723\u5251\u4e0e\u6697\u9ed1\u9b54\u5251\u5728\u6781\u5ea6\u538b\u7f29\u540e\u6b63\u9762\u78b0\u649e\uff0c\u5149\u660e\u4e0e\u9ed1\u6697\u4e24\u79cd\u529b\u91cf\u77ac\u95f4\u5f15\u7206\uff0c\u5f62\u6210\u5267\u70c8\u7684\u5927\u7206\u70b8\u3002'\x2C\n        '\u4e50\u6b63\u5b87\u4e0e\u539f\u6069\u591c\u8f89\u5171\u540c\u7814\u7a76\u51fa\u7684\u7ec4\u5408\u6218\u6cd5\uff0c\u501f\u5149\u660e\u548c\u9ed1\u6697\u76f8\u4e92\u6392\u65a5\u7684\u7206\u53d1\u529b\u6253\u51fa\u8fdc\u8d85\u4e24\u4eba\u666e\u901a\u5408\u51fb\u7684\u7834\u574f\u3002\u5b9e\u9645\u6548\u679c\uff1a\u7fa4\u4f5388%\u8fdc\u7a0b\u653b\u51fb\uff0c\u9632\u7a7f12\uff0c\u7fa4\u4f53[\u5149\u6697\u9707\u8361]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-12%)\u3002\u6d88\u8017\uff1a\u9b42\u529b2600\uff0c\u7cbe\u795e\u529b800\u3002'\x2C\n      )\x2C\n      \u6210\u957f\u6280\u80fd\u6a21\u677f\u9879(\n        '\u5927\u5929\u4f7f\u4e4b\u6012 / \u5929\u4f7f\u4e4b\u6012'\x2C\n        '\u9b42\u73af\u9b42\u6280'\x2C\n        '\u7b2c1\u6b66\u9b42.\u7b2c5\u9b42\u73af.\u7b2c5\u9b42\u6280'\x2C\n        'ch0796_02'\x2C\n        657489\x2C\n        ['\u5927\u5929\u4f7f\u4e4b\u6012'\x2C '\u5929\u4f7f\u4e4b\u6012']\x2C\n        5\x2C\n        '\u6700\u7eaf\u7cb9\u7684\u795e\u5723\u5149\u660e\u4e4b\u529b\u88ab\u4ed6\u5f7b\u5e95\u5f15\u7206\uff0c\u70bd\u70c8\u5723\u5149\u5982\u5929\u4f7f\u66b4\u6012\u822c\u4ece\u9ad8\u7a7a\u704c\u843d\uff0c\u6240\u8fc7\u4e4b\u5904\u8fde\u9ed1\u6697\u4e0e\u90aa\u6c14\u90fd\u4f1a\u88ab\u711a\u51c0\u3002'\x2C\n        '\u9ad8\u5f3a\u5ea6\u8303\u56f4\u5723\u5149\u7206\u53d1\uff0c\u5bf9\u9ed1\u6697\u4e0e\u90aa\u9b42\u7c7b\u76ee\u6807\u538b\u5236\u6781\u5f3a\uff0c\u662f\u4ed6\u4e2d\u540e\u671f\u6700\u5177\u4ee3\u8868\u6027\u7684\u795e\u5723\u91cd\u51fb\u3002\u5b9e\u9645\u6548\u679c\uff1a\u7fa4\u4f5376%\u771f\u5b9e\u653b\u51fb\uff0c\u7fa4\u4f53[\u795e\u5723\u707c\u70e7]\u6301\u7eed2\u56de\u5408(\u5f3a\u5ea6-10%)\u3002\u6d88\u8017\uff1a\u9b42\u529b4200\uff0c\u7cbe\u795e\u529b900\u3002'\x2C\n      )\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u795e\u5723\u4e4b\u5149'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u795e\u5723\u4e4b\u5149'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u4e50\u6b63\u5b87_\u795e\u5723\u4e4b\u5149'\x2C\n        \u9700\u6c42\u9b42\u73af\u6570: 5\x2C\n        \u9644\u5e26\u5c5e\u6027: ['\u5149']\x2C\n        \u6548\u679c\u6a21\u5f0f: '\u9886\u57df\u589e\u5e45'\x2C\n        \u76ee\u6807: '\u81ea\u8eab'\x2C\n        \u5c5e\u6027: ['\u529b\u91cf'\x2C '\u9632\u5fa1']\x2C\n        \u7ed3\u7b97: '\u9020\u6210\u4f24\u5bb3'\x2C\n        \u524d\u6447: 18\x2C\n        \u89e6\u53d1\u5173\u952e\u8bcd: ['\u795e\u5723\u4e4b\u5149']\x2C\n        \u753b\u9762\u63cf\u8ff0:\n          '\u4e00\u9053\u91d1\u8272\u795e\u5723\u5149\u8292\u4f1a\u4ece\u5929\u800c\u964d\u6216\u76f4\u63a5\u9644\u7740\u5728\u81ea\u8eab\u4e0e\u5723\u5251\u4e4b\u4e0a\uff0c\u6d53\u70c8\u5149\u5143\u7d20\u4e0e\u795e\u5723\u6c14\u606f\u4f1a\u5728\u77ac\u95f4\u628a\u5468\u56f4\u7a7a\u95f4\u90fd\u6620\u6210\u7eaf\u91d1\u8272\u3002'\x2C\n        \u6548\u679c\u63cf\u8ff0:\n          '\u653b\u9632\u517c\u5177\u7684\u9ad8\u5f3a\u5ea6\u795e\u5723\u589e\u5e45\u4e0e\u538b\u5236\u80fd\u529b\uff0c\u53ef\u5916\u653e\u9547\u538b\u76ee\u6807\uff0c\u4e5f\u53ef\u52a0\u6301\u81ea\u8eab\u3001\u5723\u5251\u4e0e\u9632\u5fa1\uff0c\u662f\u4ed6\u591a\u79cd\u9ad8\u9636\u8fde\u62db\u7684\u6838\u5fc3\u5e95\u76d8\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u529b\u91cf\u3001\u9632\u5fa1+18%\u6301\u7eed4\u56de\u5408\uff0c\u81ea\u8eab\u9020\u6210\u4f24\u5bb3+20%(\u9650\u5b9a\u5149)\u6301\u7eed3\u56de\u5408\u3002\u6d88\u8017\uff1a\u9b42\u529b7200\uff0c\u7cbe\u795e\u529b1728\u3002'\x2C\n      })\x2C\n      \u8865\u5145\u6210\u957f\u6280\u80fd\u6a21\u677f\u9879({\n        \u9b42\u6280\u540d: '\u5723\u5149\u77ac\u53d1'\x2C\n        \u5199\u5165\u7c7b\u578b: '\u81ea\u521b\u9b42\u6280'\x2C\n        \u5199\u5165\u8def\u5f84: '\u81ea\u521b\u9b42\u6280.\u5723\u5149\u77ac\u53d1'\x2C\n        \u89e6\u53d1\u4e8b\u4ef6\u6807\u8bc6: 'growth_\u4e50\u6b63\u5b87_\u5723\u5149\u77