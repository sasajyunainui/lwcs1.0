7\u4e3a\u5de8\u7434\uff0c\u7434\u5f26\u81ea\u884c\u9e23\u52a8\u5e76\u5411\u56db\u9762\u516b\u65b9\u91ca\u653e\u97f3\u6ce2\u3002'\x2C\n      \u6548\u679c\u63cf\u8ff0: '\u8fdb\u5165\u6b66\u9b42\u771f\u8eab\u540e\u5168\u9762\u5f3a\u5316\u97f3\u6ce2\u653b\u9632\u4e0e\u63a7\u5236\u8303\u56f4\uff0c\u53ef\u501f\u771f\u8eab\u786c\u64bc\u7fa4\u4f53\u51b2\u51fb\u3002\u5b9e\u9645\u6548\u679c\uff1a\u81ea\u8eab\u7cbe\u795e\u529b\u4e0a\u9650+164.3%\u6301\u7eed3\u56de\u5408\uff0c\u7fa4\u4f53[\u7cbe\u795e\u7d0a\u4e71]\u6301\u7eed1\u56de\u5408(\u5f3a\u5ea6-70.42%)\u3002\u6d88\u8017\uff1a\u9b42\u529b:25% \u7ef4\u6301:\u9b42\u529b:8%\u3002'\x2C\n      \u627f\u8f7d\u65b9\u5f0f: '\u76f4\u63a5\u751f\u6548'\x2C\n      \u9644\u5e26\u5c5e\u6027: ['\u7cbe\u795e']\x2C\n      \u6d88\u8017: '\u9b42\u529b:25% \u7ef4\u6301:\u9b42\u529b:8%'\x2C\n      \u524d\u6447: 25\x2C\n      _\u6548\u679c\u6570\u7ec4: [\n        {\n          \u539f\u578b: '\u5c5e\u6027\u4fee\u6b63'\x2C\n          \u76ee\u6807: '\u81ea\u8eab'\x2C\n          \u6301\u7eed\u56de\u5408: 3\x2C\n          \u751f\u6548\u65b9\u5f0f: '\u72ec\u7acb\u751f\u6548'\x2C\n          \u5c5e\u6027: '\u7cbe\u795e\u529b\u4e0a\u9650'\x2C\n          \u6570\u503c: '+164.3%'\x2C\n        }\x2C\n        {\n          \u539f\u578b: '\u72b6\u6001\u65bd\u52a0'\x2C\n          \u76ee\u6807: '\u7fa4\u4f53'\x2C\n          \u6301\u7eed\u56de\u5408: 1\x2C\n          \u751f\u6548\u65b9\u5f0f: '\u72ec\u7acb\u751f\u6548'\x2C\n          \u72b6\u6001: '\u7cbe\u795e\u7d0a\u4e71'\x2C\n          \u89e6\u53d1\u65b9\u5f0f: '\u7acb\u5373\u89e6\u53d1'\x2C\n          \u6570\u503c: '-70.42%'\x2C\n          \u526f\u6570\u503c: '-46.94%'\x2C\n          \u9a71\u52a8\u5c5e\u6027: '\u7cbe\u795e\u529b\u4e0a\u9650'\x2C\n          \u5f71\u54cd\u65b9\u5411: '\u6548\u679c\u5f3a\u5ea6'\x2C\n        }\x2C\n      ]\x2C\n    }\x2C\n    '\u89d2\u8272.\u83ab\u6893\u9e3f.\u5feb\u7167.0.\u89d2\u8272.\u7b2c1\u6b66\u9b42.\u7b2c1\u9b42\u7075.\u7b2c9\u9b42\u73af.\u7b2c9\u9b42\u6280': {\n      \u753