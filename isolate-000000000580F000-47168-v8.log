963b\u6b62\u6761\u4ef6\uff0c\u8f6c\u5165\u6218\u540e\u5904\u7f6e'\x2C\n        }\n      : resolveNextIntents({\n          combatData\x2C decisionTrace\x2C playerSummary\x2C enemySummary\x2C currentTargets: readCurrentTargets()\x2C\n        });\n    const { playerIntent\x2C enemyIntent } = resolvedIntents;\n    const tacticalWindows = [];\n    const risks = [];\n    [...playerSummary\x2C ...enemySummary].forEach(unit => {\n      const hpRatio = unit.hp / Math.max(1\x2C unit.hpMax);\n      const resourceRatio = (unit.sp + unit.vit + unit.men) / Math.max(1\x2C unit.spMax + unit.vitMax + unit.menMax);\n      const canAct = unit.hp > 0 && !/\u5931\u53bb\u6218\u6597\u529b|\u660f\u8ff7|\u6295\u964d|\u5236\u670d|\u64a4\u79bb/.test(unit.actionState);\n      if (canAct && hpRatio <= 0.25) tacticalWindows.push(`${unit.name}\u751f\u547d\u4f4e\u4e8e25%\uff0c\u8fdb\u5165\u65a9\u6740\u7a97\u53e3`);\n      if (canAct && resourceRatio <= 0.2) risks.push(`${unit.name}\u53ef\u7528\u8d44\u6e90\u63a5\u8fd1\u67af\u7aed`);\n      unit.states.forEach(state => {\n        if (state.skipTurn) tacticalWindows.push(`${unit.name}\u88ab\u3010${state.name}\u3011\u9650\u5236\u884c\u52a8${state.duration}\u56de\u5408`);\n        if (state.dot > 0) risks.push(`${unit.name}\u4ecd\u627f\u53d7\u3010${state.name}\u3011\u6301\u7eed\u4f24\u5bb3${state.duration}\u56de\u5408`);\n      });\n    });\n    summonSummary.forEach(unit => {\n      if (unit.hp > 0 && unit.remainingWindows > 0) tacticalWindows.push(`${unit.name}\u5c1a\u6709${unit.remainingWindows}\u4e2a${unit.mode || '\u884c\u52a8'}\u7a97\u53e3`);\n      if (unit.hp <= 0 || unit.remainingWindows <= 0) risks.push(`${unit.name}\u5df2\u65e0\u53ef\u5151\u73b0\u884c\u52a8\u7a97\u53e3`);\n    });\n    const hpRatioGap = playerMetric.hpRatio - enemyMetric.hpRatio;\n    if (battleEnded) {\n      tacticalWindows.push(objectiveTimedOut ? '\u672c\u573a\u5df2\u8fbe\u5230\u56de\u5408\u4e0a\u9650\uff0c\u53cc\u65b9\u505c\u6b62\u4ea4\u950b' : objectiveEvent ? `\u80dc\u8d1f\u6761\u4ef6\u5df2\u6210\u7acb\uff08${objectiveStatusText}\uff09\uff0c\u672c\u573a\u4ea4\u950b\u5df2\u7ecf\u7ed3\u675f` : enemyDefeated ? '\u654c\u65b9\u5df2\u5931\u53bb\u6218\u6597\u80fd\u529b\uff0c\u672c\u573a\u4ea4\u950b\u5df2\u7ecf\u7ed3\u675f' : '\u6211\u65b9\u5df2\u5931\u53bb\u6218\u6597\u80fd\u529b\uff0c\u672c\u573a\u4ea4\u950b\u5df2\u7ecf\u7ed3\u675f');\n      const survivingSide = advantage === 'DRAW' ? [...playerSummary\x2C ...enemySummary] : advantage === 'PLAYER_VICTORY' ? playerSummary : enemySummary;\n      const damagedSurvivors = survivingSide.filter(unit => unit.hp > 0 && unit.hp < unit.hpMax);\n      if (damagedSurvivors.length) risks.push(`${damagedSurvivors.map(unit => unit.name).join('\u3001')}\u4ecd\u6709\u6218\u635f\uff0c\u9700\u8981\u8fdb\u884c\u6218\u540e\u6062\u590d`);\n    } else if (hpRatioGap <= -0.03) {\n      tacticalWindows.push('\u654c\u65b9\u5c1a\u672a\u627f\u53d7\u540c\u7b49\u751f\u547d\u635f\u5931\uff0c\u6211\u65b9\u9700\u8981\u5148\u5efa\u7acb\u6709\u6548\u547d\u4e2d\u6216\u63a7\u5236\u7a97\u53e3');\n      risks.push('\u6211\u65b9\u6362\u8840\u843d\u540e\uff0c\u7ee7\u7eed\u7a7a\u8017\u4f1a\u8ba9\u654c\u65b9\u628a\u8f7b\u5fae\u4f18\u52bf\u6eda\u5927');\n    } else if (hpRatioGap >= 0.03) {\n      tacticalWindows.push('\u6211\u65b9\u5df2\u5efa\u7acb\u751f\u547d\u4f18\u52bf\uff0c\u53ef\u4ee5\u56f4\u7ed5\u96c6\u706b\u6216\u8d44\u6e90\u538b\u5236\u7ee7\u7eed\u6269\u5927\u5dee\u8ddd');\n      risks.push('\u82e5\u5728\u4f18\u52bf\u671f\u8f6c\u5165\u65e0\u6548\u8f85\u52a9\uff0c\u53ef\u80fd\u9519\u5931\u7ee7\u7eed\u538b\u5236\u7684\u7a97\u53e3');\n    } else if (!tacticalWindows.length) {\n      tacticalWindows.push('\u53cc\u65b9\u5747\u65e0\u786c\u63a7\u5236\uff0c\u4e0b\u4e00\u6b21\u6709\u6548\u547d\u4e2d\u6216\u622a\u65ad\u5c06\u91cd\u65b0\u5206\u914d\u4e3b\u52a8\u6743');\n    }\n    const currentTargets = readCurrentTargets();\n    const round = Math.max(0\x2C Number(snapshot?.round || ledger[ledger.length - 1]?.round || 0));\n    const formatTeam = units => units.length ? units.map(unit => `${unit.name} HP ${unit.hp}/${unit.hpMax}\uff0c\u9b42\u529b ${unit.sp}/${unit.spMax}\uff0c\u4f53\u529b ${unit.vit}/${unit.vitMax}\uff0c\u7cbe\u795e\u529b ${unit.men}/${unit.menMax}${unit.actionState && unit.actionState !== '\u6218\u6597' ? `\uff0c\u884c\u52a8\u72b6\u6001 ${unit.actionState}` : ''}${unit.states.length ? `\uff0c\u72b6\u6001 ${unit.states.map(state => `${state.name}(${state.duration})`).join('\u3001')}` : ''}`).join('\uff1b') : '\u65e0\u53ef\u884c\u52a8\u5355\u4f4d';\n    const text = [\n      `\u6218\u81f3\u7b2c${round}\u56de\u5408\uff0c${advantageText}\u3002`\x2C\n      `\u80dc\u5229\u6761\u4ef6\uff1a${objectiveText.victory || '\u672a\u8bbe\u7f6e'}\uff1b\u5931\u8d25\u6761\u4ef6\uff1a${objectiveText.defeat || '\u672a\u8bbe\u7f6e'}\uff1b\u56de\u5408\u4e0a\u9650\uff1a${objectiveText.maxRounds}\u3002`\x2C\n      `\u6211\u65b9\uff1a${formatTeam(playerSummary)}\u3002\u654c\u65b9\uff1a${formatTeam(enemySummary)}\u3002`\x2C\n      `\u63a5\u4e0b\u6765\u6211\u65b9${playerIntent.replace(/^\u6211\u65b9/\x2C '')}\uff1b\u654c\u65b9${enemyIntent.replace(/^\u654c\u65b9/\x2C '')}\u3002`\x2C\n      `\u53ef\u5229\u7528\u7a97\u53e3\uff1a${tacticalWindows.slice(0\x2C 5).join('\uff1b') || '\u6682\u65f6\u6ca1\u6709\u660e\u786e\u7a97\u53e3'}\u3002\u6700\u5927\u98ce\u9669\uff1a${risks.slice(0\x2C 4).join('\uff1b') || '\u53cc\u65b9\u6682\u65e0\u8feb\u8fd1\u7684\u8d44\u6e90\u6216\u72b6\u6001\u98ce\u9669'}\u3002`\x2C\n    ].join('\\n');\n    const finalBattleReport = {\n      blockId: `final_summary_${round}`\x2C\n      round\x2C\n      actionGroupId: `final_summary_${round}`\x2C\n      actorId: 'SYSTEM'\x2C\n      targetIds: []\x2C\n      blockType: 'FINAL_SUMMARY'\x2C\n      facts: [\n        { factType: 'BATTLE_STATE'\x2C round\x2C advantage\x2C scoreGap\x2C objectiveStatus: objectiveStatusText\x2C objectiveWinner }\x2C\n        { factType: 'BATTLE_OBJECTIVES'\x2C victory: objectiveText.victory\x2C defeat: objectiveText.defeat\x2C maxRounds: objectiveText.maxRounds }\x2C\n        { factType: 'TEAM_STATE'\x2C side: 'PLAYER'\x2C units: playerSummary }\x2C\n        { factType: 'TEAM_STATE'\x2C side: 'ENEMY'\x2C units: enemySummary }\x2C\n        { factType: 'SUMMON_STATE'\x2C units: summonSummary }\x2C\n      ]\x2C\n      badges: []\x2C\n      intentSummary: `\u6211\u65b9\uff1a${playerIntent}\uff1b\u654c\u65b9\uff1a${enemyIntent}`\x2C\n      outcomeSummary: advantageText\x2C\n      nextWindow: tacticalWindows.slice(0\x2C 5).join('\uff1b')\x2C\n      headline: advantageText\x2C\n      advantage\x2C\n      objectiveStatus: objectiveStatusText\x2C\n      objectiveWinner\x2C\n      objectives: objectiveText\x2C\n      scoreGap\x2C\n      sides: { player: { units: playerSummary\x2C metric: playerMetric }\x2C enemy: { units: enemySummary\x2C metric: enemyMetric } }\x2C\n      summons: summonSummary\x2C\n      currentTargets\x2C\n      nextIntents: { player: playerIntent\x2C enemy: enemyIntent }\x2C\n      tacticalWindows: [...new Set(tacticalWindows)].slice(0\x2C 8)\x2C\n      risks: [...new Set(risks)].slice(0\x2C 8)\x2C\n      text\x2C\n    };\n    const aiSummaryInput = {\n      round\x2C\n      advantage\x2C\n      objectiveStatus: objectiveStatusText\x2C\n      objectiveWinner\x2C\n      objectives: objectiveText\x2C\n      sides: {\n        player: playerSummary\x2C\n        enemy: enemySummary\x2C\n      }\x2C\n      summons: summonSummary\x2C\n      currentTargets\x2C\n      nextIntents: { player: playerIntent\x2C enemy: enemyIntent }\x2C\n      tacticalWindows: finalBattleReport.tacticalWindows\x2C\n      risks: finalBattleReport.risks\x2C\n      recentFacts: ledger\n        .filter(event => ['action_start'\x2C 'charge_start'\x2C 'hit_result'\x2C 'counter'\x2C 'state_apply'\x2C 'state_tick'\x2C 'resource_change'\x2C 'summon_create'\x2C 'summon_assist'\x2C 'failed_action'\x2C 'blocked_action'\x2C 'battle_objective_resolved'].includes(String(event?.eventKind || '').trim()))\n        .slice(-24)\n        .map(event => ({\n          round: Math.max(0\x2C Number(event?.round || event?.sourceRound || 0))\x2C\n          factType: String(event?.eventKind || '').trim()\x2C\n          actor: String(event?.actorName || '').trim()\x2C\n          target: String(event?.targetName || '').trim()\x2C\n          action: normalizeActionDisplayName(event?.finalActionName || event?.actionName || event?.sourceActionName || '')\x2C\n          result: String(event?.result || event?.actionStatus || '').trim()\x2C\n          value: Math.round(Number(readLedgerNumber(event\x2C 'damage') || event?.meta?.delta || readLedgerNumber(event\x2C 'amount') || 0))\x2C\n          state: ['state_apply'\x2C 'state_tick'].includes(String(event?.eventKind || '').trim()) ? readLedgerStateName(event) : ''\x2C\n        }))\x2C\n    };\n    return { finalBattleReport\x2C aiSummaryInput };\n  }\n\n  function buildAiNarrativeSummary(aiSummaryInput = {}\x2C options = {}) {\n    const input = aiSummaryInput && typeof aiSummaryInput === 'object' ? aiSummaryInput : {};\n    const tokenBudget = Math.max(240\x2C Number(options?.tokenBudget || 1400));\n    const maxRounds = Math.max(1\x2C Number(options?.maxRounds || 3));\n    const playerUnits = Array.isArray(input?.sides?.player) ? input.sides.player : [];\n    const enemyUnits = Array.isArray(input?.sides?.enemy) ? input.sides.enemy : [];\n    const summons = Array.isArray(input?.summons) ? input.summons : [];\n    const formatUnit = unit => {\n      const states = (Array.isArray(unit?.states) ? unit.states : [])\n        .filter(state => Number(state?.duration || 0) > 0)\n        .slice(0\x2C 5)\n        .map(state => `${String(state?.name || '\u72b6\u6001').trim()}(${Math.max(0\x2C Math.round(Number(state?.duration || 0)))}\u56de\u5408)`);\n      return [\n        `${String(unit?.name || '\u5355\u4f4d').trim()} HP${Math.max(0\x2C Math.round(Number(unit?.hp || 0)))}`\x2C\n        `\u9b42\u529b${Math.max(0\x2C Math.round(Number(unit?.sp || 0)))}`\x2C\n        `\u4f53\u529b${Math.max(0\x2C Math.round(Number(unit?.vit || 0)))}`\x2C\n        `\u7cbe\u795e\u529b${Math.max(0\x2C Math.round(Number(unit?.men || 0)))}`\x2C\n        states.length ? `\u72b6\u6001:${states.join('\u3001')}` : '\u72b6\u6001:\u65e0'\x2C\n      ].join('\uff1b');\n    };\n    const lines = [`[\u6218\u6597\u7ec8\u6001][\u56de\u5408${Math.max(0\x2C Number(input?.round || 0))}]`];\n    if (playerUnits.length) lines.push(`[\u6211\u65b9] ${playerUnits.map(formatUnit).join(' | ')}`);\n    if (enemyUnits.length) lines.push(`[\u654c\u65b9] ${enemyUnits.map(formatUnit).join(' | ')}`);\n    if (summons.length) {\n      lines.push(`[\u53ec\u5524\u7269] ${summons.slice(0\x2C 8).map(unit => [\n        formatUnit(unit)\x2C\n        unit?.host ? `\u5bbf\u4e3b:${unit.host}` : ''\x2C\n        unit?.mode ? `\u6a21\u5f0f:${unit.mode}` : ''\x2C\n        `\u5269\u4f59\u7a97\u53e3:${Math.max(0\x2C Math.round(Number(unit?.remainingWindows || 0)))}`\x2C\n        unit?.stability ? `\u7a33\u5b9a:${unit.stability}` : ''\x2C\n      ].filter(Boolean).join('\uff1b')).join(' | ')}`);\n    }\n    const currentTargets = (Array.isArray(input?.currentTargets) ? input.currentTargets : [])\n      .map(pair => `${String(pair?.actor || '').trim()}->${String(pair?.target || '').trim()}`)\n      .filter(pair => !/^->|->$/.test(pair));\n    lines.push(`[\u5f53\u524d\u76ee\u6807] ${currentTargets.join('\uff1b') || '\u65e0\u660e\u786e\u76ee\u6807'}`);\n    lines.push(`[\u4e0b\u4e00\u6b65\u610f\u56fe] \u6211\u65b9:${String(input?.nextIntents?.player || '\u65e0\u660e\u786e\u884c\u52a8').trim()}\uff1b\u654c\u65b9:${String(input?.nextIntents?.enemy || '\u65e0\u660e\u786e\u884c\u52a8').trim()}`);\n    lines.push(`[\u6218\u672f\u7a97\u53e3] ${(Array.isArray(input?.tacticalWindows) ? input.tacticalWindows : []).slice(0\x2C 8).join('\uff1b') || '\u6682\u65e0\u660e\u786e\u7a97\u53e3'}`);\n    lines.push(`[\u98ce\u9669] ${(Array.isArray(input?.risks) ? input.risks : []).slice(0\x2C 8).join('\uff1b') || '\u6682\u65e0\u8feb\u8fd1\u98ce\u9669'}`);\n    const terminalLineCount = lines.length;\n    lines.push('[\u8fd1\u671f\u4e8b\u5b9e]');\n    const recentFacts = Array.isArray(input?.recentFacts) ? input.recentFacts : [];\n    const latestRound = Math.max(0\x2C ...recentFacts.map(fact => Number(fact?.round || 0)));\n    recentFacts\n      .filter(fact => Number(fact?.round || 0) >= Math.max(1\x2C latestRound - maxRounds + 1))\n      .forEach(fact => {\n        const round = Math.max(0\x2C Number(fact?.round || 0));\n        const actor = String(fact?.actor || '\u884c\u52a8\u8005').trim();\n        const target = String(fact?.target || actor || '\u76ee\u6807').trim();\n        const action = normalizeActionDisplayName(fact?.action || '\u884c\u52a8');\n        const value = Math.round(Number(fact?.value || 0));\n        const state = String(fact?.state || '').trim();\n        const factType = String(fact?.factType || '').trim();\n        const detail = value\n          ? `\u6570\u503c${value > 0 ? '+' : ''}${value}`\n          : state\n            ? `\u72b6\u6001:${state}`\n            : ['action_start'\x2C 'charge_start'].includes(factType)\n              ? '\u52a8\u4f5c\u5df2\u5ba3\u544a'\n              : ['failed_action'\x2C 'blocked_action'].includes(factType)\n                ? '\u52a8\u4f5c\u672a\u5b8c\u6210'\n                : '\u4e8b\u5b9e\u5df2\u7ed3\u7b97';\n        lines.push(`[\u56de\u5408${round}][${actor}] \u4f7f\u7528\u3010${action}\u3011 -> [${target}]\u3002[${detail}]`);\n      });\n    let text = lines.join('\\n');\n    if (text.length > tokenBudget) {\n      const terminalLines = lines.slice(0\x2C terminalLineCount);\n      const retained = [];\n      for (let index = lines.length - 1; index > terminalLineCount; index -= 1) {\n        const next = [...terminalLines\x2C '[\u8fd1\u671f\u4e8b\u5b9e]'\x2C '[\u66f4\u65e9\u4e8b\u5b9e\u5df2\u6298\u53e0]'\x2C lines[index]\x2C ...retained].join('\\n');\n        if (next.length <= tokenBud