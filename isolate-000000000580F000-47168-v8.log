script-source,93,node:internal/crypto/keys,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypeSlice\x2C\x0d\n  ObjectDefineProperties\x2C\x0d\n  ObjectPrototypeHasOwnProperty\x2C\x0d\n  ObjectSetPrototypeOf\x2C\x0d\n  SafeSet\x2C\x0d\n  SymbolToStringTag\x2C\x0d\n  Uint8Array\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  KeyObjectHandle\x2C\x0d\n  createNativeKeyObjectClass\x2C\x0d\n  // eslint-disable-next-line no-restricted-syntax -- intended here\x0d\n  getKeyObjectSlots: nativeGetKeyObjectSlots\x2C\x0d\n  createCryptoKeyClass\x2C\x0d\n  // eslint-disable-next-line no-restricted-syntax -- intended here\x0d\n  getCryptoKeySlots: nativeGetCryptoKeySlots\x2C\x0d\n  kKeyTypeSecret\x2C\x0d\n  kKeyTypePublic\x2C\x0d\n  kKeyTypePrivate\x2C\x0d\n  kKeyFormatPEM\x2C\x0d\n  kKeyFormatDER\x2C\x0d\n  kKeyFormatJWK\x2C\x0d\n  kKeyFormatRawPublic\x2C\x0d\n  kKeyFormatRawPrivate\x2C\x0d\n  kKeyFormatRawSeed\x2C\x0d\n  kKeyEncodingPKCS1\x2C\x0d\n  kKeyEncodingPKCS8\x2C\x0d\n  kKeyEncodingSPKI\x2C\x0d\n  kKeyEncodingSEC1\x2C\x0d\n} = internalBinding('crypto');\x0d\n\x0d\nconst {\x0d\n  crypto: {\x0d\n    POINT_CONVERSION_COMPRESSED\x2C\x0d\n    POINT_CONVERSION_UNCOMPRESSED\x2C\x0d\n  }\x2C\x0d\n} = internalBinding('constants');\x0d\n\x0d\nconst {\x0d\n  validateObject\x2C\x0d\n  validateOneOf\x2C\x0d\n  validateString\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS\x2C\x0d\n    ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE\x2C\x0d\n    ERR_ILLEGAL_CONSTRUCTOR\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_INVALID_THIS\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\nconst {\x0d\n  getArrayBufferOrView\x2C\x0d\n  bigIntArrayToUnsignedBigInt\x2C\x0d\n  normalizeAlgorithm\x2C\x0d\n  hasAnyNotIn\x2C\x0d\n  getUsagesMask\x2C\x0d\n  getUsagesFromMask\x2C\x0d\n  hasUsage\x2C\x0d\n} = require('internal/crypto/util');\x0d\n\x0d\nconst {\x0d\n  isAnyArrayBuffer\x2C\x0d\n  isArrayBufferView\x2C\x0d\n} = require('internal/util/types');\x0d\n\x0d\nconst {\x0d\n  customInspectSymbol: kInspect\x2C\x0d\n  getDeprecationWarningEmitter\x2C\x0d\n  kEnumerableProperty\x2C\x0d\n  kEmptyObject\x2C\x0d\n  lazyDOMException\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nconst { inspect } = require('internal/util/inspect');\x0d\n\x0d\nconst emitDEP0203 = getDeprecationWarningEmitter(\x0d\n  'DEP0203'\x2C\x0d\n  'Passing a CryptoKey to node:crypto functions is deprecated.'\x2C\x0d\n);\x0d\n\x0d\nconst maybeEmitDEP0204 = getDeprecationWarningEmitter(\x0d\n  'DEP0204'\x2C\x0d\n  'Passing a non-extractable CryptoKey to KeyObject.from() is deprecated.'\x2C\x0d\n  undefined\x2C\x0d\n  false\x2C\x0d\n  (key) => !getCryptoKeyExtractable(key)\x2C\x0d\n);\x0d\n\x0d\n// Key input contexts.\x0d\nconst kConsumePublic = 0;\x0d\nconst kConsumePrivate = 1;\x0d\nconst kCreatePublic = 2;\x0d\nconst kCreatePrivate = 3;\x0d\n\x0d\nconst encodingNames = [];\x0d\nfor (const m of [[kKeyEncodingPKCS1\x2C 'pkcs1']\x2C [kKeyEncodingPKCS8\x2C 'pkcs8']\x2C\x0d\n                 [kKeyEncodingSPKI\x2C 'spki']\x2C [kKeyEncodingSEC1\x2C 'sec1']])\x0d\n  encodingNames[m[0]] = m[1];\x0d\n\x0d\n// KeyObject state lives on the native NativeKeyObject base class. JS reads\x0d\n// the native type enum and a KeyObjectHandle in one call and caches that\x0d\n// slot tuple in a private field so no forgeable own Symbols are exposed on\x0d\n// public KeyObject instances.\x0d\nlet getKeyObjectSlots; // Populated by the createNativeKeyObjectClass callback.\x0d\n\x0d\nconst kKeyObjectSlotType = 0;\x0d\nconst kKeyObjectSlotHandle = 1;\x0d\n// The native slot tuple stops at kKeyObjectSlotHandle. The remaining entries\x0d\n// are JS-side lazy cache slots derived from the KeyObjectHandle on first use.\x0d\nconst kKeyObjectSlotSymmetricKeySize = 2;\x0d\nconst kKeyObjectSlotAsymmetricKeyType = 3;\x0d\nconst kKeyObjectSlotAsymmetricKeyDetails = 4;\x0d\n\x0d\nfunction normalizeKeyDetails(details = kEmptyObject) {\x0d\n  if (details.publicExponent !== undefined) {\x0d\n    return {\x0d\n      __proto__: null\x2C\x0d\n      ...details\x2C\x0d\n      publicExponent:\x0d\n        bigIntArrayToUnsignedBigInt(new Uint8Array(details.publicExponent))\x2C\x0d\n    };\x0d\n  }\x0d\n  return details;\x0d\n}\x0d\n\x0d\n// Creating the KeyObject class is a little complicated due to inheritance\x0d\n// and the fact that KeyObjects should be transferable between threads\x2C\x0d\n// which requires the KeyObject base class to be implemented in C++.\x0d\n// The creation requires a callback to make sure that the NativeKeyObject\x0d\n// base class cannot exist without the other KeyObject implementations.\x0d\nconst {\x0d\n  0: KeyObject\x2C\x0d\n  1: SecretKeyObject\x2C\x0d\n  2: PublicKeyObject\x2C\x0d\n  3: PrivateKeyObject\x2C\x0d\n} = createNativeKeyObjectClass((NativeKeyObject) => {\x0d\n  // Publicly visible KeyObject class.\x0d\n  class KeyObject extends NativeKeyObject {\x0d\n    #slots;\x0d\n\x0d\n    constructor(type\x2C handle) {\x0d\n      if (type !== 'secret' && type !== 'public' && type !== 'private')\x0d\n        throw new ERR_INVALID_ARG_VALUE('type'\x2C type);\x0d\n      if (typeof handle !== 'object' || !(handle instanceof KeyObjectHandle))\x0d\n        throw new ERR_INVALID_ARG_TYPE('handle'\x2C 'object'\x2C handle);\x0d\n\x0d\n      super(handle);\x0d\n    }\x0d\n\x0d\n    get type() {\x0d\n      return getKeyObjectType(this);\x0d\n    }\x0d\n\x0d\n    static from(key) {\x0d\n      if (!isCryptoKey(key))\x0d\n        throw new ERR_INVALID_ARG_TYPE('key'\x2C 'CryptoKey'\x2C key);\x0d\n      maybeEmitDEP0204(key);\x0d\n      const handle = getCryptoKeyHandle(key);\x0d\n      switch (getCryptoKeyType(key)) {\x0d\n        /* eslint-disable no-use-before-define */\x0d\n        case 'secret': return new SecretKeyObject(handle);\x0d\n        case 'public': return new PublicKeyObject(handle);\x0d\n        case 'private': return new PrivateKeyObject(handle);\x0d\n        /* eslint-enable no-use-before-define */\x0d\n      }\x0d\n    }\x0d\n\x0d\n    equals(otherKeyObject) {\x0d\n      if (!isKeyObject(otherKeyObject)) {\x0d\n        throw new ERR_INVALID_ARG_TYPE(\x0d\n          'otherKeyObject'\x2C 'KeyObject'\x2C otherKeyObject);\x0d\n      }\x0d\n\x0d\n      const slots = getKeyObjectSlots(this);\x0d\n      const otherSlots = getKeyObjectSlots(otherKeyObject);\x0d\n      return slots[kKeyObjectSlotType] === otherSlots[kKeyObjectSlotType] &&\x0d\n        slots[kKeyObjectSlotHandle].equals(\x0d\n          otherSlots[kKeyObjectSlotHandle]);\x0d\n    }\x0d\n\x0d\n    static {\x0d\n      getKeyObjectSlots = (key) => {\x0d\n        if (!key || typeof key !== 'object')\x0d\n          throw new ERR_INVALID_THIS('KeyObject');\x0d\n        if (#slots in key) {\x0d\n          const cached = key.#slots;\x0d\n          if (cached !== undefined) return cached;\x0d\n        }\x0d\n        const slots = nativeGetKeyObjectSlots(key);\x0d\n        key.#slots = slots;\x0d\n        return slots;\x0d\n      };\x0d\n    }\x0d\n  }\x0d\n\x0d\n  ObjectDefineProperties(KeyObject.prototype\x2C {\x0d\n    [SymbolToStringTag]: {\x0d\n      __proto__: null\x2C\x0d\n      configurable: true\x2C\x0d\n      value: 'KeyObject'\x2C\x0d\n    }\x2C\x0d\n  });\x0d\n\x0d\n  let webidl;\x0d\n\x0d\n  class SecretKeyObject extends KeyObject {\x0d\n    constructor(handle) {\x0d\n      super('secret'\x2C handle);\x0d\n    }\x0d\n\x0d\n    get symmetricKeySize() {\x0d\n      return getKeyObjectSymmetricKeySize(this);\x0d\n    }\x0d\n\x0d\n    export(options) {\x0d\n      const handle = getKeyObjectHandle(this);\x0d\n      if (options !== undefined) {\x0d\n        validateObject(options\x2C 'options');\x0d\n        validateOneOf(\x0d\n          options.format\x2C 'options.format'\x2C [undefined\x2C 'buffer'\x2C 'jwk']);\x0d\n        if (options.format === 'jwk') {\x0d\n          return handle.exportJwk({}\x2C false);\x0d\n        }\x0d\n      }\x0d\n      return handle.export();\x0d\n    }\x0d\n\x0d\n    toCryptoKey(algorithm\x2C extractable\x2C keyUsages) {\x0d\n      webidl ??= require('internal/crypto/webidl');\x0d\n      algorithm = normalizeAlgorithm(webidl.converters.AlgorithmIdentifier(algorithm)\x2C 'importKey');\x0d\n      extractable = webidl.converters.boolean(extractable);\x0d\n      keyUsages = webidl.converters['sequence<KeyUsage>'](keyUsages);\x0d\n\x0d\n      let result;\x0d\n      switch (algorithm.name) {\x0d\n        case 'HMAC':\x0d\n          // Fall through\x0d\n        case 'KMAC128':\x0d\n          // Fall through\x0d\n        case 'KMAC256':\x0d\n          result = require('internal/crypto/mac')\x0d\n            .macImportKey('KeyObject'\x2C this\x2C algorithm\x2C extractable\x2C keyUsages);\x0d\n          break;\x0d\n        case 'AES-CTR':\x0d\n          // Fall through\x0d\n        case 'AES-CBC':\x0d\n          // Fall through\x0d\n        case 'AES-GCM':\x0d\n          // Fall through\x0d\n        case 'AES-KW':\x0d\n          // Fall through\x0d\n        case 'AES-OCB':\x0d\n          result = require('internal/crypto/aes')\x0d\n            .aesImportKey(algorithm\x2C 'KeyObject'\x2C this\x2C extractable\x2C keyUsages);\x0d\n          break;\x0d\n        case 'ChaCha20-Poly1305':\x0d\n          result = require('internal/crypto/chacha20_poly1305')\x0d\n            .c20pImportKey(algorithm\x2C 'KeyObject'\x2C this\x2C extractable\x2C keyUsages);\x0d\n          break;\x0d\n        case 'HKDF':\x0d\n          // Fall through\x0d\n        case 'PBKDF2':\x0d\n          // Fall through\x0d\n        case 'Argon2d':\x0d\n          // Fall through\x0d\n        case 'Argon2i':\x0d\n          // Fall through\x0d\n        case 'Argon2id':\x0d\n          result = importGenericSecretKey(\x0d\n            algorithm\x2C\x0d\n            'KeyObject'\x2C\x0d\n            this\x2C\x0d\n            extractable\x2C\x0d\n            keyUsages);\x0d\n          break;\x0d\n        default:\x0d\n          throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\x0d\n      }\x0d\n\x0d\n      if (getCryptoKeyUsagesMask(result) === 0) {\x0d\n        throw lazyDOMException(\x0d\n          `Usages cannot be empty when importing a ${getCryptoKeyType(result)} key.`\x2C\x0d\n          'SyntaxError');\x0d\n      }\x0d\n\x0d\n      return result;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  class AsymmetricKeyObject extends KeyObject {\x0d\n    get asymmetricKeyType() {\x0d\n      return getKeyObjectAsymmetricKeyType(this);\x0d\n    }\x0d\n\x0d\n    get asymmetricKeyDetails() {\x0d\n      return { ...getKeyObjectAsymmetricKeyDetails(this) };\x0d\n    }\x0d\n\x0d\n    toCryptoKey(algorithm\x2C extractable\x2C keyUsages) {\x0d\n      webidl ??= require('internal/crypto/webidl');\x0d\n      algorithm = normalizeAlgorithm(webidl.converters.AlgorithmIdentifier(algorithm)\x2C 'importKey');\x0d\n      extractable = webidl.converters.boolean(extractable);\x0d\n      keyUsages = webidl.converters['sequence<KeyUsage>'](keyUsages);\x0d\n\x0d\n      let result;\x0d\n      switch (algorithm.name) {\x0d\n        case 'RSASSA-PKCS1-v1_5':\x0d\n          // Fall through\x0d\n        case 'RSA-PSS':\x0d\n          // Fall through\x0d\n        case 'RSA-OAEP':\x0d\n          result = require('internal/crypto/rsa')\x0d\n            .rsaImportKey('KeyObject'\x2C this\x2C algorithm\x2C extractable\x2C keyUsages);\x0d\n          break;\x0d\n        case 'ECDSA':\x0d\n          // Fall through\x0d\n        case 'ECDH':\x0d\n          result = require('internal/crypto/ec')\x0d\n            .ecImportKey('KeyObject'\x2C this\x2C algorithm\x2C extractable\x2C keyUsages);\x0d\n          break;\x0d\n        case 'Ed25519':\x0d\n          // Fall through\x0d\n        case 'Ed448':\x0d\n          // Fall through\x0d\n        case 'X25519':\x0d\n          // Fall through\x0d\n        case 'X448':\x0d\n          result = require('internal/crypto/cfrg')\x0d\n            .cfrgImportKey('KeyObject'\x2C this\x2C algorithm\x2C extractable\x2C keyUsages);\x0d\n          break;\x0d\n        case 'ML-DSA-44':\x0d\n          // Fall through\x0d\n        case 'ML-DSA-65':\x0d\n          // Fall through\x0d\n        case 'ML-DSA-87':\x0d\n          result = require('internal/crypto/ml_dsa')\x0d\n            .mlDsaImportKey('KeyObject'\x2C this\x2C algorithm\x2C extractable\x2C keyUsages);\x0d\n          break;\x0d\n        case 'ML-KEM-512':\x0d\n          // Fall through\x0d\n        case 'ML-KEM-768':\x0d\n          // Fall through\x0d\n        case 'ML-KEM-1024':\x0d\n          result = require('internal/crypto/ml_kem')\x0d\n            .mlKemImportKey('KeyObject'\x2C this\x2C algorithm\x2C extractable\x2C keyUsages);\x0d\n          break;\x0d\n        default:\x0d\n          throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\x0d\n      }\x0d\n\x0d\n      const resultType = getCryptoKeyType(result);\x0d\n      if (resultType === 'private' && getCryptoKeyUsagesMask(result) === 0) {\x0d\n        throw lazyDOMException(\x0d\n          `Usages cannot be empty when importing a ${resultType} key.`\x2C\x0d\n          'SyntaxError');\x0d\n      }\x0d\n\x0d\n      return result;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  class PublicKeyObject extends AsymmetricKeyObject {\x0d\n    constructor(handle) {\x0d\n      super('public'\x2C handle);\x0d\n    }\x0d\n\x0d\n    export(options) {\x0d\n      switch (options?.format) {\x0d\n        case 'jwk':\x0d\n          return getKeyObjectHandle(this).exportJwk({}\x2C false);\x0d\n        case 'raw-public': {\x0d\n          const handle = getKeyObjectHandle(this);\x0d\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\x0d\n          if (asymmetricKeyType === 'ec') {\x0d\n            const { type = 'uncompressed' } = options;\x0d\n            validateOneOf(type\x2C 'options.type'\x2C ['compressed'\x2C 'uncompressed']);\x0d\n            const form = type === 'compressed' ?\x0d\n              POINT_CONVERSION_COMPRESSED : POINT_CONVERSION_UNCOMPRESSED;\x0d\n            return handle.exportECPublicRaw(form);\x0d\n          }\x0d\n          return handle.rawPublicKey();\x0d\n        }\x0d\n        default: {\x0d\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\x0d\n          const handle = getKeyObjectHandle(this);\x0d\n          const {\x0d\n            format\x2C\x0d\n            type\x2C\x0d\n          } = parsePublicKeyEncoding(options\x2C asymmetricKeyType);\x0d\n          return handle.export(format\x2C type);\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n  class PrivateKeyObject extends AsymmetricKeyObject {\x0d\n    constructor(handle) {\x0d\n      super('private'\x2C handle);\x0d\n    }\x0d\n\x0d\n    export(options) {\x0d\n      if (options?.passphrase !== undefined &&\x0d\n          options.format !== 'pem' && options.format !== 'der') {\x0d\n        throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\x0d\n          options.format\x2C 'does not support encryption');\x0d\n      }\x0d\n      switch (options?.format) {\x0d\n        case 'jwk':\x0d\n          return getKeyObjectHandle(this).exportJwk({}\x2C false);\x0d\n        case 'raw-private': {\x0d\n          const handle = getKeyObjectHandle(this);\x0d\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\x0d\n          if (asymmetricKeyType === 'ec') {\x0d\n            return handle.exportECPrivateRaw();\x0d\n          }\x0d\n          return handle.rawPrivateKey();\x0d\n        }\x0d\n        case 'raw-seed':\x0d\n          return getKeyObjectHandle(this).rawSeed();\x0d\n        default: {\x0d\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\x0d\n          const handle = getKeyObjectHandle(this);\x0d\n          const {\x0d\n            format\x2C\x0d\n            type\x2C\x0d\n            cipher\x2C\x0d\n            passphrase\x2C\x0d\n          } = parsePrivateKeyEncoding(options\x2C asymmetricKeyType);\x0d\n          return handle.export(format\x2C type\x2C cipher\x2C passphrase);\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n  return [KeyObject\x2C SecretKeyObject\x2C PublicKeyObject\x2C PrivateKeyObject];\x0d\n});\x0d\n\x0d\nfunction parseKeyFormat(formatStr\x2C defaultFormat\x2C optionName) {\x0d\n  if (formatStr === undefined && defaultFormat !== undefined)\x0d\n    return defaultFormat;\x0d\n  else if (formatStr === 'pem')\x0d\n    return kKeyFormatPEM;\x0d\n  else if (formatStr === 'der')\x0d\n    return kKeyFormatDER;\x0d\n  else if (formatStr === 'jwk')\x0d\n    return kKeyFormatJWK;\x0d\n  else if (formatStr === 'raw-public')\x0d\n    return kKeyFormatRawPublic;\x0d\n  else if (formatStr === 'raw-private')\x0d\n    return kKeyFormatRawPrivate;\x0d\n  else if (formatStr === 'raw-seed')\x0d\n    return kKeyFormatRawSeed;\x0d\n  throw new ERR_INVALID_ARG_VALUE(optionName\x2C formatStr);\x0d\n}\x0d\n\x0d\nfunction parseKeyType(typeStr\x2C required\x2C keyType\x2C isPublic\x2C optionName) {\x0d\n  if (typeStr === undefined && !required) {\x0d\n    return undefined;\x0d\n  } else if (typeStr === 'pkcs1') {\x0d\n    if (keyType !== undefined && keyType !== 'rsa') {\x0d\n      throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\x0d\n        typeStr\x2C 'can only be used for RSA keys');\x0d\n    }\x0d\n    return kKeyEncodingPKCS1;\x0d\n  } else if (typeStr === 'spki' && isPublic !== false) {\x0d\n    return kKeyEncodingSPKI;\x0d\n  } else if (typeStr === 'pkcs8' && isPublic !== true) {\x0d\n    return kKeyEncodingPKCS8;\x0d\n  } else if (typeStr === 'sec1' && isPublic !== true) {\x0d\n    if (keyType !== undefined && keyType !== 'ec') {\x0d\n      throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\x0d\n        typeStr\x2C 'can only be used for EC keys');\x0d\n    }\x0d\n    return kKeyEncodingSEC1;\x0d\n  }\x0d\n\x0d\n  throw new ERR_INVALID_ARG_VALUE(optionName\x2C typeStr);\x0d\n}\x0d\n\x0d\nfunction option(name\x2C prefix) {\x0d\n  return prefix === undefined ?\x0d\n    `options.${name}` : `${prefix}.${name}`;\x0d\n}\x0d\n\x0d\nfunction parseKeyFormatAndType(enc\x2C keyType\x2C isPublic\x2C objName) {\x0d\n  const { format: formatStr\x2C type: typeStr } = enc;\x0d\n\x0d\n  const isInput = keyType === undefined;\x0d\n  const format = parseKeyFormat(formatStr\x2C\x0d\n                                isInput ? kKeyFormatPEM : undefined\x2C\x0d\n                                option('format'\x2C objName));\x0d\n\x0d\n  if (format === kKeyFormatRawPublic) {\x0d\n    if (isPublic === false) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(option('format'\x2C objName)\x2C 'raw-public');\x0d\n    }\x0d\n    let type;\x0d\n    if (typeStr === undefined || typeStr === 'uncompressed') {\x0d\n      type = POINT_CONVERSION_UNCOMPRESSED;\x0d\n    } else if (typeStr === 'compressed') {\x0d\n      type = POINT_CONVERSION_COMPRESSED;\x0d\n    } else {\x0d\n      throw new ERR_INVALID_ARG_VALUE(option('type'\x2C objName)\x2C typeStr);\x0d\n    }\x0d\n    return { format\x2C type };\x0d\n  }\x0d\n\x0d\n  if (format === kKeyFormatRawPrivate || format === kKeyFormatRawSeed) {\x0d\n    if (isPublic === true) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(\x0d\n        option('format'\x2C objName)\x2C\x0d\n        format === kKeyFormatRawPrivate ? 'raw-private' : 'raw-seed');\x0d\n    }\x0d\n    if (typeStr !== undefined) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(option('type'\x2C objName)\x2C typeStr);\x0d\n    }\x0d\n    return { format };\x0d\n  }\x0d\n\x0d\n  const isRequired = (!isInput ||\x0d\n                      format === kKeyFormatDER) &&\x0d\n                      format !== kKeyFormatJWK;\x0d\n  const type = parseKeyType(typeStr\x2C\x0d\n                            isRequired\x2C\x0d\n                            keyType\x2C\x0d\n                            isPublic\x2C\x0d\n                            option('type'\x2C objName));\x0d\n  return { format\x2C type };\x0d\n}\x0d\n\x0d\nfunction isStringOrBuffer(val) {\x0d\n  return typeof val === 'string' |