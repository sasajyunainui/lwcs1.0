  depth: 0\x2C\n        effectPath: []\x2C\n        rootActionId\x2C\n        effectInstanceId: String(effect?.effectId || effect?.\u6548\u679cID || `${rootActionId}:effect:${index}`).trim()\x2C\n        windowId: `round:${Number(worldSnapshot?.\u56de\u5408 || 0)}:effect:${index}`\x2C\n        battleIntent: input?.battleIntent || {}\x2C\n        damageMultiplierByTarget: input?.damageMultiplierByTarget || {}\x2C\n        damageMultiplierResolver: input?.damageMultiplierResolver\x2C\n        hitProbabilityResolver: input?.hitProbabilityResolver\x2C\n        applicationProbabilityResolver: input?.applicationProbabilityResolver\x2C\n        actionDamageMultiplier\x2C\n      };\n      if (!String(effect?.\u539f\u578b || '').trim() && Array.isArray(effect?.\u4f7f\u7528\u6548\u679c)) {\n        previewCreationCarrier(effect\x2C overlay\x2C ledger\x2C context);\n        return;\n      }\n      if (followsPrimary) {\n        context.applicationProbabilityByTarget = new Map(\n          targets.map(target => [unitId(target)\x2C primarySuccessProbability.get(unitId(target)) ?? 0])\n        );\n      }\n      applyEffect(effect\x2C targets\x2C overlay\x2C ledger\x2C context\x2C 0);\n      if (String(effect?.\u539f\u578b || '').trim() === '\u70b8\u73af') {\n        actionDamageMultiplier *= Math.max(0\x2C Number(effect?.\u5f3a\u5316\u500d\u7387 || 1));\n      }\n      if (index === 0) {\n        targets.forEach(target => {\n          const prototype = String(effect?.\u539f\u578b || '').trim();\n          if (prototype === '\u4f24\u5bb3\u7ed3\u7b97') {\n            const baseHitProbability = estimateHitProbability(effectActor\x2C target\x2C effect);\n            const resolvedHitProbability = typeof input?.hitProbabilityResolver === 'function'\n              ? input.hitProbabilityResolver({\n                  targetId: unitId(target)\x2C\n                  actor: effectActor\x2C\n                  effect\x2C\n                  effectInstanceId: context.effectInstanceId\x2C\n                  baseHitProbability\x2C\n                })\n              : null;\n            const perSegment = clamp(\n              Number.isFinite(Number(resolvedHitProbability))\n                ? Number(resolvedHitProbability)\n                : baseHitProbability\x2C\n              0\x2C\n              1\x2C\n            );\n            const segments = Math.max(1\x2C Math.floor(Number(effect?.\u653b\u51fb\u6bb5\u6570 || effect?.\u6bb5\u6570 || 1)) || 1);\n            primarySuccessProbability.set(unitId(target)\x2C 1 - Math.pow(1 - perSegment\x2C segments));\n          } else if (prototype === '\u72b6\u6001\u65bd\u52a0') {\n            const baseApplicationProbability = normalizeEffectProbability(\n              effect?.\u6210\u529f\u7387 ?? effect?.\u89e6\u53d1\u6982\u7387\x2C\n              1\x2C\n            );\n            const resolvedApplicationProbability = typeof input?.applicationProbabilityResolver === 'function'\n              ? input.applicationProbabilityResolver({\n                  targetId: unitId(target)\x2C\n                  actor: effectActor\x2C\n                  effect\x2C\n                  effectInstanceId: context.effectInstanceId\x2C\n                  baseApplicationProbability\x2C\n                })\n              : baseApplicationProbability;\n            primarySuccessProbability.set(\n              unitId(target)\x2C\n              clamp(\n                Number.isFinite(Number(resolvedApplicationProbability))\n                  ? Number(resolvedApplicationProbability)\n                  : baseApplicationProbability\x2C\n                0\x2C\n                1\x2C\n              )\x2C\n            );\n          } else {\n            primarySuccessProbability.set(unitId(target)\x2C 1);\n          }\n        });\n      }\n    });\n    settleImmediateCooperativeSummons({\n      overlay\x2C\n      ledger\x2C\n      rootActionId\x2C\n      declaration\x2C\n      worldSnapshot\x2C\n      nodeBudget\x2C\n      battleIntent: input?.battleIntent || {}\x2C\n      damageMultiplierByTarget: input?.damageMultiplierByTarget || {}\x2C\n      damageMultiplierResolver: input?.damageMultiplierResolver\x2C\n      hitProbabilityResolver: input?.hitProbabilityResolver\x2C\n    });\n    metrics.maxNodesObserved = Math.max(metrics.maxNodesObserved\x2C nodeBudget.count);\n    const result = Object.freeze({\n      version: VERSION\x2C\n      cacheKey\x2C\n      actorId: unitId(actor)\x2C\n      actionId: rootActionId\x2C\n      actionKind: String(declaration?.actionKind || '').trim()\x2C\n      nodeCount: nodeBudget.count\x2C\n      contributions: Object.freeze([...ledger.entries])\x2C\n      scheduledEvents: Object.freeze([...overlay.scheduledEvents])\x2C\n      changedRules: Object.freeze(Object.fromEntries(overlay.changedRules))\x2C\n      changedUnitIds: Object.freeze([...overlay.changedUnits.keys()])\x2C\n      afterSnapshot: overlay.snapshot()\x2C\n      metrics: Object.freeze({ overlayWrites: metrics.overlayWrites\x2C fullCloneCalls: 0 })\x2C\n    });\n    previewCache.set(cacheKey\x2C result);\n    return result;\n  }\n\n  function calculateWithdrawalPressureDetails(unit = {}\x2C opponent = {}\x2C stance = 'WITHDRAW') {\n    const agilityBreakdown = readCombatStatBreakdown(unit\x2C 'agi');\n    const agility = agilityBreakdown.value;\n    const spirit = readResource(unit\x2C '\u7cbe\u795e\u529b');\n    const spiritMax = readResourceMax(unit\x2C '\u7cbe\u795e\u529b');\n    const stamina = readResource(unit\x2C '\u4f53\u529b');\n    const staminaMax = readResourceMax(unit\x2C '\u4f53\u529b');\n    const spiritRatio = clamp(spirit / Math.max(1\x2C spiritMax)\x2C 0\x2C 1);\n    const staminaRatio = clamp(stamina / Math.max(1\x2C staminaMax)\x2C 0\x2C 1);\n    const stateEffects = stateEntries(unit).map(([stateKey\x2C state]) => ({\n      source: stateName(state) || String(stateKey || '\u72b6\u6001\u6548\u679c').trim()\x2C\n      effect: state?.\u6218\u6597\u6548\u679c || {}\x2C\n    }));\n    const effectContributions = [];\n    const dodgeModifier = stateEffects.reduce((sum\x2C entry) => {\n      const value = Number(entry.effect?.dodge_bonus || 0) * 100 - Number(entry.effect?.dodge_penalty || 0) * 100;\n      if (value) effectContributions.push({ kind: 'add'\x2C value\x2C source: `${entry.source}\xb7\u95ea\u907f\u4fee\u6b63` });\n      return sum + value;\n    }\x2C 0);\n    const reactionModifier = stateEffects.reduce((sum\x2C entry) => {\n      const value = Number(entry.effect?.reaction_bonus || 0) * 80 - Number(entry.effect?.reaction_penalty || 0) * 80;\n      if (value) effectContributions.push({ kind: 'add'\x2C value\x2C source: `${entry.source}\xb7\u53cd\u5e94\u4fee\u6b63` });\n      return sum + value;\n    }\x2C 0);\n    const hardControlSource = stateEffects.find(entry => entry.effect?.skip_turn === true || entry.effect?.cannot_react === true);\n    const hardControlPenalty = hardControlSource ? 999999 : 0;\n    if (hardControlSource) effectContributions.push({ kind: 'subtract'\x2C value: hardControlPenalty\x2C source: `${hardControlSource.source}\xb7\u65e0\u6cd5\u53cd\u5e94` });\n    const opposingSpirit = readResource(opponent\x2C '\u7cbe\u795e\u529b');\n    const resourcePressure = clamp(\n      Math.pow(Math.max(0.01\x2C spirit / Math.max(1\x2C opposingSpirit))\x2C 0.35) * (0.45 + 0.55 * spiritRatio)\x2C\n      0.35\x2C\n      1.65\x2C\n    );\n    const base = agility * 0.72 + spirit * 0.012 + spiritMax * 0.025;\n    const conditionFactor = 0.35 + spiritRatio * 0.4 + staminaRatio * 0.25;\n    const stanceMultiplier = stance === 'PURSUIT' ? 1.08 : 1;\n    const value = Math.max(0\x2C base * conditionFactor * resourcePressure * stanceMultiplier + dodgeModifier + reactionModifier - hardControlPenalty);\n    return Object.freeze({\n      value\x2C\n      stance\x2C\n      agility: agilityBreakdown\x2C\n      spirit\x2C\n      spiritMax\x2C\n      stamina\x2C\n      staminaMax\x2C\n      opposingSpirit\x2C\n      spiritRatio\x2C\n      staminaRatio\x2C\n      base\x2C\n      conditionFactor\x2C\n      resourcePressure\x2C\n      stanceMultiplier\x2C\n      effectContributions: Object.freeze(effectContributions.map(item => Object.freeze({ ...item })))\x2C\n    });\n  }\n\n  function calculateWithdrawalPressure(unit = {}\x2C opponent = {}\x2C stance = 'WITHDRAW') {\n    return calculateWithdrawalPressureDetails(unit\x2C opponent\x2C stance).value;\n  }\n\n  function estimateWithdrawal(actor = {}\x2C pursuer = {}) {\n    const withdrawalScore = calculateWithdrawalPressure(actor\x2C pursuer\x2C 'WITHDRAW');\n    const pursuitScore = calculateWithdrawalPressure(pursuer\x2C actor\x2C 'PURSUIT');\n    const ratio = withdrawalScore / Math.max(1\x2C pursuitScore);\n    const successProbability = ratio >= 1.18 ? 1 : clamp((ratio - 0.72) * 0.55\x2C 0.03\x2C 0.92);\n    const partialThreshold = ratio >= 0.9 ? 1 : Math.max(successProbability\x2C Math.min(0.96\x2C successProbability + 0.24));\n    const partialProbability = Math.max(0\x2C partialThreshold - successProbability);\n    const failureProbability = Math.max(0\x2C 1 - successProbability - partialProbability);\n    const hpMax = readHpMax(actor);\n    return Object.freeze({\n      withdrawalScore\x2C\n      pursuitScore\x2C\n      ratio\x2C\n      successProbability\x2C\n      partialProbability\x2C\n      failureProbability\x2C\n      expectedPursuitDamage: partialProbability * hpMax * 0.04 + failureProbability * hpMax * 0.08\x2C\n    });\n  }\n\n  function calculateReactionContest(reactor = {}\x2C sourceActor = {}) {\n    const reactionDetails = calculateWithdrawalPressureDetails(reactor\x2C sourceActor\x2C 'WITHDRAW');\n    const attackDetails = calculateWithdrawalPressureDetails(sourceActor\x2C reactor\x2C 'PURSUIT');\n    const reactionPressure = reactionDetails.value;\n    const attackPressure = attackDetails.value;\n    const share = reactionPressure / Math.max(1\x2C reactionPressure + attackPressure);\n    return Object.freeze({\n      probability: clamp(0.18 + (share - 0.5) * 1.1\x2C 0.03\x2C 0.78)\x2C\n      reactionPressure\x2C\n      attackPressure\x2C\n      share\x2C\n      reactionAgility: reactionDetails.agility.value\x2C\n      sourceAgility: attackDetails.agility.value\x2C\n      reactionPressureBreakdown: reactionDetails\x2C\n      attackPressureBreakdown: attackDetails\x2C\n      reactionAgilityBreakdown: reactionDetails.agility\x2C\n      sourceAgilityBreakdown: attackDetails.agility\x2C\n    });\n  }\n\n  function calculateDefenseDamageMultiplier(reactor = {}\x2C sourceActor = {}\x2C prepared = false) {\n    const defense = Math.max(1\x2C readCombatStat(reactor\x2C 'def'));\n    const attack = Math.max(1\x2C readCombatStat(sourceActor\x2C 'str'));\n    const staminaRatio = readResource(reactor\x2C '\u4f53\u529b') / Math.max(1\x2C readResourceMax(reactor\x2C '\u4f53\u529b'));\n    const ordinary = clamp(\n      0.78 -\n      Math.min(0.2\x2C defense / (defense + attack) * 0.24) -\n      Math.min(0.08\x2C staminaRatio * 0.08)\x2C\n      0.45\x2C\n      0.82\x2C\n    );\n    return prepared ? Math.max(0.35\x2C ordinary * 0.8) : ordinary;\n  }\n\n  function calculateDodgeProbability(reactor = {}\x2C sourceActor = {}\x2C prepared = false) {\n    const ordinary = calculateReactionContest(reactor\x2C sourceActor).probability;\n    return prepared ? clamp(ordinary + (1 - ordinary) * 0.25\x2C 0.03\x2C 0.92) : ordinary;\n  }\n\n  function clearCache() {\n    previewCache.clear();\n    normalizedObjectivesCache = new WeakMap();\n  }\n\n  function readMetrics() {\n    return Object.freeze({ ...metrics\x2C cacheSize: previewCache.size });\n  }\n\n  const api = Object.freeze({\n    version: VERSION\x2C\n    outcomeComponents\x2C\n    battlePrototypes: Object.freeze([...battlePrototypes])\x2C\n    nonBattlePrototypes: Object.freeze([...nonBattlePrototypes])\x2C\n    PreviewOverlay\x2C\n    ContributionLedger\x2C\n    stableHash\x2C\n    summonInstanceId\x2C\n    unitId\x2C\n    unitName\x2C\n    listUnits\x2C\n    findUnit\x2C\n    sideOf\x2C\n    isAlive\x2C\n    isDead\x2C\n    isPhysicallyAlive\x2C\n    isBattleCapable\x2C\n    isSummonUnit\x2C\n    shouldTriggerTraumaUnconscious\x2C\n    compareNaturalActionOrder\x2C\n    readIncapacityReason\x2C\n    evaluateObjectiveConditionDetail\x2C\n    readHp\x2C\n    readHpMax\x2C\n    readShield\x2C\n    calculateShieldGain\x2C\n    readResource\x2C\n    readResourceMax\x2C\n    staminaScaleForUnit\x2C\n    refreshStaminaAdjustedFinal\x2C\n    readCombatStat\x2C\n    readCombatStatBreakdown\x2C\n    parseSignedValue\x2C\n    calculateSettledSegmentDamage\x2C\n    normalizeEffectProbability\x2C\n    effectTargetsAllies\x2C\n    resolveTargets\x2C\n    collectEffects\x2C\n    effectArrayHash\x2C\n    declarationGrantsCounter\x2C\n    fusionSkillMetadata\x2C\n    resolveFusionAction\x2C\n    effectConditionEnabled\x2C\n    calculateBaseDamage\x2C\n    estimateHitProbability\x2C\n    calculateBaseActionValue\x2C\n    calculateDirectPotential\x2C\n    calculateAtomicActionPotential\x2C\n    calculateSequencePotential\x2C\n    calculateUnitCapacity\x2C\n    calculateTwoOpportunityCapacity\x2C\n    calculateWithdrawalPressure\x2C\n    calculateWithdrawalPressureDetails\x2C\n    estimateWithdrawal\x2C\n    calculateReactionContest\x2C\n    calculateDefenseDamageMultiplier\x2C\n    calculateDodgeProbability\x2C\n    deriveStateCombatEffect\x2C\n    actorSuppressesEffect\x2C\n    pendingGrantedEffects\x2C\n    normalizeBattleObjectives\x2C\n    evaluateBattleObjectives\x2C\n    calculateNonlethalHpFloor\x2C\n    previewAction\x2C\n    clearCache\x2C\n    readMetrics\x2C\n  });\n\n  root.__LWCS_BATTLE_PREVIEW__ = api;\n})();\n
