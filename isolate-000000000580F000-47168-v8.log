script-source,94,node:internal/crypto/util,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayBufferIsView\x2C\x0d\n  ArrayBufferPrototypeGetByteLength\x2C\x0d\n  ArrayPrototypeIncludes\x2C\x0d\n  ArrayPrototypePush\x2C\x0d\n  BigInt\x2C\x0d\n  DataViewPrototypeGetBuffer\x2C\x0d\n  DataViewPrototypeGetByteLength\x2C\x0d\n  DataViewPrototypeGetByteOffset\x2C\x0d\n  Number\x2C\x0d\n  ObjectDefineProperty\x2C\x0d\n  ObjectEntries\x2C\x0d\n  ObjectKeys\x2C\x0d\n  ObjectPrototypeHasOwnProperty\x2C\x0d\n  PromisePrototypeThen\x2C\x0d\n  PromiseReject\x2C\x0d\n  PromiseWithResolvers\x2C\x0d\n  SafeSet\x2C\x0d\n  StringPrototypeToUpperCase\x2C\x0d\n  Symbol\x2C\x0d\n  TypedArrayPrototypeGetBuffer\x2C\x0d\n  TypedArrayPrototypeGetByteLength\x2C\x0d\n  TypedArrayPrototypeGetByteOffset\x2C\x0d\n  TypedArrayPrototypeSlice\x2C\x0d\n  Uint8Array\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  getCiphers: _getCiphers\x2C\x0d\n  getCurves: _getCurves\x2C\x0d\n  getHashes: _getHashes\x2C\x0d\n  setEngine: _setEngine\x2C\x0d\n  secureHeapUsed: _secureHeapUsed\x2C\x0d\n  getCachedAliases\x2C\x0d\n  getOpenSSLSecLevelCrypto: getOpenSSLSecLevel\x2C\x0d\n  EVP_PKEY_ML_DSA_44\x2C\x0d\n  EVP_PKEY_ML_DSA_65\x2C\x0d\n  EVP_PKEY_ML_DSA_87\x2C\x0d\n  EVP_PKEY_ML_KEM_512\x2C\x0d\n  EVP_PKEY_ML_KEM_768\x2C\x0d\n  EVP_PKEY_ML_KEM_1024\x2C\x0d\n  kKeyVariantAES_OCB_128: hasAesOcbMode\x2C\x0d\n  Argon2Job\x2C\x0d\n  KmacJob\x2C\x0d\n} = internalBinding('crypto');\x0d\n\x0d\nconst { getOptionValue } = require('internal/options');\x0d\n\x0d\nconst {\x0d\n  crypto: {\x0d\n    ENGINE_METHOD_ALL\x2C\x0d\n  }\x2C\x0d\n} = internalBinding('constants');\x0d\n\x0d\nconst normalizeHashName = require('internal/crypto/hashnames');\x0d\n\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_CRYPTO_CUSTOM_ENGINE_NOT_SUPPORTED\x2C\x0d\n    ERR_CRYPTO_ENGINE_UNKNOWN\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n  }\x2C\x0d\n  hideStackFrames\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\nconst {\x0d\n  validateArray\x2C\x0d\n  validateNumber\x2C\x0d\n  validateString\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst { Buffer } = require('buffer');\x0d\n\x0d\nconst {\x0d\n  cachedResult\x2C\x0d\n  emitExperimentalWarning\x2C\x0d\n  filterDuplicateStrings\x2C\x0d\n  lazyDOMException\x2C\x0d\n  setOwnProperty\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nconst {\x0d\n  namespace: {\x0d\n    isBuildingSnapshot\x2C\x0d\n    addSerializeCallback\x2C\x0d\n  }\x2C\x0d\n} = require('internal/v8/startup_snapshot');\x0d\n\x0d\nconst {\x0d\n  isDataView\x2C\x0d\n  isArrayBufferView\x2C\x0d\n  isAnyArrayBuffer\x2C\x0d\n  isPromise\x2C\x0d\n} = require('internal/util/types');\x0d\n\x0d\nconst kHandle = Symbol('kHandle');\x0d\n\x0d\n// This is here because many functions accepted binary strings without\x0d\n// any explicit encoding in older versions of node\x2C and we don't want\x0d\n// to break them unnecessarily.\x0d\nfunction toBuf(val\x2C encoding) {\x0d\n  if (typeof val === 'string') {\x0d\n    if (encoding === 'buffer')\x0d\n      encoding = 'utf8';\x0d\n    return Buffer.from(val\x2C encoding);\x0d\n  }\x0d\n  return val;\x0d\n}\x0d\n\x0d\nlet _hashCache;\x0d\nfunction getHashCache() {\x0d\n  if (_hashCache === undefined) {\x0d\n    _hashCache = getCachedAliases();\x0d\n    if (isBuildingSnapshot()) {\x0d\n      // For dynamic linking\x2C clear the map.\x0d\n      addSerializeCallback(() => { _hashCache = undefined; });\x0d\n    }\x0d\n  }\x0d\n  return _hashCache;\x0d\n}\x0d\n\x0d\nfunction getCachedHashId(algorithm) {\x0d\n  const result = getHashCache()[algorithm];\x0d\n  return result === undefined ? -1 : result;\x0d\n}\x0d\n\x0d\nconst getCiphers = cachedResult(() => filterDuplicateStrings(_getCiphers()));\x0d\nconst getHashes = cachedResult(() => filterDuplicateStrings(_getHashes()));\x0d\nconst getCurves = cachedResult(() => filterDuplicateStrings(_getCurves()));\x0d\n\x0d\nfunction setEngine(id\x2C flags) {\x0d\n  validateString(id\x2C 'id');\x0d\n  if (flags)\x0d\n    validateNumber(flags\x2C 'flags');\x0d\n  flags = flags >>> 0;\x0d\n\x0d\n  // Use provided engine for everything by default\x0d\n  if (flags === 0)\x0d\n    flags = ENGINE_METHOD_ALL;\x0d\n\x0d\n  if (typeof _setEngine !== 'function')\x0d\n    throw new ERR_CRYPTO_CUSTOM_ENGINE_NOT_SUPPORTED();\x0d\n  if (!_setEngine(id\x2C flags))\x0d\n    throw new ERR_CRYPTO_ENGINE_UNKNOWN(id);\x0d\n}\x0d\n\x0d\nconst getArrayBufferOrView = hideStackFrames((buffer\x2C name\x2C encoding) => {\x0d\n  if (isAnyArrayBuffer(buffer))\x0d\n    return buffer;\x0d\n  if (typeof buffer === 'string') {\x0d\n    if (encoding === 'buffer')\x0d\n      encoding = 'utf8';\x0d\n    return Buffer.from(buffer\x2C encoding);\x0d\n  }\x0d\n  if (!isArrayBufferView(buffer)) {\x0d\n    throw new ERR_INVALID_ARG_TYPE.HideStackFramesError(\x0d\n      name\x2C\x0d\n      [\x0d\n        'string'\x2C\x0d\n        'ArrayBuffer'\x2C\x0d\n        'Buffer'\x2C\x0d\n        'TypedArray'\x2C\x0d\n        'DataView'\x2C\x0d\n      ]\x2C\x0d\n      buffer\x2C\x0d\n    );\x0d\n  }\x0d\n  return buffer;\x0d\n});\x0d\n\x0d\n// The maximum buffer size that we'll support in the WebCrypto impl\x0d\nconst kMaxBufferLength = (2 ** 31) - 1;\x0d\n\x0d\n// The EC named curves that we currently support via the Web Crypto API.\x0d\nconst kNamedCurveAliases = {\x0d\n  'P-256': 'prime256v1'\x2C\x0d\n  'P-384': 'secp384r1'\x2C\x0d\n  'P-521': 'secp521r1'\x2C\x0d\n};\x0d\n\x0d\n// Algorithm definitions organized by algorithm name\x0d\nconst kAlgorithmDefinitions = {\x0d\n  'AES-CBC': {\x0d\n    'generateKey': 'AesKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'encrypt': 'AesCbcParams'\x2C\x0d\n    'decrypt': 'AesCbcParams'\x2C\x0d\n    'get key length': 'AesDerivedKeyParams'\x2C\x0d\n  }\x2C\x0d\n  'AES-CTR': {\x0d\n    'generateKey': 'AesKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'encrypt': 'AesCtrParams'\x2C\x0d\n    'decrypt': 'AesCtrParams'\x2C\x0d\n    'get key length': 'AesDerivedKeyParams'\x2C\x0d\n  }\x2C\x0d\n  'AES-GCM': {\x0d\n    'generateKey': 'AesKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'encrypt': 'AeadParams'\x2C\x0d\n    'decrypt': 'AeadParams'\x2C\x0d\n    'get key length': 'AesDerivedKeyParams'\x2C\x0d\n  }\x2C\x0d\n  'AES-KW': {\x0d\n    'generateKey': 'AesKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'get key length': 'AesDerivedKeyParams'\x2C\x0d\n    'wrapKey': null\x2C\x0d\n    'unwrapKey': null\x2C\x0d\n  }\x2C\x0d\n  'AES-OCB': {\x0d\n    'generateKey': 'AesKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'encrypt': 'AeadParams'\x2C\x0d\n    'decrypt': 'AeadParams'\x2C\x0d\n    'get key length': 'AesDerivedKeyParams'\x2C\x0d\n  }\x2C\x0d\n  'Argon2d': {\x0d\n    'deriveBits': 'Argon2Params'\x2C\x0d\n    'get key length': null\x2C\x0d\n    'importKey': null\x2C\x0d\n  }\x2C\x0d\n  'Argon2i': {\x0d\n    'deriveBits': 'Argon2Params'\x2C\x0d\n    'get key length': null\x2C\x0d\n    'importKey': null\x2C\x0d\n  }\x2C\x0d\n  'Argon2id': {\x0d\n    'deriveBits': 'Argon2Params'\x2C\x0d\n    'get key length': null\x2C\x0d\n    'importKey': null\x2C\x0d\n  }\x2C\x0d\n  'ChaCha20-Poly1305': {\x0d\n    'generateKey': null\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'encrypt': 'AeadParams'\x2C\x0d\n    'decrypt': 'AeadParams'\x2C\x0d\n    'get key length': null\x2C\x0d\n  }\x2C\x0d\n  'cSHAKE128': { 'digest': 'CShakeParams' }\x2C\x0d\n  'cSHAKE256': { 'digest': 'CShakeParams' }\x2C\x0d\n  'KT128': { 'digest': 'KangarooTwelveParams' }\x2C\x0d\n  'KT256': { 'digest': 'KangarooTwelveParams' }\x2C\x0d\n  'TurboSHAKE128': { 'digest': 'TurboShakeParams' }\x2C\x0d\n  'TurboSHAKE256': { 'digest': 'TurboShakeParams' }\x2C\x0d\n  'ECDH': {\x0d\n    'generateKey': 'EcKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': 'EcKeyImportParams'\x2C\x0d\n    'deriveBits': 'EcdhKeyDeriveParams'\x2C\x0d\n  }\x2C\x0d\n  'ECDSA': {\x0d\n    'generateKey': 'EcKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': 'EcKeyImportParams'\x2C\x0d\n    'sign': 'EcdsaParams'\x2C\x0d\n    'verify': 'EcdsaParams'\x2C\x0d\n  }\x2C\x0d\n  'Ed25519': {\x0d\n    'generateKey': null\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'sign': null\x2C\x0d\n    'verify': null\x2C\x0d\n  }\x2C\x0d\n  'Ed448': {\x0d\n    'generateKey': null\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'sign': 'ContextParams'\x2C\x0d\n    'verify': 'ContextParams'\x2C\x0d\n  }\x2C\x0d\n  'HKDF': {\x0d\n    'importKey': null\x2C\x0d\n    'deriveBits': 'HkdfParams'\x2C\x0d\n    'get key length': null\x2C\x0d\n  }\x2C\x0d\n  'HMAC': {\x0d\n    'generateKey': 'HmacKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': 'HmacImportParams'\x2C\x0d\n    'sign': null\x2C\x0d\n    'verify': null\x2C\x0d\n    'get key length': 'HmacImportParams'\x2C\x0d\n  }\x2C\x0d\n  'KMAC128': {\x0d\n    'generateKey': 'KmacKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': 'KmacImportParams'\x2C\x0d\n    'sign': 'KmacParams'\x2C\x0d\n    'verify': 'KmacParams'\x2C\x0d\n    'get key length': 'KmacImportParams'\x2C\x0d\n  }\x2C\x0d\n  'KMAC256': {\x0d\n    'generateKey': 'KmacKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': 'KmacImportParams'\x2C\x0d\n    'sign': 'KmacParams'\x2C\x0d\n    'verify': 'KmacParams'\x2C\x0d\n    'get key length': 'KmacImportParams'\x2C\x0d\n  }\x2C\x0d\n  'ML-DSA-44': {\x0d\n    'generateKey': null\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'sign': 'ContextParams'\x2C\x0d\n    'verify': 'ContextParams'\x2C\x0d\n  }\x2C\x0d\n  'ML-DSA-65': {\x0d\n    'generateKey': null\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'sign': 'ContextParams'\x2C\x0d\n    'verify': 'ContextParams'\x2C\x0d\n  }\x2C\x0d\n  'ML-DSA-87': {\x0d\n    'generateKey': null\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'sign': 'ContextParams'\x2C\x0d\n    'verify': 'ContextParams'\x2C\x0d\n  }\x2C\x0d\n  'ML-KEM-512': {\x0d\n    'generateKey': null\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'encapsulate': null\x2C\x0d\n    'decapsulate': null\x2C\x0d\n  }\x2C\x0d\n  'ML-KEM-768': {\x0d\n    'generateKey': null\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'encapsulate': null\x2C\x0d\n    'decapsulate': null\x2C\x0d\n  }\x2C\x0d\n  'ML-KEM-1024': {\x0d\n    'generateKey': null\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'encapsulate': null\x2C\x0d\n    'decapsulate': null\x2C\x0d\n  }\x2C\x0d\n  'PBKDF2': {\x0d\n    'importKey': null\x2C\x0d\n    'deriveBits': 'Pbkdf2Params'\x2C\x0d\n    'get key length': null\x2C\x0d\n  }\x2C\x0d\n  'RSA-OAEP': {\x0d\n    'generateKey': 'RsaHashedKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': 'RsaHashedImportParams'\x2C\x0d\n    'encrypt': 'RsaOaepParams'\x2C\x0d\n    'decrypt': 'RsaOaepParams'\x2C\x0d\n  }\x2C\x0d\n  'RSA-PSS': {\x0d\n    'generateKey': 'RsaHashedKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': 'RsaHashedImportParams'\x2C\x0d\n    'sign': 'RsaPssParams'\x2C\x0d\n    'verify': 'RsaPssParams'\x2C\x0d\n  }\x2C\x0d\n  'RSASSA-PKCS1-v1_5': {\x0d\n    'generateKey': 'RsaHashedKeyGenParams'\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': 'RsaHashedImportParams'\x2C\x0d\n    'sign': null\x2C\x0d\n    'verify': null\x2C\x0d\n  }\x2C\x0d\n  'SHA-1': { 'digest': null }\x2C\x0d\n  'SHA-256': { 'digest': null }\x2C\x0d\n  'SHA-384': { 'digest': null }\x2C\x0d\n  'SHA-512': { 'digest': null }\x2C\x0d\n  'SHA3-256': { 'digest': null }\x2C\x0d\n  'SHA3-384': { 'digest': null }\x2C\x0d\n  'SHA3-512': { 'digest': null }\x2C\x0d\n  'X25519': {\x0d\n    'generateKey': null\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'deriveBits': 'EcdhKeyDeriveParams'\x2C\x0d\n  }\x2C\x0d\n  'X448': {\x0d\n    'generateKey': null\x2C\x0d\n    'exportKey': null\x2C\x0d\n    'importKey': null\x2C\x0d\n    'deriveBits': 'EcdhKeyDeriveParams'\x2C\x0d\n  }\x2C\x0d\n};\x0d\n\x0d\n// Conditionally supported algorithms\x0d\nconst conditionalAlgorithms = {\x0d\n  'AES-OCB': !!hasAesOcbMode\x2C\x0d\n  'Argon2d': !!Argon2Job\x2C\x0d\n  'Argon2i': !!Argon2Job\x2C\x0d\n  'Argon2id': !!Argon2Job\x2C\x0d\n  'ChaCha20-Poly1305': process.features.openssl_is_boringssl ||\x0d\n    ArrayPrototypeIncludes(getCiphers()\x2C 'chacha20-poly1305')\x2C\x0d\n  'cSHAKE128': !process.features.openssl_is_boringssl ||\x0d\n    ArrayPrototypeIncludes(getHashes()\x2C 'shake128')\x2C\x0d\n  'cSHAKE256': !process.features.openssl_is_boringssl ||\x0d\n    ArrayPrototypeIncludes(getHashes()\x2C 'shake256')\x2C\x0d\n  'Ed448': !process.features.openssl_is_boringssl\x2C\x0d\n  'KMAC128': !!KmacJob\x2C\x0d\n  'KMAC256': !!KmacJob\x2C\x0d\n  'ML-DSA-44': !!EVP_PKEY_ML_DSA_44\x2C\x0d\n  'ML-DSA-65': !!EVP_PKEY_ML_DSA_65\x2C\x0d\n  'ML-DSA-87': !!EVP_PKEY_ML_DSA_87\x2C\x0d\n  'ML-KEM-512': !!EVP_PKEY_ML_KEM_512\x2C\x0d\n  'ML-KEM-768': !!EVP_PKEY_ML_KEM_768\x2C\x0d\n  'ML-KEM-1024': !!EVP_PKEY_ML_KEM_1024\x2C\x0d\n  'SHA3-256': !process.features.openssl_is_boringssl ||\x0d\n    ArrayPrototypeIncludes(getHashes()\x2C 'sha3-256')\x2C\x0d\n  'SHA3-384': !process.features.openssl_is_boringssl ||\x0d\n    ArrayPrototypeIncludes(getHashes()\x2C 'sha3-384')\x2C\x0d\n  'SHA3-512': !process.features.openssl_is_boringssl ||\x0d\n    ArrayPrototypeIncludes(getHashes()\x2C 'sha3-512')\x2C\x0d\n  'X448': !process.features.openssl_is_boringssl\x2C\x0d\n};\x0d\n\x0d\n// Experimental algorithms\x0d\nconst experimentalAlgorithms = [\x0d\n  'AES-OCB'\x2C\x0d\n  'Argon2d'\x2C\x0d\n  'Argon2i'\x2C\x0d\n  'Argon2id'\x2C\x0d\n  'ChaCha20-Poly1305'\x2C\x0d\n  'cSHAKE128'\x2C\x0d\n  'cSHAKE256'\x2C\x0d\n  'Ed448'\x2C\x0d\n  'KMAC128'\x2C\x0d\n  'KMAC256'\x2C\x0d\n  'ML-DSA-44'\x2C\x0d\n  'ML-DSA-65'\x2C\x0d\n  'ML-DSA-87'\x2C\x0d\n  'ML-KEM-512'\x2C\x0d\n  'ML-KEM-768'\x2C\x0d\n  'ML-KEM-1024'\x2C\x0d\n  'SHA3-256'\x2C\x0d\n  'SHA3-384'\x2C\x0d\n  'SHA3-512'\x2C\x0d\n  'TurboSHAKE128'\x2C\x0d\n  'TurboSHAKE256'\x2C\x0d\n  'KT128'\x2C\x0d\n  'KT256'\x2C\x0d\n  'X448'\x2C\x0d\n];\x0d\n\x0d\n// Transform the algorithm definitions into the operation-keyed structure\x0d\nfunction createSupportedAlgorithms(algorithmDefs) {\x0d\n  const result = {};\x0d\n\x0d\n  for (const { 0: algorithmName\x2C 1: operations } of ObjectEntries(algorithmDefs)) {\x0d\n    // Skip algorithms that are conditionally not supported\x0d\n    if (ObjectPrototypeHasOwnProperty(conditionalAlgorithms\x2C algorithmName) &&\x0d\n        !conditionalAlgorithms[algorithmName]) {\x0d\n      continue;\x0d\n    }\x0d\n\x0d\n    for (const { 0: operation\x2C 1: dict } of ObjectEntries(operations)) {\x0d\n      result[operation] ||= {};\x0d\n\x0d\n      // Add experimental warnings for experimental algorithms\x0d\n      if (ArrayPrototypeIncludes(experimentalAlgorithms\x2C algorithmName)) {\x0d\n        ObjectDefineProperty(result[operation]\x2C algorithmName\x2C {\x0d\n          get() {\x0d\n            emitExperimentalWarning(`The ${algorithmName} Web Crypto API algorithm`);\x0d\n            return dict;\x0d\n          }\x2C\x0d\n          __proto__: null\x2C\x0d\n          enumerable: true\x2C\x0d\n        });\x0d\n      } else {\x0d\n        result[operation][algorithmName] = dict;\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n  return result;\x0d\n}\x0d\n\x0d\nconst kSupportedAlgorithms = createSupportedAlgorithms(kAlgorithmDefinitions);\x0d\n\x0d\nconst simpleAlgorithmDictionaries = {\x0d\n  AesCbcParams: { iv: 'BufferSource' }\x2C\x0d\n  AesCtrParams: { counter: 'BufferSource' }\x2C\x0d\n  AeadParams: { iv: 'BufferSource'\x2C additionalData: 'BufferSource' }\x2C\x0d\n  // publicExponent is not strictly a BufferSource but it is a Uint8Array that we normalize\x0d\n  // this way\x0d\n  RsaHashedKeyGenParams: { hash: 'HashAlgorithmIdentifier'\x2C publicExponent: 'BufferSource' }\x2C\x0d\n  EcKeyGenParams: {}\x2C\x0d\n  HmacKeyGenParams: { hash: 'HashAlgorithmIdentifier' }\x2C\x0d\n  RsaPssParams: {}\x2C\x0d\n  EcdsaParams: { hash: 'HashAlgorithmIdentifier' }\x2C\x0d\n  HmacImportParams: { hash: 'HashAlgorithmIdentifier' }\x2C\x0d\n  HkdfParams: {\x0d\n    hash: 'HashAlgorithmIdentifier'\x2C\x0d\n    salt: 'BufferSource'\x2C\x0d\n    info: 'BufferSource'\x2C\x0d\n  }\x2C\x0d\n  ContextParams: { context: 'BufferSource' }\x2C\x0d\n  Pbkdf2Params: { hash: 'HashAlgorithmIdentifier'\x2C salt: 'BufferSource' }\x2C\x0d\n  RsaOaepParams: { label: 'BufferSource' }\x2C\x0d\n  RsaHashedImportParams: { hash: 'HashAlgorithmIdentifier' }\x2C\x0d\n  EcKeyImportParams: {}\x2C\x0d\n  CShakeParams: {\x0d\n    functionName: 'BufferSource'\x2C\x0d\n    customization: 'BufferSource'\x2C\x0d\n  }\x2C\x0d\n  Argon2Params: {\x0d\n    associatedData: 'BufferSource'\x2C\x0d\n    nonce: 'BufferSource'\x2C\x0d\n    secretValue: 'BufferSource'\x2C\x0d\n  }\x2C\x0d\n  KmacParams: {\x0d\n    customization: 'BufferSource'\x2C\x0d\n  }\x2C\x0d\n  KangarooTwelveParams: {\x0d\n    customization: 'BufferSource'\x2C\x0d\n  }\x2C\x0d\n  TurboShakeParams: {}\x2C\x0d\n};\x0d\n\x0d\nfunction validateMaxBufferLength(data\x2C name\x2C max = kMaxBufferLength) {\x0d\n  if (data.byteLength > max) {\x0d\n    throw lazyDOMException(\x0d\n      `${name} must be at most ${max} bytes`\x2C\x0d\n      'OperationError');\x0d\n  }\x0d\n}\x0d\n\x0d\nlet webidl;\x0d\n\x0d\n// https://w3c.github.io/webcrypto/#algorithm-normalization-normalize-an-algorithm\x0d\n// adapted for Node.js from Deno's implementation\x0d\n// https://github.com/denoland/deno/blob/v1.29.1/ext/crypto/00_crypto.js#L195\x0d\nfunction normalizeAlgorithm(algorithm\x2C op) {\x0d\n  if (typeof algorithm ==