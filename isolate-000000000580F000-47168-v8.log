script-source,153,BattlePreview_Module.js,/* BattlePreview_Module.js - Pure battle preview and capacity model. */\n\n(() => {\n  'use strict';\n\n  const root = typeof globalThis !== 'undefined' ? globalThis : window;\n  const sharedRegistry = root.__LWCS_SKILL_MECHANISM_REGISTRY__;\n  const prototypeRegistry = sharedRegistry?.\u539f\u578b\u5b9a\u4e49;\n  if (!prototypeRegistry || typeof prototypeRegistry !== 'object') {\n    throw new Error('battle_preview_shared_prototype_registry_missing');\n  }\n\n  const VERSION = '7.3-R6.3-preview-2';\n  const MAX_PREVIEW_NODES = 12;\n  const MAX_RECURSION_DEPTH = 4;\n  const effectHashCache = new WeakMap();\n  const effectArrayHashCache = new WeakMap();\n  const fusionMetadataCache = new WeakMap();\n  const stableHashCache = new WeakMap();\n  let normalizedObjectivesCache = new WeakMap();\n  const battlePrototypes = new Set([\n    '\u4f24\u5bb3\u7ed3\u7b97'\x2C '\u8d44\u6e90\u53d8\u5316'\x2C '\u8d44\u6e90\u8f6c\u79fb'\x2C '\u62a4\u76fe\u53d8\u5316'\x2C '\u5c5e\u6027\u4fee\u6b63'\x2C '\u5224\u5b9a\u4fee\u6b63'\x2C '\u7ed3\u7b97\u4fee\u6b63'\x2C\n    '\u70b8\u73af'\x2C '\u72b6\u6001\u65bd\u52a0'\x2C '\u65f6\u7a97\u4fee\u6b63'\x2C '\u72b6\u6001\u79fb\u9664'\x2C '\u89c4\u5219\u9632\u5fa1'\x2C '\u72b6\u6001\u8f6c\u79fb'\x2C '\u72b6\u6001\u4ea4\u6362'\x2C\n    '\u8d44\u6e90\u9501\u5b9a'\x2C '\u89c4\u5219\u6539\u5199'\x2C '\u673a\u5236\u62b9\u6d88'\x2C '\u673a\u5236\u6388\u4e88'\x2C '\u590d\u5236\u6267\u884c'\x2C '\u65f6\u5149\u56de\u6eaf'\x2C '\u4f4d\u79fb\u6267\u884c'\x2C\n    '\u51b3\u7b56\u5e72\u6270'\x2C '\u53ec\u5524\u751f\u6210'\x2C\n  ]);\n  const nonBattlePrototypes = new Set(['\u4fee\u70bc\u589e\u76ca'\x2C '\u6218\u6597\u5916\u590d\u6d3b']);\n  const BASIC_ATTACK_EFFECT = Object.freeze({\n    \u539f\u578b: '\u4f24\u5bb3\u7ed3\u7b97'\x2C\n    \u76ee\u6807: '\u5355\u4f53'\x2C\n    \u5a01\u529b\u500d\u7387: 50\x2C\n    \u4f24\u5bb3\u7c7b\u578b: '\u8fd1\u8eab\u653b\u51fb'\x2C\n    \u751f\u6548\u65b9\u5f0f: '\u72ec\u7acb\u751f\u6548'\x2C\n  });\n  const outcomeComponents = Object.freeze({\n    HP_DELTA: 'IMMEDIATE_STATE'\x2C\n    SHIELD_DELTA: 'IMMEDIATE_STATE'\x2C\n    SCHEDULED_HP_DELTA: 'SCHEDULED_STATE'\x2C\n    ACTION_GRANTED: 'ACTION_ECONOMY'\x2C\n    ACTION_CANCELLED: 'ACTION_ECONOMY'\x2C\n    NEXT_ACTION_QUALITY_CHANGED: 'FUTURE_OPTION'\x2C\n    RESOURCE_OPTION_CHANGED: 'RESOURCE_OPTION'\x2C\n    INFORMATION_REVEALED: 'INFORMATION'\x2C\n    BELIEF_CHANGED: 'BELIEF_STATE'\x2C\n    IRREVERSIBLE_ASSET_LOST: 'IRREVERSIBLE_COST'\x2C\n    TAIL_FAILURE: 'TAIL_RISK'\x2C\n    CHAIN_CONFLICT: 'CHAIN_CONFLICT'\x2C\n    STATE_CHANGED: 'STATE_DELTA'\x2C\n    STATE_SCHEDULED: 'SCHEDULED_STATE'\x2C\n    RULE_CHANGED: 'RULE_DELTA'\x2C\n    SUMMON_WINDOW: 'SCHEDULED_STATE'\x2C\n  });\n  const effectArrayFields = Object.freeze([\n    '_\u6548\u679c\u6570\u7ec4'\x2C\n    ...(Array.isArray(sharedRegistry?.\u5d4c\u5957\u6548\u679c\u6570\u7ec4\u5b57\u6bb5) ? sharedRegistry.\u5d4c\u5957\u6548\u679c\u6570\u7ec4\u5b57\u6bb5 : [])\x2C\n    ...(Array.isArray(sharedRegistry?.\u6761\u4ef6\u5206\u652f\u6548\u679c\u6570\u7ec4\u5b57\u6bb5) ? sharedRegistry.\u6761\u4ef6\u5206\u652f\u6548\u679c\u6570\u7ec4\u5b57\u6bb5 : [])\x2C\n  ]);\n\n  const metrics = {\n    previewCalls: 0\x2C\n    cacheHits: 0\x2C\n    overlayWrites: 0\x2C\n    fullCloneCalls: 0\x2C\n    maxNodesObserved: 0\x2C\n    stableHashCalls: 0\x2C\n    stableHashChars: 0\x2C\n    stableHashCacheHits: 0\x2C\n  };\n  const previewCache = new Map();\n  const unitIdCache = new WeakMap();\n  const unitNameCache = new WeakMap();\n\n  function clamp(value\x2C min\x2C max) {\n    return Math.max(min\x2C Math.min(max\x2C Number(value) || 0));\n  }\n\n  function cloneValue(value) {\n    if (typeof structuredClone === 'function') return structuredClone(value);\n    return JSON.parse(JSON.stringify(value));\n  }\n\n  function cloneUnitForOverlay(unit = {}) {\n    const cloneStates = states => {\n      if (Array.isArray(states)) return states.map(state => state && typeof state === 'object' ? cloneValue(state) : state);\n      if (states && typeof states === 'object') return Object.fromEntries(Object.entries(states).map(([key\x2C state]) => [key\x2C cloneValue(state)]));\n      return states;\n    };\n    return {\n      ...unit\x2C\n      \u5c5e\u6027: unit?.\u5c5e\u6027 && typeof unit.\u5c5e\u6027 === 'object' ? { ...unit.\u5c5e\u6027 } : unit?.\u5c5e\u6027\x2C\n      \u72b6\u6001: unit?.\u72b6\u6001 && typeof unit.\u72b6\u6001 === 'object' ? { ...unit.\u72b6\u6001 } : unit?.\u72b6\u6001\x2C\n      final: unit?.final && typeof unit.final === 'object' ? { ...unit.final } : unit?.final\x2C\n      __battleRuntime: unit?.__battleRuntime && typeof unit.__battleRuntime === 'object'\n        ? cloneValue(unit.__battleRuntime)\n        : unit?.__battleRuntime\x2C\n      \u72b6\u6001\u6548\u679c: cloneStates(unit?.\u72b6\u6001\u6548\u679c)\x2C\n      \u80cc\u5305: unit?.\u80cc\u5305 && typeof unit.\u80cc\u5305 === 'object' ? cloneValue(unit.\u80cc\u5305) : unit?.\u80cc\u5305\x2C\n      \u5e93\u5b58: unit?.\u5e93\u5b58 && typeof unit.\u5e93\u5b58 === 'object' ? cloneValue(unit.\u5e93\u5b58) : unit?.\u5e93\u5b58\x2C\n      \u7269\u54c1: unit?.\u7269\u54c1 && typeof unit.\u7269\u54c1 === 'object' ? cloneValue(unit.\u7269\u54c1) : unit?.\u7269\u54c1\x2C\n      \u6218\u6597\u7269\u54c1: unit?.\u6218\u6597\u7269\u54c1 && typeof unit.\u6218\u6597\u7269\u54c1 === 'object' ? cloneValue(unit.\u6218\u6597\u7269\u54c1) : unit?.\u6218\u6597\u7269\u54c1\x2C\n    };\n  }\n\n  function stableStringify(value) {\n    if (Array.isArray(value)) return `[${value.map(stableStringify).join('\x2C')}]`;\n    if (value && typeof value === 'object') {\n      return `{${Object.keys(value).sort().map(key => `${JSON.stringify(key)}:${stableStringify(value[key])}`).join('\x2C')}}`;\n    }\n    return JSON.stringify(value);\n  }\n\n  function stableHash(value) {\n    const cacheable = Array.isArray(value);\n    if (cacheable) {\n      const cached = stableHashCache.get(value);\n      if (cached) {\n        metrics.stableHashCacheHits += 1;\n        return cached;\n      }\n    }\n    const text = typeof value === 'string' ? value : stableStringify(value);\n    metrics.stableHashCalls += 1;\n    metrics.stableHashChars += text.length;\n    let hash = 2166136261;\n    for (let index = 0; index < text.length; index += 1) {\n      hash ^= text.charCodeAt(index);\n      hash = Math.imul(hash\x2C 16777619);\n    }\n    const result = (hash >>> 0).toString(36);\n    if (cacheable) stableHashCache.set(value\x2C result);\n    return result;\n  }\n\n  function effectArrayHash(effects) {\n    if (!Array.isArray(effects)) return '';\n    const cached = effectArrayHashCache.get(effects);\n    if (cached) return cached;\n    const result = stableHash(effects);\n    effectArrayHashCache.set(effects\x2C result);\n    return result;\n  }\n\n  function unitId(unit = {}) {\n    if (unit && typeof unit === 'object') {\n      const cached = unitIdCache.get(unit);\n      if (cached) return cached;\n      const result = String(unit?.\u53ec\u5524\u952e || unit?.id || unit?.\u89d2\u8272ID || unit?.uid || unit?.name || unit?.\u540d\u79f0 || '').trim();\n      if (result) unitIdCache.set(unit\x2C result);\n      return result;\n    }\n    return '';\n  }\n\n  function unitName(unit = {}) {\n    if (unit && typeof unit === 'object') {\n      const cached = unitNameCache.get(unit);\n      if (cached) return cached;\n      const result = String(unit?.name || unit?.\u540d\u79f0 || unitId(unit) || '\u672a\u77e5\u5355\u4f4d').trim();\n      if (result) unitNameCache.set(unit\x2C result);\n      return result;\n    }\n    return '\u672a\u77e5\u5355\u4f4d';\n  }\n\n  function readNumber(unit = {}\x2C keys = []\x2C fallback = 0) {\n    const finalStats = unit?.final && typeof unit.final === 'object' ? unit.final : {};\n    const sourceStats = unit?.\u5c5e\u6027 && typeof unit.\u5c5e\u6027 === 'object' ? unit.\u5c5e\u6027 : {};\n    for (const key of keys) {\n      const direct = Number(unit?.[key]);\n      if (Number.isFinite(direct)) return direct;\n      const fromFinal = Number(finalStats?.[key]);\n      if (Number.isFinite(fromFinal)) return fromFinal;\n      const fromSource = Number(sourceStats?.[key]);\n      if (Number.isFinite(fromSource)) return fromSource;\n    }\n    return Number(fallback) || 0;\n  }\n\n  function readHpMax(unit = {}) {\n    const direct = Number(unit?.hp_max);\n    if (Number.isFinite(direct)) return Math.max(1\x2C direct);\n    return Math.max(1\x2C readNumber(unit\x2C ['hp_max'\x2C 'HP\u4e0a\u9650'\x2C '\u751f\u547d\u4e0a\u9650'\x2C 'vit_max'\x2C '\u4f53\u529b\u4e0a\u9650']\x2C 1));\n  }\n\n  function readHp(unit = {}) {\n    const maximum = readHpMax(unit);\n    const direct = Number(unit?.hp);\n    if (Number.isFinite(direct)) return clamp(direct\x2C 0\x2C maximum);\n    return clamp(readNumber(unit\x2C ['hp'\x2C 'HP'\x2C '\u751f\u547d'\x2C 'vit'\x2C '\u4f53\u529b']\x2C maximum)\x2C 0\x2C maximum);\n  }\n\n  function readShield(unit = {}) {\n    const direct = Math.max(0\x2C readNumber(unit\x2C ['shield'\x2C '\u62a4\u76fe'\x2C '\u62a4\u76fe\u503c']\x2C 0));\n    const stateTotal = Object.values(unit?.\u72b6\u6001\u6548\u679c || {}).reduce(\n      (total\x2C condition) => total + Math.max(0\x2C Number(condition?.shield_value || 0))\x2C\n      0\x2C\n    );\n    // Runtime stores active shields as state entries; direct fields are only the\n    // fallback for snapshots that have not been materialized into states yet.\n    return stateTotal > 0 ? stateTotal : direct;\n  }\n\n  function calculateShieldGain(unit = {}\x2C shieldAmount = 0) {\n    const requested = Math.max(0\x2C Math.floor(Number(shieldAmount || 0)));\n    if (!(requested > 0)) return 0;\n    const current = readShield(unit);\n    const softCap = Math.max(300\x2C Math.floor(readHpMax(unit) * 1.2 + readResourceMax(unit\x2C '\u9b42\u529b') * 0.35));\n    const normal = Math.min(requested\x2C Math.max(0\x2C softCap - current));