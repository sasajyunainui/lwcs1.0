\u5f02\u5e38\u72b6\u6001\uff0c\u514d\u75ab\u8d1f\u9762\u72b6\u6001\u4e0e\u524a\u51cf\u7c7b\u6548\u679c`\x2C\n  \u9738\u4f53: \u76ee\u6807 => `\u4f7f${\u76ee\u6807}\u8fdb\u5165\u9738\u4f53\u72b6\u6001`\x2C\n  \u5c01\u6280: \u76ee\u6807 => `\u4f7f${\u76ee\u6807}\u8fdb\u5165\u5c01\u6280\u72b6\u6001`\x2C\n  \u62a4\u536b: (\u76ee\u6807\x2C \u6548\u679c) => `\u62a4\u536b${\u76ee\u6807}\uff0c\u66ff\u5176\u62e6\u622a\u653b\u51fb\uff0c${\u8f6c\u8bd1\u72b6\u6001\u65bd\u52a0\u6570\u503c\u8bf4\u660e_V1('\u62a4\u536b'\x2C \u6548\u679c)}`\x2C\n  \u5632\u8bbd: (\u76ee\u6807\x2C \u6548\u679c) => `\u4f7f${\u76ee\u6807}\u5632\u8bbd\uff0c${\u8f6c\u8bd1\u72b6\u6001\u65bd\u52a0\u6570\u503c\u8bf4\u660e_V1('\u5632\u8bbd'\x2C \u6548\u679c)}`\x2C\n  \u865a\u5f31: (\u76ee\u6807\x2C \u6548\u679c) => `\u4f7f${\u76ee\u6807}\u865a\u5f31\uff0c${\u8f6c\u8bd1\u72b6\u6001\u65bd\u52a0\u6570\u503c\u8bf4\u660e_V1('\u865a\u5f31'\x2C \u6548\u679c)}`\x2C\n  \u5931\u63a7: (\u76ee\u6807\x2C \u6548\u679c) => `\u4f7f${\u76ee\u6807}\u5931\u63a7\uff0c${\u8f6c\u8bd1\u72b6\u6001\u65bd\u52a0\u6570\u503c\u8bf4\u660e_V1('\u5931\u63a7'\x2C \u6548\u679c)}`\x2C\n  \u53cd\u566c: (\u76ee\u6807\x2C \u6548\u679c) => `\u4f7f${\u76ee\u6807}\u53cd\u566c\uff0c${\u8f6c\u8bd1\u72b6\u6001\u65bd\u52a0\u6570\u503c\u8bf4\u660e_V1('\u53cd\u566c'\x2C \u6548\u679c)}`\x2C\n  \u7cbe\u795e\u7d0a\u4e71: (\u76ee\u6807\x2C \u6548\u679c) => `\u4f7f${\u76ee\u6807}\u7cbe\u795e\u7d0a\u4e71\uff0c${\u8f6c\u8bd1\u72b6\u6001\u65bd\u52a0\u6570\u503c\u8bf4\u660e_V1('\u7cbe\u795e\u7d0a\u4e71'\x2C \u6548\u679c)}`\x2C\n  \u9b42\u529b\u67af\u7aed: (\u76ee\u6807\x2C \u6548\u679c) => `\u4f7f${\u76ee\u6807}\u9b42\u529b\u67af\u7aed\uff0c${\u8f6c\u8bd1\u72b6\u6001\u65bd\u52a0\u6570\u503c\u8bf4\u660e_V1('\u9b42\u529b\u67af\u7aed'\x2C \u6548\u679c)}`\x2C\n  \u50f5\u76f4: (\u76ee\u6807\x2C \u6548\u679c) => `\u4f7f${\u76ee\u6807}\u50f5\u76f4\uff0c${\u8f6c\u8bd1\u72b6\u6001\u65bd\u52a0\u6570\u503c\u8bf4\u660e_V1('\u50f5\u76f4'\x2C \u6548\u679c)}`\x2C\n  \u9ebb\u75f9: (\u76ee\u6807\x2C \u6548\u679c) => `\u4f7f${\u76ee\u6807}\u9ebb\u75f9\uff0c${\u8f6c\u8bd1\u72b6\u6001\u65bd\u52a0\u6570\u503c\u8bf4\u660e_V1('\u9ebb\u75f9'\x2C \u6548\u679c)}`\x2C\n  \u6df7\u4e71: (\u76ee\u6807\x2C \u6548\u679c) => `\u4f7f${\u76ee\u6807}\u6df7\u4e71\uff0c${\u8f6c\u8bd1\u72b6\u6001\u65bd\u52a0\u6570\u503c\u8bf4\u660e_V1('\u6df7\u4e71'\x2C \u6548\u679c)}`\x2C\n});\n\nfunction \u8f6c\u8bd1\u6280\u80fd\u72b6\u6001\u65bd\u52a0\u63cf\u8ff0_V1(\u6548\u679c = {}\x2C \u76ee\u6807 = '\u76ee\u6807') {\n  const \u72b6\u6001 = \u683c\u5f0f\u5316\u6280\u80fd\u7ed3\u6784\u8f6c\u8bd1\u5b57\u6bb5_V1(\u6548\u679c?.\u72b6\u6001 || \u6548\u679c?.\u72b6\u6001\x2C '\u72b6\u6001');\n  const \u8f6c\u8bd1 = \u6280\u80fd\u72b6\u6001\u65bd\u52a0\u8f6c\u8bd1\u8bed\u4e49_V1[\u72b6\u6001];\n  const \u89e6\u53d1\u65b9\u5f0f = String(\u6548\u679c?.\u89e6\u53d1\u65b9\u5f0f || '\u7acb\u5373\u89e6\u53d1').trim();\n  const \u89e6\u53d1\u524d\u7f00 = \u89e6\u53d1\u65b9\u5f0f === '\u5ef6\u8fdf\u89e6\u53d1' && Number(\u6548\u679c?.\u5ef6\u8fdf\u56de\u5408 || 0) > 0\n    ? `\u5ef6\u8fdf${formatSkillNumber(\u6548\u679c.\u5ef6\u8fdf\u56de\u5408)}\u56de\u5408\u540e\uff0c`\n    : \u89e6\u53d1\u65b9\u5f0f === '\u9065\u63a7\u89e6\u53d1'\n      ? '\u9065\u63a7\u89e6\u53d1\u65f6\uff0c'\n      : '';\n  if (typeof \u8f6c\u8bd1 === 'function') return `${\u89e6\u53d1\u524d\u7f00}${\u8f6c\u8bd1(\u76ee\u6807\x2C \u6548\u679c)}`;\n  return `${\u89e6\u53d1\u524d\u7f00}\u4f7f${\u76ee\u6807}\u8fdb\u5165\u3010${\u72b6\u6001}\u3011\u72b6\u6001`;\n}\n\nfunction \u8f6c\u8bd1\u72b6\u6001\u79fb\u9664\u5bf9\u8c61_V1(\u6548\u679c = {}) {\n  const \u72b6\u6001 = \u683c\u5f0f\u5316\u6280\u80fd\u7ed3\u6784\u8f6c\u8bd1\u5b57\u6bb5_V1(\u6548\u679c?.\u72b6\u6001\x2C '');\n  const \u5339\u914d\u539f\u578b = \u683c\u5f0f\u5316\u6280\u80fd\u7ed3\u6784\u8f6c\u8bd1\u5b57\u6bb5_V1(\u6548\u679c?.\u5339\u914d\u539f\u578b\x2C '');\n  const \u8d44\u6e90 = \u683c\u5f0f\u5316\u6280\u80fd\u7ed3\u6784\u8f6c\u8bd1\u5b57\u6bb5_V1(\u6548\u679c?.\u8d44\u6e90\x2C '');\n  const \u6570\u503c\u65b9\u5411 = \u683c\u5f0f\u5316\u6280\u80fd\u7ed3\u6784\u8f6c\u8bd1\u5b57\u6bb5_V1(\u6548\u679c?.\u6570\u503c\u65b9\u5411 || '\u4efb\u610f'\x2C '\u4efb\u610f');\n  const \u72b6\u6001\u6587\u672c =\n    \u72b6\u6001 === '\u4efb\u610f\u8d1f\u9762'\n      ? '\u8d1f\u9762\u72b6\u6001'\n      : \u72b6\u6001 === '\u4efb\u610f\u589e\u76ca'\n        ? '\u589e\u76ca\u72b6\u6001'\n        : \u72b6\u6001 === '\u4efb\u610f\u72b6\u6001'\n          ? '\u5339\u914d\u72b6\u6001'\n          : \u72b6\u6001\n            ? `\u3010${\u72b6\u6001}\u3011\u72b6\u6001`\n            : '';\n  let \u7b5b\u9009\u6587\u672c = '';\n  if (\u5339\u914d\u539f\u578b === '\u8d44\u6e90\u53d8\u5316') {\n    const \u8d44\u6e90\u6587\u672c = \u8d44\u6e90 || '\u8d44\u6e90';\n    if (\u6570\u503c\u65b9\u5411 === '\u8d1f\u5411') \u7b5b\u9009\u6587\u672c = `\u6301\u7eed\u6263${\u8d44\u6e90\u6587\u672c}\u7c7b\u72b6\u6001`;\n    else if (\u6570\u503c\u65b9\u5411 === '\u6b63\u5411') \u7b5b\u9009\u6587\u672c = `\u6301\u7eed\u6062\u590d${\u8d44\u6e90\u6587\u672c}\u7c7b\u72b6\u6001`;\n    else \u7b5b\u9009\u6587\u672c = `\u5e26${\u8d44\u6e90\u6587\u672c}\u53d8\u5316\u7684\u72b6\u6001`;\n  } else if (\u5339\u914d\u539f\u578b === '\u62a4\u76fe\u53d8\u5316') \u7b5b\u9009\u6587\u672c = '\u62a4\u76fe\u72b6\u6001';\n  if (\u72b6\u6001\u6587\u672c && \u7b5b\u9009\u6587\u672c && !['\u5339\u914d\u72b6\u6001'\x2C \u7b5b\u9009\u6587\u672c].includes(\u72b6\u6001\u6587\u672c)) return `${\u72b6\u6001\u6587\u672c}\u4e2d${\u7b5b\u9009\u6587\u672c}`;\n  return \u7b5b\u9009\u6587\u672c || \u72b6\u6001\u6587\u672c || '\u5339\u914d\u72b6\u6001';\n}\n\nfunction \u8f6c\u8bd1\u72b6\u6001\u8f6c\u79fb\u72b6\u6001\u540d_V1(\u72b6\u6001 = '') {\n  const \u6587\u672c = \u683c\u5f0f\u5316\u6280\u80fd\u7ed3\u6784\u8f6c\u8bd1\u5b57\u6bb5_V1(\u72b6\u6001\x2C '\u5339\u914d\u72b6\u6001');\n  if (\u6587\u672c === '\u4efb\u610f\u8d1f\u9762') return '\u8d1f\u9762\u72b6\u6001';\n  if (\u6587\u672