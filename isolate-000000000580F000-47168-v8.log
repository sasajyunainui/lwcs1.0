return 'private';\x0d\n    default: {\x0d\n      const assert = require('internal/assert');\x0d\n      assert.fail('Unreachable code');\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\n// The helpers below return a KeyObject's native-backed slot values\x2C\x0d\n// populating the per-instance cache on first access via a single native\x0d\n// call. The public getters delegate to these helpers\x2C and internal\x0d\n// consumers use them directly to avoid user-replaceable public accessors.\x0d\n// Derived metadata such as key size and asymmetric key details is expanded\x0d\n// lazily from the cached KeyObjectHandle. The public asymmetric key details\x0d\n// getter returns a clone so the cached details object stays internal.\x0d\n\x0d\n/**\x0d\n * Returns the KeyObject's native type slot as a string.\x0d\n * @param {KeyObject} key\x0d\n * @returns {'secret' | 'public' | 'private'}\x0d\n */\x0d\nfunction getKeyObjectType(key) {\x0d\n  return keyObjectTypeToString(getKeyObjectSlots(key)[kKeyObjectSlotType]);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the KeyObjectHandle wrapping the KeyObject's underlying key\x0d\n * material.\x0d\n * @param {KeyObject} key\x0d\n * @returns {KeyObjectHandle}\x0d\n */\x0d\nfunction getKeyObjectHandle(key) {\x0d\n  return getKeyObjectSlots(key)[kKeyObjectSlotHandle];\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the KeyObject's symmetric key size\x2C bypassing the public\x0d\n * `symmetricKeySize` getter. The value is derived lazily from the cached\x0d\n * KeyObjectHandle.\x0d\n * @param {SecretKeyObject} key\x0d\n * @returns {number}\x0d\n */\x0d\nfunction getKeyObjectSymmetricKeySize(key) {\x0d\n  const slots = getKeyObjectSlots(key);\x0d\n  if (slots[kKeyObjectSlotType] !== kKeyTypeSecret)\x0d\n    throw new ERR_INVALID_THIS('SecretKeyObject');\x0d\n\x0d\n  let cached = slots[kKeyObjectSlotSymmetricKeySize];\x0d\n  if (cached === undefined) {\x0d\n    cached = slots[kKeyObjectSlotHandle].getSymmetricKeySize();\x0d\n    slots[kKeyObjectSlotSymmetricKeySize] = cached;\x0d\n  }\x0d\n  return cached;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the KeyObject's asymmetric key type\x2C bypassing the public\x0d\n * `asymmetricKeyType` getter. The value is derived lazily from the cached\x0d\n * KeyObjectHandle.\x0d\n * @param {PublicKeyObject|PrivateKeyObject} key\x0d\n * @returns {string}\x0d\n */\x0d\nfunction getKeyObjectAsymmetricKeyType(key) {\x0d\n  const slots = getKeyObjectSlots(key);\x0d\n  if (slots[kKeyObjectSlotType] === kKeyTypeSecret)\x0d\n    throw new ERR_INVALID_THIS('AsymmetricKeyObject');\x0d\n\x0d\n  let cached = slots[kKeyObjectSlotAsymmetricKeyType];\x0d\n  if (cached === undefined) {\x0d\n    cached = slots[kKeyObjectSlotHandle].getAsymmetricKeyType();\x0d\n    slots[kKeyObjectSlotAsymmetricKeyType] = cached;\x0d\n  }\x0d\n  return cached;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the KeyObject's cached asymmetric key details\x2C bypassing the\x0d\n * public `asymmetricKeyDetails` getter (which returns a cloned copy).\x0d\n * The value is derived lazily from the cached KeyObjectHandle.\x0d\n * @param {PublicKeyObject|PrivateKeyObject} key\x0d\n * @returns {object}\x0d\n */\x0d\nfunction getKeyObjectAsymmetricKeyDetails(key) {\x0d\n  const slots = getKeyObjectSlots(key);\x0d\n  if (slots[kKeyObjectSlotType] === kKeyTypeSecret)\x0d\n    throw new ERR_INVALID_THIS('AsymmetricKeyObject');\x0d\n\x0d\n  let cached = slots[kKeyObjectSlotAsymmetricKeyDetails];\x0d\n  if (cached === undefined) {\x0d\n    let asymmetricKeyType = slots[kKeyObjectSlotAsymmetricKeyType];\x0d\n    if (asymmetricKeyType === undefined) {\x0d\n      asymmetricKeyType = slots[kKeyObjectSlotHandle].getAsymmetricKeyType();\x0d\n      slots[kKeyObjectSlotAsymmetricKeyType] = asymmetricKeyType;\x0d\n    }\x0d\n    switch (asymmetricKeyType) {\x0d\n      case 'rsa':\x0d\n      case 'rsa-pss':\x0d\n      case 'dsa':\x0d\n      case 'ec':\x0d\n        cached = normalizeKeyDetails(\x0d\n          slots[kKeyObjectSlotHandle].keyDetail({ __proto__: null })\x2C\x0d\n        );\x0d\n        break;\x0d\n      default:\x0d\n        cached = kEmptyObject;\x0d\n        break;\x0d\n    }\x0d\n    slots[kKeyObjectSlotAsymmetricKeyDetails] = cached;\x0d\n  }\x0d\n  return cached;\x0d\n}\x0d\n\x0d\nfunction isKeyObject(obj) {\x0d\n  if (obj == null || typeof obj !== 'object')\x0d\n    return false;\x0d\n\x0d\n  try {\x0d\n    getKeyObjectSlots(obj);\x0d\n    return true;\x0d\n  } catch {\x0d\n    return false;\x0d\n  }\x0d\n}\x0d\n\x0d\n// CryptoKey is a plain JS class whose prototype's [[Prototype]] is\x0d\n// Object.prototype\x2C as Web Crypto requires. Instance storage (type enum\x2C\x0d\n// extractable\x2C algorithm\x2C usages mask\x2C and the KeyObject handle) lives\x0d\n// on a C++ class\x2C NativeCryptoKey\x2C created by createCryptoKeyClass.\x0d\n// InternalCryptoKey is the only constructor we expose to internal\x0d\n// code; it extends NativeCryptoKey to get that storage and then has\x0d\n// its prototype spliced so the chain visible to user code is:\x0d\n//   instance -> InternalCryptoKey.prototype\x0d\n//            -> CryptoKey.prototype\x0d\n//            -> Object.prototype\x0d\n//\x0d\n// All five internal slots are read from C++ in a single call via\x0d\n// `getCryptoKeySlots`. The resulting array is cached in a private\x0d\n// class field on `InternalCryptoKey` so that it is invisible to\x0d\n// reflection (`Object.getOwnPropertySymbols` etc.) and leaves each\x0d\n// CryptoKey's hidden class pristine. The `getCryptoKey{Type\x2C\x0d\n// Extractable\x2CAlgorithm\x2CUsages\x2CHandle}` helpers index into that\x0d\n// array and convert native enums/masks back to Web Crypto strings.\x0d\n// The internal algorithm object is stored as a null-prototype clone\x0d\n// so it cannot observe polluted Object.prototype properties.\x0d\n// The public `algorithm` getter caches a cloned dictionary and the\x0d\n// public `usages` getter caches a synthesized array (as Web Crypto\x0d\n// requires repeat reads to return the same object so a consumer's\x0d\n// mutation is visible next time).\x0d\nlet getSlots; // Populated by the createCryptoKeyClass callback below.\x0d\n\x0d\nconst kSlotType = 0;\x0d\nconst kSlotExtractable = 1;\x0d\nconst kSlotAlgorithm = 2;\x0d\nconst kSlotUsagesMask = 3;\x0d\nconst kSlotHandle = 4;\x0d\nconst kSlotClonedAlgorithm = 5;\x0d\nconst kSlotClonedUsages = 6;\x0d\nconst kSlotUsages = 7;\x0d\n\x0d\nfunction cloneAlgorithm(raw) {\x0d\n  const cloned = { ...raw };\x0d\n  if (ObjectPrototypeHasOwnProperty(cloned\x2C 'hash') &&\x0d\n      cloned.hash !== undefined) {\x0d\n    cloned.hash = { ...cloned.hash };\x0d\n  }\x0d\n  if (ObjectPrototypeHasOwnProperty(cloned\x2C 'publicExponent') &&\x0d\n      cloned.publicExponent !== undefined) {\x0d\n    cloned.publicExponent = new Uint8Array(cloned.publicExponent);\x0d\n  }\x0d\n  return cloned;\x0d\n}\x0d\n\x0d\nfunction cloneInternalAlgorithm(raw) {\x0d\n  const cloned = { __proto__: null\x2C ...raw };\x0d\n  if (ObjectPrototypeHasOwnProperty(cloned\x2C 'hash') &&\x0d\n      cloned.hash !== undefined) {\x0d\n    cloned.hash = { __proto__: null\x2C ...cloned.hash };\x0d\n  }\x0d\n  if (ObjectPrototypeHasOwnProperty(cloned\x2C 'publicExponent') &&\x0d\n      cloned.publicExponent !== undefined) {\x0d\n    cloned.publicExponent = new Uint8Array(cloned.publicExponent);\x0d\n  }\x0d\n  return cloned;\x0d\n}\x0d\n\x0d\nconst {\x0d\n  0: CryptoKey\x2C\x0d\n  1: InternalCryptoKey\x2C\x0d\n} = createCryptoKeyClass((NativeCryptoKey) => {\x0d\n  class CryptoKey {\x0d\n    constructor() {\x0d\n      throw new ERR_ILLEGAL_CONSTRUCTOR();\x0d\n    }\x0d\n\x0d\n    [kInspect](depth\x2C options) {\x0d\n      if (depth < 0)\x0d\n        return this;\x0d\n\x0d\n      const opts = {\x0d\n        ...options\x2C\x0d\n        depth: options.depth == null ? null : options.depth - 1\x2C\x0d\n      };\x0d\n\x0d\n      return `CryptoKey ${inspect({\x0d\n        type: getCryptoKeyType(this)\x2C\x0d\n        extractable: getCryptoKeyExtractable(this)\x2C\x0d\n        algorithm: cloneAlgorithm(getCryptoKeyAlgorithm(this))\x2C\x0d\n        usages: ArrayPrototypeSlice(getCryptoKeyUsages(this)\x2C 0)\x2C\x0d\n      }\x2C opts)}`;\x0d\n    }\x0d\n\x0d\n    get type() {\x0d\n      return getCryptoKeyType(this);\x0d\n    }\x0d\n\x0d\n    get extractable() {\x0d\n      return getCryptoKeyExtractable(this);\x0d\n    }\x0d\n\x0d\n    get algorithm() {\x0d\n      const slots = getSlots(this);\x0d\n      let cached = slots[kSlotClonedAlgorithm];\x0d\n      if (cached === undefined) {\x0d\n        cached = cloneAlgorithm(slots[kSlotAlgorithm]);\x0d\n        slots[kSlotClonedAlgorithm] = cached;\x0d\n      }\x0d\n      return cached;\x0d\n    }\x0d\n\x0d\n    get usages() {\x0d\n      const slots = getSlots(this);\x0d\n      let cached = slots[kSlotClonedUsages];\x0d\n      if (cached === undefined) {\x0d\n        cached = ArrayPrototypeSlice(getCryptoKeyUsagesFromSlots(slots)\x2C 0);\x0d\n        slots[kSlotClonedUsages] = cached;\x0d\n      }\x0d\n      return cached;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  class InternalCryptoKey extends NativeCryptoKey {\x0d\n    #slots;\x0d\n\x0d\n    constructor(handle\x2C algorithm\x2C usagesMask\x2C extractable) {\x0d\n      if (algorithm !== undefined)\x0d\n        algorithm = cloneInternalAlgorithm(algorithm);\x0d\n      super(handle\x2C algorithm\x2C usagesMask\x2C extractable);\x0d\n    }\x0d\n\x0d\n    static {\x0d\n      getSlots = (key) => {\x0d\n        if (!key || typeof key !== 'object')\x0d\n          throw new ERR_INVALID_THIS('CryptoKey');\x0d\n        if (#slots in key) {\x0d\n          const cached = key.#slots;\x0d\n          if (cached !== undefined) return cached;\x0d\n        }\x0d\n        const slots = nativeGetCryptoKeySlots(key);\x0d\n        slots[kSlotAlgorithm] = cloneInternalAlgorithm(slots[kSlotAlgorithm]);\x0d\n        key.#slots = slots;\x0d\n        return slots;\x0d\n      };\x0d\n    }\x0d\n  }\x0d\n  // Hide NativeCryptoKey from user code.\x0d\n  InternalCryptoKey.prototype.constructor = CryptoKey;\x0d\n  ObjectSetPrototypeOf(InternalCryptoKey.prototype\x2C CryptoKey.prototype);\x0d\n\x0d\n  ObjectDefineProperties(CryptoKey.prototype\x2C {\x0d\n    type: kEnumerableProperty\x2C\x0d\n    extractable: kEnumerableProperty\x2C\x0d\n    algorithm: kEnumerableProperty\x2C\x0d\n    usages: kEnumerableProperty\x2C\x0d\n    [SymbolToStringTag]: {\x0d\n      __proto__: null\x2C\x0d\n      configurable: true\x2C\x0d\n      value: 'CryptoKey'\x2C\x0d\n    }\x2C\x0d\n  });\x0d\n\x0d\n  return [CryptoKey\x2C InternalCryptoKey];\x0d\n});\x0d\n\x0d\n// The helpers below return a CryptoKey's internal slot value\x2C\x0d\n// populating the per-instance cache on first access via a single\x0d\n// native call. The public `type` getter converts the native enum to\x0d\n// the Web Crypto string. The `usages` helper converts the native usage\x0d\n// mask to Web Crypto strings. The public `algorithm` / `usages` getters\x0d\n// on `CryptoKey.prototype` cache their returned objects.\x0d\n\x0d\n/**\x0d\n * Returns the value of a CryptoKey's `[[type]]` internal slot.\x0d\n * @param {CryptoKey} key\x0d\n * @returns {'secret' | 'public' | 'private'}\x0d\n */\x0d\nfunction getCryptoKeyType(key) {\x0d\n  switch (getSlots(key)[kSlotType]) {\x0d\n    case kKeyTypeSecret: return 'secret';\x0d\n    case kKeyTypePublic: return 'public';\x0d\n    case kKeyTypePrivate: return 'private';\x0d\n    default: {\x0d\n      const assert = require('internal/assert');\x0d\n      assert.fail('Unreachable code');\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the value of a CryptoKey's `[[extractable]]` internal slot.\x0d\n * @param {CryptoKey} key\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction getCryptoKeyExtractable(key) {\x0d\n  return getSlots(key)[kSlotExtractable];\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the CryptoKey's `[[algorithm]]` internal slot\x2C bypassing the\x0d\n * public `algorithm` getter (which returns a cloned copy).\x0d\n * @param {CryptoKey} key\x0d\n * @returns {object}\x0d\n */\x0d\nfunction getCryptoKeyAlgorithm(key) {\x0d\n  return getSlots(key)[kSlotAlgorithm];\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the CryptoKey's native `[[usages]]` mask.\x0d\n * @param {CryptoKey} key\x0d\n * @returns {number}\x0d\n */\x0d\nfunction getCryptoKeyUsagesMask(key) {\x0d\n  return getSlots(key)[kSlotUsagesMask];\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns whether a CryptoKey's `[[usages]]` contains `usage`.\x0d\n * @param {CryptoKey} key\x0d\n * @param {string} usage\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction hasCryptoKeyUsage(key\x2C usage) {\x0d\n  return hasUsage(getCryptoKeyUsagesMask(key)\x2C usage);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the CryptoKey's cached canonical usages array for internal\x0d\n * consumers\x2C expanding it from the native usage mask on first access.\x0d\n * @param {Array} slots\x0d\n * @returns {string[]}\x0d\n */\x0d\nfunction getCryptoKeyUsagesFromSlots(slots) {\x0d\n  let usages = slots[kSlotUsages];\x0d\n  if (usages === undefined) {\x0d\n    usages = getUsagesFromMask(slots[kSlotUsagesMask]);\x0d\n    slots[kSlotUsages] = usages;\x0d\n  }\x0d\n  return usages;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the CryptoKey's `[[usages]]` internal slot\x2C bypassing the\x0d\n * public `usages` getter (which returns a cloned array). The internal\x0d\n * array is expanded lazily from the native usage mask.\x0d\n * @param {CryptoKey} key\x0d\n * @returns {string[]}\x0d\n */\x0d\nfunction getCryptoKeyUsages(key) {\x0d\n  return getCryptoKeyUsagesFromSlots(getSlots(key));\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the KeyObjectHandle wrapping the CryptoKey's underlying\x0d\n * key material.\x0d\n * @param {CryptoKey} key\x0d\n * @returns {KeyObjectHandle}\x0d\n */\x0d\nfunction getCryptoKeyHandle(key) {\x0d\n  return getSlots(key)[kSlotHandle];\x0d\n}\x0d\n\x0d\nfunction isCryptoKey(obj) {\x0d\n  if (obj == null || typeof obj !== 'object')\x0d\n    return false;\x0d\n\x0d\n  try {\x0d\n    getSlots(obj);\x0d\n    return true;\x0d\n  } catch {\x0d\n    return false;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction importGenericSecretKey(\x0d\n  algorithm\x2C\x0d\n  format\x2C\x0d\n  keyData\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages\x2C\x0d\n) {\x0d\n  const usagesSet = new SafeSet(keyUsages);\x0d\n  const { name } = algorithm;\x0d\n  if (extractable)\x0d\n    throw lazyDOMException(`${name} keys are not extractable`\x2C 'SyntaxError');\x0d\n\x0d\n  if (hasAnyNotIn(usagesSet\x2C ['deriveKey'\x2C 'deriveBits'])) {\x0d\n    throw lazyDOMException(\x0d\n      `Unsupported key usage for a ${name} key`\x2C\x0d\n      'SyntaxError');\x0d\n  }\x0d\n\x0d\n  let handle;\x0d\n  switch (format) {\x0d\n    case 'KeyObject': {\x0d\n      handle = getKeyObjectHandle(keyData);\x0d\n      break;\x0d\n    }\x0d\n    case 'raw-secret':\x0d\n    case 'raw': {\x0d\n      handle = new KeyObjectHandle();\x0d\n      handle.init(kKeyTypeSecret\x2C keyData);\x0d\n      break;\x0d\n    }\x0d\n    default:\x0d\n      return undefined;\x0d\n  }\x0d\n\x0d\n  return new InternalCryptoKey(\x0d\n    handle\x2C\x0d\n    { name }\x2C\x0d\n    getUsagesMask(usagesSet)\x2C\x0d\n    false);\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  // Public API.\x0d\n  createSecretKey\x2C\x0d\n  createPublicKey\x2C\x0d\n  createPrivateKey\x2C\x0d\n  KeyObject\x2C\x0d\n  CryptoKey\x2C\x0d\n  InternalCryptoKey\x2C\x0d\n\x0d\n  // These are designed for internal use only and should not be exposed.\x0d\n  parsePublicKeyEncoding\x2C\x0d\n  parsePrivateKeyEncoding\x2C\x0d\n  parseKeyEncoding\x2C\x0d\n  preparePrivateKey\x2C\x0d\n  preparePublicOrPrivateKey\x2C\x0d\n  prepareSecretKey\x2C\x0d\n  SecretKeyObject\x2C\x0d\n  PublicKeyObject\x2C\x0d\n  PrivateKeyObject\x2C\x0d\n  isKeyObject\x2C\x0d\n  getKeyObjectType\x2C\x0d\n  getKeyObjectHandle\x2C\x0d\n  getKeyObjectSymmetricKeySize\x2C\x0d\n  getKeyObjectAsymmetricKeyType\x2C\x0d\n  getKeyObjectAsymmetricKeyDetails\x2C\x0d\n  isCryptoKey\x2C\x0d\n  getCryptoKeyType\x2C\x0d\n  getCryptoKeyExtractable\x2C\x0d\n  getCryptoKeyAlgorithm\x2C\x0d\n  getCryptoKeyUsages\x2C\x0d\n  getCryptoKeyUsagesMask\x2C\x0d\n  hasCryptoKeyUsage\x2C\x0d\n  getCryptoKeyHandle\x2C\x0d\n  importGenericSecretKey\x2C\x0d\n};\x0d\n
