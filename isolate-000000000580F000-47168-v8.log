script-source,89,file:///D:/silltyavern/tavern_helper_template-main/tavern_helper_template-main/lwcs/tools/audit_battle_r83_phase9.mjs,import crypto from 'node:crypto';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport vm from 'node:vm';\nimport { spawnSync } from 'node:child_process';\nimport { fileURLToPath } from 'node:url';\nimport { buildManualCases } from './battle_r63_manual_cases.mjs';\n\nconst toolDir = path.dirname(fileURLToPath(import.meta.url));\nconst repoRoot = path.resolve(toolDir\x2C '..');\nconst artifactPath = path.join(repoRoot\x2C 'artifacts'\x2C 'r83_phase9_batch.json');\nconst manifestPath = path.join(toolDir\x2C 'evidence'\x2C 'r8'\x2C 'r75_real_case_manifest.json');\nconst providers = Object.freeze(['r74-next-baseline'\x2C 'r8-shadow']);\nconst fullBattleTimeoutMs = 180000;\nconst mode = process.argv.includes('--first-actions-only')\n  ? 'first-actions'\n  : process.argv.includes('--full-battles-only')\n    ? 'full-battles'\n    : 'all';\n\nfunction makeNode() {\n  return {\n    style: {}\x2C\n    dataset: {}\x2C\n    isConnected: true\x2C\n    innerHTML: ''\x2C\n    hidden: false\x2C\n    classList: { add() {}\x2C remove() {}\x2C toggle() {} }\x2C\n    setAttribute() {}\x2C\n    appendChild() {}\x2C\n    remove() {}\x2C\n    addEventListener() {}\x2C\n    removeEventListener() {}\x2C\n    querySelector() { return null; }\x2C\n    querySelectorAll() { return []; }\x2C\n    getBoundingClientRect() { return { top: 10\x2C right: 800\x2C width: 600\x2C height: 500 }; }\x2C\n  };\n}\n\nfunction createSandbox() {\n  const sandbox = {\n    console\x2C\n    setTimeout\x2C\n    clearTimeout\x2C\n    setInterval\x2C\n    clearInterval\x2C\n    structuredClone\x2C\n    Math\x2C\n    Date\x2C\n    JSON\x2C\n    Array\x2C\n    Object\x2C\n    String\x2C\n    Number\x2C\n    Boolean\x2C\n    RegExp\x2C\n    Map\x2C\n    Set\x2C\n    WeakMap\x2C\n    WeakSet\x2C\n    Symbol\x2C\n    parseInt\x2C\n    parseFloat\x2C\n    isNaN\x2C\n    Intl\x2C\n    URL\x2C\n    URLSearchParams\x2C\n    TextEncoder\x2C\n    TextDecoder\x2C\n    navigator: { userAgent: 'node' }\x2C\n    location: { href: 'http://localhost/' }\x2C\n    innerWidth: 1440\x2C\n    innerHeight: 900\x2C\n    getComputedStyle: () => ({ getPropertyValue() { return ''; }\x2C zIndex: '1' })\x2C\n    ResizeObserver: function ResizeObserver() {\n      this.observe = () => {};\n      this.disconnect = () => {};\n    }\x2C\n    localStorage: { getItem() { return null; }\x2C setItem() {}\x2C removeItem() {} }\x2C\n    sessionStorage: { getItem() { return null; }\x2C setItem() {}\x2C removeItem() {} }\x2C\n    dispatchEvent() {}\x2C\n    addEventListener() {}\x2C\n    removeEventListener() {}\x2C\n    CustomEvent: function CustomEvent(type\x2C init) {\n      this.type = type;\n      this.detail = init?.detail;\n    }\x2C\n  };\n  sandbox.document = {\n    documentElement: { clientWidth: 1440\x2C clientHeight: 900 }\x2C\n    createElement: () => makeNode()\x2C\n    body: { appendChild() {} }\x2C\n    head: { appendChild() {} }\x2C\n    querySelector: () => null\x2C\n    querySelectorAll: () => []\x2C\n    addEventListener() {}\x2C\n    removeEventListener() {}\x2C\n  };\n  sandbox.window = sandbox;\n  sandbox.globalThis = sandbox;\n  sandbox.self = sandbox;\n  vm.createContext(sandbox);\n  return sandbox;\n}\n\nfunction loadRuntime() {\n  const sandbox = createSandbox();\n  for (const fileName of [\n    'CharacterLibrary.js'\x2C\n    'MVU_Skill_Runtime.js'\x2C\n    'BattlePreview_Module.js'\x2C\n    'BattleDecision_Module.js'\x2C\n    'BattleRuntime_Module.js'\x2C\n  ]) {\n    vm.runInContext(\n      fs.readFileSync(path.join(repoRoot\x2C fileName)\x2C 'utf8')\x2C\n      sandbox\x2C\n      { filename: fileName }\x2C\n    );\n  }\n  return sandbox;\n}\n\nfunction sha256(value) {\n  return crypto.createHash('sha256')\n    .update(typeof value === 'string' ? value : JSON.stringify(value))\n    .digest('hex');\n}\n\nfunction plain(value) {\n  return value === undefined ? undefined : JSON.parse(JSON.stringify(value));\n}\n\nfunction decisionSummary(result = {}) {\n  const audit = result?.decisionAudit || {};\n  const selected = audit?.selected || {};\n  return {\n    providerId: result?.providerId || ''\x2C\n    requestHash: result?.requestHash || ''\x2C\n    selectedCandidateId: result?.selectedCandidateId || selected?.candidateId || ''\x2C\n    selectedActionKind: result?.selectedDeclaration?.actionKind || selected?.actionKind || ''\x2C\n    selectedActionName:\n      selected?.actionName ||\n      result?.selectedDeclaration?.skill?.name ||\n      result?.selectedDeclaration?.skill?.\u9b42\u6280\u540d ||\n      result?.selectedDeclaration?.actionKind ||\n      ''\x2C\n    targetIds: plain(result?.selectedDeclaration?.targetIds || selected?.targetIds || [])\x2C\n    objectiveUtilityHEPP: Number(\n      selected?.objectiveUtilityHEPP ??\n      selected?.objectiveUtility ??\n      0\x2C\n    )\x2C\n    normalizedUtility: Number(selected?.normalizedUtility || 0)\x2C\n    candidateCount: Number(audit?.candidateCount || audit?.candidateAudit?.length || 0)\x2C\n    paretoCount: Number(audit?.paretoCount || 0)\x2C\n    selectionMode: String(selected?.selectionMode || audit?.decisionProfile?.selectionMode || '')\x2C\n    rejectionCode: String(selected?.rejectionCode || '')\x2C\n    primaryRouteKey: String(selected?.primaryRoute?.routeKey || selected?.route?.routeKey || '')\x2C\n    backupRouteKey: String(selected?.backupRoute?.routeKey || '')\x2C\n    causalFactCount: Array.isArray(selected?.causalValueFacts)\n      ? selected.causalValueFacts.length\n      : 0\x2C\n    candidateAuditHash: sha256(audit?.candidateAudit || audit?.scoreAudit || [])\x2C\n  };\n}\n\nfunction firstActionRecord(caseDefinition\x2C runtime\x2C decision\x2C preview) {\n  const world = structuredClone(caseDefinition.combatData);\n  const queue = runtime.buildActionQueue(world);\n  const firstEntry = queue[0];\n  if (!firstEntry?.char) throw new Error('PHASE9_FIRST_ACTOR_MISSING');\n  const actorId = String(preview.unitId(firstEntry.char) || '').trim();\n  const pendingNaturalUnits = queue.map(entry => entry.char).filter(Boolean);\n  const pendingNaturalActorIds = pendingNaturalUnits\n    .map(unit => String(preview.unitId(unit) || '').trim())\n    .filter(Boolean);\n  const pendingHostileActorIds = queue\n    .filter(entry => entry.side !== firstEntry.side)\n    .map(entry => String(preview.unitId(entry.char) || '').trim())\n    .filter(Boolean);\n  const opportunityId = `phase9:${caseDefinition.caseId}:natural:${actorId}`;\n  const actionOpportunity = {\n    role: 'ACTIVE'\x2C\n    sequence: 1\x2C\n    opportunityId\x2C\n    grantId: opportunityId\x2C\n    grantType: 'NATURAL_ACTION'\x2C\n    futureHostileResponseAllowed: pendingHostileActorIds.length > 0\x2C\n    pendingNaturalActorIds\x2C\n    pendingHostileActorIds\x2C\n    naturalActionBudget: pendingNaturalActorIds.length\x2C\n    battleHorizon: {\n      currentRound: Number(world?.\u56de\u5408 || 0)\x2C\n      finalRound: Number(world?.\u80dc\u8d1f\u6761\u4ef6?.maxRounds || caseDefinition.rounds || 1)\x2C\n      remainingRounds: Number(world?.\u80dc\u8d1f\u6761\u4ef6?.maxRounds || caseDefinition.rounds || 1)\x2C\n      naturalActionBudget: pendingNaturalActorIds.length\x2C\n    }\x2C\n  };\n  const sourceHash = preview.stableHash(world);\n  const runtimeSnapshot = plain(runtime.buildDecisionRuntimeSnapshot(world\x2C actorId\x2C actionOpportunity));\n  const knownOpportunityIds = new Set(\n    (runtimeSnapshot.opportunitySnapshot || [])\n      .map(entry => String(entry?.opportunityId || '').trim())\n      .filter(Boolean)\x2C\n  );\n  pendingNaturalUnits.forEach((unit\x2C index) => {\n    const pendingActorId = String(preview.unitId(unit) || '').trim();\n    const pendingOpportunityId = `phase9:${caseDefinition.caseId}:pending:${pendingActorId}`;\n    if (!pendingActorId || knownOpportunityIds.has(pendingOpportunityId)) return;\n    runtimeSnapshot.opportunitySnapshot.push({\n      opportunityId: pendingOpportunityId\x2C\n      ownerId: pendingActorId\x2C\n      role: 'ACTIVE'\x2C\n      grantType: 'NATURAL_ACTION'\x2C\n      sequence: index + 1\x2C\n      status: pendingActorId === actorId ? 'EXECUTING' : 'PENDING'\x2C\n    });\n  });\n  const prepareStartedAt = performance.now();\n  const request = decision.prepareDecisionRequest({\n    worldSnapshot: world\x2C\n    actorId\x2C\n    objectiveContract: world?.\u80dc\u8d1f\u6761\u4ef6 || {}\x2C\n    battleIntent: { mode: caseDefinition.intent\x2C objectives: world?.\u80dc\u8d1f\u6761\u4ef6 || {} }\x2C\n    beliefState: caseDefinition.initialBelief?.[actorId] || caseDefinition.initialBelief || {}\x2C\n    actionOpportunity\x2C\n    runtimeSnapshot\x2C\n    seed: `${caseDefinition.seed}:phase9:first`\x2C\n  });\n  const prepareDurationMs = Number((performance.now() - prepareStartedAt).toFixed(3));\n  const results = Object.fromEntries(providers.map(providerId => {\n    const startedAt = performance.now();\n    const providerResult = decision.runProvider({ providerId\x2C request });\n    return [providerId\x2C {\n      durationMs: Number((performance.now() - startedAt).toFixed(3))\x2C\n      ...decisionSummary(providerResult)\x2C\n    }];\n  }));\n  if (preview.stableHash(world) !== sourceHash) throw new Error('PROVIDER_MUTATED_STATE');\n  return {\n    caseId: caseDefinition.caseId\x2C\n    actorId\x2C\n    actorSide: firstEntry.side\x2C\n    sourceDataHashes: plain(caseDefinition.sourceDataHashes)\x2C\n    requestHash: request.requestHash\x2C\n    prepareDurationMs\x2C\n    routeCacheMetrics: plain(request.routeCacheMetrics || {})\x2C\n    candidateEnvelopeMetrics: plain(request.candidateEnvelopeMetrics || {})\x2C\n    candidateEnvelopeDeltaCount: Object.values(request.candidateEnvelopeDeltas || {})\n      .reduce((sum\x2C rows) => sum + (Array.isArray(rows) ? rows.length : 0)\x2C 0)\x2C\n    actionPoolOutcomeCounts: Object.values(request.actorCandidateRoutes || {})\n      .flatMap(route => route?.actionPoolEffects || [])\n      .reduce((counts\x2C effect) => {\n        const key = String(effect?.outcomeKind || 'UNKNOWN');\n        counts[key] = Number(counts[key] || 0) + 1;\n        return counts;\n      }\x2C {})\x2C\n    actionPoolEffectsByCandidate: Object.fromEntries(\n      Object.entries(request.actorCandidateRoutes || {})\n        .filter(([\x2C route]) => (route?.actionPoolEffects || []).length)\n        .map(([candidateId\x2C route]) => [\n          candidateId\x2C\n          (route.actionPoolEffects || []).map(effect => ({\n            targetId: effect.targetId\x2C\n            outcomeKind: effect.outcomeKind\x2C\n            windowId: effect.windowId\x2C\n            evidence: plain(effect.evidence || {})\x2C\n          }))\x2C\n        ])\x2C\n    )\x2C\n    candidateCount: request.frozenCandidates.length\x2C\n    candidateIdsHash: sha256(request.frozenCandidates.map(candidate => candidate.candidateId))\x2C\n    declarationFingerprintsHash: sha256(request.candidateFingerprintMap)\x2C\n    results\x2C\n  };\n}\n\nfunction fullBattleRecord(caseDefinition\x2C providerId\x2C runtime\x2C options = {}) {\n  const startedAt = performance.now();\n  const result = runtime.runBattleCase({\n    caseId: caseDefinition.caseId\x2C\n    seed: caseDefinition.seed\x2C\n    combatData: caseDefinition.combatData\x2C\n    mode: 'team_preview'\x2C\n    rounds: caseDefinition.rounds\x2C\n    initialBelief: caseDefinition.initialBelief\x2C\n    battleIntent: { mode: caseDefinition.intent }\x2C\n    selectedAction: caseDefinition.selectedAction\x2C\n    settings: {\n      providerId\x2C\n      disableRouteCatalogCache: options.disableRouteCatalogCache === true\x2C\n    }\x2C\n  });\n  const decisions = Array.isArray(result?.decisions) ? result.decisions : [];\n  const ledger = Array.isArray(result?.ledger) ? result.ledger : [];\n  const fatalCodes = (Array.isArray(result?.audit?.fatals) ? result.audit.fatals : [])\n    .map(item => String(item?.code || '').trim())\n    .filter(Boolean);\n  return {\n    caseId: caseDefinition.caseId\x2C\n    providerId\x2C\n    durationMs: Number((performance.now() - startedAt).toFixed(3))\x2C\n    roundsRequested: Number(result?.roundsRequested || caseDefinition.rounds || 0)\x2C\n    roundsExecuted: Number(result?.roundsExecuted || 0)\x2C\n    winner: String(result?.winner || '')\x2C\n    terminal: plain(result?.terminal || result?.objectiveResolution || null)\x2C\n    decisionCount: decisions.length\x2C\n    routeMetrics: decisions.reduce((totals\x2C decisionAudit) => {\n      const route = decisionAudit?.routeCacheMetrics || {};\n      const envelope = decisionAudit?.candidateEnvelopeMetrics || {};\n      totals.basePreviewCalls += Number(route.previewCalls || 0);\n      totals.baseRecomputedUnitCount += Number(route.recomputedUnitCount || 0);\n      totals.envelopePreviewCalls += Number(envelope.previewCalls || 0);\n      totals.envelopeReusedRouteCount += Number(envelope.reusedRouteCount || 0);\n      totals.envelopeRebuildCount += Number(envelope.rebuildCount || 0);\n      return totals;\n    }\x2C {\n      basePreviewCalls: 0\x2C\n      baseRecomputedUnitCount: 0\x2C\n      envelopePreviewCalls: 0\x2C\n      envelopeReusedRouteCount: 0\x2C\n      envelopeRebuildCount: 0\x2C\n    })\x2C\n    ledgerCount: ledger.length\x2C\n    actionQueueNodeCount: Array.isArray(result?.actionQueueTrace)\n      ? result.actionQueueTrace.length\n      : 0\x2C\n    decisionSequence: decisions.map(entry => ({\n      round: Number(entry?.round || 0)\x2C\n      actorId: String(entry?.actorId || '')\x2C\n      actionRole: String(entry?.actionRole || '')\x2C\n      opportunityId: String(entry?.opportunityId || '')\x2C\n      selectedCandidateId: String(entry?.selected?.candidateId || '')\x2C\n      selectedActionKind: String(entry?.selected?.declaration?.actionKind || '')\x2C\n      targetIds: plain(entry?.selected?.declaration?.targetIds || [])\x2C\n      objectiveUtilityHEPP: Number(\n        entry?.selected?.objectiveUtilityHEPP ??\n        entry?.selected?.objectiveUtility ??\n        0\x2C\n      )\x2C\n      rejectionCode: String(entry?.selected?.rejectionCode || '')\x2C\n    }))\x2C\n    fatalCount: Number(result?.audit?.fatalCount || 0)\x2C\n    fatalCodes\x2C\n    fatals: plain(result?.audit?.fatals || [])\x2C\n    ledgerHash: sha256(ledger)\x2C\n    decisionHash: sha256(decisions)\x2C\n    terminalHash: sha256(result?.terminal || result?.objectiveResolution || null)\x2C\n    finalSnapshotHash: sha256(result?.finalSnapshot || result?.snapshot || null)\x2C\n  };\n}\n\nfunction runFullBattleWorker(caseId\x2C providerId) {\n  const worker = spawnSync(\n    process.execPath\x2C\n    [fileURLToPath(import.meta.url)\x2C '--worker-full'\x2C caseId\x2C providerId]\x2C\n    {\n      cwd: repoRoot\x2C\n      encoding: 'utf8'\x2C\n      timeout: fullBattleTimeoutMs\x2C\n      maxBuffer: 64 * 1024 * 1024\x2C\n      windowsHide: true\x2C\n    }\x2C\n  );\n  if (worker.error?.code === 'ETIMEDOUT') {\n    return {\n      caseId\x2C\n      providerId\x2C\n      error: `PHASE9_FULL_BATTLE_TIMEOUT:${fullBattleTimeoutMs}`\x2C\n      timedOut: true\x2C\n    };\n  }\n  if (worker.status !== 0) {\n    return {\n      caseId\x2C\n      providerId\x2C\n      error: String(worker.stderr || worker.stdout || `PHASE9_FULL_BATTLE_WORKER_EXIT:${worker.status}`)\x2C\n      timedOut: false\x2C\n    };\n  }\n  try {\n    return JSON.parse(worker.stdout);\n  } catch (error) {\n    return {\n      caseId\x2C\n      providerId\x2C\n      error: `PHASE9_FULL_BATTLE_WORKER_OUTPUT_INVALID:${String(error?.message || error)}`\x2C\n      timedOut: false\x2C\n    };\n  }\n}\n\nfunction clusterFailures(firstActions = []\x2C fullBattles = []) {\n  const clusters = new Map();\n  const add = (clusterId\x2C item) => {\n    if (!clusters.has(clusterId)) clusters.set(clusterId\x2C []);\n    clusters.get(clusterId).push(item);\n  };\n  firstActions.forEach(record => {\n    if (record.error) add('FIRST_ACTION_EXECUTION_ERROR'\x2C {\n      caseId: record.caseId\x2C\n      error: record.error\x2C\n    });\n    for (const providerId of providers) {\n      const result = record?.results?.[providerId];\n      if (!result) continue;\n      if (!result.selectedCandidateId) {\n        add('PROVIDER_SELECTION_MISSING'\x2C { caseId: record.caseId\x2C providerId });\n      }\n      if (providerId === 'r8-shadow' && !result.primaryRouteKey) {\n        add('R8_PRIMARY_ROUTE_MISSING'\x2C { caseId: record.caseId\x2C providerId });\n      }\n      if (\n        providerId === 'r8-shadow' &&\n        result.causalFactCount === 0 &&\n        result.objectiveUtilityHEPP !== 0\n      ) {\n        add('R8_CAUSAL_FACT_MISSING'\x2C {\n          caseId: record.caseId\x2C\n          providerId\x2C\n          objectiveUtilityHEPP: result.objectiveUtilityHEPP\x2C\n        });\n      }\n    }\n  });\n  fullBattles.forEach(record => {\n    if (record.error) {\n      add('FULL_BATTLE_EXECUTION_ERROR'\x2C {\n        caseId: record.caseId\x2C\n        providerId: record.providerId\x2C\n        error: record.error\x2C\n      });\n      return;\n    }\n    record.fatalCodes.forEach(code => add(code\x2C {\n      caseId: record.caseId\x2C\n      providerId: record.providerId\x2C\n      fatalCount: record.fatalCodes.filter(value => value === code).length\x2C\n    }));\n    if (!record.decisionCount) {\n      add('FULL_BATTLE_DECISION_MISSING'\x2C {\n        caseId: record.caseId\x2C\n        providerId: record.providerId\x2C\n      });\n    }\n  });\n  return [...clusters.entries()]\n    .map(([clusterId\x2C items]) => ({\n      clusterId\x2C\n      occurrenceCount: items.length\x2C\n      affectedCaseIds: [...new Set(items.map(item => item.caseId))].sort()\x2C\n      affectedProviders: [...new Set(items.map(item => item.providerId).filter(Boolean))].sort()\x2C\n      items\x2C\n    }))\n    .sort((left\x2C right) =>\n      right.occurrenceCount - left.occurrenceCount ||\n      left.clusterId.localeCompare(right.clusterId)\n    );\n}\n\nconst sandbox = loadRuntime();\nconst preview = sandbox.__LWCS_BATTLE_PREVIEW__;\nconst decision = sandbox.__LWCS_BATTLE_DECISION__;\nconst runtime = sandbox.__LWCS_BATTLE_RUNTIME__;\nif (!preview || !decision || !runtime) throw new Error('PHASE9_RUNTIME_MISSING');\n\nconst manifest = JSON.parse(fs.readFileSync(manifestPath\x2C 'utf8'));\nconst manualCases = buildManualCases(\n  sandbox.__LWCS_\u5185\u7f6e\u89d2\u8272\u5e93__\x2C\n  sandbox.__LWCS_GET_BASE_STATS__\x2C\n);\nconst caseById = new Map(manualCases.map(item => [item.caseId\x2C item]));\nconst manifestCaseIds = manifest.snapshots.map(item => item.caseId);\nconst manualCaseIds = manualCases.map(item => item.caseId);\nif (\n  manifestCaseIds.length !== 24 ||\n  JSON.stringify([...manifestCaseIds].sort()) !== JSON.stringify([...manualCaseIds].sort())\n) {\n  throw new Error('PHASE9_REAL_CASE_MANIFEST_MISMATCH');\n}\nconst deepReviewCaseIds = [...manifest.deepReviewSelection.selectedCaseIds];\nif (deepReviewCaseIds.length !== 8 || deepReviewCaseIds.some(caseId => !caseById.has(caseId))) {\n  throw new Error('PHASE9_DEEP_REVIEW_SELECTION_INVALID');\n}\nconst workerIndex = process.argv.indexOf('--worker-full');\nif (workerIndex >= 0) {\n  const caseId = String(process.argv[workerIndex + 1] || '').trim();\n  const providerId = String(process.argv[workerIndex + 2] || '').trim();\n  if (!caseById.has(caseId) || !providers.includes(providerId)) {\n    throw new Error(`PHASE9_FULL_BATTLE_WORKER_INPUT_INVALID:${caseId}:${providerId}`);\n  }\n  const record = fullBattleRecord(caseById.get(caseId)\x2C providerId\x2C runtime\x2C {\n    disableRouteCatalogCache: process.argv.includes('--no-route-cache')\x2C\n  });\n  process.stdout.write(`${JSON.stringify(record)}\\n`);\n  process.exit(0);\n}\nconst firstWorkerIndex = process.argv.indexOf('--worker-first');\nif (firstWorkerIndex >= 0) {\n  const caseId = String(process.argv[firstWorkerIndex + 1] || '').trim();\n  if (!caseById.has(caseId)) {\n    throw new Error(`PHASE9_FIRST_ACTION_WORKER_INPUT_INVALID:${caseId}`);\n  }\n  const record = firstActionRecord(caseById.get(caseId)\x2C runtime\x2C decision\x2C preview);\n  process.stdout.write(`${JSON.stringify(record)}\\n`);\n  process.exit(0);\n}\n\nconst firstActions = [];\nif (mode !== 'full-battles') {\n  for (const caseDefinition of manualCases) {\n    process.stderr.write(`[phase9:first] ${caseDefinition.caseId}\\n`);\n    try {\n      firstActions.push(firstActionRecord(caseDefinition\x2C runtime\x2C decision\x2C preview));\n    } catch (error) {\n      firstActions.push({\n        caseId: caseDefinition.caseId\x2C\n        error: String(error?.stack || error?.message || error)\x2C\n      });\n    }\n  }\n}\n\nconst fullBattles = [];\nif (mode !== 'first-actions') {\n  for (const caseId of deepReviewCaseIds) {\n    for (const providerId of providers) {\n      process.stderr.write(`[phase9:full] ${caseId} ${providerId}\\n`);\n      fullBattles.push(runFullBattleWorker(caseId\x2C providerId));\n    }\n  }\n}\n\nconst rootCauseClusters = clusterFailures(firstActions\x2C fullBattles);\nconst output = {\n  schemaVersion: '8.3-phase9-batch-1'\x2C\n  generatedAt: new Date().toISOString()\x2C\n  mode\x2C\n  providers\x2C\n  manifestHash: sha256(manifest)\x2C\n  deepReviewCaseIds\x2C\n  summary: {\n    firstActionCaseCount: firstActions.length\x2C\n    firstActionErrorCount: firstActions.filter(item => item.error).length\x2C\n    fullBattleRunCount: fullBattles.length\x2C\n    fullBattleErrorCount: fullBattles.filter(item => item.error).length\x2C\n    fullBattleFatalCount: fullBattles.reduce(\n      (sum\x2C item) => sum + Number(item?.fatalCount || 0)\x2C\n      0\x2C\n    )\x2C\n    rootCauseClusterCount: rootCauseClusters.length\x2C\n    batchCollectionComplete:\n      (mode === 'full-battles' || firstActions.length === 24) &&\n      (mode === 'first-actions' || fullBattles.length === 16)\x2C\n  }\x2C\n  firstActions\x2C\n  fullBattles\x2C\n  rootCauseClusters\x2C\n};\n\nfs.mkdirSync(path.dirname(artifactPath)\x2C { recursive: true });\nfs.writeFileSync(artifactPath\x2C `${JSON.stringify(output\x2C null\x2C 2)}\\n`\x2C 'utf8');\nprocess.stdout.write(`${JSON.stringify(output\x2C null\x2C 2)}\\n`);\nprocess.exitCode =\n  output.summary.firstActionErrorCount > 0 ||\n  output.summary.fullBattleErrorCount > 0 ||\n  output.summary.fullBattleFatalCount > 0\n    ? 1\n    : 0;\n
