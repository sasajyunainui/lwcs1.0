\x2C { level: 70 })]\x2C [make('\u97e6\u5c0f\u67ab'\x2C { level: 45 })])\x2C\n  ];\n  const defaultVictory = [{ type: 'TEAM_INCAPACITATED'\x2C side: 'ENEMY'\x2C scope: 'ALL' }];\n  cases.find(item => item.caseId === 'team_control_overlap').combatData.\u65f6\u95f4\u6bb5 = '\u9ed1\u591c';\n  cases.find(item => item.caseId === 'team_unknown_enemy_adaptation').combatData.\u65f6\u95f4\u6bb5 = '\u9ed1\u591c';\n  cases.forEach(item => {\n    item.combatData.\u80dc\u8d1f\u6761\u4ef6 = objectiveContract(item.rounds\x2C defaultVictory);\n  });\n  const summonHeavyCase = cases.find(item => item.caseId === 'raid_summon_heavy');\n  summonHeavyCase.combatData.\u53c2\u6218\u8005.team_enemy.forEach(unit => {\n    const originalHpMax = Math.max(\n      1\x2C\n      Number(unit?.hp_max || unit?.\u5c5e\u6027?.HP\u4e0a\u9650 || unit?.vit_max || 1)\x2C\n    );\n    const durableHpMax = Math.max(originalHpMax\x2C Math.ceil(originalHpMax * 3));\n    const originalDefense = Math.max(1\x2C Number(unit?.def || unit?.\u5c5e\u6027?.\u9632\u5fa1 || 1));\n    const durableDefense = Math.max(originalDefense\x2C Math.ceil(originalDefense * 1.25));\n    unit.hp_max = durableHpMax;\n    unit.HP = durableHpMax;\n    unit.hp = durableHpMax;\n    unit.vit_max = durableHpMax;\n    unit.\u5c5e\u6027 = {\n      ...(unit.\u5c5e\u6027 || {})\x2C\n      HP: durableHpMax\x2C\n      HP\u4e0a\u9650: durableHpMax\x2C\n      \u4f53\u529b\u4e0a\u9650: durableHpMax\x2C\n      \u9632\u5fa1: durableDefense\x2C\n    };\n    unit.def = durableDefense;\n  });\n  summonHeavyCase.combatData.\u80dc\u8d1f\u6761\u4ef6 = objectiveContract(5\x2C [\n    { type: 'ROUND_REACHED'\x2C side: 'PLAYER'\x2C round: 5\x2C requireActive: true }\x2C\n  ]);\n  cases.find(item => item.caseId === 'duel_overmatch_nonlethal').combatData.\u80dc\u8d1f\u6761\u4ef6 = objectiveContract(4\x2C [\n    { type: 'HP_RATIO_AT_OR_BELOW'\x2C side: 'ENEMY'\x2C targetIds: ['\u97e6\u5c0f\u67ab']\x2C threshold: 0.01\x2C scope: 'ALL' }\x2C\n  ]);\n  ['duel_underdog_survival'\x2C 'duel_charge_defense_safer'].forEach(caseId => {\n    const item = cases.find(entry => entry.caseId === caseId);\n    item.combatData.\u80dc\u8d1f\u6761\u4ef6 = objectiveContract(item.rounds\x2C [\n      { type: 'ROUND_REACHED'\x2C side: 'PLAYER'\x2C round: item.rounds\x2C requireActive: true }\x2C\n    ]);\n  });\n  cases.find(item => item.caseId === 'duel_agile_single_target_failure').combatData.\u80dc\u8d1f\u6761\u4ef6 = objectiveContract(5\x2C [\n    { type: 'WITHDRAW_SUCCESS'\x2C side: 'PLAYER' }\x2C\n  ]);\n  ['summon_one_window'].forEach(caseId => {\n    const item = cases.find(entry => entry.caseId === caseId);\n    const actor = item.combatData.\u53c2\u6218\u8005.team_player.find(unit => unit?.name === '\u97e6\u5c0f\u67ab');\n    const summonSkill = actor?.\u7b2c1\u6b66\u9b42?.\u7b2c1\u9b42\u7075?.\u7b2c2\u9b42\u73af?.\u7b2c2\u9b42\u6280;\n    const target = item.combatData.\u53c2\u6218\u8005.team_enemy[0];\n    item.selectedAction = {\n      actorId: actor?.id || actor?.name || '\u97e6\u5c0f\u67ab'\x2C\n      actionKind: 'RELEASE_SKILL'\x2C\n      targetIds: [target?.id || target?.name].filter(Boolean)\x2C\n      skill: clone(summonSkill)\x2C\n    };\n  });\n  const equipmentCase = cases.find(item => item.caseId === 'equipment_switch_no_loop');\n  const equipmentActor = equipmentCase.combatData.\u53c2\u6218\u8005.team_player[0];\n  const equipmentItem = equipmentActor?.\u80cc\u5305?.\u75be\u98ce\u8bd5\u4f5c\u5315\u9996;\n  equipmentCase.selectedAction = {\n    actorId: equipmentActor?.id || equipmentActor?.name || '\u8c22\u9082'\x2C\n    actionKind: 'EQUIP'\x2C\n    targetIds: [equipmentActor?.id || equipmentActor?.name || '\u8c22\u9082']\x2C\n    skill: clone(equipmentItem)\x2C\n    irreversibleAsset: { assetId: equipmentItem?.id || 'r63-review-agility-dagger'\x2C cost: 0 }\x2C\n  };\n  const itemCase = cases.find(item => item.caseId === 'item_creation_consumption');\n  const itemProducer = itemCase.combatData.\u53c2\u6218\u8005.team_player.find(unit => unit?.name === '\u5f90\u7b20\u667a');\n  const recoverySkill = itemProducer?.\u7b2c1\u6b66\u9b42?.\u7b2c1\u9b42\u7075?.\u7b2c1\u9b42\u73af?.\u7b2c1\u9b42\u6280;\n  itemCase.combatData.\u53c2\u6218\u8005.team_enemy.forEach(unit => {\n    unit.hp = 20000;\n    unit.HP = 20000;\n    unit.hp_max = 20000;\n    unit.\u5c5e\u6027.HP = 20000;\n    unit.\u5c5e\u6027.HP\u4e0a\u9650 = 20000;\n    unit.str = 1000;\n    unit.def = 5000;\n    unit.\u5c5e\u6027.\u529b\u91cf = 1000;\n    unit.\u5c5e\u6027.\u9632\u5fa1 = 5000;\n  });\n  itemCase.selectedAction = {\n    actorId: itemProducer?.id || itemProducer?.name || '\u5f90\u7b20\u667a'\x2C\n    actionKind: 'RELEASE_SKILL'\x2C\n    targetIds: [itemProducer?.id || itemProducer?.name || '\u5f90\u7b20\u667a']\x2C\n    skill: clone(recoverySkill)\x2C\n  };\n  cases.find(item => item.caseId === 'team_protect_critical_ally').combatData.\u80dc\u8d1f\u6761\u4ef6 = objectiveContract(4\x2C [\n    { type: 'ROUND_REACHED'\x2C side: 'PLAYER'\x2C round: 4\x2C requireActive: true }\x2C\n  ]\x2C [\n    { type: 'UNIT_INCAPACITATED'\x2C side: 'PLAYER'\x2C targetIds: ['\u821e\u957f\u7a7a']\x2C scope: 'ANY' }\x2C\n  ]);\n  cases.find(item => item.caseId === 'team_heal_crisis').combatData.\u80dc\u8d1f\u6761\u4ef6 = objectiveContract(4\x2C [\n    { type: 'ROUND_REACHED'\x2C side: 'PLAYER'\x2C round: 4\x2C requireActive: true }\x2C\n  ]\x2C [\n    { type: 'UNIT_INCAPACITATED'\x2C side: 'PLAYER'\x2C targetIds: ['\u821e\u957f\u7a7a'\x2C '\u53e4\u6708']\x2C scope: 'ANY' }\x2C\n  ]);\n  cases.find(item => item.caseId === 'item_creation_consumption').combatData.\u80dc\u8d1f\u6761\u4ef6 = objectiveContract(6\x2C [\n    { type: 'ROUND_REACHED'\x2C side: 'PLAYER'\x2C round: 6\x2C requireActive: true }\x2C\n  ]\x2C [\n    { type: 'TEAM_INCAPACITATED'\x2C side: 'PLAYER'\x2C scope: 'ALL' }\x2C\n  ]);\n  cases.find(item => item.caseId === 'intent_capture_vs_kill').combatData.\u80dc\u8d1f\u6761\u4ef6 = objectiveContract(6\x2C [\n    { type: 'HP_RATIO_AT_OR_BELOW'\x2C side: 'ENEMY'\x2C targetIds: ['\u97e6\u5c0f\u67ab']\x2C threshold: 0.3\x2C scope: 'ALL' }\x2C\n  ]);\n  cases.find(item => item.caseId === 'duel_agile_counter_options').seed = 630071;\n  cases.find(item => item.caseId === 'team_counter_coordination').seed = 630071;\n  return cases;\n}\n
