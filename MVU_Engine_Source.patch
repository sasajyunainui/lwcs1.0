+type MvuPromptProjector = (
+    full_state: unknown,
+    context: Record<string, unknown>
+) => unknown;
+
+function findMvuPromptProjector(): MvuPromptProjector | null {
+    const candidates: any[] = [];
+    const add = (candidate: any) => {
+        if (candidate && !candidates.includes(candidate)) candidates.push(candidate);
+    };
+    add(globalThis);
+    try { add((globalThis as any).parent); } catch { /* optional parent window */ }
+    try { add((globalThis as any).top); } catch { /* optional top window */ }
+    return candidates
+        .map(candidate => candidate?.__LWCS_MVU_PROMPT_PROJECTOR_V1__)
+        .find(value => typeof value === 'function') ?? null;
+}
+
+function buildProjectedMvuContext(): string {
+    const projector = findMvuPromptProjector();
+    if (!projector) return '';
+    try {
+        const full_state = getCanonicalMvuData({ type: 'chat' });
+        const state = full_state as Record<string, any>;
+        const message = getChatMessages(-1, { include_swipes: true }).at(-1) as
+            | Record<string, any>
+            | undefined;
+        const message_text = typeof message?.message === 'string'
+            ? message.message
+            : typeof message?.mes === 'string'
+                ? message.mes
+                : '';
+        const player_name = String(
+            state?.sys?.玩家名
+            ?? state?.sys?.playerName
+            ?? message?.name
+            ?? ''
+        ).trim();
+        const player = player_name ? state?.char?.[player_name] : undefined;
+        const current_location = String(
+            state?.world?.当前地点
+            ?? player?.状态?.位置
+            ?? player?.位置
+            ?? ''
+        ).trim();
+        const explicit_mentions = message?.extra?.mentionedEntities
+            ?? message?.extra?.mentioned_entities
+            ?? message?.extra?.mentions
+            ?? message?.mentionedEntities
+            ?? message?.mentions;
+        const projected = projector(full_state, {
+            text: message_text,
+            message: message_text,
+            playerName: player_name,
+            currentLocation: current_location,
+            mentionedEntities: Array.isArray(explicit_mentions) ? explicit_mentions : [],
+        });
+        if (projected === undefined || projected === null) return '';
+        return `<mvu_projected_context>\n${JSON.stringify(projected)}\n</mvu_projected_context>`;
+    } catch (error) {
+        console.warn('[LWCS MVU] 额外模型提示投影失败，跳过投影上下文', error);
+        return '';
+    }
+}
