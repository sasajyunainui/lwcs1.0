    "replaceString": "```html\n<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<style>\n.dl-panel,\n.dl-panel * {\n  box-sizing: border-box;\n}\n\n.dl-panel {\n  --主题主色: #00ffcc;\n  --主题辅色: #0a192f;\n  --主题高光: #ffffff;\n  --主题底色: #06111e;\n  --投影背景: rgba(0, 255, 204, 0.055);\n  --实体背景: rgba(255, 255, 255, 0.075);\n  --虚幻背景: rgba(255, 255, 255, 0.04);\n  --投影圆角: 2px;\n  --主题发光: 0 0 18px rgba(0, 255, 204, 0.46);\n  --边线颜色: rgba(0, 255, 204, 0.32);\n  --文字主色: #e9fffb;\n  --文字弱色: #8ba9b7;\n  --抽屉缓动: ease;\n  --虚化强度: blur(8px);\n  --字号倍率: 1;\n  --阅读行高: 1.68;\n  --魂环十年: #f4f7fb;\n  --魂环百年: #ffd45a;\n  --魂环千年: #b77cff;\n  --魂环万年: #1b1b22;\n  --魂环十万年: #ff3d53;\n  --魂环神级: #ffdf70;\n  --魂环当前色: var(--魂环千年);\n  --魂环当前阴影: rgba(183, 124, 255, 0.42);\n  position: relative;\n  z-index: 0;\n  margin: 10px 0;\n  overflow: hidden;\n  isolation: isolate;\n  color: var(--文字主色);\n  font-family: \"Noto Serif SC\", \"Source Han Serif SC\", \"Microsoft YaHei\", serif;\n  font-size: calc(14px * var(--字号倍率));\n  line-height: var(--阅读行高);\n  border: 1px solid rgba(118, 226, 255, 0.15);\n  border-radius: var(--投影圆角);\n  background: rgba(5, 12, 18, 0.4);\n  backdrop-filter: blur(8px);\n  -webkit-backdrop-filter: blur(8px);\n  box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);\n}\n\n.dl-panel[data-theme=\"炫世唐门\"] {\n  --主题主色: #00ffcc;\n  --主题辅色: #0a192f;\n  --主题高光: #ffffff;\n  --主题底色: #06111e;\n  --投影背景: rgba(0, 255, 204, 0.055);\n  --实体背景: rgba(0, 255, 204, 0.085);\n  --虚幻背景: rgba(0, 255, 204, 0.04);\n  --投影圆角: 2px;\n  --主题发光: 0 0 18px rgba(0, 255, 204, 0.46);\n  --边线颜色: rgba(0, 255, 204, 0.34);\n  --文字主色: #e9fffb;\n  --文字弱色: #8ba9b7;\n}\n\n.dl-panel[data-theme=\"金龙王\"] {\n  --主题主色: #ff3300;\n  --主题辅色: #1a0505;\n  --主题高光: #ffd700;\n  --主题底色: #140303;\n  --投影背景: rgba(255, 51, 0, 0.07);\n  --实体背景: rgba(255, 170, 0, 0.105);\n  --虚幻背景: rgba(255, 51, 0, 0.05);\n  --投影圆角: 0px;\n  --主题发光: 0 0 22px rgba(255, 51, 0, 0.42);\n  --边线颜色: rgba(255, 215, 0, 0.42);\n  --文字主色: #fff0d7;\n  --文字弱色: #c9966c;\n  --抽屉缓动: cubic-bezier(0.8, 0, 0.2, 1);\n  border-width: 2px;\n}\n\n.dl-panel[data-theme=\"银龙王\"] {\n  --主题主色: #e0eaff;\n  --主题辅色: rgba(255, 255, 255, 0.12);\n  --主题高光: #ffffff;\n  --主题底色: rgba(10, 14, 24, 0.72);\n  --投影背景: rgba(255, 255, 255, 0.1);\n  --实体背景: rgba(255, 255, 255, 0.11);\n  --虚幻背景: rgba(255, 255, 255, 0.055);\n  --投影圆角: 20px;\n  --主题发光: inset 0 0 18px rgba(255,255,255,0.12), 0 0 20px rgba(224, 234, 255, 0.28);\n  --边线颜色: rgba(255, 255, 255, 0.3);\n  --文字主色: #f7fbff;\n  --文字弱色: #b8c7da;\n  --虚化强度: blur(16px);\n}\n\n.dl-panel[data-theme=\"幻海蝶舞\"] {\n  --主题主色: #00d2ff;\n  --主题辅色: #ff7eb3;\n  --主题高光: #ffd700;\n  --主题底色: #062333;\n  --投影背景: linear-gradient(135deg, rgba(0, 210, 255, 0.08), rgba(255, 126, 179, 0.08), rgba(255, 215, 0, 0.05));\n  --实体背景: rgba(255, 255, 255, 0.11);\n  --虚幻背景: rgba(0, 210, 255, 0.045);\n  --投影圆角: 30px 40px 20px 40px;\n  --主题发光: 0 0 15px rgba(0, 210, 255, 0.4), inset 0 0 20px rgba(255, 126, 179, 0.2);\n  --边线颜色: rgba(255, 255, 255, 0.18);\n  --文字主色: #f7feff;\n  --文字弱色: #8ec9d7;\n  --虚化强度: blur(12px) saturate(110%);\n}\n\n.dl-buffer {\n  display: none;\n}\n\n.dl-shard-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 10px 12px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n  background: rgba(0, 0, 0, 0.2);\n}\n\n.dl-route-badge {\n  display: inline-flex;\n  align-items: center;\n  padding: 4px 10px;\n  border-radius: 999px;\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 0.05em;\n}\n\n.dl-route-badge[data-hit=\"true\"] {\n  background: rgba(0, 255, 204, 0.15);\n  border: 1px solid rgba(0, 255, 204, 0.3);\n  color: #00ffcc;\n  box-shadow: 0 0 10px rgba(0, 255, 204, 0.2);\n}\n\n.dl-route-badge[data-hit=\"false\"] {\n  background: rgba(255, 255, 255, 0.1);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  color: #ccc;\n}\n\n.dl-shard-meta {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  font-size: 12px;\n  color: var(--文字弱色);\n}\n\n.dl-shard-viewport {\n  position: relative;\n  max-height: 50vh;\n  overflow-y: auto;\n  overflow-x: hidden;\n  padding: 12px;\n  scrollbar-width: thin;\n  scrollbar-color: rgba(255, 255, 255, 0.2) transparent;\n}\n\n.dl-shard-viewport::-webkit-scrollbar {\n  width: 4px;\n}\n\n.dl-shard-viewport::-webkit-scrollbar-thumb {\n  background: rgba(255, 255, 255, 0.2);\n  border-radius: 999px;\n}\n\n.dl-shard-page {\n  display: none;\n  animation: dl-flicker 0.15s ease-out forwards;\n}\n\n.dl-shard-page.active {\n  display: block;\n}\n\n.dl-shard-dock {\n  display: flex;\n  border-top: 1px solid rgba(255, 255, 255, 0.08);\n  background: rgba(0, 0, 0, 0.3);\n}\n\n.dl-dock-btn {\n  flex: 1;\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  padding: 12px 0;\n  border: none;\n  background: transparent;\n  color: var(--文字弱色);\n  font-size: 13px;\n  font-weight: 700;\n  cursor: pointer;\n  transition: color 0.2s, background 0.2s;\n  opacity: 0.6;\n}\n\n.dl-dock-btn:hover:not(:disabled) {\n  background: rgba(255, 255, 255, 0.05);\n  opacity: 0.8;\n}\n\n.dl-dock-btn.active {\n  color: var(--文字主色);\n  opacity: 1;\n}\n\n.dl-dock-btn.active::after {\n  content: \"\";\n  position: absolute;\n  bottom: 0;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 30px;\n  height: 3px;\n  border-radius: 3px 3px 0 0;\n  background: var(--主题主色);\n  box-shadow: 0 -2px 8px var(--主题主色);\n}\n\n.dl-dock-btn:disabled {\n  cursor: not-allowed;\n  opacity: 0.3;\n}\n\n@keyframes dl-flicker {\n  0% { opacity: 0; filter: blur(4px) contrast(2); }\n  50% { opacity: 0.5; filter: blur(2px) contrast(1.5); }\n  100% { opacity: 1; filter: blur(0) contrast(1); }\n}\n\n.dl-theme-button,\n.dl-tool-button,\n.dl-read-more,\n.dl-accordion-head {\n  font: inherit;\n}\n\n.dl-theme-button,\n.dl-tool-button {\n  border: 1px solid var(--边线颜色);\n  background: color-mix(in srgb, var(--主题主色) 10%, transparent);\n  color: var(--文字主色);\n  display: inline-grid;\n  place-items: center;\n  padding: 0;\n  cursor: pointer;\n  box-shadow: var(--主题发光);\n  backdrop-filter: var(--虚化强度);\n  transition: transform 0.16s ease, border-color 0.16s ease, background 0.16s ease;\n}\n\n.dl-tool-button {\n  width: 30px;\n  height: 30px;\n  border-radius: 999px;\n}\n\n.dl-theme-button {\n  width: 18px;\n  height: 18px;\n  border-radius: 999px;\n}\n\n.dl-theme-button:hover,\n.dl-tool-button:hover {\n  transform: translateY(-1px);\n  border-color: var(--主题主色);\n}\n\n.dl-theme-button[data-theme-name=\"炫世唐门\"] { background: linear-gradient(135deg, #0a192f, #00ffcc); }\n.dl-theme-button[data-theme-name=\"金龙王\"] { background: linear-gradient(135deg, #1a0505, #ff3300 58%, #ffd700); border-radius: 0; }\n.dl-theme-button[data-theme-name=\"银龙王\"] { background: linear-gradient(135deg, rgba(11,12,16,.6), #e0eaff); }\n.dl-theme-button[data-theme-name=\"幻海蝶舞\"] { background: linear-gradient(135deg, #00d2ff, #ff7eb3 55%, #ffd700); }\n.dl-theme-button[aria-pressed=\"true\"] { outline: 2px solid var(--主题主色); outline-offset: 2px; }\n\n.dl-icon {\n  width: 16px;\n  height: 16px;\n  stroke: currentColor;\n  stroke-width: 2;\n  fill: none;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n\n.dl-scene-bar {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n  margin: 0 0 10px;\n  transition: opacity 0.18s ease, filter 0.18s ease, transform 0.18s ease;\n}\n\n.dl-scene-chip,\n.dl-ring-chip {\n  display: inline-flex;\n  align-items: center;\n  max-width: 100%;\n  padding: 2px 8px;\n  border: 1px solid color-mix(in srgb, var(--魂环当前色) 52%, transparent);\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--魂环当前色) 13%, transparent);\n  color: color-mix(in srgb, var(--文字主色) 76%, var(--魂环当前色));\n  font-family: \"Cascadia Code\", Consolas, \"Microsoft YaHei\", sans-serif;\n  font-size: calc(11px * var(--字号倍率));\n  font-weight: 800;\n  word-break: break-word;\n}\n\n.dl-profiles {\n  display: flex;\n  gap: 8px;\n  overflow-x: auto;\n  padding: 1px 0 8px;\n  scrollbar-width: thin;\n  transition: opacity 0.18s ease, filter 0.18s ease, transform 0.18s ease;\n}\n\n.dl-profile-card {\n  --魂环当前色: var(--魂环百年);\n  flex: 0 0 min(230px, 78%);\n  border: 1px solid color-mix(in srgb, var(--魂环当前色) 50%, transparent);\n  border-left: 4px solid var(--魂环当前色);\n  border-radius: var(--投影圆角);\n  background: var(--实体背景);\n  box-shadow: 2px 4px 10px rgba(0,0,0,0.3), 0 0 10px var(--魂环当前阴影);\n  padding: 9px;\n  cursor: pointer;\n}\n\n.dl-profile-head {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  min-width: 0;\n}\n\n.dl-avatar {\n  width: 30px;\n  height: 30px;\n  flex: 0 0 auto;\n  display: grid;\n  place-items: center;\n  border-radius: var(--投影圆角);\n  border: 1px solid color-mix(in srgb, var(--魂环当前色) 46%, transparent);\n  color: var(--魂环当前色);\n  background: color-mix(in srgb, var(--魂环当前色) 10%, transparent);\n  font-weight: 900;\n}\n\n.dl-profile-name {\n  color: var(--魂环当前色);\n  font-weight: 900;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.dl-profile-summary {\n  color: var(--文字弱色);\n  font-size: calc(11px * var(--字号倍率));\n  margin-top: 2px;\n  overflow: hidden;\n  white-space: nowrap;\n  text-overflow: ellipsis;\n}\n\n.dl-profile-detail {\n  display: none;\n  margin-top: 8px;\n  padding-top: 8px;\n  border-top: 1px solid var(--边线颜色);\n}\n\n.dl-profile-card[data-open=\"true\"] .dl-profile-detail {\n  display: block;\n}\n\n.dl-story-flow {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-width: 0;\n  transition: opacity 0.18s ease, filter 0.18s ease, transform 0.18s ease;\n}\n\n.dl-card-act {\n  --魂环当前色: var(--魂环千年);\n  position: relative;\n  border: 1px solid rgba(255, 255, 255, 0.05);\n  border-left: 4px solid var(--魂环当前色);\n  border-radius: 0 8px 8px 0;\n  background: rgba(0, 0, 0, 0.2);\n  box-shadow: 2px 4px 10px rgba(0,0,0,0.2);\n  padding: 11px 12px 11px 14px;\n  font-weight: 600;\n  min-width: 0;\n}\n\n.dl-card-title,\n.dl-card-name {\n  color: var(--魂环当前色);\n  font-weight: 900;\n  margin-bottom: 7px;\n  text-shadow: 0 0 8px var(--魂环当前阴影);\n}\n\n.dl-fields {\n  display: grid;\n  gap: 7px;\n}\n\n.dl-field-row {\n  display: grid;\n  grid-template-columns: 82px minmax(0, 1fr);\n  gap: 8px;\n  align-items: start;\n}\n\n.dl-field-name {\n  color: var(--文字弱色);\n  font-family: \"Cascadia Code\", Consolas, \"Microsoft YaHei\", sans-serif;\n  font-size: calc(11px * var(--字号倍率));\n  font-weight: 900;\n}\n\n.dl-field-value {\n  white-space: pre-wrap;\n  word-break: break-word;\n}\n\n.dl-dialogue {\n  color: color-mix(in srgb, var(--文字主色) 70%, var(--魂环当前色));\n  font-weight: 900;\n}\n\n.dl-card-inner {\n  --魂环当前色: var(--魂环百年);\n  margin: 2px 0 0 24px;\n  padding: 8px 12px 10px;\n  border: 0;\n  border-radius: 8px;\n  background: linear-gradient(90deg, rgba(255, 255, 255, 0.05), transparent);\n  color: rgba(255, 255, 255, 0.7);\n  backdrop-filter: blur(4px);\n  font-style: italic;\n}\n\n.dl-card-act > .dl-card-inner {\n  margin-top: 7px;\n  margin-bottom: -4px;\n}\n\n.dl-stage-text {\n  position: relative;\n  padding: 8px 12px;\n  border: 0;\n  color: var(--文字主色);\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n.dl-stage-text[data-collapsed=\"true\"] .dl-stage-body {\n  max-height: 200px;\n  overflow: hidden;\n  mask-image: linear-gradient(180deg, #000 72%, transparent);\n}\n\n.dl-read-more {\n  margin-top: 7px;\n  border: 1px solid color-mix(in srgb, var(--魂环当前色) 44%, transparent);\n  border-radius: 999px;\n  background: color-mix(in srgb, var(--魂环当前色) 10%, transparent);\n  color: color-mix(in srgb, var(--文字主色) 70%, var(--魂环当前色));\n  padding: 3px 10px;\n  cursor: pointer;\n  font-size: calc(11px * var(--字号倍率));\n}\n\n\n\n.dl-drawer-section {\n  margin-bottom: 10px;\n}\n\n.dl-drawer-section-title {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: var(--主题主色);\n  font-size: calc(12px * var(--字号倍率));\n  font-weight: 900;\n  margin-bottom: 8px;\n}\n\n.dl-drawer-section-title::after {\n  content: \"\";\n  flex: 1;\n  height: 1px;\n  background: linear-gradient(90deg, var(--边线颜色), transparent);\n}\n\n.dl-route-box,\n.dl-world-card,\n.dl-step-item,\n.dl-accordion-item {\n  border: 1px solid color-mix(in srgb, var(--魂环当前色) 44%, transparent);\n  border-radius: var(--投影圆角);\n  background: color-mix(in srgb, var(--魂环当前色) 7%, transparent);\n  padding: 9px;\n  margin-bottom: 8px;\n}\n\n.dl-route-box[data-route-hit=\"true\"] {\n  border-color: var(--魂环千年);\n  background: rgba(0, 0, 0, 0.3);\n}\n\n.dl-review-steps {\n  position: relative;\n  display: grid;\n  gap: 8px;\n}\n\n.dl-step-item {\n  position: relative;\n  margin-left: 12px;\n  border-left: 3px solid var(--魂环当前色);\n}\n\n.dl-step-item::before {\n  content: \"\";\n  position: absolute;\n  left: -18px;\n  top: 13px;\n  width: 8px;\n  height: 8px;\n  border-radius: 999px;\n  background: var(--魂环当前色);\n  box-shadow: 0 0 10px var(--魂环当前阴影);\n}\n\n.dl-step-title {\n  color: var(--魂环当前色);\n  font-weight: 900;\n  margin-bottom: 4px;\n}\n\n.dl-accordion-head {\n  width: 100%;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 8px;\n  border: 0;\n  background: transparent;\n  color: var(--主题主色);\n  padding: 0;\n  cursor: pointer;\n  text-align: left;\n  font-weight: 900;\n}\n\n.dl-accordion-body {\n  display: none;\n  margin-top: 8px;\n}\n\n.dl-accordion-item[data-open=\"true\"] .dl-accordion-body {\n  display: block;\n}\n\n.dl-text-block {\n  white-space: pre-wrap;\n  word-break: break-word;\n  font-family: \"Cascadia Code\", Consolas, monospace;\n  font-size: 12px;\n  color: #a8c7fa;\n}\n\n.dl-empty {\n  color: var(--文字弱色);\n  padding: 10px 0;\n  font-size: calc(12px * var(--字号倍率));\n}\n\n.dl-hidden {\n  display: none !important;\n}\n\n.dl-ring-white {\n  --魂环当前色: var(--魂环十年);\n  --魂环当前阴影: rgba(244, 247, 251, 0.25);\n}\n\n.dl-ring-yellow {\n  --魂环当前色: var(--魂环百年);\n  --魂环当前阴影: rgba(255, 212, 90, 0.38);\n}\n\n.dl-ring-purple {\n  --魂环当前色: var(--魂环千年);\n  --魂环当前阴影: rgba(183, 124, 255, 0.42);\n}\n\n.dl-ring-black {\n  --魂环当前色: var(--魂环万年);\n  --魂环当前阴影: rgba(255, 83, 99, 0.32);\n}\n\n.dl-ring-red {\n  --魂环当前色: var(--魂环十万年);\n  --魂环当前阴影: rgba(255, 61, 83, 0.48);\n}\n\n.dl-ring-gold {\n  --魂环当前色: var(--魂环神级);\n  --魂环当前阴影: rgba(255, 223, 112, 0.55);\n}\n\n.dl-panel[data-density=\"紧凑\"] {\n  --阅读行高: 1.48;\n}\n\n\n</style>\n<div class=\"dl-panel\" id=\"dl-panel-$uid\" data-theme=\"炫世唐门\" data-density=\"标准\">\n  <textarea class=\"dl-buffer\" id=\"dl-buffer-$uid\" style=\"display:none\">$1</textarea>\n  <header class=\"dl-shard-header\">\n    <span class=\"dl-route-badge\" data-role=\"路由指示灯\"></span>\n    <div class=\"dl-shard-meta\">\n      <span data-role=\"统计\"></span>\n      <div class=\"dl-controls\">\n        <button class=\"dl-theme-button\" type=\"button\" title=\"炫世唐门\" data-theme-name=\"炫世唐门\" aria-pressed=\"true\"></button>\n        <button class=\"dl-theme-button\" type=\"button\" title=\"金龙王\" data-theme-name=\"金龙王\" aria-pressed=\"false\"></button>\n        <button class=\"dl-theme-button\" type=\"button\" title=\"银龙王\" data-theme-name=\"银龙王\" aria-pressed=\"false\"></button>\n        <button class=\"dl-theme-button\" type=\"button\" title=\"幻海蝶舞\" data-theme-name=\"幻海蝶舞\" aria-pressed=\"false\"></button>\n        <button class=\"dl-tool-button\" type=\"button\" title=\"字号\" data-action=\"font\" aria-label=\"字号\">\n          <svg class=\"dl-icon\" viewBox=\"0 0 24 24\"><path d=\"M4 7V5h10v2M9 5v14M6 19h6M15 11h5M17.5 11v8M15.5 19h4\"/></svg>\n        </button>\n        <button class=\"dl-tool-button\" type=\"button\" title=\"密度\" data-action=\"density\" aria-label=\"密度\">\n          <svg class=\"dl-icon\" viewBox=\"0 0 24 24\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></svg>\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <div class=\"dl-shard-viewport\">\n    <div class=\"dl-shard-page active\" data-page=\"story\">\n      <section class=\"dl-story-flow\" data-role=\"page-story\"></section>\n    </div>\n    <div class=\"dl-shard-page\" data-page=\"actions\">\n      <section class=\"dl-story-flow\" data-role=\"page-actions\"></section>\n    </div>\n    <div class=\"dl-shard-page\" data-page=\"dm\">\n      <section class=\"dl-drawer-section\" data-role=\"路由盒\"></section>\n      <section class=\"dl-drawer-section\" data-role=\"审查步骤\"></section>\n      <section class=\"dl-drawer-section\" data-role=\"幕后折叠\"></section>\n      <section class=\"dl-drawer-section\" data-role=\"世界账本\"></section>\n    </div>\n  </div>\n\n  <nav class=\"dl-shard-dock\">\n    <button class=\"dl-dock-btn active\" data-target=\"story\">\n      📖 剧情流\n    </button>\n    <button class=\"dl-dock-btn\" data-target=\"actions\">\n      🎭 动作监测 <span data-role=\"动作计数\"></span>\n    </button>\n    <button class=\"dl-dock-btn\" data-target=\"dm\">\n      👁️‍🗨️ DM 审查\n    </button>\n  </nav>\n</div>\n<script>\n(function () {\n  'use strict';\n\n  const 主题列表 = ['炫世唐门', '金龙王', '银龙王', '幻海蝶舞'];\n  const 主题存储键 = 'lwcs_hanayume_plot_regex_theme_v2';\n  const 字号存储键 = 'lwcs_hanayume_plot_regex_font_v2';\n  const 密度存储键 = 'lwcs_hanayume_plot_regex_density_v2';\n  const 字号列表 = ['0.92', '1', '1.08', '1.16'];\n  const 空值正则 = /^(?:无|暂无|none|null|n\\/a)$/i;\n\n  const 魂环规则 = [\n    ['dl-ring-gold', /大成功|法则|世界书|覆盖|融合技|神级|奇迹|天命/],\n    ['dl-ring-red', /重伤|死亡|极危|崩溃|核心冲突|爆发|濒死|血|杀/],\n    ['dl-ring-black', /警告|失败|扣除|敌意|战斗|检定|危险|battle|check|惩罚/],\n    ['dl-ring-purple', /关键|推进|支线|核心行动|线索|重要|突破|主线/],\n    ['dl-ring-yellow', /轻微|获得|发现|变化|提示|次要|普通物品|调整/],\n    ['dl-ring-white', /普通|闲聊|未命中|无变化|日常|无显著/]\n  ];\n\n  function 新建(标签, 类名, 文本) {\n    const 节点 = document.createElement(标签);\n    if (类名) 节点.className = 类名;\n    if (文本 !== undefined && 文本 !== null) 节点.textContent = 文本;\n    return 节点;\n  }\n\n  function 清空(节点) {\n    if (节点) 节点.replaceChildren();\n  }\n\n  function 读存储(键, 默认值) {\n    try {\n      return localStorage.getItem(键) || 默认值;\n    } catch (错误) {\n      return 默认值;\n    }\n  }\n\n  function 写存储(键, 值) {\n    try {\n      localStorage.setItem(键, 值);\n    } catch (错误) {\n      console.warn('设置保存失败', 键, 错误);\n    }\n  }\n\n  function 取文本(节点) {\n    return (节点?.textContent || '').trim();\n  }\n\n  function 是空内容(内容) {\n    const 文本 = String(内容 || '').trim();\n    return !文本 || 空值正则.test(文本);\n  }\n\n  function 切行(内容) {\n    return String(内容 || '').split(/\\r?\\n/).map(行 => 行.trim()).filter(Boolean);\n  }\n\n  function 找分隔位置(行) {\n    const 候选 = [行.indexOf(':'), 行.indexOf('：'), 行.indexOf('=')].filter(位置 => 位置 >= 0);\n    if (!候选.length) return -1;\n    return Math.min(...候选);\n  }\n\n  function 按行键值(内容) {\n    return 切行(内容).map(行 => {\n      const 位置 = 找分隔位置(行);\n      if (位置 < 0 || 位置 > 24) return { 键: '', 值: 行 };\n      return { 键: 行.slice(0, 位置).trim(), 值: 行.slice(位置 + 1).trim() };\n    });\n  }\n\n  function 取属性(节点, 名称) {\n    return (节点?.getAttribute?.(名称) || '').trim();\n  }\n\n  function 解析文档(原文) {\n    const 包裹 = `<dl-root>${原文}</dl-root>`;\n    const 文档 = new DOMParser().parseFromString(包裹, 'text/xml');\n    if (!文档.getElementsByTagName('parsererror').length) return 文档;\n    const 修复文本 = 包裹.replace(/&(?!amp;|lt;|gt;|quot;|apos;|#\\d+;|#x[0-9a-fA-F]+;)/g, '&amp;');\n    return new DOMParser().parseFromString(修复文本, 'text/xml');\n  }\n\n  function 取全部(文档, 标签) {\n    return Array.from(文档.getElementsByTagName(标签));\n  }\n\n  function 取单个文本(文档, 标签) {\n    return 取文本(文档.getElementsByTagName(标签)[0]);\n  }\n\n  function 取摘要(内容) {\n    const 第一行 = 切行(内容)[0] || '';\n    const 位置 = 找分隔位置(第一行);\n    const 文本 = 位置 >= 0 && 位置 <= 18 ? 第一行.slice(位置 + 1).trim() : 第一行;\n    return 文本.length > 42 ? `${文本.slice(0, 42)}...` : 文本;\n  }\n\n  function 取头像字(名称) {\n    return Array.from(String(名称 || '？').trim())[0] || '？';\n  }\n\n  function 取魂环类(文本, 默认类) {\n    const 内容 = String(文本 || '');\n    for (const [类名, 正则] of 魂环规则) {\n      if (正则.test(内容)) return 类名;\n    }\n    return 默认类;\n  }\n\n  function 应用魂环(节点, 类名) {\n    节点.classList.add(类名 || 'dl-ring-white');\n    return 节点;\n  }\n\n  function 生成字段组(内容, 高亮台词) {\n    const 组 = 新建('div', 'dl-fields');\n    const 项们 = 按行键值(内容);\n    if (!项们.length) {\n      组.appendChild(新建('div', 'dl-field-value', 内容));\n      return 组;\n    }\n    for (const 项 of 项们) {\n      if (!项.键) {\n        组.appendChild(新建('div', 'dl-field-value', 项.值));\n        continue;\n      }\n      const 行 = 新建('div', 'dl-field-row');\n      行.appendChild(新建('div', 'dl-field-name', 项.键));\n      const 值 = 新建('div', 'dl-field-value', 项.值);\n      if (高亮台词 && /「[^」]+」|\"[^\"]+\"/.test(项.值)) 值.classList.add('dl-dialogue');\n      行.appendChild(值);\n      组.appendChild(行);\n    }\n    return 组;\n  }\n\n  function 生成文本块(内容) {\n    return 新建('div', 'dl-text-block', 内容);\n  }\n\n  function 生成场景(面板, 文档) {\n    const 容器 = 面板.querySelector('[data-role=\"场景栏\"]');\n    清空(容器);\n    const 场景 = 取单个文本(文档, 'scene');\n    if (是空内容(场景)) return 0;\n    const 片段们 = 场景.split(/\\s*[|｜,，]\\s*/).map(项 => 项.trim()).filter(Boolean);\n    for (const 片段 of 片段们) {\n      const 胶囊 = 应用魂环(新建('span', 'dl-scene-chip', 片段), 取魂环类(片段, 'dl-ring-white'));\n      容器.appendChild(胶囊);\n    }\n    return 片段们.length;\n  }\n\n  function 设置视图(面板, 名称) {\n    const 视图 = ['环境', 'NPC', '正文', '推演'].includes(名称) ? 名称 : '正文';\n    面板.dataset.view = 视图;\n    for (const 节点 of 面板.querySelectorAll('[data-view-target]')) {\n      节点.dataset.active = 节点.dataset.viewTarget === 视图 ? 'true' : 'false';\n    }\n    const 标题 = 面板.querySelector('[data-role=\"视图标题\"]');\n    if (标题) 标题.textContent = 视图;\n    面板.dataset.switching = 'true';\n    window.setTimeout(() => {\n      if (面板.dataset.view === 视图) delete 面板.dataset.switching;\n    }, 220);\n    if (视图 === '推演') 设置抽屉(面板, true);\n  }\n\n  function 生成档案(面板, 文档) {\n    const 容器 = 面板.querySelector('[data-role=\"档案列\"]');\n    清空(容器);\n    const 档案们 = 取全部(文档, 'npc_profile');\n    if (!档案们.length) {\n      容器.classList.add('dl-hidden');\n      return 0;\n    }\n    容器.classList.remove('dl-hidden');\n    for (const 节点 of 档案们) {\n      const 内容 = 取文本(节点);\n      const 名称 = 取属性(节点, 'name') || 'NPC';\n      const 卡 = 应用魂环(新建('article', 'dl-profile-card'), 取魂环类(内容, 'dl-ring-yellow'));\n      卡.tabIndex = 0;\n      卡.setAttribute('role', 'button');\n      卡.setAttribute('aria-expanded', 'false');\n      卡.dataset.open = 'false';\n      const 头 = 新建('div', 'dl-profile-head');\n      头.appendChild(新建('div', 'dl-avatar', 取头像字(名称)));\n      const 名称列 = 新建('div', '');\n      名称列.appendChild(新建('div', 'dl-profile-name', 名称));\n      const 摘要 = 取摘要(内容);\n      if (摘要) 名称列.appendChild(新建('div', 'dl-profile-summary', 摘要));\n      头.appendChild(名称列);\n      const 详情 = 新建('div', 'dl-profile-detail');\n      详情.appendChild(生成字段组(内容, false));\n      卡.appendChild(头);\n      卡.appendChild(详情);\n      容器.appendChild(卡);\n    }\n    return 档案们.length;\n  }\n\n  function 生成行动卡(节点) {\n    const 内容 = 取文本(节点);\n    const 名称 = 取属性(节点, 'name') || '角色';\n    const 卡 = 应用魂环(新建('article', 'dl-card-act'), 取魂环类(内容, 'dl-ring-purple'));\n    卡.dataset.name = 名称;\n    卡.appendChild(新建('div', 'dl-card-name', 名称));\n    卡.appendChild(生成字段组(内容, true));\n    return 卡;\n  }\n\n  function 生成内心卡(节点) {\n    const 内容 = 取文本(节点);\n    const 名称 = 取属性(节点, 'name') || 'NPC';\n    const 卡 = 应用魂环(新建('article', 'dl-card-inner'), 取魂环类(内容, 'dl-ring-yellow'));\n    卡.dataset.name = 名称;\n    卡.appendChild(新建('div', 'dl-card-name', 名称));\n    卡.appendChild(生成字段组(内容, false));\n    return 卡;\n  }\n\n  function 生成旁白卡(内容) {\n    const 卡 = 应用魂环(新建('section', 'dl-stage-text'), 取魂环类(内容, 'dl-ring-white'));\n    const 正文 = 新建('div', 'dl-stage-body', 内容);\n    卡.appendChild(正文);\n    if (内容.length > 220) {\n      卡.dataset.collapsed = 'true';\n      const 按钮 = 新建('button', 'dl-read-more', '展开');\n      按钮.type = 'button';\n      按钮.addEventListener('click', () => {\n        const 收起 = 卡.dataset.collapsed === 'true';\n        卡.dataset.collapsed = 收起 ? 'false' : 'true';\n        按钮.textContent = 收起 ? '收起' : '展开';\n      });\n      卡.appendChild(按钮);\n    }\n    return 卡;\n  }\n\n  function 是舞台子标签(节点) {\n    return ['act', 'npc_inner', 'interplay'].includes(节点.nodeName.toLowerCase());\n  }\n\n  function 收集舞台旁白(舞台) {\n    const 旁白 = [];\n    for (const 子 of Array.from(舞台.childNodes)) {\n      if (子.nodeType === Node.TEXT_NODE) {\n        const 文本 = 子.textContent.trim();\n        if (!是空内容(文本)) {\n          for (const 行 of 切行(文本)) {\n            const 匹配 = /^interplay\\s*[：:=]\\s*(.+)$/i.exec(行);\n            旁白.push(匹配 ? 匹配[1].trim() : 行);\n          }\n        }\n      }\n      if (子.nodeType === Node.ELEMENT_NODE && !是舞台子标签(子)) {\n        const 文本 = 取文本(子);\n        if (!是空内容(文本)) 旁白.push(文本);\n      }\n    }\n    return 旁白.filter(项 => !是空内容(项));\n  }\n\n  function 生成正文(面板, 文档) {\n    const 容器 = 面板.querySelector('[data-role=\"正文流\"]');\n    清空(容器);\n    const 已用内心 = new WeakSet();\n    const 全部内心 = 取全部(文档, 'npc_inner');\n    const 舞台们 = 取全部(文档, 'stage');\n    let 数量 = 0;\n\n    const 渲染舞台 = 舞台 => {\n      let 上个行动 = null;\n      for (const 子 of Array.from(舞台.childNodes)) {\n        if (子.nodeType !== Node.ELEMENT_NODE) continue;\n        const 标签名 = 子.nodeName.toLowerCase();\n        if (标签名 === 'act') {\n          const 卡 = 生成行动卡(子);\n          容器.appendChild(卡);\n          上个行动 = 卡;\n          数量 += 1;\n          const 名称 = 取属性(子, 'name');\n          const 匹配内心 = 全部内心.find(内心 => !已用内心.has(内心) && 取属性(内心, 'name') === 名称);\n          if (匹配内心) {\n            卡.appendChild(生成内心卡(匹配内心));\n            已用内心.add(匹配内心);\n            数量 += 1;\n          }\n        } else if (标签名 === 'npc_inner') {\n          if (已用内心.has(子)) continue;\n          const 名称 = 取属性(子, 'name');\n          if (上个行动 && 上个行动.dataset.name === 名称) {\n            上个行动.appendChild(生成内心卡(子));\n          } else {\n            容器.appendChild(生成内心卡(子));\n          }\n          已用内心.add(子);\n          数量 += 1;\n        } else if (标签名 === 'interplay') {\n          const 文本 = 取文本(子);\n          if (!是空内容(文本)) {\n            容器.appendChild(生成旁白卡(文本));\n            数量 += 1;\n          }\n        }\n      }\n      for (const 旁白 of 收集舞台旁白(舞台)) {\n        容器.appendChild(生成旁白卡(旁白));\n        数量 += 1;\n      }\n    };\n\n    if (舞台们.length) {\n      for (const 舞台 of 舞台们) 渲染舞台(舞台);\n    } else {\n      for (const 行动 of 取全部(文档, 'act')) {\n        容器.appendChild(生成行动卡(行动));\n        数量 += 1;\n      }\n    }\n\n    for (const 内心 of 全部内心) {\n      if (已用内心.has(内心)) continue;\n      容器.appendChild(生成内心卡(内心));\n      已用内心.add(内心);\n      数量 += 1;\n    }\n\n    return 数量;\n  }\n\n  function 分解步骤(内容) {\n    const 步骤 = [];\n    const 正则 = /(step\\s*\\d+[^：:\\n]*(?:[：:]|）)?|【[^】]+】)/gi;\n    let 上次 = 0;\n    let 标题 = '';\n    let 匹配;\n    while ((匹配 = 正则.exec(内容))) {\n      const 前文 = 内容.slice(上次, 匹配.index).trim();\n      if (前文 || 标题) 步骤.push({ 标题: 标题 || '内容', 内容: 前文 });\n      标题 = 匹配[0].trim();\n      上次 = 正则.lastIndex;\n    }\n    const 收尾 = 内容.slice(上次).trim();\n    if (收尾 || 标题) 步骤.push({ 标题: 标题 || '内容', 内容: 收尾 });\n    if (!步骤.length) {\n      return 切行(内容).map((行, 序号) => ({ 标题: `step ${序号 + 1}`, 内容: 行 }));\n    }\n    return 步骤;\n  }\n\n  function 渲染路由(面板, 文档) {\n    const 容器 = 面板.querySelector('[data-role=\"路由盒\"]');\n    清空(容器);\n    const 文本 = 取单个文本(文档, '模块路由');\n    const 命中 = !是空内容(文本) && !/未命中/.test(文本);\n    const 灯们 = 面板.querySelectorAll('[data-role=\"路由灯\"], [data-role=\"抽屉路由灯\"], [data-role=\"节点路由灯\"]');\n    for (const 灯 of 灯们) {\n      灯.classList.toggle('dl-route-hit', 命中);\n      灯.classList.toggle('dl-route-idle', !命中);\n    }\n    if (是空内容(文本)) return { 数量: 0, 命中 };\n    const 分区标题 = 新建('div', 'dl-drawer-section-title', '模块路由');\n    const 卡 = 应用魂环(新建('div', 'dl-route-box'), 命中 ? 取魂环类(文本, 'dl-ring-black') : 'dl-ring-white');\n    卡.dataset.routeHit = 命中 ? 'true' : 'false';\n    卡.appendChild(生成字段组(文本, false));\n    容器.appendChild(分区标题);\n    容器.appendChild(卡);\n    return { 数量: 1, 命中 };\n  }\n\n  function 渲染审查(面板, 文档) {\n    const 容器 = 面板.querySelector('[data-role=\"审查步骤\"]');\n    清空(容器);\n    const 配置 = [\n      ['剧情审查', 取单个文本(文档, '剧情审查')],\n      ['dm_plan', 取单个文本(文档, 'dm_plan')],\n      ['recall', 取单个文本(文档, 'recall')],\n      ['timeline_recall', 取单个文本(文档, 'timeline_recall')],\n      ['偏差账本召回', 取单个文本(文档, '偏差账本召回')]\n    ].filter(([, 内容]) => !是空内容(内容));\n    if (!配置.length) return 0;\n    容器.appendChild(新建('div', 'dl-drawer-section-title', '裁定推演'));\n    const 步骤列 = 新建('div', 'dl-review-steps');\n    let 数量 = 0;\n    for (const [标题, 内容] of 配置) {\n      for (const 步骤 of 分解步骤(内容)) {\n        const 卡 = 应用魂环(新建('div', 'dl-step-item'), 取魂环类(`${标题}\\n${步骤.标题}\\n${步骤.内容}`, 'dl-ring-yellow'));\n        卡.appendChild(新建('div', 'dl-step-title', `${标题} · ${步骤.标题}`));\n        if (步骤.内容) 卡.appendChild(生成文本块(步骤.内容));\n        步骤列.appendChild(卡);\n        数量 += 1;\n      }\n    }\n    容器.appendChild(步骤列);\n    return 数量;\n  }\n\n  function 生成折叠项(标题, 内容, 默认类) {\n    const 项 = 应用魂环(新建('div', 'dl-accordion-item'), 取魂环类(`${标题}\\n${内容}`, 默认类 || 'dl-ring-yellow'));\n    项.dataset.open = 'false';\n    const 头 = 新建('button', 'dl-accordion-head');\n    头.type = 'button';\n    头.appendChild(新建('span', '', 标题));\n    头.appendChild(新建('span', 'dl-ring-chip', '展开'));\n    const 体 = 新建('div', 'dl-accordion-body');\n    体.appendChild(生成字段组(内容, false));\n    头.addEventListener('click', () => {\n      项.dataset.open = 项.dataset.open === 'true' ? 'false' : 'true';\n    });\n    项.appendChild(头);\n    项.appendChild(体);\n    return 项;\n  }\n\n  function 渲染幕后(面板, 文档) {\n    const 容器 = 面板.querySelector('[data-role=\"幕后折叠\"]');\n    清空(容器);\n    const 条目 = [];\n    for (const 节点 of 取全部(文档, 'npc_track')) {\n      条目.push([`npc_track · ${取属性(节点, 'name') || 'NPC'}`, 取文本(节点)]);\n    }\n    for (const 节点 of 取全部(文档, 'npc_jump')) {\n      const 时间 = 取属性(节点, '跃过时间');\n      const 名称 = `${取属性(节点, 'name') || 'NPC'}${时间 ? ` ${时间}` : ''}`;\n      条目.push([`npc_jump · ${名称}`, 取文本(节点)]);\n    }\n    const dmtrack = 取单个文本(文档, 'dmtrack');\n    const dmtrack剩余 = dmtrack.replace(取单个文本(文档, 'scene'), '').trim();\n    if (!是空内容(dmtrack剩余)) 条目.push(['dmtrack', dmtrack剩余]);\n    if (!条目.length) return 0;\n    容器.appendChild(新建('div', 'dl-drawer-section-title', '幕后动向'));\n    for (const [标题, 内容] of 条目) {\n      if (!是空内容(内容)) 容器.appendChild(生成折叠项(标题, 内容, 'dl-ring-yellow'));\n    }\n    return 条目.length;\n  }\n\n  function 渲染世界账本(面板, 文档) {\n    const 容器 = 面板.querySelector('[data-role=\"世界账本\"]');\n    清空(容器);\n    const 配置 = [\n      ['dm_box', 取单个文本(文档, 'dm_box')],\n      ['dm_set', 取单个文本(文档, 'dm_set')]\n    ].filter(([, 内容]) => !是空内容(内容));\n    if (!配置.length) return 0;\n    容器.appendChild(新建('div', 'dl-drawer-section-title', '世界账本'));\n    for (const [标题, 内容] of 配置) {\n      const 卡 = 应用魂环(新建('div', 'dl-world-card'), 取魂环类(`${标题}\\n${内容}`, 'dl-ring-purple'));\n      卡.appendChild(新建('div', 'dl-card-title', 标题));\n      卡.appendChild(生成字段组(内容, false));\n      容器.appendChild(卡);\n    }\n    return 配置.length;\n  }\n\n  function 设置主题(面板, 名称) {\n    const 主题 = 主题列表.includes(名称) ? 名称 : 主题列表[0];\n    面板.dataset.theme = 主题;\n    for (const 按钮 of 面板.querySelectorAll('[data-theme-name]')) {\n      按钮.setAttribute('aria-pressed', 按钮.dataset.themeName === 主题 ? 'true' : 'false');\n    }\n    写存储(主题存储键, 主题);\n  }\n\n  function 设置字号(面板, 值) {\n    const 字号 = 字号列表.includes(String(值)) ? String(值) : '1';\n    面板.style.setProperty('--dl-font-scale', 字号);\n    写存储(字号存储键, 字号);\n  }\n\n  function 切换字号(面板) {\n    const 当前 = getComputedStyle(面板).getPropertyValue('--dl-font-scale').trim() || '1';\n    const 序号 = 字号列表.indexOf(当前);\n    设置字号(面板, 字号列表[(序号 + 1) % 字号列表.length]);\n  }\n\n  function 设置密度(面板, 值) {\n    const 密度 = 值 === '紧凑' ? '紧凑' : '标准';\n    面板.dataset.density = 密度;\n    写存储(密度存储键, 密度);\n  }\n\n  function 切换密度(面板) {\n    设置密度(面板, 面板.dataset.density === '紧凑' ? '标准' : '紧凑');\n  }\n\n  function 设置抽屉(面板, 打开) {\n    const 按钮 = 面板.querySelector('[data-action=\"toggle-drawer\"]');\n    if (!打开 && 面板.querySelector('.dl-drawer')?.contains(document.activeElement) && 按钮) {\n      按钮.focus();\n    }\n    面板.classList.toggle('is-drawer-open', 打开);\n    const 抽屉 = 面板.querySelector('.dl-drawer');\n    if (按钮) 按钮.setAttribute('aria-expanded', 打开 ? 'true' : 'false');\n    if (抽屉) 抽屉.setAttribute('aria-hidden', 打开 ? 'false' : 'true');\n  }\n\n  function 切换档案(卡) {\n    const 列 = 卡.closest('[data-role=\"档案列\"]');\n    const 打开 = 卡.dataset.open === 'true';\n    if (列) {\n      for (const 同级 of 列.querySelectorAll('.dl-profile-card')) {\n        同级.dataset.open = 'false';\n        同级.setAttribute('aria-expanded', 'false');\n      }\n    }\n    卡.dataset.open = 打开 ? 'false' : 'true';\n    卡.setAttribute('aria-expanded', 打开 ? 'false' : 'true');\n  }\n\n  function 绑定交互(面板) {\n    设置主题(面板, 读存储(主题存储键, 主题列表[0]));\n    设置字号(面板, 读存储(字号存储键, '1'));\n    设置密度(面板, 读存储(密度存储键, '标准'));\n\n    面板.addEventListener('click', 事件 => {\n      const 视图节点 = 事件.target.closest('[data-view-target]');\n      if (视图节点 && 面板.contains(视图节点)) {\n        设置视图(面板, 视图节点.dataset.viewTarget);\n        return;\n      }\n\n      const 主题按钮 = 事件.target.closest('[data-theme-name]');\n      if (主题按钮 && 面板.contains(主题按钮)) {\n        设置主题(面板, 主题按钮.dataset.themeName);\n        return;\n      }\n\n      const 动作按钮 = 事件.target.closest('[data-action]');\n      if (动作按钮 && 面板.contains(动作按钮)) {\n        if (动作按钮.dataset.action === 'font') 切换字号(面板);\n        if (动作按钮.dataset.action === 'density') 切换密度(面板);\n        if (动作按钮.dataset.action === 'toggle-drawer') 设置抽屉(面板, !面板.classList.contains('is-drawer-open'));\n        if (动作按钮.dataset.action === 'close-drawer') 设置抽屉(面板, false);\n        return;\n      }\n\n      const 档案卡 = 事件.target.closest('.dl-profile-card');\n      if (档案卡 && 面板.contains(档案卡)) 切换档案(档案卡);\n    });\n\n    面板.addEventListener('keydown', 事件 => {\n      const 视图节点 = 事件.target.closest('[data-view-target]');\n      if (视图节点 && 面板.contains(视图节点) && (事件.key === 'Enter' || 事件.key === ' ')) {\n        事件.preventDefault();\n        设置视图(面板, 视图节点.dataset.viewTarget);\n        return;\n      }\n\n      const 档案卡 = 事件.target.closest('.dl-profile-card');\n      if (!档案卡 || !面板.contains(档案卡)) return;\n      if (事件.key !== 'Enter' && 事件.key !== ' ') return;\n      事件.preventDefault();\n      切换档案(档案卡);\n    });\n  }\n\n  function 启动(面板) {\n    if (面板.dataset.initialized === 'true') return;\n    面板.dataset.initialized = 'true';\n    const 原文 = 面板.querySelector('.dl-buffer')?.value || '';\n    const 文档 = 解析文档(原文);\n    绑定交互(面板);\n    const 场景数 = 生成场景(面板, 文档);\n    const 档案数 = 生成档案(面板, 文档);\n    const 正文数 = 生成正文(面板, 文档);\n    const 路由 = 渲染路由(面板, 文档);\n    const 审查数 = 渲染审查(面板, 文档);\n    const 幕后数 = 渲染幕后(面板, 文档);\n    const 账本数 = 渲染世界账本(面板, 文档);\n    const 统计 = 面板.querySelector('[data-role=\"统计\"]');\n    const 数据数 = 路由.数量 + 审查数 + 幕后数 + 账本数;\n    if (统计) 统计.textContent = `场景 ${场景数} / 档案 ${档案数} / 正文 ${正文数} / 数据 ${数据数}`;\n    const 空态 = 面板.querySelector('[data-role=\"空态\"]');\n    if (空态 && !场景数 && !档案数 && !正文数 && !数据数) 空态.classList.remove('dl-hidden');\n    const 视图状态 = 面板.querySelector('[data-role=\"视图状态\"]');\n    if (视图状态) 视图状态.textContent = `场景 ${场景数} / 档案 ${档案数} / 正文 ${正文数}`;\n    设置视图(面板, '正文');\n  }\n\n  for (const 面板 of document.querySelectorAll('.dl-panel')) {\n    启动(面板);\n  }\n})();\n\n</script>\n</html>\n```",
